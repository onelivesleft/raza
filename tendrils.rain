// Black's connected material: a nest, a probing strand, then a single impact.
// Time is measured by the volley, not by a population of disposable particles.
BLACK_REACH :: 0.32
BLACK_PULSE :: 0.28
BLACK_SNAP :: 0.28
BLACK_IMPACT :: BLACK_REACH + BLACK_PULSE + BLACK_SNAP
BLACK_RESIDUE :: 0.22

black_strands :: (amount: i32 -> i64) #pure {
    return 3 + i64'Math.min(Math.sqrt(f32'Math.max(amount, 1)) * 2, 21.0)
}

black_size :: (amount: i32 -> f32) #pure {
    return 1.1 + Math.min(Math.sqrt(f32'Math.max(amount, 1)) * 0.18, 2.0)
}

black_origin :: (layout: Layout, game: Game, from: i64, time: f32 -> V2) #pure {
    *count: i64 = 0
    *before: i64 = 0
    for colour: [4] Mana⟨.WHITE, .BLUE, .BLACK, .RED⟩ {
        if has_colour(game.identity[from], colour) {
            count += 1
            if colour == .WHITE or colour == .BLUE then before += 1
        }
    }
    if count <= 1 then return layout.seats[from].icon
    angle := f32'before / f32'count * f32'Math.TAU + time * 0.05
    return layout.seats[from].icon + V2⟨Math.cos(angle), Math.sin(angle)⟩ * (0.5 * cell_of(layout))
}

// Bow past the toolbar rather than vanishing beneath its buttons.
black_bend :: (layout: Layout, start: V2, end: V2 -> V2) #pure {
    *bend := (start + end) / 2
    centre := layout.centre
    cell := cell_of(layout)
    // Choose a side from the source, so crossing the centre with the finger
    // does not flip an established strand to the opposite side.
    for i: 1 < 10 {
        p := curve_at(start, bend, end, f32'i / 10)
        if Math.abs(p.x - centre.x) < (CAPSULE_HALF_WIDTH + 0.55) * cell and Math.abs(p.y - centre.y) < 1.1 * cell {
            side: f32 = if start.y <= centre.y then 1 else -1
            bend.x = centre.x + side * (CAPSULE_HALF_WIDTH + 2.0) * cell * 2
            break
        }
    }
    return bend
}

TENDRIL_POINTS :: 28

// A tapered ribbon, with a thin cool rim and an oily, almost black body.
// The envelope pins both ends. Several travelling waves make its curl turn
// over itself without disconnecting it into independent smoke particles.
draw_tendril :: (canvas: *Draw.Canvas, start: V2, bend: V2, end: V2, width: f32,
                 curl: f32, time: f32, seed: f32, extent: f32 = 1, pulse: f32 = 0) {
    *points: [TENDRIL_POINTS] V2
    *outline: [TENDRIL_POINTS * 2] V2
    for i: 0 < TENDRIL_POINTS {
        t := f32'i / f32'(TENDRIL_POINTS - 1) * extent
        tangent := curve_at(start, bend, end, Math.min(t + 0.01, 1.0)) - curve_at(start, bend, end, Math.max(t - 0.01, 0.0))
        way := tangent / Math.max(Math.length(tangent), 0.001)
        across := V2⟨0 - way.y, way.x⟩
        envelope := Math.sin(t * f32'Math.PI)
        wave := Math.sin(t * 12 + seed + time * 1.3) + 0.4 * Math.sin(t * 23 - time * 1.7 + seed * 2)
        points[i] = curve_at(start, bend, end, t) + across * (curl * envelope * wave)
    }
    for i: 0 < TENDRIL_POINTS {
        t := f32'i / f32'(TENDRIL_POINTS - 1)
        tangent := points[Math.min(i + 1, TENDRIL_POINTS - 1)] - points[Math.max(i - 1, 0)]
        way := tangent / Math.max(Math.length(tangent), 0.001)
        across := V2⟨0 - way.y, way.x⟩
        swelling := 1 + pulse * (0.5 + 0.5 * Math.sin(t * 18 - time * 25))
        radius := width * (0.10 + 0.90 * (1 - t)) * swelling
        outline[i] = points[i] + across * radius
        outline[TENDRIL_POINTS * 2 - 1 - i] = points[i] - across * radius
    }
    canvas.fill_polygon(outline[:], Draw.rgb(0x42434F))
    // Inset the body, leaving only a hair of oily highlight along the edge.
    for i: 0 < TENDRIL_POINTS {
        outline[i] = Math.mix(points[i], outline[i], 0.78)
        j := TENDRIL_POINTS * 2 - 1 - i
        outline[j] = Math.mix(points[i], outline[j], 0.90)
    }
    canvas.fill_polygon(outline[:], Draw.Gradient⟨from: start, to: end,
        colours: ⟨Draw.rgb(0x08070C), Draw.rgb(0x17121F), Draw.rgb(0x050509)⟩,
        pattern: ⟨kind: .OIL, scale: Math.max(width * 4, 1.0), strength: 0.5, seed: seed, time: time * 0.25⟩⟩)
}

// Short searching arms wind around and out of a common, roiling body.
draw_black_nest :: (canvas: *Draw.Canvas, at: V2, size: f32, time: f32, seed: f32) {
    canvas.fill_glow(at, size * 0.7, Draw.rgba(0x5F536D, 0.23))
    for i: 0 < 13 {
        phase := f32'i * 2.39996 + seed
        turn := phase + 0.24 * Math.sin(time * 0.43 + phase)
        way := V2⟨Math.cos(turn), Math.sin(turn)⟩
        across := V2⟨0 - way.y, way.x⟩
        reach := size * (0.43 + 0.16 * Math.sin(time * 0.61 + phase * 1.7))
        tip := at + way * reach + across * (size * 0.12 * Math.sin(time * 0.7 + phase))
        bend := at + way * (size * 0.25) + across * (size * 0.42)
        draw_tendril(canvas, at - way * (size * 0.12), bend, tip, size * 0.065, size * 0.09, time, phase)
    }
    draw_oil_body(canvas, at, size * 0.72, 0, time, seed)
}

draw_black_attacks :: (canvas: *Draw.Canvas, layout: Layout, game: Game, screen: Screen_State, volleys: Volleys, time: f32) {
    cell := cell_of(layout)
    if screen.drag.active and has_colour(game.identity[screen.drag.from], .BLACK) {
        start := black_origin(layout, game, screen.drag.from, time)
        bend := black_bend(layout, start, screen.mouse)
        draw_tendril(canvas, start, bend, screen.mouse, cell * 0.09, cell * 0.36, time, 1)
    }
    for volley: volleys.list {
        if !volley.black then continue
        age := volley.age
        snap := Math.clamp((age - BLACK_REACH - BLACK_PULSE) / BLACK_SNAP, 0.0, 1.0)
        pull := snap * snap * snap
        base := curve_at(volley.start, volley.bend, volley.end, pull)
        size := black_size(volley.amount) * cell
        if age >= BLACK_IMPACT {
            remaining := Math.clamp(1 - (age - BLACK_IMPACT) / BLACK_RESIDUE, 0.0, 1.0)
            canvas.fill_glow(volley.end, size * 1.2, Draw.rgba(0x24132D, remaining * 0.6))
            draw_black_nest(canvas, volley.end, size * Math.sqrt(remaining), time * 2, f32'volley.id)
            continue
        }
        strands := black_strands(volley.amount)
        for i: 0 < strands {
            seed := f32'i * 2.39996
            // The original strand reaches first; the others spear out in a fan.
            extent := if i == 0 then 1.0 else Math.clamp((age - f32'i / f32'strands * 0.08) / (BLACK_REACH - 0.08), 0.0, 1.0)
            spread := V2⟨Math.cos(seed), Math.sin(seed)⟩
            tip := volley.end + spread * (cell * 0.4 * (1 - pull))
            bend := Math.mix(volley.bend, volley.end, pull) + spread * (cell * 0.65 * (1 - pull))
            pulse: f32 = if age >= BLACK_REACH then 1 else 0
            draw_tendril(canvas, base, bend, tip, cell * (0.075 + 0.025 * Math.sin(seed)), cell * 0.48 * (1 - pull), time, seed, extent, pulse)
        }
        draw_black_nest(canvas, base, size * (1 + 0.12 * Math.sin(snap * f32'Math.PI)), time, f32'volley.id)
    }
}

// Focused captures of the actual draw and strike paths; no saved game is used.
save_black_snapshots :: (folder: string) [failed: string] {
    #with scratch.rewind()
    `scratch {
        *canvas: Draw.Canvas
        if c := Draw.create_canvas(⟨1280, 800⟩) { canvas = c } else if os_error { fail: failed = "cannot create black snapshot canvas" }
        defer canvas.destroy()
        layout := lay_out(⟨1280, 800⟩, equal_splits(2, ⟨1280, 800⟩))
        *game := new_game(2)
        game.identity[1] = u8'1 << u8'Mana.BLACK
        game.identity[0] = u8'1 << u8'Mana.RED
        *fonts: Fonts
        if fonts.reload_fonts(TEXT_FAMILIES[0], layout) is os_error then fail: failed = "cannot load black snapshot fonts"
        *motes: Particles.System = ⟨time: 10, flow_scale: MOTE_FLOW * cell_of(layout)⟩
        *volleys: Volleys
        *random := Random.generator(seed: 17)
        *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
        finger := layout.seats[0].middle + V2⟨120, 50⟩
        *previous: f32 = 0
        for age, i: [7] f32⟨-2, -1, 0.16, 0.44, 0.72, 0.84, 0.94⟩ {
            if i == 2 then strike(game, motes, volleys, random, layout, pending, 1, 0, 18, finger)
            if age >= 0 {
                delta := age - previous
                motes.update(delta)
                steer_volleys(motes, volleys, random, layout, game, pending, delta)
                previous = age
            }
            screen := Screen_State⟨drag: ⟨i == 1, 1⟩, mouse: finger⟩
            draw(canvas, layout, shown_game(game, pending), fonts, screen, motes, volleys)
            path := `scratch "«folder»/black_«i».png"
            if canvas.save_png(path) is os_error then fail: failed = "cannot write black snapshot PNG"
        }
    }
}
