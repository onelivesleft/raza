// Raza's tests: the layout's parts and the game's rules.

LANDSCAPE :: V2⟨2160, 1440⟩
PORTRAIT  :: V2⟨1440, 2160⟩

near_point :: (a: V2, b: V2 -> bool) {
    return Math.length(a - b) < 0.5
}

// Each finger is followed by its id: one let go this frame, or gone, has let
// go, one still down hasn't. Opening the count column or the settings ends
// every player's drag and grid; a drum stays open (only its cross or tick
// ends it), and one spinning spins on.
fingers_are_followed_apart :: () #test {
    pointers := [2] Pointer⟨⟨3, ⟨10, 10⟩, false, false⟩, ⟨5, ⟨20, 20⟩, false, true⟩⟩
    assert(!let_go(pointers[:], 3) and let_go(pointers[:], 5) and let_go(pointers[:], 9), "3 down, 5 let go, 9 gone")
    if down := pointer_with(pointers[:], 3) { assert(down.at == V2⟨10, 10⟩, "3 at «down.at»") } else if absent { assert(false, "3's down") }
    *screen: Screen_State
    screen.drags[0] = ⟨active: true, from: 0⟩
    screen.drags[2] = ⟨active: true, from: 2⟩
    screen.pickers[1] = ⟨open: true, from: 1, to: 0⟩
    screen.drums[3] = ⟨open: true, player: 3⟩
    screen.drums[1] = ⟨open: true, player: 1, start: 40, from: 40, place: 1, turned: 2.8, speed: 6, spinning: true⟩
    assert(dragging(screen) and any_grid_open(screen), "two dragging, a grid open")
    end_gestures(screen)
    assert(!dragging(screen) and !any_grid_open(screen), "the drags and the grid ended")
    assert(screen.drums[3].open, "the drum still open")
    assert(screen.drums[1].open and screen.drums[1].spinning, "the spinning drum still spinning")
}

// A drag's damage confirmed: the amount's button a square where the finger
// let go; one more's above it and one less's below, as wide and half as
// tall, and two more's and two less's beyond them, half as wide and half as
// tall as the amount's, a small gap between each, as the dragger sees them
// (none below 1); all on the screen, even
// let go at its corner. Touched, each gives its damage, and the gap between
// them none. While one's open, something's under way (undo waits), and the
// count column or the settings opening ends it.
confirms_ask_where_let_go :: () #test {
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        layout := laid_out(4, size)
        cell := cell_of(layout)
        wide := 2.1 * cell
        for from: 0 < 4 {
            to := (from + 2) % 4
            // (half way to their life: room all round)
            at := Math.mix(layout.centre, layout.seats[to].middle, 0.5)
            confirm := Confirm⟨open: true, from: from, to: to, amount: 5, at: at⟩
            buttons, count, origin, angle := confirm_buttons(layout, confirm, wide)
            assert(count == 5 and Math.length(origin - at) < 0.01, "«size», «from»: five, where it was let go")
            assert(buttons[0].damage == 5 and buttons[1].damage == 6 and buttons[2].damage == 4 and buttons[3].damage == 7 and buttons[4].damage == 3,
                   "the amount, one more, one less, two more, two less")
            assert(buttons[0].half.x == buttons[0].half.y and Math.abs(buttons[0].half.x * 2 - wide) < 0.01, "the amount's a square, wide across")
            assert(buttons[1].half.x == buttons[0].half.x and Math.abs(buttons[0].half.y - 2 * buttons[1].half.y) < 0.01,
                   "one more's as wide, half as tall")
            assert(Math.abs(buttons[3].half.x * 2 - wide / 2) < 0.01 and Math.abs(buttons[3].half.y * 2 - wide / 2) < 0.01,
                   "two more's half as wide and half as tall as the amount's")
            // (each the gap from the next)
            gap_above := (buttons[1].middle.y + buttons[1].half.y) - (buttons[0].middle.y - buttons[0].half.y)
            assert(Math.abs(gap_above + CONFIRM_GAP * cell) < 0.01, "«CONFIRM_GAP» cells between them: «gap_above»")
            toward := layout.seats[from].toward
            // (as the dragger sees them, from the top: two more, one more, the amount, one less, two less)
            for i: 0 < 4 {
                upper := placed(origin, angle, buttons[[4] i64⟨3, 1, 0, 2⟩[i]].middle)
                lower := placed(origin, angle, buttons[[4] i64⟨1, 0, 2, 4⟩[i]].middle)
                assert(Math.dot(upper - lower, toward) < 0, "«size», «from»: in order, as the dragger sees them")
            }
            for button: buttons[:count] {
                *got: i32 = -1
                if damage := confirm_damage_at(layout, confirm, wide, placed(origin, angle, button.middle)) is not absent then got = damage
                assert(got == button.damage, "«size», «from»: «button.damage»'s button gives «got»")
            }
            between := placed(origin, angle, V2⟨0, 0 - buttons[0].half.y - CONFIRM_GAP * cell / 2⟩)
            if _ := confirm_damage_at(layout, confirm, wide, between) is not absent then assert(false, "between the buttons, none")
            _, one_count, _, _ := confirm_buttons(layout, Confirm⟨open: true, from: from, to: to, amount: 1, at: at⟩, wide)
            _, two_count, _, _ := confirm_buttons(layout, Confirm⟨open: true, from: from, to: to, amount: 2, at: at⟩, wide)
            assert(one_count == 3 and two_count == 4, "none below 1")
            // (let go at the screen's corner: all of them moved onto it)
            cornered := Confirm⟨open: true, from: from, to: to, amount: 9, at: ⟨1, 1⟩⟩
            moved, moved_count, moved_origin, moved_angle := confirm_buttons(layout, cornered, wide)
            down := placed(V2⟨0, 0⟩, moved_angle, V2⟨0, 1⟩)
            assert(Math.dot(down, Math.normalize(layout.seats[from].middle - cornered.at)) > 0.9999, "the confirm faces the attacker from the release point")
            for button: moved[:moved_count] {
                for corner: [4] V2⟨⟨-1, -1⟩, ⟨1, -1⟩, ⟨-1, 1⟩, ⟨1, 1⟩⟩ {
                    p := placed(moved_origin, moved_angle, button.middle + button.half * corner)
                    assert(p.x >= 0 and p.y >= 0 and p.x <= size.x and p.y <= size.y, "«size», «from»: on the screen: «p»")
                }
            }
        }
    }
    *screen := Screen_State⟨moving_end: -1⟩
    screen.confirms[1] = ⟨open: true, from: 1, to: 3, amount: 4⟩
    assert(under_way(screen) and first_aimed(laid_out(4, LANDSCAPE), new_game(4), screen) == 3, "under way, its target lit")
    end_gestures(screen)
    assert(!under_way(screen), "ended with the other gestures")
}

// A life total's place is one width whatever its digits, two digits' at
// least: 40, 39 and 9 the same, 100 wider by a digit, a minus wider by it.
life_area_is_fixed_by_digits :: () #test {
    fonts := Fonts⟨life_digit: 10, life_minus: 4⟩
    assert(life_area_width(fonts, 40) == 20 and life_area_width(fonts, 39) == 20 and life_area_width(fonts, 9) == 20 and life_area_width(fonts, 0) == 20,
           "two digits' room up to 99")
    assert(life_area_width(fonts, 100) == 30 and life_area_width(fonts, -3) == 24 and life_area_width(fonts, -12) == 24, "more digits, and a minus")
}

// Commander damage alone counts toward the 21 and takes no life, and its
// volley pends none; life+ and life- are life shortcuts, their sign their
// change's.
commander_damage_alone_takes_no_life :: () #test {
    *game := new_game(4)
    game.deal_attack(.COMMANDER_ONLY, 1, 0, 7)
    assert(game.life[0] == STARTING_LIFE and game.commander[0][1] == 7, "7 commander damage, no life: «game.life[0]», «game.commander[0][1]»")
    assert(is_commander(.COMMANDER_ONLY) and !takes_life(.COMMANDER_ONLY) and !takes_life(.POISON) and takes_life(.COMMANDER), "what each does")
    *volleys: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    *struck := new_game(4)
    strike(struck, volleys, laid_out(4, LANDSCAPE), pending, 1, 0, 5, .COMMANDER_ONLY)
    assert(pending[0][1] == 0 and struck.life[0] == STARTING_LIFE and struck.commander[0][1] == 5, "none pending, the chip grows as it lands")
    assert(self_life_delta(.LIFE_UP) == 1 and self_life_delta(.LIFE_DOWN) == -1, "life+ and life-: their signs")
}

// The number grid asked for where a finger let go (or touched) is centred
// there, keys and buttons together, facing its player.
grids_centred_where_asked :: () #test {
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        layout := laid_out(4, size)
        cell := cell_of(layout)
        for k: 0 < 4 {
            seat := layout.seats[k]
            origin, angle, pitch := picker_frame(layout, Picker⟨open: true, from: k, to: k, kind: .LIFE_UP, at: layout.centre⟩)
            below := (GLASS_PAD + PICK_BUTTON_GAP + PICK_BUTTON_TALL) * cell
            middle := placed(origin, angle, V2⟨0, (below - f32'PICK_ROWS * pitch) / 2⟩)
            assert(Math.length(middle - layout.centre) < 0.01, "«size», «k»: the grid centred where it was asked for: «middle»")
            assert(angle == seat.angle, "facing its player")
        }
    }
}

// A drum tapped open again after a turn it was ticked on opens with no
// change: the rows it was turned last time aren't carried into the next.
drums_open_again_at_no_change :: () #test {
    frame: f32 = 1.0 / 60
    cap: f32 = 10
    row := DRUM_PITCH * cap
    *game := new_game(4)
    *drum: Life_Drum
    *timeline: Timeline
    lines: Lines = ⟨⟩
    // (opened, its tens turned up 2, let go, ticked)
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    _, _ := release_drum(drum, game)
    press_drum(drum, game, 1, ⟨0, 0⟩, 10)
    move_drum(drum, ⟨0, 2 * row⟩, cap)
    for _: 0 < 20 { step_drum(drum, game, frame) }
    turned_to, turned := release_drum(drum, game)
    if turned then game.life[1] = turned_to
    commit_drum(drum, game, timeline, lines)
    assert(game.life[1] == 60, "turned up to «game.life[1]»")
    for _: 0 < 60 { step_drum(drum, game, frame) }
    // (tapped open again)
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    _, _ := release_drum(drum, game)
    for _: 0 < 60 { step_drum(drum, game, frame) }
    assert(drum.open and game.life[1] == 60, "open at 60, not «game.life[1]»")
    assert(change_wheel_position(drum) == 0, "opened again showing «change_wheel_position(drum)», not 0 (from «drum.from», start «drum.start»)")
}

// Another player's damage while a drum's open stays: the drum's turn
// carries it, its tick shows only its own change, and its cross undoes
// only its own, whether the damage came while it rested, was held or spun.
drums_keep_others_changes :: () #test {
    frame: f32 = 1.0 / 60
    cap: f32 = 10
    row := DRUM_PITCH * cap
    // (resting: opened at 40, turned up 2, then 5 damage)
    *game := new_game(4)
    *drum: Life_Drum
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    _, _ := release_drum(drum, game)
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    move_drum(drum, ⟨0, 2 * row⟩, cap)
    step_drum(drum, game, frame)
    for _: 0 < 20 { step_drum(drum, game, frame) }
    turned_to, turned := release_drum(drum, game)
    if turned then game.life[1] = turned_to
    assert(game.life[1] == 42, "turned up to «game.life[1]»")
    game.life[1] -= 5
    step_drum(drum, game, frame)
    assert(drum.start == 35, "its start moved with the damage: «drum.start»")
    *crossed := drum
    assert(game.life[1] - crossed.start == 2, "the cross undoes only its own +2")
    *timeline: Timeline
    lines: Lines = ⟨⟩
    *ticked := game
    commit_drum(drum, ticked, timeline, lines)
    assert(ticked.life[1] == 37 and drum.change == 2, "the tick: 37, showing +2, not «drum.change»")
    // (held: damage while a finger turns it, then let go)
    *held_game := new_game(4)
    *held: Life_Drum
    press_drum(held, held_game, 1, ⟨0, 0⟩, 1)
    _, _ := release_drum(held, held_game)
    press_drum(held, held_game, 1, ⟨0, 0⟩, 1)
    move_drum(held, ⟨0, 3 * row⟩, cap)
    step_drum(held, held_game, frame)
    held_game.life[1] -= 5
    for _: 0 < 20 { step_drum(held, held_game, frame) }
    held_to, held_turned := release_drum(held, held_game)
    if held_turned then held_game.life[1] = held_to
    assert(held_game.life[1] == 38 and held.start == 35, "40 - 5 + 3: «held_game.life[1]», from «held.start»")
    // (spinning: damage while it spins, then it settles)
    *spun_game := new_game(4)
    *spun := Life_Drum⟨open: true, player: 1, start: 40, from: 40, place: 1, turned: 0, speed: 3, spinning: true, seen: 40⟩
    spun_game.life[1] -= 5
    *steps := 0
    while !spun.settled and steps < 2000 {
        step_drum(spun, spun_game, frame)
        steps += 1
    }
    assert(spun.settled and spun.settled_life - 35 == i32'spun.goal and spun.start == 35, "settled on 35 and its own turn: «spun.settled_life»")
}

// Undo and redo wait while anything's under way (a drag, a number grid, a
// drum open, held or spinning, a line moved, the count column or the
// settings open), and work once nothing is.
undo_waits_while_anything_is_under_way :: () #test {
    *game := new_game(4)
    *timeline: Timeline
    *lines: Lines
    timeline.remember(game, lines)
    game.life[2] -= 7
    *screen: Screen_State
    screen.moving_end = -1
    assert(!under_way(screen), "nothing under way")
    ways := [8] Screen_State⟨⟨drags: ⟨⟨active: true⟩, ⟨⟩, ⟨⟩, ⟨⟩, ⟨⟩, ⟨⟩⟩, moving_end: -1⟩,
                              ⟨pickers: ⟨⟨⟩, ⟨open: true⟩, ⟨⟩, ⟨⟩, ⟨⟩, ⟨⟩⟩, moving_end: -1⟩,
                              ⟨drums: ⟨⟨⟩, ⟨⟩, ⟨open: true, player: 2⟩, ⟨⟩, ⟨⟩, ⟨⟩⟩, moving_end: -1⟩,
                              ⟨drums: ⟨⟨⟩, ⟨⟩, ⟨pressed: true, player: 2⟩, ⟨⟩, ⟨⟩, ⟨⟩⟩, moving_end: -1⟩,
                              ⟨drums: ⟨⟨⟩, ⟨⟩, ⟨spinning: true, player: 2⟩, ⟨⟩, ⟨⟩, ⟨⟩⟩, moving_end: -1⟩,
                              ⟨moving_end: 1⟩,
                              ⟨counts: ⟨open: true⟩, moving_end: -1⟩,
                              ⟨settings_open: true, moving_end: -1⟩⟩
    for way, i: ways {
        *busy := way
        assert(under_way(busy) and !step_history(busy, timeline, game, lines, false) and game.life[2] == 33, "waits («i»)")
    }
    assert(step_history(screen, timeline, game, lines, false) and game.life[2] == 40, "undone once nothing is")
}

// A wheel let go with a flick spins on, slowing, and settles on a whole row
// further its way, that row's life to be the game's; one turned and held
// still before it's let go doesn't spin; and a spinning wheel's caught
// where it is.
drums_spin_on_when_flicked :: () #test {
    game := new_game(4)
    cap: f32 = 10
    row := DRUM_PITCH * cap
    frame: f32 = 1.0 / 60
    *drum: Life_Drum
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    _, _ := release_drum(drum, game)
    // (a row a frame, down: the bigger digits coming)
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    for i: 1 <= 5 {
        move_drum(drum, ⟨0, f32'i * row⟩, cap)
        step_drum(drum, game, frame)
    }
    _, flicked := release_drum(drum, game)
    assert(drum.spinning and !flicked, "a flick spins on, the life not yet changed")
    for _: 0 < 30 { step_drum(drum, game, frame) }
    turning := drum.turned
    assert(turning > 6 and drum.spinning, "still turning on: «turning»")
    // (caught: where it is, and let go without moving, it stops on the row it's nearest)
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    assert(!drum.spinning and drum.turned == turning, "caught where it was")
    caught, stops := release_drum(drum, game)
    assert(stops and caught == game.life[1] + i32'Math.round(turning), "stopped on its row: «caught»")
    // (let go again with a flick, it slows and settles on its own)
    *settling := drum
    settling.from = caught
    settling.turned = 0
    settling.speed = 20
    settling.spinning = true
    *steps := 0
    while !settling.settled and steps < 2000 {
        step_drum(settling, game, frame)
        steps += 1
    }
    assert(settling.settled and settling.settled_life > caught + 10, "settled further on: «settling.settled_life»")
    assert(settling.goal == Math.floor(settling.goal), "on a whole row")
    // (a turn held still before it's let go is no flick)
    *held: Life_Drum
    press_drum(held, game, 1, ⟨0, 0⟩, 1)
    _, _ := release_drum(held, game)
    press_drum(held, game, 1, ⟨0, 0⟩, 1)
    move_drum(held, ⟨0, 2 * row⟩, cap)
    step_drum(held, game, frame)
    for _: 0 < 20 { step_drum(held, game, frame) }
    _, turned := release_drum(held, game)
    assert(!held.spinning and turned, "held still: no spin, the life its row's")
}

// A drum turns a life no lower than 0, the finger past it moving the wheel
// again as it comes back, and a spin back stops there; a life damage has
// taken below 0 turns no lower than it is.
drums_stop_at_nothing :: () #test {
    cap: f32 = 100
    row := DRUM_PITCH * cap
    frame: f32 = 1.0 / 60
    *game := new_game(4)
    game.life[1] = 3
    *drum: Life_Drum
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    _, _ := release_drum(drum, game)
    // (the units' up five rows: only three)
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    move_drum(drum, ⟨0, -5 * row⟩, cap)
    assert(drum.turned == -3, "stopped at 0: «drum.turned»")
    move_drum(drum, ⟨0, -4 * row⟩, cap)
    assert(Math.abs(drum.turned + 2) < 0.001, "back a row as soon as the finger is: «drum.turned»")
    nothing, _ := release_drum(drum, game)
    assert(nothing == 1, "a row back from 0: «nothing»")
    // (the tens' from 23: two rows, to 3)
    game.life[1] = 23
    press_drum(drum, game, 1, ⟨0, 0⟩, 10)
    move_drum(drum, ⟨0, -4 * row⟩, cap)
    tens, _ := release_drum(drum, game)
    assert(tens == 3, "the tens' stop short of below 0: «tens»")
    // (a spin back settles on 0)
    game.life[1] = 6
    *spun := drum
    spun.from = 6
    spun.seen = 6
    spun.place = 1
    spun.turned = 0
    spun.speed = -40
    spun.spinning = true
    *steps := 0
    while !spun.settled and steps < 2000 {
        step_drum(spun, game, frame)
        steps += 1
    }
    assert(spun.settled and spun.settled_life == 0, "spun back to 0: «spun.settled_life»")
    // (below 0 from damage: no lower, but up)
    game.life[1] = -4
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    move_drum(drum, ⟨0, -2 * row⟩, cap)
    assert(drum.turned == 0, "no lower than it is")
    move_drum(drum, ⟨0, 0⟩, cap)
    up, _ := release_drum(drum, game)
    assert(up == -2, "up from it: «up»")
}

// A life below 0 tapped opens its drum at 0, the change it adds on its
// wheel; the cross takes it back to where it was.
drums_open_at_nothing_from_below :: () #test {
    *game := new_game(4)
    game.life[2] = -4
    *drum: Life_Drum
    press_drum(drum, game, 2, ⟨0, 0⟩, 1)
    life, changes := release_drum(drum, game)
    assert(drum.open and changes and life == 0, "opened at 0: «life»")
    game.life[2] = life
    step_drum(drum, game, 1.0 / 60)
    assert(drum_life(drum) == 0 and change_wheel_position(drum) == 4, "at 0, +4: «change_wheel_position(drum)»")
    assert(drum.start == -4, "the cross's life: «drum.start»")
}

// A life below 0 opened at 0 and cancelled straight away leaves no step to
// undo: the cross takes back the opening's, rather than making another.
// Something done between them, and the cross makes its own step as usual.
cancelled_openings_leave_no_step :: () #test {
    lines: Lines = ⟨⟩
    for between: [2] bool⟨false, true⟩ {
        with scratch.rewind()
        `scratch {
            *game := new_game(4)
            game.life[2] = -4
            *timeline: Timeline
            *drum: Life_Drum
            press_drum(drum, game, 2, ⟨0, 0⟩, 1)
            // (as the program does on letting go: the opening a step to undo)
            life, changes := release_drum(drum, game)
            assert(changes, "opened at 0")
            timeline.remember(game, lines)
            game.life[2] = life
            drum.opening_step = timeline.past.count
            if between {
                timeline.remember(game, lines)
                game.life[0] -= 3
            }
            cancel_drum(drum, game, timeline, lines)
            assert(!drum.open and game.life[2] == -4, "back below: «game.life[2]»")
            steps := if between then 3 else 0
            assert(timeline.past.count == steps, "«steps» steps to undo, with something between («between»): «timeline.past.count»")
        }
    }
}

// Two fingers on the lines turn them all about the centre: on a square a
// quarter turn moves each end a quarter of the way round, and on any screen
// a whole turn (or none) leaves them where they were, in order round.
lines_turn_together :: () #test {
    square := V2⟨1200, 1200⟩
    four := equal_splits(4, square)
    quarter := turned_splits(four, square, f32'Math.TAU / 4)
    for k: 0 < 4 {
        moved := share_between(four.at[k], quarter.at[k])
        assert(Math.abs(moved - 0.25) < 0.001, "line «k» went «moved» round, not a quarter")
    }
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        for players: 2 <= MAX_PLAYERS {
            lines := equal_splits(players, size)
            for angle: [2] f32⟨0, f32'Math.TAU⟩ {
                back := turned_splits(lines, size, angle)
                for k: 0 < players { assert(Math.abs(share_between(lines.at[k], back.at[k])) < 0.001, "«players» on «size», turned «angle»: line «k» back") }
            }
            assert(splits_fit(turned_splits(lines, size, 0.3), players), "«players» on «size»: turned, still in order round")
        }
    }
    assert(Math.abs(turn_between(angle_about(⟨0, 0⟩, ⟨0, 1⟩), angle_about(⟨0, 0⟩, ⟨-1, 0⟩)) - f32'Math.PI / 2) < 0.001, "down to left is a quarter turn clockwise")
}

// Undo brings back a moment's lines only for the orientation they were the
// table's in: after it turns, the game comes back, the lines stay its own.
undo_keeps_each_orientations_lines :: () #test {
    with scratch.rewind()
    `scratch {
        *timeline: Timeline
        *game := new_game(4)
        *lines: Lines
        lines[4] = equal_splits(4, LANDSCAPE)
        timeline.remember(game, lines)
        game.life[0] = 30
        // (the table turns: portrait's own lines)
        timeline.portrait = true
        portrait_lines := lines
        lines[4] = equal_splits(4, PORTRAIT)
        tall := lines
        assert(timeline.undo(game, lines) and game.life[0] == 40, "the game back")
        assert(lines == tall and lines != portrait_lines, "portrait's lines kept, not landscape's")
        assert(timeline.redo(game, lines) and game.life[0] == 30 and lines == tall, "redone, the lines still portrait's")
    }
}

// A game kept by a build whose attacks were a byte each comes over as it
// was: each attack's bit its own, LOSE_TWO on where plain damage's bit was
// clear, plain damage always on.
games_of_bytes_come_over :: () #test {
    *old := Game_Of_Bytes⟨players: 3⟩
    old.life[1] = 17
    old.attacks[0] = 3                                   // damage, commander
    old.attacks[1] = 0b0010_1000                         // lifelink, gain one; bit 0 clear: lose two
    game := from_bytes(old)
    assert(game.players == 3 and game.life[1] == 17, "the game as it was")
    kinds0, n0 := attacks_of(game.attacks[0])
    assert(n0 == 2 and kinds0[0] == .DAMAGE and kinds0[1] == .COMMANDER, "damage and commander: «kinds0[:n0]»")
    assert(has_attack(game.attacks[1], .LIFELINK) and has_attack(game.attacks[1], .GAIN_ONE) and has_attack(game.attacks[1], .LOSE_TWO) and
           !has_attack(game.attacks[1], .COMMANDER), "lifelink, gain one and lose two")
    assert(from_bytes(Game_Of_Bytes⟨players: 0⟩).players == 0, "none kept: none")
}

// A game kept last time comes back as it was; none kept, or one a build
// with another Game kept (Defaults gives the default, with no players), is a
// new game of four whose colours are still to be given, not colourless
// players.
games_come_back_or_start_fresh :: () #test {
    *kept := new_game(3, starting_colours(LANDSCAPE, 3))
    kept.life[1] = 12
    back, fresh := kept_game(kept)
    assert(!fresh and back == kept, "kept: as it was")
    started, new := kept_game(Game⟨players: 0⟩)
    assert(new and started.players == 4 and started.life[0] == STARTING_LIFE, "none kept: four, fresh")
    coloured := starting_colours(LANDSCAPE, 4)
    *any := false
    for c: coloured[:4] { if c != 0 then any = true }
    assert(any, "Reset's colours aren't all colourless")
}

// A player's attacks stand in Attack's order, plain damage first and always
// on; commander damage and commander damage alone are on to start with, and
// the options turn the rest on and off.
attacks_are_in_order_and_turned_on :: () #test {
    kinds, count := attacks_of(STARTING_ATTACKS)
    assert(count == 3 and kinds[0] == .DAMAGE and kinds[1] == .COMMANDER and kinds[2] == .COMMANDER_ONLY,
           "to start with: damage, commander damage, commander damage alone")
    assert(STARTING_ATTACKS == attack_bit(.DAMAGE) | attack_bit(.COMMANDER) | attack_bit(.COMMANDER_ONLY), "its bits")
    every, all := attacks_of(31 | attack_bit(.COMMANDER_ONLY))
    expected := [6] Attack⟨.DAMAGE, .COMMANDER, .COMMANDER_LIFELINK, .COMMANDER_ONLY, .LIFELINK, .POISON⟩
    assert(all == 6 and every[:all] == expected[:], "every attack, in order: «every»")
    *game := new_game(4)
    toggle_attack(game, 2, .POISON)
    toggle_attack(game, 2, .COMMANDER)
    toggle_attack(game, 2, .COMMANDER_ONLY)
    toggle_attack(game, 2, .DAMAGE)
    turned, n := attacks_of(game.attacks[2])
    assert(n == 2 and turned[0] == .DAMAGE and turned[1] == .POISON, "poison on, commander off, damage always: «turned[:n]»")
    kept := new_game(4, game.identity, game.attacks)
    assert(kept.attacks == game.attacks and new_game(4).attacks[2] == STARTING_ATTACKS, "a new game keeps them; a reset's starts them again")
}

self_life_shortcuts_undo_individually :: () #test {
    *timeline: Timeline
    *lines: Lines
    *screen: Screen_State
    *game := new_game(2)
    amounts := [4] i32⟨1, -1, 2, -2⟩
    for amount: amounts {
        previous := game.life[1]
        apply_life_shortcut(timeline, game, lines, screen, 1, amount)
        assert(game.life[1] == previous + amount and screen.history_changes[1].change == amount)
    }
    for i: 0 < 4 {
        before := game
        assert(timeline.undo(game, lines))
        show_history_changes(screen, before, game, true)
        amount := amounts[3 - i]
        assert(game.life[1] == before.life[1] - amount and game.life[0] == 40)
        assert(screen.history_changes[1].change == amount and screen.history_changes[1].crossed)
    }
    assert(!timeline.undo(game, lines))
    for amount: amounts {
        before := game
        assert(timeline.redo(game, lines))
        show_history_changes(screen, before, game, false)
        assert(game.life[1] == before.life[1] + amount and game.life[0] == 40)
        assert(screen.history_changes[1].change == amount and !screen.history_changes[1].crossed)
    }
}

// A player's life shortcuts sit in two rows beyond their leftmost damage chip.
life_shortcuts_beside_damage :: () #test {
    for players: 2 <= MAX_PLAYERS {
        layout := laid_out(players, LANDSCAPE)
        cell := cell_of(layout)
        for seat, k: layout.seats[:players] {
            width := f32'life_size_of(layout) * 0.95
            chips := chip_places(layout, k, width, cell)
            // (every one on: +1, +2, -1, -2, life+, life-, as LIFE_SHORTCUTS)
            *positions: [6] V2
            for kind, i: LIFE_SHORTCUTS {
                world := life_shortcut_place(layout, k, kind, 0xFFF, chips, width)
                assert(world.x > 0 and world.y > 0 and world.x < layout.size.x and world.y < layout.size.y)
                positions[i] = local_of(seat.middle, seat.angle, world)
                assert(positions[i].x < -width / 2)
            }
            if Math.abs(positions[0].x - positions[1].x) < 0.01 {
                // (one column: life+, +2, +1, -1, -2, life- down it)
                for pair: [5] [2] i64⟨⟨4, 1⟩, ⟨1, 0⟩, ⟨0, 2⟩, ⟨2, 3⟩, ⟨3, 5⟩⟩ { assert(positions[pair[0]].y < positions[pair[1]].y) }
            }
            else {
                // (columns out from the life: the ones, the twos, life+ and life-; each gain above its loss)
                assert(positions[4].x < positions[1].x and positions[1].x < positions[0].x and positions[5].x < positions[3].x and positions[3].x < positions[2].x)
                assert(Math.abs(positions[1].y - positions[0].y) < 0.01 and Math.abs(positions[4].y - positions[0].y) < 0.01 and positions[1].y < positions[3].y)
            }
        }
    }
}

enabled_shortcuts_pack_in_order :: () #test {
    layout := laid_out(2, LANDSCAPE)
    cell := cell_of(layout)
    seat := layout.seats[0]
    chips := chip_places(layout, 0, cell, cell)
    for mask: 0 < 16 {
        *selection := new_game(2)
        for key, i: LIFE_SHORTCUTS {
            if (mask & (i64'1 << i)) != 0 then toggle_attack(selection, 0, key)
        }
        enabled := selection.attacks[0]
        *previous: V2
        *seen := false
        for key: [4] Attack⟨.GAIN_TWO, .GAIN_ONE, .LOSE_ONE, .LOSE_TWO⟩ {
            if !has_attack(enabled, key) then continue
            at := local_of(seat.middle, seat.angle, life_shortcut_place(layout, 0, key, enabled, chips, cell))
            if seen {
                assert(Math.abs(at.x - previous.x) < 0.01)
                assert(Math.abs(at.y - previous.y - OPTION_PITCH * cell) < 0.01)
            }
            previous = at
            seen = true
        }
    }
}

// Each attack does what it says: damage takes life, commander damage counts
// toward the 21 too, lifelink gives the attacker as much life, poison gives
// counters, and ten is out; as volleys, each shows happening as it lands.
attacks_do_what_they_say :: () #test {
    *game := new_game(4)
    game.deal_attack(.DAMAGE, 1, 0, 3)
    game.deal_attack(.COMMANDER, 1, 0, 4)
    game.deal_attack(.COMMANDER_LIFELINK, 1, 0, 5)
    game.deal_attack(.LIFELINK, 2, 0, 2)
    game.deal_attack(.POISON, 3, 0, 9)
    assert(game.life[0] == 40 - 3 - 4 - 5 - 2 and game.commander[0][1] == 9 and game.commander[0][2] == 0, "life «game.life[0]», commander damage «game.commander[0][1]»")
    assert(game.life[1] == 45 and game.life[2] == 42 and game.life[3] == 40, "lifelink's life: «game.life[1]», «game.life[2]»")
    assert(game.poison[0] == 9 and !is_out(game, 0), "nine poison: still in")
    game.deal_attack(.POISON, 3, 0, 1)
    assert(is_out(game, 0), "ten poison: out")
    layout := laid_out(4, LANDSCAPE)
    *struck := new_game(4)
    *volleys: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    strike(struck, volleys, layout, pending, 1, 0, 3, .LIFELINK)
    strike(struck, volleys, layout, pending, 2, 3, 10, .POISON)
    before := shown_game(struck, pending, volleys)
    assert(before.life[1] == 40 and before.life[0] == 40 and before.poison[3] == 0, "shown as it was while they fly: «before.life[1]», «before.poison[3]»")
    steer_volleys(volleys, pending, volley_landing(volleys.list[0]) + LIFELINK_ARRIVAL - 0.01)
    flying_back := shown_game(struck, pending, volleys)
    assert(flying_back.life[0] == 37 and flying_back.life[1] == 40, "damage landed, all three gains still returning")
    steer_volleys(volleys, pending, 0.02)
    first_back := shown_game(struck, pending, volleys)
    assert(first_back.life[1] == 41, "only the first returning point reached the attacker")
    steer_volleys(volleys, pending, 4)
    after := shown_game(struck, pending, volleys)
    assert(after.life[1] == 43 and after.life[0] == 37 and after.poison[3] == 10, "landed: «after.life[1]», «after.life[0]», «after.poison[3]»")
    assert(damage_of(amount_for(0.1, .POISON)) == 1 and damage_of(amount_for(0.5, .POISON)) == 2 and damage_of(amount_for(0.9, .POISON)) == 3, "poison drags 1, 2, 3")
    assert(damage_of(amount_for(1.1, .POISON)) == 0, "then asks")
}

// Each part's options are in its bottom right corner as its player sees
// it, right of its colour toggles, all four inside the part.
options_are_in_the_bottom_right :: () #test {
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        for players: 2 <= MAX_PLAYERS {
            layout := laid_out(players, size)
            for seat, k: layout.seats[:players] {
                colours, colours_middle, _ := toggle_places(layout, seat)
                options, options_hub, button := toggle_places(layout, seat, options: true)
                left := local_of(seat.middle, seat.angle, colours_middle).x
                right := local_of(seat.middle, seat.angle, options_hub).x
                assert(left < right, "«players» on «size», «k»: the options right of the colours")
                assert(local_of(seat.middle, seat.angle, button).x > 0, "«players» on «size», «k»: the options button on its player's right")
                for i: 0 < 4 {
                    upper := local_of(options_hub, seat.angle, options[i])
                    lower := local_of(options_hub, seat.angle, options[i + 4])
                    assert(Math.abs(upper.x - lower.x) < 0.01 and upper.y < lower.y)
                    if i > 0 then assert(upper.x > local_of(options_hub, seat.angle, options[i - 1]).x)
                }
                for place: options[:OPTION_KINDS.count] { assert(inside(place, seat.outline[:seat.count]), "«players» on «size», «k»: an option outside its part") }
            }
        }
    }
}

// Squeezing a seat must never push its rotated options pane offscreen or over its button.
options_in_squeezed_seats :: () #test {
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        *splits := equal_splits(6, size)
        splits.move_split(0, splits.at[1] - LEAST_SPLIT)
        layout := lay_out(size, splits)
        seat := layout.seats[0]
        _, middle, hub := toggle_places(layout, seat, options: true)
        cell := cell_of(layout)
        half := option_panel_half(cell)
        assert(option_button_clear(local_of(hub, seat.angle, middle), half, (FIVE_COLOURS_SIDE / 2 + TOGGLE_BUTTON_GAP) * cell))
        for sx: [2] f32⟨-1, 1⟩ { for sy: [2] f32⟨-1, 1⟩ {
            corner := placed(middle, seat.angle, ⟨sx * half.x, sy * half.y⟩)
            assert(corner.x >= 0 and corner.y >= 0 and corner.x <= size.x and corner.y <= size.y)
        } }
    }
}

// A count of players laid out as they start.
laid_out :: (players: i64, size: V2 -> Layout) {
    return lay_out(size, equal_splits(players, size))
}

// Every point of the screen is in one part, and one only.
covers_the_screen_once :: (layout: Layout) {
    for y: 0 < 24 {
        for x: 0 < 24 {
            p := V2⟨(f32'x + 0.5) / 24 * layout.size.x, (f32'y + 0.5) / 24 * layout.size.y⟩
            *count := 0
            for seat: layout.seats[:layout.count] { if inside(p, seat.outline[:seat.count]) then count += 1 }
            assert(count == 1, "«p» is in «count» parts of «layout.count»")
        }
    }
}

// The number grid, for each player of each count either way up, let go
// over the next player's life total, faces the quarter turn nearest its
// player (an eighth of a turn from them at most), is on the screen, and
// each of its keys is the key it's drawn as (the units 0 to 9 in the bottom
// two rows, the tens 00 to 90 above), the tick and the cross below them.
the_number_grid_is_by_its_player :: () #test {
    part_code :: (part: Picker_Part -> i64) {
        return if part is { case tens: 100 + i64'tens; case units: i64'units; case accept: -2; case cancel: -3; case outside: -1 }
    }
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        for players: 2 <= MAX_PLAYERS {
            layout := laid_out(players, size)
            cell := cell_of(layout)
            for seat, k: layout.seats[:players] {
                // (let go over the next player's life total)
                to := (k + 1) % players
                picker := Picker⟨open: true, from: k, to: to, at: layout.seats[to].middle⟩
                origin, angle, pitch := picker_frame(layout, picker)
                off := seat.angle - angle
                assert(Math.abs(Math.atan2(Math.sin(off), Math.cos(off))) <= f32'Math.PI / 4 + 0.001, "«players» on «size», «k»: faces within an eighth of a turn")
                half := f32'PICK_COLUMNS / 2
                for corner: [4] V2⟨⟨0 - half, 0⟩, ⟨half, 0⟩, ⟨0 - half, 0 - f32'PICK_ROWS⟩, ⟨half, 0 - f32'PICK_ROWS⟩⟩ {
                    at := placed(origin, angle, corner * pitch)
                    assert(at.x >= 0 and at.y >= 0 and at.x <= size.x and at.y <= size.y, "«players» on «size», «k»: the grid's corner «at» on the screen")
                }
                *seen: [200] bool
                for row: 0 < PICK_ROWS {
                    for column: 0 < PICK_COLUMNS {
                        middle := placed(origin, angle, pick_key_middle(row, column, pitch))
                        hit := part_code(picker_part_at(layout, picker, middle))
                        assert(hit == part_code(pick_key(row, column)), "«players» on «size», «k»: key «row», «column» hits «hit»")
                        assert(hit >= 0, "«players» on «size», «k»: key «row», «column» is a number")
                        seen[hit] = true
                    }
                }
                for units: 0 < 10 { assert(seen[units] and seen[100 + units * 10], "«players» on «size», «k»: every unit and ten has its key") }
                // (the buttons below the keys, each half the grid across, on the
                // screen, the cross on its player's left; past their ends, and
                // between them, nothing of the grid's)
                cross_middle, cross_half := picker_button(layout, false)
                tick_middle, tick_half := picker_button(layout, true)
                assert(cross_middle.x < 0 and tick_middle.x > 0 and cross_middle.y > 0, "«players» on «size», «k»: the cross left, the tick right, below the keys")
                assert(Math.abs(cross_half.x + tick_half.x - (half * pitch + GLASS_PAD * cell - PICK_BUTTON_GAP * cell / 2)) < 0.01, "«players» on «size», «k»: each half the grid")
                for button: [2] V2⟨cross_middle, tick_middle⟩ {
                    for corner: [4] V2⟨⟨-1, -1⟩, ⟨1, -1⟩, ⟨-1, 1⟩, ⟨1, 1⟩⟩ {
                        at := placed(origin, angle, button + corner * cross_half)
                        assert(at.x >= 0 and at.y >= 0 and at.x <= size.x and at.y <= size.y, "«players» on «size», «k»: a button's corner «at» on the screen")
                    }
                }
                assert(part_code(picker_part_at(layout, picker, placed(origin, angle, tick_middle))) == -2, "«players» on «size», «k»: the tick")
                assert(part_code(picker_part_at(layout, picker, placed(origin, angle, cross_middle))) == -3, "«players» on «size», «k»: the cross")
                assert(part_code(picker_part_at(layout, picker, placed(origin, angle, tick_middle + V2⟨tick_half.x + 0.2 * cell, 0⟩))) == -1, "«players» on «size», «k»: past the tick, nothing")
                assert(part_code(picker_part_at(layout, picker, placed(origin, angle, V2⟨0, tick_middle.y⟩))) == -1, "«players» on «size», «k»: between them, nothing")
            }
        }
    }
}

// The grid opens at 10; a tens or a units touched is chosen, another of one
// kind changing it, the tick, the cross and outside choosing nothing.
picking_chooses_a_tens_and_a_units :: () #test {
    *picker := Picker⟨open: true, from: 0, to: 1⟩
    assert(picker.tens + picker.units == 10, "opens at 10")
    picker.pick(Picker_Part.tens(30))
    picker.pick(Picker_Part.tens(40))
    picker.pick(Picker_Part.units(7))
    assert(picker.tens + picker.units == 47, "40 then 7: 47, not «picker.tens + picker.units»")
    picker.pick(Picker_Part.units(2))
    picker.pick(Picker_Part.tens(0))
    picker.pick(Picker_Part.accept)
    picker.pick(Picker_Part.outside)
    assert(picker.tens + picker.units == 2, "2 then 00: 2")
}

lays_out_every_count :: () #test {
    for players: 2 <= MAX_PLAYERS {
        covers_the_screen_once(laid_out(players, LANDSCAPE))
        covers_the_screen_once(laid_out(players, PORTRAIT))
    }
}

// As they start, every part is as wide across its life total, at every
// count, either way up, and the lines are mirrored about the screen's
// upright middle.
parts_start_equal :: () #test {
    for players: 2 <= MAX_PLAYERS {
        for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
            layout := laid_out(players, size)
            first := width_across(layout, 0)
            for k: 1 < players {
                width := width_across(layout, k)
                assert(Math.abs(width - first) <= 1, "«players» players on «size»: part «k» is «width» across, part 0 «first»")
            }
            for end: layout.ends[:players] {
                *mirrored := false
                for other: layout.ends[:players] {
                    if near_point(other, V2⟨size.x - end.x, end.y⟩) then mirrored = true
                }
                assert(mirrored, "«players» players on «size»: «end» has no line mirroring it")
            }
        }
    }
}

// Whether a part's player faces a way (to within a hair), and their text's
// turned to match.
faces :: (seat: Seat, way: V2, angle: f32 -> bool) {
    return near_point(seat.toward * 1000, way * 1000) and Math.abs(turn_between(seat.angle, angle)) < 0.001
}

// Two players have the halves, top and bottom, each facing its own side.
two_have_the_halves :: () #test {
    layout := laid_out(2, PORTRAIT)
    assert(near_point(layout.ends[0], ⟨1440, 1080⟩) and near_point(layout.ends[1], ⟨0, 1080⟩), "«layout.ends[:2]»")
    assert(faces(layout.seats[0], ⟨0, 1⟩, 0), "the bottom's faces down: «layout.seats[0].toward»")
    assert(faces(layout.seats[1], ⟨0, -1⟩, f32'Math.PI), "the top's faces up, its text upside down: «layout.seats[1].toward»")
}

// Three players: a line up to the top's middle, the others equal from it;
// the bottom's player faces down, the others up and out to either side.
three_start_from_the_top :: () #test {
    layout := laid_out(3, LANDSCAPE)
    assert(near_point(layout.ends[0], ⟨1080, 0⟩), "up to the top's middle: «layout.ends[0]»")
    assert(faces(layout.seats[1], ⟨0, 1⟩, 0), "the bottom's faces down: «layout.seats[1].toward»")
    right := layout.seats[0].toward
    left := layout.seats[2].toward
    assert(right.x > 0.5 and right.y < -0.1 and left.x < -0.5 and left.y < -0.1, "the others face up and out: «right», «left»")
    assert(near_point(right * 1000, V2⟨-left.x, left.y⟩ * 1000), "...alike: «right», «left»")
}

// Four players: an X, one facing each side.
four_are_an_x :: () #test {
    layout := laid_out(4, LANDSCAPE)
    half_pi := f32'Math.PI / 2
    assert(faces(layout.seats[0], ⟨1, 0⟩, -half_pi), "right: «layout.seats[0].toward»")
    assert(faces(layout.seats[1], ⟨0, 1⟩, 0), "bottom: «layout.seats[1].toward»")
    assert(faces(layout.seats[2], ⟨-1, 0⟩, half_pi), "left: «layout.seats[2].toward»")
    assert(faces(layout.seats[3], ⟨0, -1⟩, f32'Math.PI), "top: «layout.seats[3].toward»")
}

// Every player faces halfway between their part's lines,
// into their part, however the lines are dragged.
players_face_between_their_lines :: () #test {
    *dragged := equal_splits(4, LANDSCAPE)
    dragged.move_split(0, dragged.at[0] + 0.07)
    for splits: [7] Splits⟨equal_splits(2, LANDSCAPE), equal_splits(3, LANDSCAPE), equal_splits(4, LANDSCAPE), equal_splits(5, LANDSCAPE),
                           equal_splits(6, LANDSCAPE), equal_splits(5, PORTRAIT), dragged⟩ {
        layout := lay_out(LANDSCAPE, splits)
        n := layout.count
        for seat, k: layout.seats[:n] {
            to_first := Math.normalize(layout.ends[k] - layout.centre)
            to_next := Math.normalize(layout.ends[(k + 1) % n] - layout.centre)
            first := Math.acos(Math.clamp(Math.dot(seat.toward, to_first), -1, 1))
            next := Math.acos(Math.clamp(Math.dot(seat.toward, to_next), -1, 1))
            assert(Math.abs(first - next) <= 0.001, "«n» players: part «k» faces «first» from one line, «next» from the other")
            if at := seat_at(layout, layout.centre + seat.toward * 100) { assert(at == k, "«n» players: part «k» faces into «at»'s") }
            else if absent { assert(false, "«n» players: part «k» faces off the screen") }
            assert(Math.abs(turn_between(seat.angle, text_angle(seat.toward))) < 0.001, "«n» players: part «k»'s text is turned to its facing")
            offset := seat.middle - layout.centre
            sideways := Math.abs(offset.x * seat.toward.y - offset.y * seat.toward.x)
            assert(sideways <= 0.01, "life position follows its orientation on the channel bisector")
            assert(inside(seat.middle, seat.outline[:seat.count]), "centred life stays inside its region")
        }
    }
}

// The edge's shares go round and back: a point of the edge is the share
// it's at, and a point inside is the nearest side's.
shares_go_round :: () #test {
    for share: [7] f32⟨0, 0.1, 0.3, 0.45, 0.62, 0.8, 0.99⟩ {
        back := share_at(LANDSCAPE, edge_at(LANDSCAPE, share))
        assert(Math.abs(back - share) < 0.0001, "«share» back as «back»")
    }
    assert(near_point(edge_at(LANDSCAPE, share_at(LANDSCAPE, ⟨2100, 700⟩)), ⟨2160, 700⟩), "nearest the right")
}

// A line's end dragged past its neighbour stops short of it.
dragged_ends_stay_between :: () #test {
    *splits := equal_splits(4, LANDSCAPE)
    next := splits.at[1]
    splits.move_split(0, next + 0.1)
    assert(splits_fit(splits, 4), "still in order: «splits.at[:4]»")
    assert(Math.abs(wrapped_share(next - splits.at[0]) - LEAST_SPLIT) < 0.0001, "stopped LEAST_SPLIT short: «splits.at[0]»")
    assert(!splits_fit(splits, 5), "they're four players' lines, not five's")
    assert(!splits_fit(Splits⟨⟩, 4), "none aren't any count's")
}

// The life totals' size follows the smallest part as a line's end is
// dragged: smaller as a part's squeezed. It's never more than the part's
// room allows, and every part's spinner, open, cross and tick and all,
// fits in its part clear of the controls, for every count either way up.
life_size_follows_the_parts :: () #test {
    *splits := equal_splits(4, LANDSCAPE)
    before := lay_out(LANDSCAPE, splits)
    start := life_size_of(before)
    // (the part with least room squeezed to half its edge)
    *least: i64 = 0
    for seat, k: before.seats[:4] { if seat.room < before.seats[least].room then least = k }
    splits.move_split(least, splits.at[least] + wrapped_share(splits.at[(least + 1) % 4] - splits.at[least]) / 2)
    after := life_size_of(lay_out(LANDSCAPE, splits))
    assert(after < start, "a squeezed part's life is smaller: «start», then «after»")
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        for players: 2 <= MAX_PLAYERS {
            layout := laid_out(players, size)
            cell := cell_of(layout)
            life := f32'life_size_of(layout)
            *room: f32 = 1e30
            for seat: layout.seats[:players] { room = Math.min(room, seat.room) }
            assert(life <= Math.clamp(room * 1.15, cell, 6 * cell) + 0.5, "«players» players at «size»: «life» more than the room allows")
            assert(life <= cell + 0.5 or spinners_fit(layout, life), "«players» players at «size»: a spinner for «life» doesn't fit")
        }
    }
}

// Each attack spot is clear of its life total, however big the totals are
// drawn (two players' in portrait the biggest), with room for a commander
// chip between them.
attack_spots_clear_the_life :: () #test {
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        for players: 2 <= MAX_PLAYERS {
            layout := laid_out(players, size)
            cell := cell_of(layout)
            life_half := f32'life_size_of(layout) * LIFE_CAP_SHARE / 2
            for seat, k: layout.seats[:players] {
                above := 0 - local_of(seat.middle, seat.angle, seat.icon).y
                assert(above >= life_half + (2 * CHIP_RADIUS + DAMAGE_ICON_RADIUS) * cell - 1,
                       "«players» players at «size»: «k»'s attack spot «above» above its life, whose top is «life_half»")
            }
        }
    }
}

// Each damage icon is in its own part, and away from the capsule.
icons_are_in_their_parts :: () #test {
    for players: 2 <= MAX_PLAYERS {
        layout := laid_out(players, LANDSCAPE)
        for seat, k: layout.seats[:players] {
            if at := seat_at(layout, seat.icon) { assert(at == k, "«players» players: «k»'s icon is in «at»'s part") }
            else if absent { assert(false, "«players» players: «k»'s icon is off the screen") }
            if part := capsule_part_at(layout, seat.icon) is not absent {
                assert(false, "«players» players: «k»'s icon is under the capsule's «part»")
            }
        }
    }
}

// Each player's two damage icons, damage's on their left and commander
// damage's on their right, are wholly in their own part and clear of the controls, for
// every count either way up; each is found where it's drawn.
damage_icons_are_in_their_parts :: () #test {
    // (the table's always landscape: a window taller than wide is drawn
    // landscape and turned onto it)
    for screen: [1] V2⟨LANDSCAPE⟩ {
        for players: 2 <= MAX_PLAYERS {
            layout := laid_out(players, screen)
            cell := cell_of(layout)
            // (as they start, damage and commander damage; and with every
            // option on, the life shortcuts too, which aren't attack icons)
            for every: [2] bool⟨false, true⟩ {
                *game := new_game(players)
                if every {
                    for k: 0 < players {
                        for kind: OPTION_KINDS { if !has_attack(game.attacks[k], kind) then toggle_attack(game, k, kind) }
                    }
                }
                for seat, k: layout.seats[:players] {
                    kinds, count := attacks_of(game.attacks[k])
                    if every then assert(count == 12, "«players» players: «k» has every option on: «count»")
                    for kind: kinds[:count] {
                        if self_life_delta(kind) != 0 then continue
                        at := attack_icon(layout, game, k, kind)
                        for i: 0 < 8 {
                            a := f32'i / 8 * f32'Math.TAU
                            edge := at + V2⟨Math.cos(a), Math.sin(a)⟩ * (DAMAGE_ICON_RADIUS * cell)
                            assert(inside(edge, seat.outline[:seat.count]), "«players» players on «screen»: «k»'s «kind» icon spills out of its part")
                            assert(!in_controls(layout, edge), "«players» players on «screen»: «k»'s «kind» icon is under the controls")
                        }
                        if found, which := icon_at(layout, game, at) {
                            assert(found == k and which == kind, "«players» players: «k»'s «kind» icon found as «found»'s «which»")
                        }
                        else if absent { assert(false, "«players» players: «k»'s «kind» icon isn't found where it's drawn") }
                    }
                    left := local_of(seat.middle, seat.angle, attack_icon(layout, game, k, .DAMAGE)).x
                    right := local_of(seat.middle, seat.angle, attack_icon(layout, game, k, .COMMANDER)).x
                    assert(left < right, "«players» players: «k»'s damage icon on their left")
                    // (a line that wraps goes up, away from them, never below the first)
                    first := local_of(seat.middle, seat.angle, attack_icon(layout, game, k, .DAMAGE)).y
                    for kind: kinds[:count] {
                        if self_life_delta(kind) != 0 then continue
                        y := local_of(seat.middle, seat.angle, attack_icon(layout, game, k, kind)).y
                        assert(y <= first + 0.01, "«players» players on «screen»: «k»'s «kind» icon below their first line")
                    }
                }
            }
        }
    }
}

// The column's rings are on the screen wherever it's been dragged to (and
// in its groove: plus_becomes_the_count_groove).
counts_are_on_the_screen :: () #test {
    layout := laid_out(4, LANDSCAPE)
    for shown: [3] f32⟨2, 4, 5.5⟩ {
        for count: 2 <= MAX_PLAYERS {
            place := count_place(layout, shown, count)
            assert(place.y > 0 and place.y < LANDSCAPE.y, "«count»'s ring is on the screen at «shown»")
        }
    }
}

// Lines morph from one count's to the next's: at the start, the first's
// with one doubled; at the end, the next's exactly; between, each part of
// the way, still in order round.
lines_morph_between_counts :: () #test {
    for players: 2 < MAX_PLAYERS {
        a := equal_splits(players, LANDSCAPE)
        b := equal_splits(players + 1, LANDSCAPE)
        start := morph_splits(a, b, 0)
        end := morph_splits(a, b, 1)
        assert(start.count == players + 1 and end.count == players + 1)
        for k: 0 < players + 1 {
            assert(Math.abs(share_between(end.at[k], b.at[k])) < 0.0001, "«players» to «players + 1»: line «k» ends at the next's")
            *found := false
            for s: a.at[:players] { if Math.abs(share_between(start.at[k], s)) < 0.0001 then found = true }
            assert(found, "«players» to «players + 1»: line «k» starts at one of the first's")
        }
        // (none crosses another on the way: each part's span stays under a whole turn)
        middle := morph_splits(a, b, 0.5)
        *total: f32 = 0
        for k: 0 < players + 1 { total += wrapped_share(middle.at[(k + 1) % (players + 1)] - middle.at[k]) }
        assert(Math.abs(total - 1) < 0.001, "«players» to «players + 1»: halfway, the lines are still in order round")
        covers_the_screen_once(lay_out(LANDSCAPE, middle))
    }
}

// Each part's colour toggles are a pentagon inside it, each the gap clear of
// its sides, none touching another, its middle (where they fold to) in it
// too; white at its top as its player sees it, then blue, black, red and
// green clockwise, as a card's back has them.
toggles_make_a_pentagon :: () #test {
    for players: 2 <= MAX_PLAYERS {
        for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
            layout := laid_out(players, size)
            cell := cell_of(layout)
            want := (TOGGLE_RADIUS + TOGGLE_GAP) * cell
            for seat, k: layout.seats[:players] {
                points := seat.outline[:seat.count]
                places, middle, folded := toggle_places(layout, seat)
                assert(inside(middle, points), "«players» on «size»: part «k»'s pentagon's middle is inside it")
                // (the icon in the corner, the gap clear of the sides; the
                // pentagon as near it as fits: a step nearer doesn't)
                assert(inside(folded, points) and clearance(folded, points) >= want - 1, "«players» on «size»: part «k»'s icon fits")
                *screen_clearance: f32 = 1e30
                *channel_clearance: f32 = 1e30
                for a, edge: points {
                    distance := distance_to_segment(folded, a, points[(edge + 1) % points.count])
                    if edge == 0 or edge == points.count - 1 {
                        channel_clearance = Math.min(channel_clearance, distance - BEVEL_CELLS * cell)
                    } else {
                        screen_clearance = Math.min(screen_clearance, distance)
                    }
                }
                assert(Math.abs(screen_clearance - want) < 0.1, "all folded pickers have the same screen gap")
                assert(channel_clearance >= want - 0.1, "folded picker stays clear of channels")
                corner := local_of(seat.middle, seat.angle, folded)
                hub := local_of(seat.middle, seat.angle, middle)
                *bottom_left := V2⟨1e30, -1e30⟩
                for p: points {
                    l := local_of(seat.middle, seat.angle, p)
                    bottom_left = ⟨Math.min(bottom_left.x, l.x), Math.max(bottom_left.y, l.y)⟩
                }
                // Fixed screen/channel clearance determines the folded position; the open pentagon may sit nearer the corner.
                if Math.length(corner - hub) > 0.1 * cell {
                    nearer := hub + Math.normalize(corner - hub) * 0.1 * cell
                    assert(!pentagon_fits(layout, seat, points, nearer.x, nearer.y, corner), "«players» on «size»: part «k»'s pentagon could come nearer its icon")
                }
                for p, i: places[:5] {
                    assert(inside(p, points), "«players» on «size»: part «k»'s toggles are inside it")
                    gap := clearance(p, points)
                    assert(gap >= want - 1, "«players» on «size»: part «k»'s toggle «i» is «gap» from its sides, under «want»")
                    next := places[(i + 1) % 5]
                    assert(Math.length(next - p) >= 2 * TOGGLE_RADIUS * cell, "«players» on «size»: part «k»'s toggles «i» and the next touch")
                    // (clockwise as its player sees it: each the next a fifth of a turn round)
                    a := local_of(middle, seat.angle, p)
                    b := local_of(middle, seat.angle, next)
                    assert(a.x * b.y - a.y * b.x > 0, "«players» on «size»: part «k»'s toggles go clockwise")
                }
                top := local_of(middle, seat.angle, places[0])
                assert(Math.abs(top.x) < 0.5 and top.y < 0, "«players» on «size»: part «k»'s white toggle at its top as its player sees it")
            }
        }
    }
}

// A life tapped opens its drum, and tapped again closes it; a press that
// moves is a turn, not a tap. Open, a wheel turned changes the life by its
// place a whole row at a time, rounding to the nearest (down, the bigger
// digits come to the middle: more), each turn the game's as it's let go;
// the drum follows the life changed otherwise. Closed, it flattens, and its
// change shows DRUM_HOLD seconds, then fades over DRUM_FADE; a change of
// nothing shows nothing.
life_drums_open_turn_and_close :: () #test {
    cap: f32 = 100
    row := DRUM_PITCH * cap
    *game := new_game(4)
    *drum: Life_Drum
    // (a tap opens it, and a press that moves on a closed one does nothing)
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    move_drum(drum, ⟨0, 0.5 * row⟩, cap)
    life, changes := release_drum(drum, game)
    assert(!drum.open and !changes, "a turn of a closed drum does nothing")
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    _, _ := release_drum(drum, game)
    assert(drum.open and drum.start == 40, "a tap opens it")
    step_drum(drum, game, DRUM_FLATTEN)
    assert(drum.bend == 1 and drum_showing(drum, 1) and !drum_showing(drum, 0), "open, round")
    // (the units' wheel down two and two fifths rows: two more)
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    move_drum(drum, ⟨0, 2.4 * row⟩, cap)
    turned, turns := release_drum(drum, game)
    assert(turns and turned == 42, "the units' two rows down: «turned»")
    game.life[1] = turned
    // (the tens' up a row and three fifths: twenty less)
    press_drum(drum, game, 1, ⟨0, 0⟩, 10)
    move_drum(drum, ⟨0, -1.6 * row⟩, cap)
    tens, _ := release_drum(drum, game)
    assert(tens == 22, "the tens' two rows up: «tens»")
    game.life[1] = tens
    step_drum(drum, game, 1)
    assert(drum.open and drum_life(drum) == 22, "settled on its row")
    assert(change_showing(drum, 1) == 0, "open, no flat change")
    // (the life changed otherwise, 3 damage: the drum follows it)
    game.life[1] = 19
    step_drum(drum, game, 0.01)
    assert(drum_life(drum) == 19, "it follows the life")
    // (a tap keeps it open; closed, it shows its own change, 40 to 22, not
    // the damage)
    press_drum(drum, game, 1, ⟨0, 0⟩, 1)
    _, _ := release_drum(drum, game)
    assert(drum.open, "tapping the life again keeps editing open")
    assert(player_controls_visibility(drum, 1) == 0)
    assert(player_controls_visibility(drum, 0) == 1)
    close_drum(drum, game)
    assert(!drum.open and drum.change == -18, "closing from outside keeps its own change: «drum.change»")
    for _: 0 < 10 { step_drum(drum, game, DRUM_FLATTEN / 10) }
    assert(drum.bend == 0 and !drum_showing(drum, 1), "closed, flat")
    assert(change_showing(drum, 1) == 1, "its change shows")
    step_drum(drum, game, DRUM_HOLD - DRUM_FLATTEN)
    assert(change_showing(drum, 1) > 0.5, "then fades: «change_showing(drum, 1)»")
    step_drum(drum, game, DRUM_FADE)
    assert(change_showing(drum, 1) == 0, "and is gone")
    assert(change_text(3) == "+3" and change_text(-2) == "-2" and change_text(0) == "0")
    nothing := Life_Drum⟨player: 1, start: 30, since: 0⟩
    assert(change_showing(nothing, 1) == 0, "no change, nothing shown")
}

// Each digit's a wheel of its own: as a number turns to the next, a wheel
// whose digit doesn't change stays, one that does turns the short way round
// (9 to 0 forward), so the tens turn only as the units carry.
wheels_turn_alone :: () #test {
    assert(digit_of(305, 0) == 5 and digit_of(305, 1) == 0 and digit_of(305, 2) == 3 and digit_of(-27, 0) == 7)
    assert(digits_in(0) == 1 and digits_in(9) == 1 and digits_in(10) == 2 and digits_in(-120) == 3)
    assert(wheel_at(30, 31, 0, 0.25) == 0.25 and wheel_at(30, 31, 1, 0.25) == 3, "30 to 31: the units turn, the tens stay")
    assert(wheel_at(29, 30, 0, 0.5) == 9.5 and wheel_at(29, 30, 1, 0.5) == 2.5, "29 to 30: the units carry into the tens")
    assert(wheel_at(30, 29, 0, 0.5) == -0.5 and wheel_at(30, 29, 1, 0.5) == 2.5, "30 to 29: both back")
    assert(wheel_at(30, 40, 0, 0.5) == 0 and wheel_at(30, 40, 1, 0.5) == 3.5, "30 to 40: the tens alone")
    *drum := Life_Drum⟨from: 30, place: 1, turned: -1.4⟩
    base, frac := drum_between(drum)
    assert(base == 28 and Math.abs(frac - 0.6) < 0.001, "turned up a row and two fifths from 30: 28, three fifths to 29")
}

// The toggles stay open after a new game until one's set; then fold
// TOGGLE_LINGER seconds later, unless another's set first (which starts it
// again); folded, the icon touched opens them for TOGGLE_OPENED, and one set
// then gives TOGGLE_LINGER from then; the pentagon's middle touched folds
// them at once.
toggles_fold_when_left_alone :: () #test {
    *toggles: Toggles
    fold_toggles(toggles)
    open_toggles(toggles)
    for _: 0 < 100 { step_toggles(toggles, 0.1) }
    assert(toggles.open[0] and toggles.shown[0] == 1, "open until one's set")
    touch_toggles(toggles, 0)
    step_toggles(toggles, TOGGLE_LINGER - 0.5)
    touch_toggles(toggles, 0)
    step_toggles(toggles, TOGGLE_LINGER - 0.5)
    assert(toggles.open[0], "another set starts the countdown again")
    step_toggles(toggles, 1)
    assert(!toggles.open[0] and toggles.open[1], "folded once left alone, the others' open as they were")
    for _: 0 < 10 { step_toggles(toggles, 0.1) }
    assert(toggles.shown[0] == 0, "folded all the way")
    unfold_toggles(toggles, 0)
    step_toggles(toggles, TOGGLE_OPENED - 0.1)
    assert(toggles.open[0], "the icon touched opens them")
    step_toggles(toggles, 0.2)
    assert(!toggles.open[0], "and they fold again TOGGLE_OPENED later")
    unfold_toggles(toggles, 0)
    step_toggles(toggles, 0.5)
    touch_toggles(toggles, 0)
    step_toggles(toggles, TOGGLE_LINGER - 0.1)
    assert(toggles.open[0], "one set gives TOGGLE_LINGER from then")
    step_toggles(toggles, 0.2)
    assert(!toggles.open[0], "and no more")
    unfold_toggles(toggles, 0)
    fold_now(toggles, 0)
    step_toggles(toggles, 0.01)
    assert(!toggles.open[0], "the middle touched folds them at once")
}

// The lines snap toward a count a step at a time: from three to six they
// pass through four's and five's, each a whole step, and stop at six's.
lines_step_toward_a_count :: () #test {
    *picking := Count_Picker⟨laid: 3, toward: 3⟩
    *seen: [MAX_PLAYERS + 1] bool
    for _: 0 < 200 {
        picking.move_lines(6, 0.02)
        seen[picking.laid] = true
        assert(Math.abs(picking.toward - picking.laid) <= 1, "a step at a time: «picking.laid» toward «picking.toward»")
    }
    assert(seen[4] and seen[5] and picking.laid == 6 and picking.toward == 6, "through four and five to six")
    // Passing through four and five is fast-forwarded; the last step, to six,
    // takes its own time.
    *timed := Count_Picker⟨laid: 3, toward: 3⟩
    *frames := 0
    while timed.laid != 6 and frames < 1000 {
        timed.move_lines(6, 0.01)
        frames += 1
    }
    total: f32 = 2 * LINES_PASSING_STEP_TIME + LINES_STEP_TIME
    expected := i64'Math.round(total / 0.01)
    assert(Math.abs(frames - expected) <= 2, "three to six took «frames» frames of 10 ms, not about «expected»")
    // A picker that's never moved starts still, at the count it's given,
    // however long its first frame.
    *fresh: Count_Picker
    for _: 0 < 30 { fresh.move_lines(4, 0.1) }
    assert(fresh.laid == 4 and fresh.toward == 4, "a fresh picker stays at four: «fresh.laid» toward «fresh.toward»")
    *none: [MAX_PLAYERS + 1] Splits
    halfway := Count_Picker⟨laid: 4, toward: 5, progress: 0.5⟩
    assert(shown_splits(halfway, none[:], LANDSCAPE).count == 5, "between four and five, five's lines (one splitting)")
    assert(!lines_moving(Count_Picker⟨laid: 4, toward: 4⟩, 4) and lines_moving(halfway, 4))
}

// A line is grabbed anywhere along it (the nearest line, where two are
// close), and not far from it.
lines_are_grabbed_anywhere :: () #test {
    layout := laid_out(4, LANDSCAPE)
    cell := cell_of(layout)
    reach := 0.5 * cell
    for end, k: layout.ends[:4] {
        for along: [3] f32⟨0.1, 0.5, 0.8⟩ {
            p := end + (layout.centre - end) * along
            if line := line_at(layout, p, reach) { assert(line == k, "line «k», «along» of the way in, is line «line»'s") }
            else if absent { assert(false, "line «k», «along» of the way in, grabs it") }
        }
    }
    // (the middle of a part is no line's)
    if line := line_at(layout, layout.seats[0].middle, reach) is not absent then assert(false, "a part's middle grabs line «line»")
}

// A dragged line goes through the finger: its end is where a line from the
// centre through the finger meets the edge, wherever the finger is along it.
dragged_lines_pass_under_the_finger :: () #test {
    layout := laid_out(4, LANDSCAPE)
    for finger: [4] V2⟨⟨1500, 300⟩, ⟨1200, 650⟩, ⟨300, 1300⟩, ⟨2000, 900⟩⟩ {
        if share := share_through(layout, finger) {
            end := edge_at(LANDSCAPE, share)
            assert(distance_to_segment(finger, layout.centre, end) < 0.5, "the line to «end» passes under «finger»")
        }
        else if absent {
            assert(false, "«finger» aims somewhere")
        }
    }
    if aimed := share_through(layout, layout.centre) is not absent then assert(false, "the centre aims nowhere, not «aimed»")
}

// The settings' buttons are each where it's drawn, in the channel the
// table opens: the motion's a place left of undo; Reset a place right of
// the system's, the orientation's a place right of Reset, and Quit at the
// channel's far right; the pill's buttons, the system's too, or anywhere
// else, close the table; and all of them are on the screen, either way up.
settings_buttons_are_where_drawn :: () #test {
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        shown := laid_out(4, size)
        quit := quit_place(shown)
        last := shown.centre.x + (quit.x * CAPSULE_PITCH + SETTINGS_BUTTON) * cell_of(shown)
        first := shown.centre.x + (animation_place(.OFF).x * CAPSULE_PITCH - 0.38) * cell_of(shown)
        assert(first > 0 and last < size.x, "the settings' buttons on the screen at «size»: «first» to «last»")
        assert((quit.x - ORIENTATION_PLACE.x) * CAPSULE_PITCH > 2 * SETTINGS_BUTTON, "Quit clear of the orientation's at «size»")
    }
    layout := laid_out(4, LANDSCAPE)
    pitch := CAPSULE_PITCH * cell_of(layout)
    at :: (layout: Layout, place: V2, pitch: f32 -> Settings_Part) { return settings_part_at(layout, layout.centre + place * pitch) }
    if at(layout, quit_place(layout), pitch) is {
    case quit: _
    case animation, brightness, scale, orientation, reset, info, close: assert(false, "the far right quits")
    }
    if at(layout, ⟨4, 0⟩, pitch) is {
    case orientation: _
    case animation, brightness, scale, reset, info, quit, close: assert(false, "right of Reset turns the orientation on")
    }
    if at(layout, ⟨3, 0⟩, pitch) is {
    case reset: _
    case animation, brightness, scale, orientation, info, quit, close: assert(false, "right of the system's button resets")
    }
    if at(layout, ⟨-3, 0⟩, pitch) is {
    case animation: assert(animation == .FAST)
    case brightness, scale, orientation, reset, info, quit, close: assert(false, "left of undo moves the motion on")
    }
    info, landscape_info := info_place(layout)
    if at(layout, info, pitch) is {
    case info: _
    case animation, brightness, scale, orientation, reset, quit, close: assert(false, "left of Quit shows the credits")
    }
    _, portrait_info := info_place(laid_out(4, PORTRAIT))
    assert(landscape_info and !portrait_info, "the info button in landscape, not in portrait")
    if settings_part_at(layout, capsule_centre(layout, .SYSTEM)) is {
    case close: _
    case animation, brightness, scale, orientation, reset, info, quit: assert(false, "the system's button closes the table")
    }
    // (the settings' buttons are past the pill's ends, in the channel)
    reach := CAPSULE_REACH * cell_of(layout)
    assert(Math.abs(RESET_PLACE.x) * pitch - SETTINGS_BUTTON * cell_of(layout) > reach, "Reset clear of the pill")
    assert(Math.abs(ANIMATION_PLACE.x) * pitch - SETTINGS_BUTTON * cell_of(layout) > reach, "the motion's button clear of the pill")
    assert(SETTINGS_BUTTON < SETTINGS_SPLIT_HALF, "each fits the channel")
    blanks := [6] V2⟨⟨-2, 0⟩, ⟨-1, 0⟩, ⟨0, 0⟩, ⟨1, 0⟩, ⟨2, 1⟩, ⟨0, 2⟩⟩
    for blank: blanks {
        if at(layout, blank, pitch) is {
        case close: _
        case animation, brightness, scale, orientation, reset, info, quit: assert(false, "«blank» closes the settings")
        }
    }
}

// The orientation's button goes round: auto, landscape, portrait, auto. A
// kept orientation is drawn turned onto a window the other way about; auto
// never is.
orientation_goes_round :: () #test {
    *orientation := Orientation.AUTO
    for expected: [3] Orientation⟨.LANDSCAPE, .PORTRAIT, .AUTO⟩ {
        orientation = next_orientation(orientation)
        assert(orientation == expected, "«orientation», not «expected»")
    }
    wide := Wide.i32x2⟨2160, 1440⟩
    tall := Wide.i32x2⟨1440, 2160⟩
    assert(!turned_onto_window(.AUTO, wide) and !turned_onto_window(.AUTO, tall), "auto: as the window is")
    assert(!turned_onto_window(.LANDSCAPE, wide) and turned_onto_window(.LANDSCAPE, tall), "landscape: turned onto a tall window")
    assert(turned_onto_window(.PORTRAIT, wide) and !turned_onto_window(.PORTRAIT, tall), "portrait: turned onto a wide window")
}

// The brightness slider is right of the orientation's button and left of
// Quit, on the screen, its left end the dimmest and its right end full;
// touched, it gives the brightness there. A portrait screen has no room
// for it.
brightness_slides :: () #test {
    layout := laid_out(4, LANDSCAPE)
    pitch := CAPSULE_PITCH * cell_of(layout)
    from, to, fits := brightness_track(layout)
    info, _ := info_place(layout)
    assert(fits and from > ORIENTATION_PLACE.x and to < info.x and layout.centre.x + (to + BRIGHTNESS_SUN) * pitch < layout.size.x,
           "between the orientation's and Quit, on the screen: «from» to «to»")
    assert(brightness_at(layout, from) == MIN_BRIGHTNESS and brightness_at(layout, to) == 1, "dimmest at its left, full at its right")
    if settings_part_at(layout, layout.centre + V2⟨(from + to) / 2, 0⟩ * pitch) is {
    case brightness: assert(Math.abs(brightness - (MIN_BRIGHTNESS + 1) / 2) < 0.01, "half way: «brightness»")
    case animation, scale, orientation, reset, info, quit, close: assert(false, "its middle is the slider")
    }
    _, _, room := brightness_track(laid_out(4, PORTRAIT))
    assert(!room, "no room in portrait")
}

// The widgets' scale slider is left of the motion's buttons, on the screen,
// its left end the scale they were first drawn at (the least) and its right
// end the most, in steps; touched, it gives the scale there. A portrait
// screen has no room for it.
scale_slides :: () #test {
    layout := laid_out(4, LANDSCAPE)
    pitch := CAPSULE_PITCH * cell_of(layout)
    from, to, fits := scale_track(layout)
    assert(fits and to < animation_place(.OFF).x and layout.centre.x + (from - BRIGHTNESS_SUN) * pitch > 0,
           "left of the motion's buttons, on the screen: «from» to «to»")
    assert(scale_at(layout, from) == MIN_WIDGET_SCALE and scale_at(layout, to) == MAX_WIDGET_SCALE and MIN_WIDGET_SCALE == 1,
           "as first drawn at its left, the most at its right")
    if settings_part_at(layout, layout.centre + V2⟨(from + to) / 2, 0⟩ * pitch) is {
    case scale:
        steps := (scale - MIN_WIDGET_SCALE) / WIDGET_SCALE_STEP
        assert(Math.abs(scale - (MIN_WIDGET_SCALE + MAX_WIDGET_SCALE) / 2) <= WIDGET_SCALE_STEP and Math.abs(steps - Math.round(steps)) < 0.001,
               "half way, to a step: «scale»")
    case animation, brightness, orientation, reset, info, quit, close: assert(false, "its middle is the slider")
    }
    _, _, room := scale_track(laid_out(4, PORTRAIT))
    assert(!room, "no room in portrait")
}

// The widgets' scale grows the players' widgets, not their life totals: the
// attack icons further apart, the colour toggles' ring wider; the life
// totals' size and the commander damage chips' places as they were.
widgets_scale :: () #test {
    with scratch.rewind()
    game := sample_game(4)
    plain := laid_out(4, LANDSCAPE)
    grown := lay_out(plain.size, plain.splits, MAX_WIDGET_SCALE)
    assert(widget_cell(grown) == cell_of(grown) * MAX_WIDGET_SCALE and widget_cell(plain) == cell_of(plain), "the widgets' cell")
    assert(grown.life_size == plain.life_size, "the life totals as they were: «grown.life_size», «plain.life_size»")
    apart :: (layout: Layout, game: Game -> f32) {
        return Math.length(attack_icon(layout, game, 0, .COMMANDER) - attack_icon(layout, game, 0, .DAMAGE))
    }
    assert(apart(grown, game) > apart(plain, game) * 1.5, "the attack icons further apart: «apart(grown, game)», «apart(plain, game)»")
    ring :: (layout: Layout -> f32) {
        places := toggles_of(layout, 0)
        return Math.length(places[0] - places[2])
    }
    assert(ring(grown) > ring(plain) * 1.5, "the colour toggles' ring wider")
    // (the cache made again for the plain layout, as main's would be)
    assert(ring(plain) < ring(grown), "the toggles' cache follows the scale")
}

// The motion's button goes round: paused, slow, medium, fast, paused.
motion_button_goes_round :: () #test {
    *motion := Motion.OFF
    for expected: [4] Motion⟨.SLOW, .MEDIUM, .FAST, .OFF⟩ {
        motion = next_motion(motion)
        assert(motion == expected, "after one tap: «motion», not «expected»")
    }
}

// A strike changes the game at once but shows it undone while its volley
// gathers and flies; as it lands the life shown ticks down a point at a
// time, and once it has, it's the game's.
volleys_land_a_point_at_a_time :: () #test {
    layout := laid_out(4, LANDSCAPE)
    *game := new_game(4)
    game.commander[0][1] = 15
    *volleys: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    strike(game, volleys, layout, pending, 1, 0, 7)
    assert(game.life[0] == 33 and game.commander[0][1] == 22, "dealt at once: «game.life[0]», «game.commander[0][1]»")
    assert(shown_game(game, pending).life[0] == 40, "shown undone while it flies")
    assert(volleys.list.count == 1, "a volley")
    landing: f32 = VOLLEY_GATHER + VOLLEY_TRAVEL
    *age: f32 = 0
    *shown_before: i32 = 40
    *steps := 0
    frames := i64'Math.ceil((bolt_impact(volleys.list[0], 6) + LOSS_DURATION) * 60) + 1
    for _: 0 < frames {
        steer_volleys(volleys, pending, 1.0 / 60)
        age += 1.0 / 60
        now := shown_game(game, pending).life[0]
        if age < landing - 0.001 then assert(now == 40, "nothing off before it lands: «now» at «age»")
        assert(now <= shown_before and shown_before - now <= 1, "down a point at a time: «shown_before» to «now»")
        if now < shown_before then steps += 1
        shown_before = now
    }
    assert(pending[0][1] == 0 and shown_before == 33 and steps == 7, "landed, shown as dealt: «shown_before», «pending[0][1]» pending, «steps» steps")
    assert(volleys.list.count == 0, "the volley done")
}

// A volley flies from its player's damage icon to the life total it hit,
// arcing above the table, and its point comes off as it lands.
volleys_follow_the_path :: () #test {
    layout := laid_out(4, LANDSCAPE)
    *game := new_game(4)
    *volleys: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    strike(game, volleys, layout, pending, 1, 0, 1)
    v := volleys.list[0]
    assert(near_point(v.start, attack_icon(layout, game, 1, .COMMANDER)) and near_point(v.end, layout.seats[0].middle), "from their spot to the life total")
    middle := (v.start + v.end) / 2
    assert(v.bend.y < middle.y, "the bolts arc above the table")
    steer_volleys(volleys, pending, VOLLEY_GATHER + VOLLEY_TRAVEL)
    assert(pending[0][1] == 0, "the bolt takes one life on contact")
}

// Volleys from one player to another stay apart, each landing its own
// points, a long frame landing one whole.
volleys_land_apart :: () #test {
    layout := laid_out(3, LANDSCAPE)
    *game := new_game(3)
    *volleys: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    strike(game, volleys, layout, pending, 1, 0, 3)
    steer_volleys(volleys, pending, bolt_impact(volleys.list[0], 2) + 0.01)
    strike(game, volleys, layout, pending, 1, 0, 7)
    steer_volleys(volleys, pending, 0.1)
    assert(pending[0][1] == 7 and shown_game(game, pending).life[0] == 37, "the first landed, the second in flight: «pending[0][1]»")
    steer_volleys(volleys, pending, bolt_impact(volleys.list[1], 6) + LOSS_DURATION)
    assert(pending[0][1] == 0 and shown_game(game, pending).life[0] == 30 and volleys.list.count == 0)
}

// A volley's bolts, one a point, leave one after another once it's
// gathered, each landing a bolt's spacing after the one before.
bolts_land_in_sequence :: () #test {
    for amount: [4] i32⟨1, 5, 12, 40⟩ {
        n := i64'amount
        for j: 0 < n {
            arrival := VOLLEY_GATHER + VOLLEY_TRAVEL + bolt_delay(j, n)
            assert(bolt_along(arrival - 0.001, j, n) < 1)
            assert(Math.abs(bolt_along(arrival, j, n) - 1) < 0.001)
            if j + 1 < n then assert(bolt_along(arrival, j + 1, n) < 1)
        }
    }
}

// A volley of any size, from a player of any colours, lands a life a bolt,
// nothing before its first bolt lands, and is gone once it has.
volleys_of_any_size_land_a_point_at_a_time :: () #test {
    layout := laid_out(2, LANDSCAPE)
    for amount: [3] i32⟨1, 18, 40⟩ {
        with scratch.rewind()
        `scratch {
            *game := new_game(2)
            game.identity[1] = (u8'1 << u8'Mana.BLACK) | (u8'1 << u8'Mana.RED)
            *volleys: Volleys
            *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
            strike(game, volleys, layout, pending, 1, 0, amount)
            assert(volleys.list.count == 1, "one volley")
            landing := volley_landing(volleys.list[0])
            assert(landing == VOLLEY_GATHER + VOLLEY_TRAVEL)
            *age: f32 = 0
            *previous: i32 = 40
            for _: 0 < 300 {
                steer_volleys(volleys, pending, 1.0 / 60)
                age += 1.0 / 60
                shown := shown_game(game, pending).life[0]
                assert(shown <= previous and previous - shown <= 1, "one life per bolt")
                previous = shown
                if age < landing - 0.001 then assert(shown == 40, "nothing off before its first bolt lands: «shown» at «age»")
            }
            assert(pending[0][1] == 0 and volleys.list.count == 0, "landed and gone")
        }
    }
}

// Damage circles surround the life total and stay clear of the number.
chips_are_where_their_commanders_sit :: () #test {
    for players: [3] i64⟨3, 4, 6⟩ {
        layout := laid_out(players, LANDSCAPE)
        cell := cell_of(layout)
        for k: 0 < players {
            seat := layout.seats[k]
            chips := chip_places(layout, k, 2.0 * cell, 1.6 * cell)
            assert(Math.length(chips[k] - seat.middle) > cell, "own slot reserved for tax")
            for j: 0 < players {
                if j == k then continue
                chip := local_of(seat.middle, seat.angle, chips[j])
                assert(Math.abs(chip.x) >= (1 + CHIP_RADIUS) * cell or Math.abs(chip.y) >= (0.8 + CHIP_RADIUS) * cell)
                for m: 0 < j { if m == k then continue; assert(Math.length(chips[j] - chips[m]) >= 2 * CHIP_RADIUS * cell) }
            }
        }
    }
}

// A part's colour and options buttons answer a touch only where they're
// drawn: not while its drum's open, nor while the count column has the
// table.
hidden_buttons_take_no_touch :: () #test {
    layout := laid_out(4, LANDSCAPE)
    *screen: Screen_State
    colours := toggle_folded(layout, 1)
    options := options_folded(layout, 1)
    if shown_colours := five_colours_at(layout, screen, colours) { assert(shown_colours == 1, "its five-colour button: «shown_colours»") }
    else if absent { assert(false, "its five-colour button") }
    if shown_options := options_button_at(layout, screen, options) { assert(shown_options == 1, "its options button: «shown_options»") }
    else if absent { assert(false, "its options button") }
    for hiding: 0 < 2 {
        *hidden := screen
        if hiding == 0 { hidden.drums[1].open = true } else { hidden.count_ui_visible = 0 }
        if _ := five_colours_at(layout, hidden, colours) is not absent then assert(false, "a hidden five-colour button took a touch («hiding»)")
        if _ := options_button_at(layout, hidden, options) is not absent then assert(false, "a hidden options button took a touch («hiding»)")
    }
}

// A window taller than wide shows the landscape drawing turned a quarter
// turn clockwise: its top right is the drawing's top left, its bottom left
// the drawing's bottom right, and a finger's turned back to where it is in
// the drawing.
fingers_on_a_turned_window_are_turned_back :: () #test {
    window_width: f32 = 1440    // (the drawing's 2160 by 1440 on a window 1440 by 2160)
    assert(landscape_point(V2⟨1440, 0⟩, true, window_width) == V2⟨0, 0⟩, "the window's top right: the drawing's top left")
    assert(landscape_point(V2⟨0, 2160⟩, true, window_width) == V2⟨2160, 1440⟩, "its bottom left: the drawing's bottom right")
    assert(landscape_point(V2⟨1000, 300⟩, true, window_width) == V2⟨300, 440⟩, "a finger turned back")
    assert(landscape_point(V2⟨1000, 300⟩, false, 2160) == V2⟨1000, 300⟩, "a landscape window's as it is")
}

// A player's poison and tax sit either side of their centre line, the
// poison on their left, inside their part and clear of the other chips.
tax_reverses_from_its_current_position :: () #test {
    *slide: Tax_Slide
    step_tax_slide(slide, false, 0)
    assert(slide.phase == 0)
    step_tax_slide(slide, true, TAX_SLIDE_SECONDS / 2)
    assert(Math.abs(slide.phase - 0.5) < 0.001)
    step_tax_slide(slide, false, TAX_SLIDE_SECONDS / 4)
    assert(Math.abs(slide.phase - 0.25) < 0.001)
    step_tax_slide(slide, false, 1)
    assert(slide.phase == 0)
    step_tax_slide(slide, true, 1)
    assert(slide.phase == 1)
}

poison_and_tax_straddle_the_centre_line :: () #test {
    for players: 2 <= MAX_PLAYERS {
        layout := laid_out(players, LANDSCAPE)
        cell := cell_of(layout)
        for k: 0 < players {
            seat := layout.seats[k]
            chips := chip_places(layout, k, 2.0 * cell, 1.6 * cell)
            poison, tax := poison_tax_places(seat, chips[k], cell)
            // (either side of their middle: on the centre line where there's
            // room, else as near it as fits, clear of the attack icons)
            p := local_of(chips[k], seat.angle, poison)
            t := local_of(chips[k], seat.angle, tax)
            solo := chip_places(layout, k, 2.0 * cell, 1.6 * cell, false)
            _, centred := poison_tax_places(seat, solo[k], cell, false)
            assert(Math.abs(local_of(solo[k], seat.angle, centred).x) < 0.01, "tax alone sits on its middle")
            // (their near edges as far from the middle, each its own width)
            poison_edge := p.x + POISON_HALF * cell
            tax_edge := t.x - TAX_HALF * cell
            assert(Math.abs(poison_edge + tax_edge) < 0.01 and poison_edge < 0 and tax_edge > 0 and Math.abs(p.y - t.y) < 0.01,
                   "«players» players, part «k»: poison at «p», tax at «t»")
            assert(inside(poison, seat.outline[:seat.count]) and inside(tax, seat.outline[:seat.count]), "«players» players, part «k»: inside it")
            game := new_game(players)
            kinds, count := attacks_of(game.attacks[k])
            for kind: kinds[:count] {
                attack_at := attack_icon(layout, game, k, kind)
                for at: [2] V2⟨poison, tax⟩ {
                    assert(Math.length(attack_at - at) >= (PAIR_REACH + DAMAGE_ICON_RADIUS) * cell, "«players» players, part «k»: the pair on its «kind» icon")
                }
            }
            for j: 0 < players {
                if j == k then continue
                for at: [2] V2⟨poison, tax⟩ {
                    assert(Math.length(chips[j] - at) >= (PAIR_REACH + CHIP_RADIUS) * cell, "«players» players, part «k»: «j»'s chip on the pair")
                }
            }
        }
    }
}

// However its lines are dragged (each as far as it goes either way), a
// player's poison and tax are inside their part, clear of its edges.
poison_and_tax_stay_in_thin_parts :: () #test {
    for players: 2 <= MAX_PLAYERS {
        initial := laid_out(players, LANDSCAPE)
        for edge: 0 < players {
            for direction: [2] f32⟨-1, 1⟩ {
                *splits := initial.splits
                splits.move_split_with_clearance(edge, wrapped_share(splits.at[edge] + direction * 0.4), LANDSCAPE)
                layout := lay_out(LANDSCAPE, splits)
                cell := cell_of(layout)
                for k: 0 < players {
                    seat := layout.seats[k]
                    if seat.room < 0.6 * cell then continue
                    chips := chip_places(layout, k, 2.0 * cell, 1.6 * cell)
                    poison, tax := poison_tax_places(seat, chips[k], cell)
                    for at: [2] V2⟨poison, tax⟩ {
                        assert(inside(at, seat.outline[:seat.count]) and clearance(at, seat.outline[:seat.count]) >= 0.8 * PAIR_REACH * cell,
                               "«players» players, line «edge» dragged «direction»: «k»'s poison or tax at «at» isn't in their part")
                    }
                }
            }
        }
    }
}

// A part's commander damage chips, as many as it can have, are inside it
// and clear of its colour toggles, for every count of players, either way up.
chips_keep_off_the_toggles :: () #test {
    for screen: [2] V2⟨LANDSCAPE, ⟨LANDSCAPE.y, LANDSCAPE.x⟩⟩ {
        for players: 2 <= MAX_PLAYERS {
            layout := lay_out(screen, equal_splits(players, screen))
            cell := cell_of(layout)
            for k: 0 < players {
                chips := chip_places(layout, k, 2.0 * cell, 1.6 * cell)
                for chip, from: chips[:players] {
                    if from == k then continue
                    for t: toggles_of(layout, k) {
                        assert(Math.length(chip - t) >= (CHIP_RADIUS + TOGGLE_RADIUS) * cell, "«players» players, part «k»: a chip at «chip» on a toggle at «t»")
                    }
                }
            }
        }
    }
}

// Each colour's element, in WUBRG order, and an artifact's (no colours)
// liquid metal.
elements_are_the_colours :: () #test {
    *list: [6] Element
    n := elements_of((u8'1 << u8'Mana.RED) | (u8'1 << u8'Mana.WHITE), list)
    assert(n == 2 and list[0] == .SUN and list[1] == .FIRE, "white and red: «list[:n]»")
    m := elements_of(0, list)
    assert(m == 1 and list[0] == .CHROME)
    all := elements_of(0x1F, list)
    assert(all == 5 and list[2] == .OIL and list[4] == .WIND)
}

// An undo (or a new game) calls volleys off: none left, nothing pending.
undo_calls_off_volleys :: () #test {
    layout := laid_out(4, LANDSCAPE)
    *game := new_game(4)
    *volleys: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    strike(game, volleys, layout, pending, 2, 3, 5)
    steer_volleys(volleys, pending, VOLLEY_GATHER + VOLLEY_TRAVEL + 0.01)
    call_off_volleys(volleys, pending)
    assert(pending[3][2] == 0 and volleys.list.count == 0)
}

// While a count's picked, the count runner grows out of the pill's middle:
// the count bar, every count's ring on it, inside it wherever the bar's slid
// to (its ends too, from one end of its travel to the other), the runner on
// the screen either way up, and the rest of the pill (undo's end) still
// there; half grown, the runner's not yet its full length.
count_runner_grows_out_of_the_pill :: () #test {
    for screen: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        layout := laid_out(4, screen)
        cell := cell_of(layout)
        for shown: [4] f32⟨2, 3.4, 5.5, 6⟩ {
            for count: 2 <= MAX_PLAYERS {
                ring := count_place(layout, shown, count)
                assert(in_controls(layout, ring + V2⟨BAR_WIDTH * cell, 0⟩, 1), "«count»'s ring's width in the runner, at «shown»")
            }
            middle := (count_place(layout, shown, 2) + count_place(layout, shown, MAX_PLAYERS)) / 2
            for end: [2] f32⟨-1, 1⟩ {
                tip := middle + V2⟨0, end * (BAR_HALF - 0.01) * cell⟩
                assert(in_controls(layout, tip, 1), "the bar's end at «tip» in the runner, at «shown»")
                outside := layout.centre + V2⟨0, end * (RUNNER_HALF + 0.1) * cell⟩
                assert(!in_controls(layout, outside, 1), "the fixed groove ends beyond the full slider travel")
            }
        }
        reach := RUNNER_HALF * cell
        assert(layout.centre.y - reach > 0 and layout.centre.y + reach < screen.y, "the runner on the screen, on «screen»")
        for part: CAPSULE_PARTS {
            assert(in_controls(layout, capsule_centre(layout, part), 1), "«part»'s place still in the pill as the runner grows")
        }
        far := layout.centre + V2⟨0, (RUNNER_HALF - 0.2) * cell⟩
        assert(!in_controls(layout, far, 0) and !in_controls(layout, far, 0.5) and in_controls(layout, far, 1), "the runner grows to its length")
    }
}

// The controls are a pill across the screen: from the left, undo, redo, the
// players in the middle, a new game, and the system's at the right end;
// each button found at its middle, inside the pill, and none between two
// neighbours; above and below the pill is outside it.
capsule_buttons_make_a_pill :: () #test {
    layout := laid_out(4, LANDSCAPE)
    cell := cell_of(layout)
    c := layout.centre
    for part, i: CAPSULE_PARTS {
        middle := capsule_centre(layout, part)
        assert(Math.abs(middle.y - c.y) < 0.01, "«part» on the pill's line")
        if found := capsule_part_at(layout, middle) { assert(found == part, "«part»'s middle is «found»") }
        else if absent { assert(false, "«part»'s middle is no button") }
        // (a button's round, its icon 0.62 cells across: points round it half a cell out)
        for k: 0 < 8 {
            a := f32'k / 8 * f32'Math.TAU
            assert(in_controls(layout, middle + V2⟨Math.cos(a), Math.sin(a)⟩ * (0.5 * cell)), "«part»'s button inside the pill")
        }
        if i > 0 {
            before := capsule_centre(layout, CAPSULE_PARTS[i - 1])
            assert(before.x < middle.x, "«CAPSULE_PARTS[i - 1]» left of «part»")
            between := (before + middle) / 2
            if stray := capsule_part_at(layout, between) is not absent then assert(false, "between «CAPSULE_PARTS[i - 1]» and «part» is «stray»")
        }
    }
    assert(capsule_centre(layout, .PLAYERS) == c, "the players in the middle")
    assert(!in_controls(layout, c + V2⟨0, CAPSULE_PITCH⟩ * cell) and !in_controls(layout, c - V2⟨0, CAPSULE_PITCH⟩ * cell), "above and below the pill is outside it")
}

// Undo goes back a game and redo forward again; doing something new
// forgets what was undone.
undo_and_redo :: () #test {
    *timeline: Timeline
    *lines: Lines
    *game := new_game(4)
    timeline.remember(game, lines)
    game.deal(1, 0, 5)
    timeline.remember(game, lines)
    game.deal(2, 0, 3)
    assert(game.life[0] == 32)
    assert(timeline.undo(game, lines) and game.life[0] == 35, "one back: «game.life[0]»")
    assert(timeline.undo(game, lines) and game.life[0] == 40, "two back: «game.life[0]»")
    assert(!timeline.undo(game, lines), "nothing further back")
    assert(timeline.redo(game, lines) and game.life[0] == 35, "one forward: «game.life[0]»")
    timeline.remember(game, lines)
    game.deal(3, 0, 1)
    assert(!timeline.redo(game, lines) and game.life[0] == 34, "something new forgets what was undone")
    assert(timeline.undo(game, lines) and game.life[0] == 35)
}

// The lines are undone with the game: a line moved, or a reset's lines
// forgotten, comes back.
lines_are_undone :: () #test {
    *timeline: Timeline
    *lines: Lines
    lines[4] = equal_splits(4, LANDSCAPE)
    before := lines
    *game := new_game(4)
    timeline.remember(game, before)
    lines[4].move_split(0, wrapped_share(lines[4].at[0] + 0.05))
    assert(lines[4] != before[4])
    assert(timeline.undo(game, lines) and lines[4] == before[4], "the line back where it was")
    assert(timeline.redo(game, lines) and lines[4] != before[4], "and moved again")
}

// A player's colours tapped one after another are one step; another
// player's, or anything else done between, starts another.
colour_taps_are_one_step :: () #test {
    *timeline: Timeline
    *lines: Lines
    *game := new_game(4)
    for colour: 0 < 3 {
        timeline.remember_colours(game, lines, 1)
        game.identity[1] |= u8'1 << u8'colour
    }
    timeline.remember_colours(game, lines, 2)
    game.identity[2] = 1
    assert(timeline.past.count == 2, "one step each player's run: «timeline.past.count»")
    assert(timeline.undo(game, lines) and game.identity[2] == 0 and game.identity[1] == 7, "the second player's back")
    assert(timeline.undo(game, lines) and game.identity[1] == 0, "the first's run, all three, back")
    timeline.remember_colours(game, lines, 1)
    timeline.remember(game, lines)
    timeline.remember_colours(game, lines, 1)
    assert(timeline.past.count == 3, "something between starts another")
}

// A turn there and back is where it began.
frames_turn_back :: () #test {
    for angle: [4] f32⟨0, f32'Math.PI / 2, f32'Math.PI, -f32'Math.PI / 2⟩ {
        p := V2⟨30, -12⟩
        back := local_of(⟨100, 50⟩, angle, placed(⟨100, 50⟩, angle, p))
        assert(near_point(back, p), "«angle»: «back»")
    }
}

// A drag's damage, or 0 for one that asks.
damage_of :: (amount: Drag_Amount -> i32) {
    return if amount is { case damage: damage; case asked: 0 }
}

// Slots along the aim line reach the life total, 1 three, 2 two, the rest
// one; beyond it the drag asks.
drags_grow_then_ask :: () #test {
    assert(damage_of(amount_for(0)) == 1 and damage_of(amount_for(-1)) == 1, "1 at the edge, and before it")
    assert(damage_of(amount_for(QUESTION_FROM / 2)) > 1, "more further in")
    assert(damage_of(amount_for(QUESTION_FROM - 0.001)) == MOST_BY_DRAG, "9 at the last")
    assert(damage_of(amount_for(QUESTION_FROM)) == 9 and damage_of(amount_for(1.5)) == 0, "then it asks")
    // (each amount's share of the way: 3, 2, then 1 each, of 12)
    assert(DRAG_SLOT_COUNT == 12)
    *seen: [MOST_BY_DRAG + 1] i32
    for slot: 0 < 12 { seen[damage_of(amount_for((f32'slot + 0.5) / 12))] += 1 }
    expected := [MOST_BY_DRAG + 1] i32⟨0, 3, 2, 1, 1, 1, 1, 1, 1, 1⟩
    assert(seen == expected, "each amount's slots: «seen»")
}

// A drag aimed half way into another part does some damage there; one in
// its own part only over its own life total, asking how much; off the
// board, it misses.
aims_at_other_parts :: () #test {
    layout := laid_out(4, LANDSCAPE)
    game := new_game(4)
    target := layout.seats[0]
    if to, amount := aim(layout, game, 1, target.middle) {
        assert(to == 0 and damage_of(amount) > 0, "«to», «amount»")
    }
    else if missed {
        assert(false, "it hits the first player's part")
    }
    own := layout.seats[1]
    if self, paid := aim(layout, game, 1, own.middle) {
        assert(self == 1 and paid == Drag_Amount.asked, "its own life, asked: «self», «paid»")
    }
    else if missed {
        assert(false, "its own life total can be aimed at")
    }
    if _, _ := aim(layout, game, 1, attack_icon(layout, game, 1, .DAMAGE)) is not missed then assert(false, "at its own icon, none")
    beside := placed(own.middle, own.angle, ⟨0, 0 - 1.2 * f32'layout.life_size⟩)
    if _ := seat_at(layout, beside) is not absent {
        if _, _ := aim(layout, game, 1, beside) is not missed then assert(false, "in its own part, off its life total, none")
    }
    if _, _ := aim(layout, game, 1, V2⟨-50, -50⟩) is not missed then assert(false, "off the board, none")
}

// The colour of the seat whose player faces nearest a way (degrees from
// the centre, clockwise from the right, y down).
colour_facing :: (layout: Layout, colours: [MAX_PLAYERS] Identity, degrees: f32 -> Identity) {
    way := degrees * f32'Math.TAU / 360
    *nearest: i64 = 0
    for seat, k: layout.seats[:layout.count] {
        if Math.abs(turn_between(facing_of(seat), way)) < Math.abs(turn_between(facing_of(layout.seats[nearest]), way)) then nearest = k
    }
    return colours[nearest]
}

// The settings' Reset's colours: six from the top round clockwise white,
// blue, green, black, red, artifact; fewer take players away (the artifact
// deck, white, black, green), the rest carried as the lines morph: five and
// four where they're pinned here, three and two holding the colours left.
resets_colours_from_the_top :: () #test {
    w := mono(.WHITE)
    u := mono(.BLUE)
    g := mono(.GREEN)
    b := mono(.BLACK)
    r := mono(.RED)
    // each count's seats' facings, and the colour each should have
    Expect :: struct { players: i64; ways: [MAX_PLAYERS] f32; colours: [MAX_PLAYERS] Identity }
    expected := [5] Expect⟨
        ⟨6, ⟨-90, -30, 30, 90, 150, 210⟩, ⟨w, u, g, b, r, 0⟩⟩,
        ⟨5, ⟨-126, -54, 18, 90, 162, 0⟩, ⟨w, u, g, b, r, 0⟩⟩,
        ⟨4, ⟨-90, 0, 90, 180, 0, 0⟩, ⟨u, g, b, r, 0, 0⟩⟩,
        ⟨3, ⟨-30, 90, 210, 0, 0, 0⟩, ⟨u, g, r, 0, 0, 0⟩⟩,
        ⟨2, ⟨90, -90, 0, 0, 0, 0⟩, ⟨u, r, 0, 0, 0, 0⟩⟩
    ⟩
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        for e: expected {
            layout := laid_out(e.players, size)
            colours := starting_colours(size, e.players)
            for i: 0 < e.players {
                if e.players >= 4 {
                    got := colour_facing(layout, colours, e.ways[i])
                    assert(got == e.colours[i], "«e.players» players on «size», facing «e.ways[i]»: «got», not «e.colours[i]»")
                }
                else {
                    assert(holds(colours, e.players, e.colours[i]), "«e.players» players on «size» hold «e.colours[i]»: «colours»")
                }
            }
        }
    }
}

// The slot that goes is the seat that's seen to go: as the lines morph from
// a count's down to one fewer's, the part that closes is the slot GOING
// names; from six, that's the upper left (the artifact deck's), not the top.
the_slot_going_is_the_part_that_closes :: () #test {
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        for n: 3 <= MAX_PLAYERS {
            slot := slot_going(size, n)
            assert(starting_colours(size, n)[slot] == GOING[n], "«n» players on «size»: the slot going is GOING's")
            closed := morph_splits(equal_splits(n - 1, size), equal_splits(n, size), 0, slot)
            span := wrapped_share(closed.at[(slot + 1) % n] - closed.at[slot])
            assert(span < 0.0001 or span > 0.9999, "«n» players on «size»: part «slot» closes, its span «span»")
            for k: 0 < n {
                if k == slot then continue
                other := wrapped_share(closed.at[(k + 1) % n] - closed.at[k])
                assert(other > 0.01 and other < 0.99, "«n» players on «size»: part «k» stays open, «other»")
            }
        }
        six := laid_out(6, size)
        assert(colour_facing(six, starting_colours(size, 6), 210) == 0, "six on «size»: the artifact deck's is the upper left")
    }
}

// Whether a game's colours hold a colour (an identity) among its players.
holds :: (colours: [MAX_PLAYERS] Identity, players: i64, colour: Identity -> bool) {
    for c: colours[:players] { if c == colour then return true }
    return false
}

// A count's change goes by slots, not colours: each seat's slot named by its
// starting colours. Six players with colours of their own (none their
// slot's default): down from six, the artifact deck's slot goes, then
// white's, black's, green's, whatever colours they hold, the rest keeping
// theirs, each in the slot of its name; back up, each slot comes back as it
// left, its colours, life and damage kept.
slots_follow_the_count :: () #test {
    gone := [4] Identity⟨0, mono(.WHITE), mono(.BLACK), mono(.GREEN)⟩
    // (each slot's own colours: two colours each, told apart, none a default)
    own := [6] Identity⟨mono(.WHITE) | mono(.BLUE), mono(.BLUE) | mono(.BLACK), mono(.BLACK) | mono(.RED), mono(.RED) | mono(.GREEN),
                        mono(.GREEN) | mono(.WHITE), mono(.WHITE) | mono(.BLACK)⟩
    *none: [MAX_PLAYERS + 1] Splits
    names := starting_colours(LANDSCAPE, 6)
    // (six players, each its own colours and life, and each commander's
    // damage to each player its own: 10 * to + from + 1)
    *game := new_game(6)
    for k: 0 < 6 {
        game.identity[k] = own[k]
        game.life[k] = i32'(30 + k)
        for j: 0 < 6 { if j != k then game.commander[k][j] = i32'(10 * k + j + 1) }
    }
    start := game
    for n: 0 < 4 {
        from := 6 - n
        game = game_for(game, from - 1, none[:], LANDSCAPE)
        assert(!holds(game.identity, from - 1, own[place_of(names, gone[n])]), "«from» to «from - 1» players drops the slot of «gone[n]»: «game.identity»")
        seated_as_named(game, start, names, LANDSCAPE)
    }
    for to: 3 <= 6 {
        game = game_for(game, to, none[:], LANDSCAPE)
        seated_as_named(game, start, names, LANDSCAPE)
    }
    assert(game == start, "back to six, everyone as they were")
}

// The place among six's of the player with a slot's name.
place_of :: (names: [MAX_PLAYERS] Identity, name: Identity -> i64) {
    for n, k: names[:6] { if n == name then return k }
    return -1
}

// That each seat of a game's count holds its slot's player as they were in
// start, a game of six: their colours, life, and the damage between them.
seated_as_named :: (game: Game, start: Game, names: [MAX_PLAYERS] Identity, size: V2) {
    seat_names := starting_colours(size, game.players)
    for name, j: seat_names[:game.players] {
        k := place_of(names, name)
        assert(game.identity[j] == start.identity[k], "«game.players» players: the slot of «name» keeps its colours, «start.identity[k]», not «game.identity[j]»")
        assert(game.life[j] == start.life[k], "«game.players» players: the slot of «name» keeps its life, «start.life[k]», not «game.life[j]»")
        for other, i: seat_names[:game.players] {
            from := place_of(names, other)
            assert(game.commander[j][i] == start.commander[k][from], "«game.players» players: «other»'s damage to «name» kept")
        }
    }
}

// A reset forgets those who've left the table; a restart starts everyone
// again, at the table or not.
the_absent_are_forgotten_by_a_reset :: () #test {
    *none: [MAX_PLAYERS + 1] Splits
    *game := new_game(6, starting_colours(LANDSCAPE, 6))
    for k: 0 < 6 { game.life[k] = i32'(20 + k) }
    game.deal(5, 0, 7)
    *four := game_for(game, 4, none[:], LANDSCAPE)
    colours := starting_colours(LANDSCAPE, 4)
    forget_the_absent(four, colours)
    for k: 4 < 6 {
        assert(four.life[k] == STARTING_LIFE and four.identity[k] == colours[k], "place «k» off the table forgotten")
        for j: 0 < 6 { assert(four.commander[k][j] == 0 and four.commander[j][k] == 0, "place «k»'s damage forgotten") }
    }
    *kept := 0
    for k: 0 < 4 { if four.life[k] != STARTING_LIFE then kept += 1 }
    assert(kept == 4, "those at the table keep their lives")
    restarted := new_game(6, game_for(four, 6, none[:], LANDSCAPE).identity)
    for l: restarted.life { assert(l == STARTING_LIFE) }
}

// Commander damage is life lost too, and 21 from one commander is out.
deals_commander_damage :: () #test {
    *game := new_game(4)
    assert(game.life[3] == STARTING_LIFE and !is_out(game, 3))
    game.deal(0, 3, 10)
    game.deal(1, 3, 10)
    assert(game.life[3] == 20 and game.commander[3][0] == 10 and !is_out(game, 3), "20 from two isn't lethal")
    game.deal(0, 3, 11)
    assert(is_out(game, 3), "21 from one is")
    *poor := new_game(2)
    poor.deal(1, 0, STARTING_LIFE)
    assert(is_out(poor, 0), "no life left")
    // (a player's own: their life paid)
    *own := new_game(2)
    own.deal_attack(.DAMAGE, 0, 0, 5)
    assert(own.life[0] == STARTING_LIFE - 5, "damage to oneself: «own.life[0]»")
}

// A spell's damage takes life alone: however much, it's never commander
// damage, so it's never lethal as 21 from a commander is; as a volley it
// flies and lands as combat damage's does, the life shown counting down,
// the commander damage shown untouched throughout.
spells_take_life_alone :: () #test {
    *game := new_game(4)
    game.deal_spell(1, 0, 25)
    assert(game.life[0] == 15 and game.commander[0][1] == 0 and !is_out(game, 0), "25 from a spell: «game.life[0]» life, «game.commander[0][1]» commander damage")
    layout := laid_out(4, LANDSCAPE)
    *flying := new_game(4)
    flying.commander[0][1] = 6
    *volleys: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    strike(flying, volleys, layout, pending, 1, 0, 20, .DAMAGE)
    assert(flying.life[0] == 20 and flying.commander[0][1] == 6, "dealt at once, life alone: «flying.life[0]», «flying.commander[0][1]»")
    assert(volleys.list.count == 1 and volleys.list[0].kind == .DAMAGE, "a spell's volley")
    shown := shown_game(flying, pending, volleys)
    assert(shown.life[0] == 40 and shown.commander[0][1] == 6, "shown undone while it flies: «shown.life[0]», «shown.commander[0][1]»")
    steer_volleys(volleys, pending, 2)
    landed := shown_game(flying, pending, volleys)
    assert(landed.life[0] == 20 and landed.commander[0][1] == 6, "landed: «landed.life[0]», «landed.commander[0][1]»")
}

// A combat volley's commander damage is shown only as it lands.
combat_damage_shows_as_it_lands :: () #test {
    layout := laid_out(4, LANDSCAPE)
    *game := new_game(4)
    *volleys: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    strike(game, volleys, layout, pending, 1, 0, 8)
    flying := shown_game(game, pending, volleys)
    assert(flying.life[0] == 40 and flying.commander[0][1] == 0, "in flight: «flying.life[0]», «flying.commander[0][1]»")
    steer_volleys(volleys, pending, 2)
    landed := shown_game(game, pending, volleys)
    assert(landed.life[0] == 32 and landed.commander[0][1] == 8, "landed: «landed.life[0]», «landed.commander[0][1]»")
}


drag_damage_uses_the_entry_line :: () #test {
    assert(damage_of(amount_for(0.5 / 12)) == 1 and damage_of(amount_for(11.5 / 12)) == 9)
    assert(damage_of(amount_for(1.001)) == 0)
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        for count: 2 <= 6 {
            layout := laid_out(count, size)
            game := new_game(count)
            for target: 0 < count {
                seat := layout.seats[target]
                for source: 0 < count {
                    if source == target then continue
                    entry := entry_point(layout.seats[source].icon, seat.middle, seat.outline[:seat.count])
                    // (each within a slot, none on a boundary between two)
                    for radius: [4] f32⟨0.05, 0.45, 0.99, 1.01⟩ {
                        finger := entry + (seat.middle - entry) * radius
                        if to, amount := aim(layout, game, source, finger) {
                            assert(to == target)
                            assert(damage_of(amount) == damage_of(amount_for(radius)))
                        }
                        else if missed { assert(false, "a point in the target's part must hit") }
                    }
                }
            }
        }
    }
}

count_table_opens_far_enough_for_the_slider :: () #test {
    for cell: [3] f32⟨40, 90, 135⟩ {
        assert(count_split_offset(cell, 0) == 0)
        full := count_split_offset(cell, 1)
        assert(full > COLUMN_HALF * cell)
        assert(Math.abs(count_split_offset(cell, 0.5) - full * 0.5) < 0.001)
        assert(COUNT_RING_RADIUS - COUNT_RING_WIDTH * 0.5 > BAR_WIDTH)
    }
}
count_table_snaps_shut_on_release :: () #test {
    assert(step_count_opening(0, true, COUNT_OPEN_TIME) == 1)
    assert(step_count_opening(1, false, COUNT_CLOSE_TIME) == 0)
    assert(step_count_opening(0.3, false, 1) == 0)
    assert(step_count_opening(0.8, true, 1) == 1)
    assert(Math.abs(step_count_opening(1, false, COUNT_CLOSE_TIME / 2) - 0.5) < 0.001)
}
count_ring_cuts_lean_top_right_and_bottom_left :: () #test {
    assert(count_ring_cut(⟨0, -1⟩) < 0)
    assert(count_ring_cut(⟨0, 1⟩) > 0)
    assert(Math.abs(count_ring_cut(⟨COUNT_RING_SLOPE, -1⟩)) < 0.0001)
    assert(Math.abs(count_ring_cut(⟨0 - COUNT_RING_SLOPE, 1⟩)) < 0.0001)
    assert(COUNT_RING_RADIUS - COUNT_RING_WIDTH / 2 > BAR_WIDTH)
}
player_ui_fades_with_table_opening :: () #test {
    assert(count_player_visibility(0) == 1)
    assert(count_player_visibility(1) == 0)
    assert(Math.abs(count_player_visibility(0.5) - 0.5) < 0.0001)
    assert(count_player_visibility(0.2) > count_player_visibility(0.8))
    assert(count_player_visibility(-1) == 1 and count_player_visibility(2) == 0)
}
player_ui_returns_after_table_reconnects :: () #test {
    assert(step_count_player_ui(0, 0.5, false, 0.1) == 0)
    assert(step_count_player_ui(0.4, 0.1, false, 0.1) == 0)
    assert(Math.abs(step_count_player_ui(0, 0, false, COUNT_UI_RETURN_TIME / 2) - 0.5) < 0.0001)
    assert(step_count_player_ui(0.5, 0, false, COUNT_UI_RETURN_TIME) == 1)
    assert(step_count_player_ui(0.2, 0.1, true, 0.1) == 0.2)
}
dividers_stop_before_attack_buttons_touch_channels :: () #test {
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        for players: 2 <= MAX_PLAYERS {
            initial := laid_out(players, size)
            assert(attack_buttons_clear(initial), "initial layout leaves room for attacks")
            for edge: 0 < players {
                for direction: [2] f32⟨-1, 1⟩ {
                    *splits := initial.splits
                    target := wrapped_share(splits.at[edge] + direction * 0.4)
                    splits.move_split_with_clearance(edge, target, size)
                    assert(attack_buttons_clear(lay_out(size, splits)), "drag cannot push a channel into an attack button")
                    splits.move_split_with_clearance(edge, initial.splits.at[edge], size)
                    assert(Math.abs(share_between(splits.at[edge], initial.splits.at[edge])) < 0.0001, "«players» «size» edge «edge» direction «direction»: divider can move back away from its limit")
                }
            }
        }
    }
}
life_is_centred_in_the_asymmetric_bottom_region :: () #test {
    size := V2⟨2880, 1800⟩
    *splits: Splits = ⟨count: 5⟩
    for edge, i: [5] V2⟨⟨1440, 0⟩, ⟨2880, 420⟩, ⟨2880, 1130⟩, ⟨1240, 1800⟩, ⟨0, 420⟩⟩ {
        splits.at[i] = share_at(size, edge)
    }
    layout := lay_out(size, splits)
    seat := layout.seats[2]
    first := distance_to_segment(seat.middle, layout.centre, layout.ends[2])
    second := distance_to_segment(seat.middle, layout.centre, layout.ends[3])
    assert(Math.abs(first - second) < 0.01, "the 88 has equal clearance to its two channels")
    assert(seat.middle.x < 2000 and seat.middle.y > 1450, "the counter moves down and left from the area centroid")
}
free_arrow_points_along_the_drag :: () #test {
    button := V2⟨1700, 1400⟩
    finger := V2⟨1760, 1000⟩
    back := free_arrow_back(button, finger, ⟨0.6, 0.8⟩)
    forward := back * -1.0
    assert(forward.y < 0 and forward.x > 0, "toward blue, not curling back toward the attacker")
    assert(Math.dot(forward, Math.normalize(finger - button)) > 0.999)
    assert(free_arrow_back(button, button, ⟨0, 1⟩) == V2⟨0, 1⟩)
}
colour_picker_is_at_the_players_bottom_left :: () #test {
    layout := laid_out(2, LANDSCAPE)
    cell := cell_of(layout)
    for seat: layout.seats[:2] {
        _, _, folded := toggle_places(layout, seat)
        local := local_of(seat.middle, seat.angle, folded)
        assert(local.x < 0 and local.y > cell, "picker is bottom-left, not beside the central divider")
    }
}
animation_settings_select_each_speed :: () #test {
    for size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
        layout := laid_out(4, size)
        for choice: [4] Motion⟨.OFF, .SLOW, .MEDIUM, .FAST⟩ {
            at := layout.centre + animation_place(choice) * (CAPSULE_PITCH * cell_of(layout))
            if settings_part_at(layout, at) is {
                case animation: assert(animation == choice)
                case brightness, scale, orientation, reset, info, quit, close: assert(false)
            }
        }
    }
}
spinner_change_falls_and_bounces :: () #test {
    assert(change_fall(0) == 0 and change_fall(0.05) > 0, "fall starts immediately")
    duration: f32 = DRUM_FADE * 0.8
    impact := change_fall(duration / 2.75)
    rebound := change_fall(duration * 1.5 / 2.75)
    assert(impact > 0.99 and rebound < 0.8)
    assert(change_fall(duration) > 0.999)
    for i: 0 <= 100 {
        at := change_fall(duration * f32'i / 100)
        assert(at >= 0 and at <= 1.001, "the change never crosses into the life text")
    }
}
history_changes_keep_original_sign_on_undo :: () #test {
    *before := new_game(3)
    *after := before
    after.life[0] -= 4
    after.life[1] += 2
    *screen: Screen_State
    show_history_changes(screen, before, after, false)
    assert(screen.history_changes[0].change == -4 and !screen.history_changes[0].crossed)
    assert(screen.history_changes[1].change == 2)
    assert(screen.history_changes[2].change == 0)
    show_history_changes(screen, after, before, true)
    assert(screen.history_changes[0].change == -4 and screen.history_changes[0].crossed)
    assert(screen.history_changes[1].change == 2 and screen.history_changes[1].crossed)
    assert(screen.history_changes[0].since == 0)
    show_history_changes(screen, before, before, true)
    assert(screen.history_changes[0].change == 0 and screen.history_changes[1].change == 0)
}
change_spinner_speed_tracks_digit_place :: () #test {
    for place: [3] i32⟨1, 10, 100⟩ {
        drum := Life_Drum⟨start: 40, from: 43, place: place, turned: 0.25⟩
        assert(change_wheel_position(drum) == 3 + f32'place * 0.25)
        reverse := Life_Drum⟨start: 40, from: 43, place: place, turned: -0.25⟩
        assert(change_wheel_position(reverse) == 3 - f32'place * 0.25)
    }
}
// A hit displaces and twists the life total, then friction settles it.
bolt_recoil_settles :: () #test {
    *volleys: Volleys
    `scratch volleys.list.add(⟨id: 1, from: 1, to: 0, start: ⟨0, 0⟩, bend: ⟨50, -50⟩, end: ⟨100, 100⟩,
                              amount: 1, landed: 1, age: VOLLEY_GATHER + VOLLEY_TRAVEL + 0.04⟩)
    first, twist := life_recoil(volleys, 0, 100)
    assert(Math.length(first) > 1 and Math.abs(twist) > 0.001)
    untouched, _ := life_recoil(volleys, 1, 100)
    assert(Math.length(untouched) == 0)
    volleys.list[0].age += 0.12
    rebound, _ := life_recoil(volleys, 0, 100)
    assert(Math.dot(first, rebound) < 0, "the spring rebounds")
    volleys.list[0].age += 0.8
    settled, _ := life_recoil(volleys, 0, 100)
    assert(Math.length(settled) < 0.02, "friction removes the motion")
}

commander_tax_accepts_one_click_a_second :: () #test {
    *game := new_game(4)
    *ready: f64 = 0
    assert(raise_commander_tax(game, ready, 0, 10))
    assert(game.tax[0] == 2)
    assert(!raise_commander_tax(game, ready, 0, 10))
    assert(!raise_commander_tax(game, ready, 0, 10.999))
    assert(game.tax[0] == 2)
    assert(raise_commander_tax(game, ready, 0, 11))
    assert(game.tax[0] == 4 and game.life[0] == 40)
    restarted := new_game(4)
    assert(restarted.tax[0] == 0)
    order := Seating⟨1, 0, 2, 3, 4, 5⟩
    moved := reseated(game, order, 4)
    assert(moved.tax[1] == 4 and moved.tax[0] == 0)
}

forest_reseeds_only_while_hidden :: () #test {
    *previous: [4] V2
    *changes: [4] i64
    *active_ticks: i64 = 0
    for tick: 0 <= 3200 {
        *fading: i64 = 0
        for layer: 0 < 4 {
            state := forest_layer_cycle(f32'tick * 0.1, 2.3, layer)
            if state.y < 1 then fading += 1
            if tick > 0 and state.x != previous[layer].x {
                assert(state.y == 0 and previous[layer].y == 0)
                changes[layer] += 1
            }
            previous[layer] = state
        }
        if fading > 0 then active_ticks += 1
        assert(fading <= 1)
    }
    assert(active_ticks < 480)
    for count: changes { assert(count >= 2) }
}

lifelink_face_follows_reversal :: () #test {
    pivot := V2⟨40, 20⟩
    attacker := V2⟨-100, 20⟩
    assert(lifelink_disc_facing(pivot, ⟨0, 0⟩, attacker) == 1)
    assert(lifelink_disc_facing(pivot, ⟨0, 4⟩, attacker) == 1)
    started := lifelink_disc_facing(pivot, ⟨-2, 0⟩, attacker)
    assert(started > 0 and started < 1)
    assert(lifelink_disc_facing(pivot, ⟨-28, 0⟩, attacker) < 0)
    assert(lifelink_disc_facing(pivot, attacker - pivot, attacker) == -1)
}

// Input dispatches touches by what's open and what's hit: an attack drag let
// go opens a confirm, a touch off it cancels and a button strikes; an open
// drum blocks its part's controls while its + square commits and opens the
// life+ grid; and Escape closes overlays from topmost down.
touches_dispatch_by_what_is_open :: () #test {
    with scratch.rewind()
    `scratch {
        *splits: Lines
        splits[4] = equal_splits(4, LANDSCAPE)
        *layout := lay_out(LANDSCAPE, splits[4])
        *fonts: Fonts
        fonts.life_digit = 24
        fonts.life_minus = 12
        fonts.life.cap_height = 60
        fonts.output.cap_height = 40
        fonts.attack.cap_height = 36
        fonts.change.cap_height = 26
        *game := new_game(4)
        *screen: Screen_State
        *timeline: Timeline
        *volleys: Volleys
        *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
        *input: Input
        *random := Random.generator(1)

        // Drag from player 1's commander icon halfway into player 0's part, then release.
        start := attack_icon(layout, game, 1, .COMMANDER)
        entry := entry_point(layout.seats[1].icon, layout.seats[0].middle, layout.seats[0].outline[:layout.seats[0].count])
        land := Math.mix(entry, layout.seats[0].middle, 0.5)
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨1, start, true, false⟩⟩, 1, random)
        assert(screen.drags[1].active, "drag started")
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨1, land, false, true⟩⟩, 1, random)
        assert(!screen.drags[1].active and screen.confirms[1].open, "let go: confirm open")

        // A touch off the confirm buttons cancels without dealing damage.
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨2, layout.seats[2].middle, true, true⟩⟩, 1, random)
        assert(!screen.confirms[1].open and game.life[0] == STARTING_LIFE, "cancelled off the buttons")

        // Drag again and confirm on the main square button.
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨3, start, true, false⟩⟩, 1, random)
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨3, land, false, true⟩⟩, 1, random)
        expected_damage := screen.confirms[1].amount
        wide := confirm_width(fonts, screen.confirms[1], cell_of(layout))
        buttons, _, origin, angle := confirm_buttons(layout, screen.confirms[1], wide)
        hit := placed(origin, angle, buttons[0].middle)
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨4, hit, true, true⟩⟩, 1, random)
        assert(!screen.confirms[1].open and game.life[0] == STARTING_LIFE - expected_damage, "confirm button dealt its damage")
        call_off_volleys(volleys, pending)

        // Tap player 2's life to open their drum: their attack icon is ignored while it's open,
        // and the drum's + square closes the drum and opens a LIFE_UP grid that adds life on tick.
        life_spot := layout.seats[2].middle
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨5, life_spot, true, true⟩⟩, 2, random)
        assert(screen.drums[2].open, "tap opened the drum")
        blocked_icon := attack_icon(layout, game, 2, .COMMANDER)
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨6, blocked_icon, true, false⟩⟩, 2, random)
        assert(!screen.drags[2].active, "controls in an open drum's part wait")
        plus, _, _, _ := drum_signs(layout, fonts, screen.drums[2], 2)
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨7, plus, true, true⟩⟩, 2, random)
        assert(!screen.drums[2].open and screen.pickers[2].open and screen.pickers[2].kind == .LIFE_UP, "+ opened the life+ grid")
        grid_origin, grid_angle, _ := picker_frame(layout, screen.pickers[2])
        tick_middle, _ := picker_button(layout, true)
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts,
                   [1] Pointer⟨⟨8, placed(grid_origin, grid_angle, tick_middle), true, true⟩⟩, 2, random)
        assert(!screen.pickers[2].open and game.life[2] == STARTING_LIFE + 10, "the grid's tick added its default 10")

        // Escape peels off confirms, then grids, then settings, then counts.
        screen.confirms[0].open = true
        screen.pickers[1].open = true
        screen.settings_open = true
        screen.counts = ⟨open: true, held: true⟩
        assert(escape_overlay(screen) and !screen.confirms[0].open and screen.pickers[1].open)
        assert(escape_overlay(screen) and !screen.pickers[1].open and screen.settings_open)
        assert(escape_overlay(screen) and !screen.settings_open and screen.counts.open)
        assert(escape_overlay(screen) and !screen.counts.open and screen.counts.settling)
        assert(!escape_overlay(screen))
    }
}

// Restart spins anticlockwise round the table, fast at first and slowing down
// onto a randomly chosen starting player, then fades that part slowly back to
// normal; undoing the restart calls the spin off.
restart_spins_anticlockwise_and_fades_slowly :: () #test {
    with scratch.rewind()
    `scratch {
        *random := Random.generator(42)
        for players: 2 <= MAX_PLAYERS {
            *winners: [MAX_PLAYERS] bool
            *starts: [MAX_PLAYERS] bool
            for _: 0 < 80 {
                trial := begin_start_spin(random, players)
                assert(trial.active and trial.winner >= 0 and trial.winner < players and trial.steps >= 5)
                first_seat, first_strength := spin_light(trial, players)
                assert(first_seat >= 0 and first_seat < players and first_strength == 1)
                winners[trial.winner] = true
                starts[first_seat] = true
                *total: f32 = 0
                for i: 0 < trial.steps { total += spin_step_duration(i, trial.steps) }
                assert(total > 3.0 and total < 5.0, "«players» players: the spin to its part takes 3..5 s («total»)")
            }
            for k: 0 < players {
                assert(winners[k] and starts[k], "«players» players: every seat can start and win")
            }

            *spin := begin_start_spin(random, players)
            assert(spin_step_duration(0, spin.steps) > 0.11 and spin_step_duration(0, spin.steps) < 0.16, "lower initial spin speed")
            for i: 0 < spin.steps - 1 {
                assert(spin_step_duration(i + 1, spin.steps) > spin_step_duration(i, spin.steps), "slows gradually at each step")
            }
            *previous, _ := spin_light(spin, players)
            *transitions: i64 = 0
            *spin_seconds: f32 = 0
            while spin_spinning(spin) {
                step_start_spin(spin, 0.005)
                spin_seconds += 0.005
                seat, strength := spin_light(spin, players)
                assert(strength > 0)
                if seat != previous {
                    // Seats run clockwise by index, so anticlockwise steps down by 1.
                    assert(seat == (previous + players - 1) % players, "«players» players: «previous» to «seat» isn't anticlockwise")
                    if players >= 3 {
                        a := angle_about(LANDSCAPE / 2, laid_out(players, LANDSCAPE).seats[previous].middle)
                        b := angle_about(LANDSCAPE / 2, laid_out(players, LANDSCAPE).seats[seat].middle)
                        assert(turn_between(a, b) < 0, "«players» players: seat angle moved clockwise")
                    }
                    previous = seat
                    transitions += 1
                }
            }
            assert(transitions == spin.steps and previous == spin.winner, "landed on the chosen starting player")
            assert(spin_seconds > 3.0 and spin_seconds < 5.0, "spins to its part in 3 to 5 s: «spin_seconds»")

            // In the final part, the sun goes back and forth for 3 s, off the
            // anticlockwise channel (1) then the clockwise one (0), each time,
            // settles at 0.5, then fades slowly; it enters at the last step's pace.
            assert(SPIN_SETTLE == 3 and Math.abs(1 / spin_step_duration(spin.steps - 1, spin.steps) - SPIN_ENTRY_SPEED) < 0.001,
                   "3 s of bounces, entered at the last step's pace")
            for k: 1 <= SPIN_BOUNCES {
                bounce, acw, cw := spin_final_bounce(spin_bounce_time(k))
                if k % 2 == 1 then assert(bounce > 0.99 and acw > 0.8, "bounce «k» off the anticlockwise channel: «bounce»")
                else assert(bounce < 0.01 and cw > 0.8, "bounce «k» off the clockwise channel: «bounce»")
            }
            early, _, _ := spin_final_bounce(0.05)
            assert(Math.abs(early / 0.05 - SPIN_ENTRY_SPEED) < 0.1, "keeps its pace as it enters: «early / 0.05»")
            settled, _, _ := spin_final_bounce(SPIN_SETTLE)
            assert(Math.abs(settled - 0.5) < 0.01, "settles overhead in the middle")

            landed_seat, landed_strength := spin_light(spin, players)
            assert(landed_seat == spin.winner and landed_strength > 0.99)
            step_start_spin(spin, SPIN_SETTLE + 2.5)
            mid_seat, mid_strength := spin_light(spin, players)
            assert(spin.active and mid_seat == spin.winner and mid_strength > 0.6 and mid_strength < landed_strength, "fades slowly: «mid_strength»")
            step_start_spin(spin, SPIN_FADE)
            done_seat, done_strength := spin_light(spin, players)
            assert(!spin.active and done_seat == -1 and done_strength == 0, "back to normal")
        }

        // Pressing Restart on the pill resets lives and begins the spin; Undo ends it.
        *splits: Lines
        splits[4] = equal_splits(4, LANDSCAPE)
        *layout := lay_out(LANDSCAPE, splits[4])
        *fonts: Fonts
        *game := new_game(4)
        game.life[0] = 17
        *screen: Screen_State
        *timeline: Timeline
        *volleys: Volleys
        *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
        *input: Input
        restart_at := capsule_centre(layout, .RESTART)
        step_input(input, screen, timeline, game, splits, volleys, pending, layout, fonts, [1] Pointer⟨⟨1, restart_at, true, true⟩⟩, 1, random)
        assert(game.life[0] == STARTING_LIFE and spin_spinning(screen.start_spin), "Restart began the spin")
        assert(step_history(screen, timeline, game, splits, false) and game.life[0] == 17 and !screen.start_spin.active, "Undo cancels the spin")

        // Debug L-key helper lights each panel in order (0..players-1) and then turns off.
        for players: 2 <= MAX_PLAYERS {
            *lit_screen := Screen_State⟨start_spin: ⟨active: true, winner: 1, step: 0, steps: 10⟩⟩
            assert(lit_screen.debug_lit == -1)
            for seat: 0 < players {
                cycle_debug_light(lit_screen, players)
                assert(lit_screen.debug_lit == seat and !lit_screen.start_spin.active, "«players» players: step «seat»")
            }
            cycle_debug_light(lit_screen, players)
            assert(lit_screen.debug_lit == -1, "«players» players: turns off after the last panel")

            // Across every seat in both orientations, the sun rises over the clockwise
            // edge, arcs overhead at noon, and sets over the anticlockwise edge along the spin vector.
            for orient_size: [2] V2⟨LANDSCAPE, PORTRAIT⟩ {
                check_layout := laid_out(players, orient_size)
                for k: 0 < players {
                    dawn, origin, spin_dir, half_span := part_sun_arc(check_layout, k, 0.0)
                    noon, _, _, _ := part_sun_arc(check_layout, k, 0.5)
                    dusk, _, _, _ := part_sun_arc(check_layout, k, 1.0)
                    assert(Math.dot(dawn.xy, spin_dir) < -0.9 and dawn.z > 0, "«players» players seat «k»: sun rises at clockwise edge")
                    assert(Math.length(noon.xy) < 0.001 and noon.z > 0.999, "«players» players seat «k»: sun is overhead at noon")
                    assert(Math.dot(dusk.xy, spin_dir) > 0.9 and dusk.z > 0, "«players» players seat «k»: sun sets over anticlockwise edge")
                    rise_side := origin - spin_dir * (half_span * 0.4)
                    set_side := origin + spin_dir * (half_span * 0.4)
                    assert(turn_between(angle_about(check_layout.centre, rise_side), angle_about(check_layout.centre, set_side)) < 0,
                           "«players» players seat «k»: sunrise to sunset moves anticlockwise")
                }
            }
        }
    }
}
