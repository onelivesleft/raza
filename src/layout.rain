// Where each player's part of the screen is: the tablet lies in the middle
// of the table, and each player has a part of it from the screen's centre
// out to their side, with their life total facing them.
//
// The parts are split by lines from the centre to the screen's edge, each
// line's end a place on the edge (Splits). To start with every life total
// has the same margins either side (each part as wide across it, from one
// line to the other), and the parts are mirrored about the screen's upright
// middle: one line goes straight up when there's an odd
// number of players, and the top part is centred on the top when there's an
// even, so two players have the halves. A player drags a line's end along
// the edge to move it, or with two fingers turns every line together about
// the centre.

MAX_PLAYERS :: 6

// The most points a part's outline has: the centre, the two ends of its
// lines, and the corners between them.
MAX_OUTLINE :: 8

// The least distance from a life total's middle up to its attack spot, in
// the player's frame, in cells (more where the totals are big: lay_out's).
ATTACK_ABOVE_CELLS :: 2.2

// The least share of the way round the edge a part keeps when a line's end
// is dragged toward the next.
LEAST_SPLIT :: 0.04

// Where the lines from the centre meet the screen's edge: each a share of
// the way round it, clockwise from its top-left corner (0 up to 1), in
// order round. Shares, so they're the same on a screen of another size.
Splits :: struct {
    count: i64
    at:    [MAX_PLAYERS] f32
}

// A player's part of the screen.
Seat :: struct {
    outline: [MAX_OUTLINE] V2    // from the screen's centre round to its edge and back
    count:   i64                 // how many of outline's points it has
    middle:  V2                  // life total on the centre line between its channels
    icon:    V2                  // its damage icon's centre, toward the screen's centre
    clear:   f32                 // how far its damage icon is from the controls' plus (what its fields may reach)
    toward:  V2                  // from the screen's centre toward its player: halfway between its lines
    angle:   f32                 // its text's turn (Draw's), the right way up for its player
    room:    f32                 // from middle to the nearest edge of its outline
    reach:   f32                 // how far toward its player it goes: its outline's furthest point along toward
}

Layout :: struct {
    size:   V2
    centre: V2
    count:  i64
    seats:  [MAX_PLAYERS] Seat
    splits: Splits
    ends:   [MAX_PLAYERS] V2     // where each line from the centre meets the screen's edge
    life_size: i32               // the life totals' font size (fitted_life_size's)
    widget_scale: f32 = 1        // the players' widgets' size (the settings' scale slider): widget_cell's
}

// The share a turned to lie from 0 up to 1 (or an angle, from 0 up to TAU).
wrapped_share :: (s: f32 -> f32) #pure {
    return s - Math.floor(s)
}

wrapped :: (a: f32 -> f32) #pure {
    tau := f32'Math.TAU
    return a - tau * Math.floor(a / tau)
}

// How far from a to b the shortest way round, from -PI up to PI.
turn_between :: (a: f32, b: f32 -> f32) #pure {
    return wrapped(b - a + f32'Math.PI) - f32'Math.PI
}

////////////////////////////////
// The edge, as shares of the way round

perimeter_of :: (size: V2 -> f32) #pure {
    return 2 * (size.x + size.y)
}

// The four corners' shares: top-right, bottom-right, bottom-left (top-left is 0).
corner_shares :: (size: V2 -> [3] f32) #pure {
    p := perimeter_of(size)
    return ⟨size.x / p, (size.x + size.y) / p, (2 * size.x + size.y) / p⟩
}

// The point of the edge a share of the way round.
edge_at :: (size: V2, share: f32 -> V2) #pure {
    s := wrapped_share(share) * perimeter_of(size)
    if s < size.x then return ⟨s, 0⟩
    if s < size.x + size.y then return ⟨size.x, s - size.x⟩
    if s < 2 * size.x + size.y then return ⟨size.x - (s - size.x - size.y), size.y⟩
    return ⟨0, size.y - (s - 2 * size.x - size.y)⟩
}

// The share of the way round of the point of the edge nearest p.
share_at :: (size: V2, p: V2 -> f32) #pure {
    perimeter := perimeter_of(size)
    x := Math.clamp(p.x, 0, size.x)
    y := Math.clamp(p.y, 0, size.y)
    // (the side it's nearest)
    to_top := y
    to_right := size.x - x
    to_bottom := size.y - y
    to_left := x
    least := Math.min(Math.min(to_top, to_right), Math.min(to_bottom, to_left))
    s := if least == to_top then x
         else if least == to_right then size.x + y
         else if least == to_bottom then size.x + size.y + (size.x - x)
         else 2 * size.x + size.y + (size.y - y)
    return wrapped_share(s / perimeter)
}

// The area a part gains for each pixel its edge goes along a side: half the
// side's distance from the centre (a thin triangle from the centre).
area_rate :: (size: V2, share: f32 -> f32) #pure {
    corners := corner_shares(size)
    s := wrapped_share(share)
    on_side := (s >= corners[0] and s < corners[1]) or s >= corners[2]
    return if on_side then size.x / 4 else size.y / 4
}

// The share past from at which a part from from has an area.
share_after_area :: (size: V2, from: f32, area: f32 -> f32) #pure {
    perimeter := perimeter_of(size)
    corners := [5] f32⟨0, corner_shares(size)[0], corner_shares(size)[1], corner_shares(size)[2], 1⟩
    *at := wrapped_share(from)
    *left := area
    *travelled: f32 = 0
    for _: 0 < 9 {
        // the next corner past at
        *next: f32 = 1
        for c: corners { if c > at + 0.000_001 { next = c; break } }
        rate := area_rate(size, at + 0.000_001)
        length := (next - at) * perimeter
        if left <= rate * length {
            return wrapped_share(from + travelled + left / rate / perimeter)
        }
        left -= rate * length
        travelled += next - at
        at = wrapped_share(next)
    }
    return wrapped_share(from + travelled)
}

// Where the edge meets a line from the centre at an angle (y down).
edge_point :: (centre: V2, half: V2, angle: f32 -> V2) #pure {
    d := V2⟨Math.cos(angle), Math.sin(angle)⟩
    across := if Math.abs(d.x) > 0.000_001 then half.x / Math.abs(d.x) else 1e30
    down := if Math.abs(d.y) > 0.000_001 then half.y / Math.abs(d.y) else 1e30
    return centre + d * Math.min(across, down)
}

// Lines giving every part the same area, mirrored about the screen's upright
// middle: an odd count's first line goes straight up; an even count's top
// part is centred on the top (its first line half a part's area round from
// the top's middle). Each line after is a part's area round from the last.
equal_area_splits :: (players: i64, size: V2 -> splits: Splits) #pure {
    n := Math.clamp(players, 2, MAX_PLAYERS)
    splits = ⟨count: n⟩
    each := size.x * size.y / f32'n
    top_middle := size.x / 2 / perimeter_of(size)
    splits.at[0] = if n % 2 == 1 then top_middle else share_after_area(size, top_middle, each / 2)
    for k: 1 < n { splits.at[k] = share_after_area(size, splits.at[k - 1], each) }
}

// How near (in pixels) the parts' widths across their life totals must come
// to each other for the lines a count starts with to be done.
ACROSS_AGREES :: 0.5

// The lines a count of players starts with on a screen of a size: every life
// total with the same margins either side, each part as wide across its life
// total (width_across) from one of its lines to the other, mirrored about the
// screen's upright middle. From equal areas, each line is moved toward
// whichever of its two parts is wider, by a share of the difference (all at
// once, so what's mirrored stays so), until they agree.
equal_splits :: (players: i64, size: V2 -> splits: Splits) #pure {
    splits = equal_area_splits(players, size)
    n := splits.count
    perimeter := perimeter_of(size)
    for _: 0 < 400 {
        layout := lay_out(size, splits)
        *widths: [MAX_PLAYERS] f32
        for k: 0 < n { widths[k] = width_across(layout, k) }
        *moved: [MAX_PLAYERS] f32
        *most: f32 = 0
        for k: 0 < n {
            // (line k ends part k - 1 and starts part k: moved on round, the
            // first gains and the second loses)
            before := widths[(k + n - 1) % n]
            after := widths[k]
            moved[k] = Math.clamp(0.25 * (after - before) / perimeter, -0.004, 0.004)
            most = Math.max(most, Math.abs(after - before))
        }
        if most < ACROSS_AGREES then return
        for k: 0 < n { splits.at[k] = wrapped_share(splits.at[k] + moved[k]) }
    }
}

// Splits that can be used for a count of players: as many lines, each
// further round than the last, none closer than LEAST_SPLIT to the next.
splits_fit :: (splits: Splits, players: i64 -> bool) #pure {
    if splits.count != players then return false
    *total: f32 = 0
    for k: 0 < players {
        gap := wrapped_share(splits.at[(k + 1) % players] - splits.at[k])
        if gap < LEAST_SPLIT * 0.5 then return false
        total += gap
    }
    return Math.abs(total - 1) < 0.001
}

// A line's end moved to a share of the way round (dragged), kept between
// its neighbours (LEAST_SPLIT from each).
move_split :: (splits: *Splits, k: i64, share: f32) {
    n := splits.count
    previous := splits.at[(k + n - 1) % n]
    next := splits.at[(k + 1) % n]
    span := if n == 2 then f32'1 else wrapped_share(next - previous)
    along := Math.clamp(wrapped_share(share - previous), LEAST_SPLIT, span - LEAST_SPLIT)
    splits.at[k] = wrapped_share(previous + along)
}

// The shortest way round the edge from a to b, as a share (-0.5 up to 0.5).
share_between :: (a: f32, b: f32 -> f32) #pure {
    return wrapped_share(b - a + 0.5) - 0.5
}

// Which of a count's lines the i-th of the next count's comes from, with
// the line doubled the one that splits in two.
source_of :: (i: i64, doubled: i64 -> i64) #pure {
    return if i <= doubled then i else i - 1
}

// How a count's lines (a) become the next's (b): the line of a's that's
// doubled, splitting in two, and the turn, b's line (i + turn) % m coming
// from a's source_of(i, doubled). The part of b's between the doubled
// line's two is the one that's new (b's part (doubled + turn) % m), and each
// other part of b's, (i + turn) % m, is a's part source_of(i, doubled). Of
// the ways that make the new part new (any, if new is -1), the one that
// moves the lines least.
morph_choice :: (a: Splits, b: Splits, new: i64 -> doubled: i64, turn: i64) #pure {
    n := a.count
    m := b.count
    assert(m == n + 1, "lines morph from a count to the next")
    *best_cost: f32 = 1e30
    doubled = 0
    turn = 0
    for d: 0 < n {
        for t: 0 < m {
            if new >= 0 and (d + t) % m != new then continue
            *cost: f32 = 0
            for i: 0 < m {
                source := a.at[source_of(i, d)]
                cost += Math.abs(share_between(source, b.at[(i + t) % m]))
            }
            if cost < best_cost {
                best_cost = cost
                doubled = d
                turn = t
            }
        }
    }
}

// Lines part of the way (f, from 0 to 1) from a count's to the next's: the
// first's, one of them doubled, each moved f of the way along the edge to
// the line of the second's it becomes (morph_choice's): so going up one line
// splits in two about the part that's new, and coming back that part's two
// meet in one.
morph_splits :: (a: Splits, b: Splits, f: f32, new: i64 = -1 -> splits: Splits) #pure {
    m := b.count
    splits = ⟨count: m⟩
    doubled, turn := morph_choice(a, b, new)
    for i: 0 < m {
        source := a.at[source_of(i, doubled)]
        target := b.at[(i + turn) % m]
        splits.at[(i + turn) % m] = wrapped_share(source + share_between(source, target) * f)
    }
}

////////////////////////////////
// The parts

// The nearest a point comes to the segment from a to b.
distance_to_segment :: (p: V2, a: V2, b: V2 -> f32) #pure {
    along := b - a
    length_squared := Math.dot(along, along)
    t := if length_squared > 0 then Math.clamp(Math.dot(p - a, along) / length_squared, 0, 1) else 0
    return Math.length(p - (a + along * t))
}

// Whether a point is inside a polygon (a line out from it crosses its
// edges an odd number of times).
inside :: (p: V2, points: [] V2 -> bool) #pure {
    *crossings := 0
    for a, i: points {
        b := points[(i + 1) % points.count]
        if (a.y > p.y) != (b.y > p.y) {
            x := a.x + (p.y - a.y) / (b.y - a.y) * (b.x - a.x)
            if p.x < x then crossings += 1
        }
    }
    return crossings % 2 == 1
}

// A polygon's area.
area_of :: (points: [] V2 -> f32) #pure {
    *twice: f32 = 0
    for a, i: points {
        b := points[(i + 1) % points.count]
        twice += a.x * b.y - b.x * a.y
    }
    return Math.abs(twice) / 2
}

// The polygon's centroid (its area's centre).
centroid :: (points: [] V2 -> V2) #pure {
    *area: f32 = 0
    *sum := V2⟨0, 0⟩
    for a, i: points {
        b := points[(i + 1) % points.count]
        cross := a.x * b.y - b.x * a.y
        area += cross
        sum = sum + (a + b) * cross
    }
    if Math.abs(area) < 0.000_001 then return points[0]
    return sum / (3 * area)
}

// Halfway round from one line from the centre to the next (as an angle from
// the centre, y down).
halfway_between :: (centre: V2, first: V2, next: V2 -> f32) #pure {
    a := Math.atan2(first.y - centre.y, first.x - centre.x)
    b := Math.atan2(next.y - centre.y, next.x - centre.x)
    return a + wrapped(b - a) / 2
}

// How wide a part is across its life total: along a line through the life
// total's centre, square to halfway between the part's lines (as its player
// faces, unrounded), from one of its lines (from the centre, on past the
// screen's edge if need be) to the other. A part whose lines that line
// never meets (two players' halves) is as wide as the screen's diagonal.
width_across :: (layout: Layout, k: i64 -> f32) #pure {
    n := layout.count
    first := layout.ends[k] - layout.centre
    next := layout.ends[(k + 1) % n] - layout.centre
    way := halfway_between(layout.centre, layout.ends[k], layout.ends[(k + 1) % n])
    along := V2⟨-Math.sin(way), Math.cos(way)⟩
    from := layout.seats[k].middle - layout.centre
    widest := Math.length(layout.size)
    // (where the line from the middle along `along` meets a line from the
    // centre along d, as a distance along it: from + t along = s d)
    meet :: (p: V2, v: V2, d: V2 -> f32) #pure {
        cross := v.x * d.y - v.y * d.x
        if Math.abs(cross) < 0.000_001 then return 1e30
        return (d.x * p.y - d.y * p.x) / cross
    }
    a := meet(from, along, first)
    b := meet(from, along, next)
    if Math.abs(a) > widest or Math.abs(b) > widest then return widest
    return Math.abs(a - b)
}

// The turn of a player's text, the right way up for them, when they're
// toward a way from the centre: a player below it reads it as the screen is
// (0), one above upside down, one at the left turned a quarter clockwise.
text_angle :: (toward: V2 -> f32) #pure {
    return Math.atan2(-toward.x, toward.y)
}

// The players' parts of a screen of a size, split as splits says, their
// widgets at a scale (widget_cell's).
lay_out :: (size: V2, splits: Splits, widget_scale: f32 = 1 -> layout: Layout) #pure {
    n := splits.count
    centre := size / 2
    layout = ⟨size: size, centre: centre, count: n, splits: splits, widget_scale: widget_scale⟩
    for k: 0 < n { layout.ends[k] = edge_at(size, splits.at[k]) }
    corners := corner_shares(size)
    all_corners := [4] f32⟨0, corners[0], corners[1], corners[2]⟩
    for k: 0 < n {
        from := splits.at[k]
        span := wrapped_share(splits.at[(k + 1) % n] - from)
        *seat: Seat
        seat.outline[0] = centre
        seat.outline[1] = layout.ends[k]
        *count: i64 = 2
        // The corners between its lines, in order round.
        *between: [4] f32
        *found: i64 = 0
        for c: all_corners {
            r := wrapped_share(c - from)
            if r > 0.000_01 and r < span - 0.000_01 {
                *j := found
                while j > 0 and between[j - 1] > r {
                    between[j] = between[j - 1]
                    j -= 1
                }
                between[j] = r
                found += 1
            }
        }
        for r: between[:found] {
            seat.outline[count] = edge_at(size, from + r)
            count += 1
        }
        seat.outline[count] = layout.ends[(k + 1) % n]
        seat.count = count + 1
        points := seat.outline[:seat.count]
        area_middle := centroid(points)

        // Its player faces it halfway between its lines, and its life total
        // is on that line, slightly nearer them than the part's centroid.
        facing := halfway_between(centre, layout.ends[k], layout.ends[(k + 1) % n])
        seat.toward = ⟨Math.cos(facing), Math.sin(facing)⟩
        seat.angle = text_angle(seat.toward)
        depth := Math.dot(area_middle - centre, seat.toward) + 0.35 * cell_of(layout)
        seat.middle = centre + seat.toward * depth
        *reach: f32 = 0
        for a: points { reach = Math.max(reach, Math.dot(a - centre, seat.toward)) }
        seat.room = room_round(seat.middle, points)
        seat.reach = reach
        layout.seats[k] = seat
    }
    // Each attack spot far enough from its life total, however big the
    // totals are drawn (fitted_life_size's, from the parts' room), for a
    // commander chip between them (two players' totals in portrait are
    // big). Where the controls in the middle hold a spot back, the life
    // total goes down toward its player instead, as far as keeps its
    // capitals, and a little, inside its part; its room is measured again
    // there, and the totals' size fitted again from where they are now.
    life_half := f32'fitted_life_size(layout) * LIFE_CAP_SHARE / 2
    // (the room for a chip and an attack icon grown with the widgets)
    grown := (ATTACK_LIFE_GAP - 0.1) * (widget_cell(layout) - cell_of(layout))
    for *seat: layout.seats[:n] {
        above := Math.max(ATTACK_ABOVE_CELLS * cell_of(layout), life_half + ATTACK_LIFE_GAP * cell_of(layout)) + grown
        seat.icon = clear_of_controls(size, centre, seat.middle, seat.middle - seat.toward * above)
        held_back := above - Math.dot(seat.middle - seat.icon, seat.toward)
        room_ahead := seat.reach - life_half - 0.3 * cell_of(layout) - Math.dot(seat.middle - centre, seat.toward)
        down := Math.min(held_back, room_ahead)
        if down > 0 {
            seat.middle = seat.middle + seat.toward * down
            seat.room = room_round(seat.middle, seat.outline[:seat.count])
        }
        seat.clear = controls_clearance(size, centre, seat.icon)
    }
    layout.life_size = fitted_life_size(layout)
}

// How far a point is from the nearest side of a part's outline.
room_round :: (at: V2, points: [] V2 -> f32) #pure {
    *room: f32 = 1e30
    for a, i: points { room = Math.min(room, distance_to_segment(at, a, points[(i + 1) % points.count])) }
    return room
}

// A life total's capitals' height, as a share of its font's size (Crimson
// Pro's figures', with a little to spare); and the room between the top of
// a life total and its attack spot, in cells: a commander chip, the gap
// beside it, an attack icon's radius, and a little more.
LIFE_CAP_SHARE :: 0.66
ATTACK_LIFE_GAP :: 2 * CHIP_RADIUS + CHIP_GAP + DAMAGE_ICON_RADIUS + 0.1

// The seat a point is in, or absent (outside the screen).
seat_at :: (layout: Layout, p: V2 -> i64) [absent] {
    for seat, k: layout.seats[:layout.count] {
        if inside(p, seat.outline[:seat.count]) then return k
    }
    fail: absent
}

// The line nearest a point, if it's within reach (anywhere along it), or
// absent.
line_at :: (layout: Layout, p: V2, reach: f32 -> i64) [absent] {
    *nearest: i64 = -1
    *least := reach
    for end, k: layout.ends[:layout.count] {
        d := distance_to_segment(p, layout.centre, end)
        if d <= least {
            least = d
            nearest = k
        }
    }
    if nearest < 0 then fail: absent
    return nearest
}

// Where a line from the centre through a point meets the screen's edge, as
// a share of the way round: where a dragged line's end goes, so the line
// passes under the finger. Absent at the centre itself (no way to aim).
share_through :: (layout: Layout, p: V2 -> f32) [absent] {
    d := p - layout.centre
    if Math.length(d) < 1 then fail: absent
    return share_at(layout.size, edge_point(layout.centre, layout.size / 2, Math.atan2(d.y, d.x)))
}

// The lines turned together about the screen's centre by an angle
// (radians, clockwise on the screen): each end where its line, so turned,
// meets the edge.
turned_splits :: (splits: Splits, size: V2, angle: f32 -> turned: Splits) #pure {
    turned = splits
    centre := size / 2
    for k: 0 < splits.count {
        end := edge_at(size, splits.at[k]) - centre
        turned.at[k] = share_at(size, edge_point(centre, centre, Math.atan2(end.y, end.x) + angle))
    }
}

// The angle of a point about a centre (y down: clockwise as it grows).
angle_about :: (centre: V2, p: V2 -> f32) #pure {
    return Math.atan2(p.y - centre.y, p.x - centre.x)
}

// A point of a frame turned angle about origin (x along its text, y down
// for its reader), on the screen; and a point of the screen in the frame.
placed :: (origin: V2, angle: f32, local: V2 -> V2) #pure {
    c := Math.cos(angle)
    s := Math.sin(angle)
    return ⟨origin.x + local.x * c - local.y * s, origin.y + local.x * s + local.y * c⟩
}

local_of :: (origin: V2, angle: f32, point: V2 -> V2) #pure {
    d := point - origin
    c := Math.cos(angle)
    s := Math.sin(angle)
    return ⟨d.x * c + d.y * s, -d.x * s + d.y * c⟩
}
