MDI_ACCOUNT :: #data "mdi/account.svg"
MDI_BACKUP_RESTORE :: #data "mdi/backup-restore.svg"
MDI_CHECK :: #data "mdi/check.svg"
MDI_CLOSE :: #data "mdi/close.svg"
MDI_DOTS_HORIZONTAL :: #data "mdi/dots-horizontal.svg"
MDI_PAUSE :: #data "mdi/pause.svg"
MDI_POWER :: #data "mdi/power.svg"
MDI_REDO :: #data "mdi/redo.svg"
MDI_RESTORE :: #data "mdi/restore.svg"
MDI_UNDO :: #data "mdi/undo.svg"

// Each icon's SVG, in the order icon(...) numbers them.
SVGS :: [] string⟨string'MDI_ACCOUNT[:], string'MDI_BACKUP_RESTORE[:], string'MDI_CHECK[:], string'MDI_CLOSE[:], string'MDI_DOTS_HORIZONTAL[:], string'MDI_PAUSE[:], string'MDI_POWER[:], string'MDI_REDO[:], string'MDI_RESTORE[:], string'MDI_UNDO[:]⟩

// The icon of Mdi's of that name, to draw (HOME :: icon(Mdi.HOME)).
icon :: ($name: Mdi -> Icons.Icon) {
    #assert(name == .ACCOUNT or name == .BACKUP_RESTORE or name == .CHECK or name == .CLOSE or name == .DOTS_HORIZONTAL or name == .PAUSE or name == .POWER or name == .REDO or name == .RESTORE or name == .UNDO, "this icon of Mdi's isn't in icons/ yet: run rain -run tools/icons/icons.rain update C:/repos/raza/src/raza.rain, which copies each icon the program names")
    return if name is {
        case .ACCOUNT: ⟨0⟩
        case .BACKUP_RESTORE: ⟨1⟩
        case .CHECK: ⟨2⟩
        case .CLOSE: ⟨3⟩
        case .DOTS_HORIZONTAL: ⟨4⟩
        case .PAUSE: ⟨5⟩
        case .POWER: ⟨6⟩
        case .REDO: ⟨7⟩
        case .RESTORE: ⟨8⟩
        case .UNDO: ⟨9⟩
        case: ⟨0⟩
    }
}

// An icon's SVG.
svg_of :: (drawn: Icons.Icon -> string) {
    return SVGS[drawn.index]
}

// The icon drawn in a colour, size pixels square, its top-left at at,
// turned angle radians clockwise about its middle (made once for a size,
// colour and angle, and kept).
draw_icon :: (canvas: *Draw.Canvas, drawn: Icons.Icon, at: Math.Vector2(f32), size: f32, colour: Draw.RGBA, angle: f32 = 0) {
    Icons.draw_svg(canvas, SVGS[drawn.index], at, size, colour, angle)
}