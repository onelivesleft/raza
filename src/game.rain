// The game: each player's life, and the damage each commander has done to
// each player.

STARTING_LIFE :: 40
LETHAL_COMMANDER_DAMAGE :: 21
LETHAL_POISON :: 10

// The attacks a player can make, in the order their icons stand: plain
// damage (always theirs, leftmost), then those they turn on in their
// options: commander damage (on to start with), commander damage with
// lifelink, lifelink, and poison.
Attack :: enum u8 {
    DAMAGE
    COMMANDER
    COMMANDER_LIFELINK
    LIFELINK
    POISON
    GAIN_ONE
    LOSE_ONE
    GAIN_TWO
    LOSE_TWO
}

// A player's attacks turned on: a bit for each, by Attack's value (DAMAGE's
// always set).
Attacks :: #alias u8
STARTING_ATTACKS :: Attacks'3                  // damage, and commander damage
EVERY_STARTING_ATTACKS :: [MAX_PLAYERS] Attacks⟨3, 3, 3, 3, 3, 3⟩

has_attack :: (attacks: Attacks, kind: Attack -> bool) #pure {
    if kind == .DAMAGE then return true
    // Plain damage was always enabled in saved games. Reuse its set bit
    // to mean LOSE_TWO is off, preserving the existing one-byte format.
    if kind == .LOSE_TWO then return attacks & 1 == 0
    return attacks & attack_bit(kind) != 0
}

attack_bit :: (kind: Attack -> Attacks) #pure {
    if kind == .LOSE_TWO then return 1
    return u8'1 << u8'kind
}

self_life_delta :: (kind: Attack -> i32) #pure {
    return if kind is {
    case .GAIN_ONE: 1
    case .LOSE_ONE: -1
    case .GAIN_TWO: 2
    case .LOSE_TWO: -2
    case .DAMAGE, .COMMANDER, .COMMANDER_LIFELINK, .LIFELINK, .POISON: 0
    }
}

// Whether an attack is its commander's combat damage (counting toward the 21
// from that commander), and whether it gives its attacker life (lifelink).
is_commander :: (kind: Attack -> bool) #pure {
    return kind == .COMMANDER or kind == .COMMANDER_LIFELINK
}

has_lifelink :: (kind: Attack -> bool) #pure {
    return kind == .COMMANDER_LIFELINK or kind == .LIFELINK
}

// A player's attacks turned on, in their order (plain damage first), and
// how many.
attacks_of :: (attacks: Attacks -> kinds: [9] Attack, count: i64) #pure {
    kinds = ⟨⟩
    count = 0
    for kind: [9] Attack⟨.GAIN_ONE, .LOSE_ONE, .GAIN_TWO, .LOSE_TWO, .DAMAGE, .COMMANDER, .COMMANDER_LIFELINK, .LIFELINK, .POISON⟩ {
        if !has_attack(attacks, kind) then continue
        kinds[count] = kind
        count += 1
    }
}

// Magic's five colours, in their order (WUBRG).
Mana :: enum u8 {
    WHITE
    BLUE
    BLACK
    RED
    GREEN
}

// A commander's colour identity: a bit for each colour, by Mana's value.
Identity :: #alias u8

has_colour :: (identity: Identity, colour: Mana -> bool) #pure {
    return identity & (u8'1 << u8'colour) != 0
}

// The identity of one colour alone.
mono :: (colour: Mana -> Identity) #pure {
    return u8'1 << u8'colour
}

// The way a seat's player faces, as an angle from the centre (y down).
facing_of :: (seat: Seat -> f32) #pure {
    return Math.atan2(seat.toward.y, seat.toward.x)
}

// The slots: each seat of a count is a slot, named by its starting colours
// (Reset's, which tell a count's slots apart; a slot's own colours are
// whatever its player has set). As the count comes down from six, a slot
// goes each time: GOING[n] names the one that goes from n to n - 1 (the
// artifact deck's, then white's, black's, green's); as it goes up, that slot
// comes back.
GOING :: [MAX_PLAYERS + 1] Identity⟨0, 0, 0, mono(.GREEN), mono(.BLACK), mono(.WHITE), 0⟩

// Which of a count's seats holds a slot's name (or colours), or -1.
seat_of :: (identity: [MAX_PLAYERS] Identity, count: i64, name: Identity -> i64) #pure {
    for c, k: identity[:count] { if c == name then return k }
    return -1
}

// Every one of the six players is kept, at the table or not: a game of n
// players has them at its places 0 to n - 1, a seat each, and those who've
// left at the places from n up, the last to leave first. A count's change
// moves them, as an order: order[k] is the place, before, of the player at
// k after.
Seating :: [MAX_PLAYERS] i64
SEATED_AS_THEY_ARE :: Seating⟨0, 1, 2, 3, 4, 5⟩

// The players moved from a count's lines (more) to one fewer's (fewer), as
// the lines' morph takes the seats: the seat going (its index among more's)
// is the one whose two lines meet in one, its player leaving to the first
// place off the table; each other seat's going to the seat it becomes.
seated_down :: (order: Seating, fewer: Splits, more: Splits, going: i64 -> next: Seating) #pure {
    doubled, turn := morph_choice(fewer, more, going)
    m := more.count
    next = order
    for i: 0 < m {
        if i != doubled then next[source_of(i, doubled)] = order[(i + turn) % m]
    }
    next[m - 1] = order[(doubled + turn) % m]
}

// ...and from a count's lines (fewer) up to one more's (more): the seat
// that's new (coming, its index among more's) the last player to leave,
// back as they were; each other seat's going to the seat it becomes.
seated_up :: (order: Seating, fewer: Splits, more: Splits, coming: i64 -> next: Seating) #pure {
    doubled, turn := morph_choice(fewer, more, coming)
    m := more.count
    next = order
    for i: 0 < m {
        if i != doubled then next[(i + turn) % m] = order[source_of(i, doubled)]
    }
    next[(doubled + turn) % m] = order[m - 1]
}

// Each seat's colours carried from a count's lines (more) to one fewer's
// (fewer), as seated_down moves the players.
carried_down :: (identity: [MAX_PLAYERS] Identity, fewer: Splits, more: Splits, going: i64 -> carried: [MAX_PLAYERS] Identity) #pure {
    order := seated_down(SEATED_AS_THEY_ARE, fewer, more, going)
    carried = ⟨⟩
    for k: 0 < MAX_PLAYERS { carried[k] = identity[order[k]] }
}

// A game with its players moved as an order says (each one's life, colours,
// and the damage each commander has done to each player), of a count.
reseated :: (game: Game, order: Seating, players: i64 -> moved: Game) #pure {
    moved = ⟨players: players⟩
    for k: 0 < MAX_PLAYERS {
        moved.life[k] = game.life[order[k]]
        moved.tax[k] = game.tax[order[k]]
        moved.poison[k] = game.poison[order[k]]
        moved.attacks[k] = game.attacks[order[k]]
        moved.identity[k] = game.identity[order[k]]
        for j: 0 < MAX_PLAYERS { moved.commander[k][j] = game.commander[order[k]][order[j]] }
    }
}

// The players who've left the table forgotten: each place off it a player
// at the starting life, with no damage done or taken, and the colours a
// reset gives that slot (colours's own places off the table).
forget_the_absent :: (game: *Game, colours: [MAX_PLAYERS] Identity) {
    for k: game.players < MAX_PLAYERS {
        game.life[k] = STARTING_LIFE
        game.tax[k] = 0
        game.poison[k] = 0
        game.attacks[k] = STARTING_ATTACKS
        game.identity[k] = colours[k]
        for j: 0 < MAX_PLAYERS {
            game.commander[k][j] = 0
            game.commander[j][k] = 0
        }
    }
}

// The colours the settings' Reset gives, seat by seat, for a count of
// players on a screen of a size (its lines where they start): each seat its
// slot's name. Six are, from the top seat round clockwise, white, blue,
// green, black, red and an artifact deck (no colours); six's top seat the
// one facing nearest straight up (of two as near, the one right of the top).
// Fewer are six's with slots taken away as GOING says, the rest carried as
// the lines' morph takes them (so the seat that goes is the one that's seen
// to go), and those off the table, as each left, their slots' names.
starting_colours ::(size: V2, players: i64 -> identity: [MAX_PLAYERS] Identity) #pure {
    // (within a step and a half of facing counts as as near: facings are
    // rounded to steps, so two places mirrored about the top may differ by one)
    six := lay_out(size, equal_splits(MAX_PLAYERS, size))
    up := -f32'Math.PI / 2
    *top: i64 = 0
    *least: f32 = 1e30
    for seat, k: six.seats[:MAX_PLAYERS] {
        turn := turn_between(up, facing_of(seat))
        off := Math.abs(turn)
        if off < least - f32'Math.TAU / 120 or (off < least + f32'Math.TAU / 120 and turn > 0) {
            least = off
            top = k
        }
    }
    from_top := [MAX_PLAYERS] Identity⟨mono(.WHITE), mono(.BLUE), mono(.GREEN), mono(.BLACK), mono(.RED), 0⟩
    identity = ⟨⟩
    for colours, i: from_top { identity[(top + i) % MAX_PLAYERS] = colours }
    *n: i64 = MAX_PLAYERS
    while n > Math.clamp(players, 2, MAX_PLAYERS) {
        identity = carried_down(identity, equal_splits(n - 1, size), equal_splits(n, size), seat_of(identity, n, GOING[n]))
        n -= 1
    }
}

Game :: struct {
    players:   i64 = 4
    life:      [MAX_PLAYERS] i32
    tax:       [MAX_PLAYERS] i32
    // commander[to][from]: what from's commander has done to to.
    commander: [MAX_PLAYERS] [MAX_PLAYERS] i32
    // Each player's commander's colours, as they've set them.
    identity:  [MAX_PLAYERS] Identity
    // Each player's poison counters, and the attacks they've turned on.
    poison:    [MAX_PLAYERS] i32
    attacks:   [MAX_PLAYERS] Attacks = EVERY_STARTING_ATTACKS
}

// A game begun: everyone at the starting life, no damage done, each seat's
// colours and attacks those it had before (the same decks, mostly, sit in
// the same seats).
new_game :: (players: i64, identity: [MAX_PLAYERS] Identity = ⟨⟩, attacks: [MAX_PLAYERS] Attacks = EVERY_STARTING_ATTACKS -> game: Game) #pure {
    game = ⟨players: Math.clamp(players, 2, MAX_PLAYERS), identity: identity, attacks: attacks⟩
    for *l: game.life { l = STARTING_LIFE }
}

// The game kept from the last run (Defaults', got with no players as its
// default), or a new game of four whose colours are still to be given
// (fresh): none was kept, or a build whose Game was another size kept it,
// which Defaults can't give back, so it gives the default.
kept_game :: (kept: Game -> game: Game, fresh: bool) #pure {
    fresh = kept.players < 2 or kept.players > MAX_PLAYERS
    game = if fresh then new_game(4) else kept
}

// Whether a player has lost: no life left, a commander's lethal damage, or
// lethal poison.
is_out :: (game: Game, player: i64 -> bool) #pure {
    if game.life[player] <= 0 or game.poison[player] >= LETHAL_POISON then return true
    for d: game.commander[player][:game.players] {
        if d >= LETHAL_COMMANDER_DAMAGE then return true
    }
    return false
}

// An attack of an amount from one player at another: damage takes life (a
// commander's counting toward LETHAL_COMMANDER_DAMAGE from it too), with
// lifelink giving the attacker as much; poison gives poison counters.
deal_attack :: (game: *Game, kind: Attack, from: i64, to: i64, amount: i32) {
    if amount <= 0 or from == to then return
    if kind == .POISON {
        game.poison[to] += amount
        return
    }
    game.life[to] -= amount
    if is_commander(kind) then game.commander[to][from] += amount
    if has_lifelink(kind) then game.life[from] += amount
}

// Commander damage from one player's commander to another (its combat
// damage, which counts toward LETHAL_COMMANDER_DAMAGE): it's life lost too.
deal :: (game: *Game, from: i64, to: i64, amount: i32) {
    game.deal_attack(.COMMANDER, from, to, amount)
}

// Damage that isn't commander damage (a spell's, an ability's, another
// creature's): life lost alone.
deal_spell :: (game: *Game, from: i64, to: i64, amount: i32) {
    game.deal_attack(.DAMAGE, from, to, amount)
}

// Progress from the region entry to the life total along the source-to-life
// line: equal slots, each amount 1 to 9 taking DRAG_SLOTS of them (the small
// amounts, the commonest, wider to hit: 1 three, 2 two, the rest one), then a
// number to pick (asked).
QUESTION_FROM :: 1.0
MOST_BY_DRAG :: 9
DRAG_SLOTS :: [MOST_BY_DRAG] i32⟨3, 2, 1, 1, 1, 1, 1, 1, 1⟩
DRAG_SLOT_COUNT :: slot_total(DRAG_SLOTS)

slot_total :: (slots: [MOST_BY_DRAG] i32 -> i32) #pure {
    *total: i32 = 0
    for s: slots { total += s }
    return total
}

Drag_Amount :: union {
    damage: i32
    asked
}

// A poison attack's drag: 1, 2 and 3 in equal slots, then a number to pick.
MOST_POISON_BY_DRAG :: 3

amount_for :: (share: f32, kind: Attack = .DAMAGE -> Drag_Amount) #pure {
    if share > QUESTION_FROM then return Drag_Amount.asked
    if kind == .POISON {
        third := i32'Math.floor(Math.max(share, 0) / QUESTION_FROM * f32'MOST_POISON_BY_DRAG)
        return Drag_Amount.damage(Math.clamp(third + 1, 1, MOST_POISON_BY_DRAG))
    }
    slot := i32'Math.floor(Math.max(share, 0) / QUESTION_FROM * f32'DRAG_SLOT_COUNT)
    *passed: i32 = 0
    for slots, i: DRAG_SLOTS {
        passed += slots
        if slot < passed then return Drag_Amount.damage(i32'i + 1)
    }
    return Drag_Amount.damage(MOST_BY_DRAG)
}
