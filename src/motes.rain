// The volleys that carry damage: a dot a point, each flying from the
// attacker's damage icon along a raised arc to the life total of whoever it
// hit, one after another, the life shown counting down a point as each
// lands and recoiling from it. (elements.rain draws them.)

// The point t of the way along a curve from a to c, pulled toward b.
curve_at :: (a: V2, b: V2, c: V2, t: f32 -> V2) #pure {
    return Math.mix(Math.mix(a, b, t), Math.mix(b, c, t), t)
}

// A volley retains its landed points briefly for recoil and loss labels.
Volley :: struct {
    id:     u32
    from:   i64
    to:     i64
    start:  V2
    bend:   V2
    end:    V2
    amount: i32
    landed: i32
    lethal: bool
    combat: bool       // commander damage (its combat damage); else damage, life alone
    age:    f32
}

Volleys :: struct {
    list:    [..] Volley
    next_id: u32 = 1
}

// A volley's times (seconds): gathering at its player's spot, each dot's
// flight along its arc, and about how long its points take to come off the
// life shown.
VOLLEY_GATHER :: 0.14
VOLLEY_TRAVEL :: 0.42
VOLLEY_LAND :: 0.36

// One bolt per point; large volleys finish launching within two seconds.
bolt_spacing :: (count: i64 -> f32) #pure {
    return Math.min(0.065, 2.0 / f32'Math.max(count - 1, 1))
}
// Small deterministic variations retain arrival order and reproducible replays.
bolt_delay :: (j: i64, count: i64 -> f32) #pure {
    return (f32'j + Math.sin(f32'j * 2.39996) * 0.22) * bolt_spacing(count)
}
volley_landing :: (v: Volley -> f32) #pure { return VOLLEY_GATHER + VOLLEY_TRAVEL }
volley_land :: (v: Volley -> f32) #pure { return bolt_delay(i64'Math.max(v.amount - 1, 0), i64'v.amount) }
volley_after :: (v: Volley -> f32) #pure { return volley_land(v) + 1.0 }
bolt_impact :: (v: Volley, j: i64 -> f32) #pure {
    return volley_landing(v) + bolt_delay(j, i64'v.amount)
}
bolt_bend :: (v: Volley, j: i64, cell: f32 -> V2) #pure {
    phase := f32'j * 2.39996 + f32'v.id * 1.73
    return v.bend + across_path(v.start, v.end) * (Math.sin(phase) * cell * 0.85) +
           V2⟨0, Math.cos(phase * 1.37) * cell * 0.55⟩
}
bolt_direction :: (v: Volley, j: i64, cell: f32 -> V2) #pure {
    delta := v.end - bolt_bend(v, j, cell)
    return if Math.length(delta) > 0.001 then Math.normalize(delta) else V2⟨0, 1⟩
}
// Damped spring impulses add for simultaneous hits, returning to rest.
life_recoil :: (volleys: Volleys, player: i64, cell: f32 -> offset: V2, turn: f32) #pure {
    offset = ⟨0, 0⟩
    turn = 0
    for v: volleys.list {
        if v.to != player then continue
        for j: 0 < i64'v.landed {
            age := v.age - bolt_impact(v, j)
            if age < 0 or age >= 1 then continue
            spring := Math.exp(0 - age * 8) * Math.sin(age * 32)
            offset += bolt_direction(v, j, cell) * (spring * cell * 0.24)
            turn += Math.sin(f32'j * 2.39996 + f32'v.id) * spring * 0.045
        }
    }
}

// Damage dealt as a volley: combat damage (commander damage: life, and the
// commander's count toward lethal), or a spell's (life alone). The game
// changed at once (so undo is as before), the volley thrown from the
// attacker's damage icon along an arc raised above the table to their life
// total, the life shown counting down as it lands (by pending, until it
// has). It's lethal when this commander damage made it so.
strike :: (game: *Game, volleys: *Volleys, layout: Layout, pending: *[MAX_PLAYERS] [MAX_PLAYERS] i32,
           from: i64, to: i64, amount: i32, combat := true) {
    if amount <= 0 or from == to then return
    was := game.commander[to][from]
    if combat { game.deal(from, to, amount) } else { game.deal_spell(from, to, amount) }
    lethal := combat and was < LETHAL_COMMANDER_DAMAGE and game.commander[to][from] >= LETHAL_COMMANDER_DAMAGE
    pending[to][from] += amount
    // (the path ends at their life total whatever the finger's over now)
    start := damage_icon(layout, from, combat)
    end := layout.seats[to].middle
    middle := (start + end) / 2
    bend := middle + V2⟨0, -Math.min(Math.length(end - start) * 0.45, cell_of(layout) * 3.5)⟩
    id := volleys.next_id
    volleys.next_id = if volleys.next_id >= 0xFFFF then 1 else volleys.next_id + 1
    `global volleys.list.add(⟨id: id, from: from, to: to, start: start, bend: bend, end: end, amount: amount, lethal: lethal,
                             combat: combat⟩)
}

// The volleys moved on a frame: each as it lands has its points come off
// what's pending over its landing, a point at a time; one whose last point
// landed a second ago (its recoil and "-1"s over) is done.
steer_volleys :: (volleys: *Volleys, pending: *[MAX_PLAYERS] [MAX_PLAYERS] i32, seconds: f32) {
    for *volley: volleys.list {
        landing := volley_landing(volley)
        volley.age += Math.max(seconds, 0)
        if volley.age >= landing {
            *should := volley.landed
            while should < volley.amount and volley.age >= bolt_impact(volley, i64'should) { should += 1 }
            newly := should - volley.landed
            if newly > 0 {
                pending[volley.to][volley.from] = Math.max(pending[volley.to][volley.from] - newly, 0)
                volley.landed = should
            }
        }
        if volley.age >= landing + volley_after(volley) then remove volley
    }
}

// The game as it's shown while volleys are in flight: what they'll do not
// yet done (the life they'll take, by pending; and a combat volley's
// commander damage, what of it hasn't landed).
shown_game :: (game: Game, pending: [MAX_PLAYERS] [MAX_PLAYERS] i32, volleys: Volleys = ⟨⟩ -> shown: Game) #pure {
    shown = game
    for to: 0 < MAX_PLAYERS {
        for from: 0 < MAX_PLAYERS { shown.life[to] += pending[to][from] }
    }
    for v: volleys.list {
        if v.combat then shown.commander[v.to][v.from] -= v.amount - v.landed
    }
}

// Every volley forgotten, and nothing pending (an undo, a new game).
call_off_volleys :: (volleys: *Volleys, pending: *[MAX_PLAYERS] [MAX_PLAYERS] i32) {
    volleys.list.clear()
    for *row: pending { for *p: row { p = 0 } }
}

// A volley of volley from from to to (combat damage, or a spell's) as it is
// volley_age seconds after it was thrown, stepped a sixtieth of a second at
// a time (for snapshots, the same each time).
settled_volleys :: (layout: Layout, game: Game, from: i64, to: i64, volley: i32, volley_age: f32, combat := true -> volleys: Volleys) {
    *thrown: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    *dealt := game
    strike(dealt, thrown, layout, pending, from, to, volley, combat)
    for _: 0 < i64'(volley_age * 60) { steer_volleys(thrown, pending, 1.0 / 60) }
    volleys = thrown
}
