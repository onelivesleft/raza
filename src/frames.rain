// How the parts look: in the manner of Magic's original card frames (1993
// to 2003: painterly, mottled and dark), each colour's frame a ground
// colour and a surface over it (Patterns': cracked rock for red, marble for
// black and gold, and so on), made as the screen's drawn, not copied from
// any card. A part of one colour is that colour's frame; of none, an
// artifact's; of several, gold, shaded across toward each of its colours in
// turn.

// A frame's look: its ground colour, and the surface over it, its features
// scale cells across.
Look :: struct {
    ground:   Draw.RGBA
    kind:     Patterns.Kind
    scale:    f32
    strength: f32
}

// The looks: an artifact's, each colour's, and gold's.
Looks :: struct {
    artifact: Look
    colours:  [Mana] Look
    gold:     Look
}

// A grey-brown artifact's grain, an ivory's soft clouds, water drops, black
// marble, cracked red rock, mottled green, marbled gold.
LOOKS :: Looks⟨
    ⟨Draw.rgb(0x9A8A76), .GRAIN, 1.0, 0.35⟩,
    ⟨⟨Draw.rgb(0xE6DFCA), .CLOUDS, 2.0, 0.22⟩, ⟨Draw.rgb(0x2A5E9A), .DROPS, 1.3, 0.45⟩, ⟨Draw.rgb(0x2A2521), .MARBLE, 1.8, 0.42⟩,
     ⟨Draw.rgb(0xB3442B), .CRACKS, 1.6, 0.42⟩, ⟨Draw.rgb(0x3A6C39), .MOTTLE, 1.3, 0.42⟩⟩,
    ⟨Draw.rgb(0xC29A3E), .MARBLE, 1.8, 0.32⟩
⟩

// The looks' feel, over them all: how much the slow variation larger than
// their features counts (broad: painterly swings), and how much fine grain
// is over it (rough).
SURFACE_BROAD :: 0.7
SURFACE_GRAIN :: 0.22

// How fast the surfaces move (a setting): still, or slowly to quickly.
Motion :: enum u8 {
    OFF
    SLOW
    MEDIUM
    FAST
}

MOTION_NAMES :: [Motion] string⟨"Off", "Slow", "Medium", "Fast"⟩

// Each speed, in a surface's features a second.
MOTION_RATES :: [Motion] f32⟨0, 0.04, 0.24, 1.05⟩

// How big the surfaces' features are against the looks' own scales (a
// card's frame is fine-grained for its size, and a part is far bigger).
SURFACE_SCALE :: 0.32

// How far gold leans toward each of a part's colours.
GOLD_TINT :: 0.06

// An artifact's colour (a colourless player's own colour).
ARTIFACT :: LOOKS.artifact.ground

////////////////////////////////
// A part's surface, drawn by a shader of its own

// What the part's shader is given: its outline (each point's xy), its
// colours across it (left to right as its player sees it), its life's
// middle and the screen's centre, the way toward its player and how far it
// reaches that way from the centre and which surface it is, its turn and
// its left and right (in its player's frame from its middle) and how many
// points; its surface (kind, features' scale in pixels, contrast, seed;
// time, broad, grain, how many colours); and whether it's out or targeted,
// its bevel's width (pixels) and how wide its noise's octaves go.
Part_Params :: struct {
    points: [MAX_OUTLINE] V4     // position, cumulative perimeter, edge length
    stops:  [5] V4
    middle: V4
    toward: V4
    frame:  V4
    look:   V4
    more:   V4
    lamp_colours: [5] V4
    hybrid_looks: [2] V4         // tile, pattern kind, strength, surface
    material: V4                 // atlas tile, feature scale, perimeter, reserved
    gold: Gold_Tuning
    state:  V4
}

// The light the parts are lit by: from the screen's top left (a frame's
// bevel lit on its edges facing it), warm, and their shade cool.
PART_LIGHT :: V2⟨-0.55, -0.83⟩
PART_WARM :: V3⟨1.0, 0.92, 0.76⟩
PART_COOL :: V3⟨0.5, 0.55, 0.74⟩

// A part's colour at a pixel: its colours across it; its surface lightening
// it toward a warm light and darkening it toward a cool shade (not white
// and black: a hue-shifted light and shade, as a painted frame has); darker
// toward its player's edge (a vignette, so the middle comes forward); and a bevel along
// its edges, lit where an edge faces the light and shaded where it faces
// away. Out, it's dimmed; aimed at, it lifts.
part_shade :: (from: Draw.Quad_Between, part: Shader.Uniforms(Part_Params), atlas: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    p := from.pixel
    n := i32'(part.frame.w + 0.5)
    // (inside by the even-odd rule, and how far from its nearest edge, and
    // that edge's way inward)
    *crossings: i32 = 0
    *closest: f32 = 1000000
    *groove_distance: f32 = 1000000
    *inward := V2⟨0, 0⟩
    for i: 0 < n {
        j := if i + 1 < n then i + 1 else 0
        a := part.points[i].xy
        b := part.points[j].xy
        if (a.y > p.y) != (b.y > p.y) {
            x := a.x + (p.y - a.y) / (b.y - a.y) * (b.x - a.x)
            if p.x < x then crossings += 1
        }
        ab := b - a
        t := Math.clamp(Math.dot(p - a, ab) / Math.max(Math.dot(ab, ab), 0.000001), 0, 1)
        d := Math.length(p - a - ab * t)
        closest = Math.min(closest, d)
        // Only the first and closing edges separate players; the rest border the screen.
        if (i == 0 or j == 0) and d < groove_distance {
            groove_distance = d
            *normal := Math.normalize(V2⟨0 - ab.y, ab.x⟩)
            if Math.dot(normal, part.middle.xy - a) < 0 then normal = normal * -1.0
            inward = normal
        }
    }
    signed := if crossings % 2 == 1 then 0 - closest else closest
    coverage := Math.clamp(0.5 - signed, 0, 1)
    if coverage <= 0 then return ⟨0, 0, 0, 0⟩
    // (its colours across it)
    angle := part.frame.x
    d := p - part.middle.xy
    local_x := d.x * Math.cos(angle) + d.y * Math.sin(angle)
    u := Math.clamp((local_x - part.frame.y) / Math.max(part.frame.z - part.frame.y, 1), 0, 1)
    stops := i32'(part.more.w + 0.5)
    *base := part.stops[0].xyz
    if stops > 1 {
        s := u * f32'(stops - 1)
        k := Math.min(i32'Math.floor(s), stops - 2)
        base = Math.mix(part.stops[k].xyz, part.stops[k + 1].xyz, s - f32'k)
    }
    shade := base * PART_COOL
    local_y := d.y * Math.cos(angle) - d.x * Math.sin(angle)
    tile := i32'(part.material.x + 0.5)
    *rgb := V3⟨0, 0, 0⟩
    if stops == 2 {
        left := part.hybrid_looks[0]
        right := part.hybrid_looks[1]
        left_look := V4⟨left.y, part.look.y, left.z, part.look.w⟩
        right_look := V4⟨right.y, part.look.y, right.z, part.look.w⟩
        // Centre the blend on the life total's local vertical axis, not
        // the midpoint of an asymmetric region's projected bounds.
        blend_half := Math.max((part.frame.z - part.frame.y) * 0.15, 1)
        blend := Math.smoothstep(0 - blend_half, blend_half, local_x)
        // (each side's material, as much of it as the blend takes: one call
        // in a loop, not one a side, so the material's code is in the stage
        // once, which the driver compiles in a fraction of the time)
        for side: 0 < 2 {
            weight := if side == 0 then 1 - blend else blend
            if weight > 0 {
                hybrid := part.hybrid_looks[side]
                look := if side == 0 then left_look else right_look
                rgb = rgb + shade_panel_material(p, local_x, local_y, part.stops[side].xyz, look, part.more, angle, hybrid.w, i32'hybrid.x, atlas, filtering) * weight
            }
        }
    }
    else {
        rgb = shade_panel_material(p, local_x, local_y, base, part.look, part.more, angle, part.toward.w, tile, atlas, filtering)
    }
    // (darker toward its player's edge)
    depth := Math.clamp(Math.dot(p - part.middle.zw, part.toward.xy) / Math.max(part.toward.z, 1), 0, 1)
    rgb = Math.mix(rgb, shade * 0.8, Math.smoothstep(0.55, 1.0, depth) * 0.32)
    // Shallow fixed undulations reflect moving studio lights in polished gold.
    *gold_polish: f32 = 0
    if tile == 6 and stops != 2 {
        at := V2⟨local_x, local_y⟩ / Math.max(part.look.y * part.gold.texture_scale, 1) + V2⟨part.look.w * 0.17, part.look.w * 0.31⟩
        texel := material_at(atlas, filtering, tile, at)
        luma := Math.dot(texel, V3⟨0.2126, 0.7152, 0.0722⟩)
        q := V2⟨local_x, local_y⟩ / Math.max(part.state.w * part.gold.surface_scale, 1)
        height_x := Math.dot(material_at(atlas, filtering, tile, at + V2⟨part.gold.texture_step, 0⟩), V3⟨0.2126, 0.7152, 0.0722⟩)
        height_y := Math.dot(material_at(atlas, filtering, tile, at + V2⟨0, part.gold.texture_step⟩), V3⟨0.2126, 0.7152, 0.0722⟩)
        slope := V2⟨Math.sin(q.x * part.gold.freq_x + q.y * part.gold.cross_x) * part.gold.wave_x + q.x * part.gold.slope_x,
                    Math.sin(q.y * part.gold.freq_y + q.x * part.gold.cross_y) * part.gold.wave_y + q.y * part.gold.slope_y⟩ + V2⟨height_x - luma, height_y - luma⟩ * part.gold.texture_slope
        normal := Math.normalize(V3⟨slope.x, slope.y, 1⟩)
        reflected := normal.xy * (2 * normal.z)
        env := reflected - V2⟨part.gold.speed_x, part.gold.speed_y⟩ * part.more.x
        key_offset := Math.fract((env - V2⟨part.gold.key_x, part.gold.key_y⟩) / part.gold.repeat + V2⟨0.5, 0.5⟩) * part.gold.repeat - V2⟨part.gold.repeat * 0.5, part.gold.repeat * 0.5⟩
        box := Math.abs(key_offset / V2⟨part.gold.key_width, part.gold.key_height⟩)
        key := 1 - Math.smoothstep(part.gold.key_soft_start, part.gold.key_soft_end, Math.max(box.x, box.y))
        spill := Math.exp(0 - Math.dot(box, box) * part.gold.spill_width)
        rim_offset := Math.fract((env - V2⟨part.gold.rim_x, part.gold.rim_y⟩) / part.gold.repeat + V2⟨0.5, 0.5⟩) * part.gold.repeat - V2⟨part.gold.repeat * 0.5, part.gold.repeat * 0.5⟩
        rim := rim_offset / V2⟨part.gold.rim_width, part.gold.rim_height⟩
        glint := Math.exp(0 - Math.dot(rim, rim) * part.gold.rim_tightness)
        // Tight ivory cores sit over the existing reflections without lowering the base.
        core := Math.exp(0 - Math.dot(box, box) * part.gold.core_tightness)
        gold_polish = Math.clamp(core * part.gold.core_strength + glint * part.gold.rim_strength, 0, part.gold.polish_limit)
        highlights := V3⟨part.gold.spill_r, part.gold.spill_g, part.gold.spill_b⟩ * spill + V3⟨part.gold.key_r, part.gold.key_g, part.gold.key_b⟩ * key + V3⟨part.gold.glint_r, part.gold.glint_g, part.gold.glint_b⟩ * glint
        // Broad warm environment fill lifts the metal between the sharp reflections.
        ambient := V3⟨part.gold.ambient_r, part.gold.ambient_g, part.gold.ambient_b⟩ * part.gold.ambient_strength * (1 - part.gold.ambient_shape + normal.z * part.gold.ambient_shape)
        rgb = ambient + highlights
    }
    // Each colour owns an equal arc length of the polygon's perimeter.
    // Split at corners, so every strip follows the real boundary.
    if stops > 2 {
        *radiance := V3⟨0, 0, 0⟩
        *energy: f32 = 0
        strip_length := part.material.z / f32'stops
        reach := Math.max(part.state.w * part.gold.strip_reach, 1)
        for i: 0 < stops {
            start := f32'i * strip_length
            finish := start + strip_length
            *distance: f32 = 1000000
            for edge: 0 < n {
                next := if edge + 1 < n then edge + 1 else 0
                info := part.points[edge]
                lo := Math.max(start, info.z)
                hi := Math.min(finish, info.z + info.w)
                if hi > lo {
                    direction := (part.points[next].xy - info.xy) / Math.max(info.w, 0.0001)
                    a := info.xy + direction * (lo - info.z)
                    length := hi - lo
                    along := Math.clamp(Math.dot(p - a, direction), 0, length)
                    distance = Math.min(distance, Math.length(p - a - direction * along))
                }
            }
            falloff := Math.exp(0 - Math.pow(distance / reach, part.gold.strip_falloff))
            radiance = radiance + part.lamp_colours[i].xyz * falloff
            energy += falloff
        }
        tint := radiance / Math.max(energy, 0.0001)
        brightness := Math.dot(rgb, V3⟨0.2126, 0.7152, 0.0722⟩)
        tint_luma := Math.dot(tint, V3⟨0.2126, 0.7152, 0.0722⟩)
        lit := tint * (brightness / Math.max(tint_luma, part.gold.strip_dark_floor))
        rgb = Math.mix(rgb, lit, Math.min(energy * part.gold.strip_strength, part.gold.strip_limit))
    }
    // Keep the sharpest reflections luminous even under coloured strip lighting.
    rgb = Math.mix(rgb, Math.max(rgb, V3⟨part.gold.polish_r, part.gold.polish_g, part.gold.polish_b⟩), gold_polish)
    // A smooth recessed channel: dark floor, curved walls, soft rolled lip.
    // Each panel shades its half, so adjacent regions share one groove.
    bevel := part.state.z
    if groove_distance < bevel {
        across := Math.clamp(groove_distance / bevel, 0, 1)
        wall := Math.sin(across * f32'Math.PI)
        facing := Math.dot(inward * -1.0, PART_LIGHT)
        floor := (1 + Math.cos(across * f32'Math.PI)) * 0.5
        rgb = rgb * (1 - floor * 0.68)
        rgb = rgb * (1 + Math.min(facing, 0) * wall * 0.48)
        rgb = Math.mix(rgb, PART_WARM, Math.max(facing, 0) * wall * 0.38)
        // A narrow bronze insert occupies only the floor; the old rolled edges remain.
        inset := 1 - Math.smoothstep(0.12, 0.30, across)
        bronze := V3⟨0.58, 0.38, 0.19⟩ * (0.72 + Math.max(facing, 0) * wall * 0.3)
        rgb = Math.mix(rgb, bronze, inset)
        // The cosine bowl meets both its floor and the surface with zero slope.
    }
    // (out, dimmed; aimed at, lifted)
    rgb = Math.mix(rgb, V3⟨0.075, 0.075, 0.094⟩, part.state.x * 0.7)
    rgb = Math.mix(rgb, V3⟨1, 1, 1⟩, part.state.y * 0.12)
    colour = V4⟨rgb.x * coverage, rgb.y * coverage, rgb.z * coverage, coverage⟩
}

// Sunny open water: fine broken ripples and sparse sun glints, observed in
// Order of the Sinking Star's published sunny-water screenshots. Several
// noise fields evolve against each other; no regular sine-wave mesh.
open_water_at :: (at: V2, base: V3, scale: f32, seed: f32, time: f32 -> V3) {
    q := at / Math.max(scale * 2.8, 1)
    coarse := Patterns.layered(q * 0.13 + V2⟨seed, 0⟩, 4)
    cloud := Patterns.layered(q * 0.24 + V2⟨time * 0.08, seed - time * 0.045⟩, 4)
    warp := Patterns.layered(q * 0.7 + V2⟨0 - time * 0.18, time * 0.11⟩, 3)
    ripple := Patterns.layered(V2⟨q.x * 2.85 + q.y * 0.15, q.y * 3.16 + warp * 1.7⟩ + V2⟨time * 0.13, time * 0.24⟩, 3)
    crossing := Patterns.noise(V2⟨q.x * 5.5 - q.y * 0.2, q.y * 6⟩ + V2⟨0 - time * 0.23, time * 0.16⟩)
    broken := Math.smoothstep(0.4, 0.7, crossing)
    crest := (1 - Math.smoothstep(0.008, 0.032, Math.abs(ripple - 0.54))) * broken
    glint := Math.smoothstep(0.63, 0.8, ripple) * Math.smoothstep(0.62, 0.85, crossing)
    sun := Math.smoothstep(0.43, 0.66, cloud)
    deep := Math.mix(base * V3⟨0.55, 0.8, 0.9⟩, V3⟨0.055, 0.35, 0.41⟩, coarse * 0.65)
    sky := V3⟨0.3, 0.51, 0.62⟩
    water := Math.mix(deep, sky, sun * 0.28) * (0.91 + ripple * 0.18)
    // Broad drifting clouds reflected in the surface, gently broken by its ripples.
    cloud_at := q * 0.32 + V2⟨time * 0.035 + seed * 3.1, seed - time * 0.018⟩ +
        V2⟨ripple - 0.5, crossing - 0.5⟩ * 0.075
    cloud_body := Patterns.layered(cloud_at, 4)
    cloud_cover := Math.smoothstep(0.46, 0.65, cloud_body)
    cloud_top := Math.smoothstep(0.52, 0.72, cloud_body)
    cloud_colour := Math.mix(V3⟨0.36, 0.49, 0.57⟩, V3⟨0.81, 0.87, 0.88⟩, cloud_top)
    reflected := Math.mix(water, cloud_colour, cloud_cover * 0.55)
    return reflected + V3⟨0.48, 0.66, 0.69⟩ * crest * (0.025 + sun * 0.07) + V3⟨0.95, 0.95, 0.83⟩ * glint * (0.12 + sun * 0.4)
}

Part_Surface :: shader { vertex: Draw.quad_place; fragment: part_shade }
PART_SURFACE :: Part_Surface(Draw.SHADER_TARGET)

// How wide a part's bevel is, in cells.
BEVEL_CELLS :: 0.075

// A part drawn by its shader: its colours across it and its surface
// (part_fill's), out or aimed at.
draw_part :: (canvas: *Draw.Canvas, layout: Layout, k: i64, colours: [] Draw.RGBA, pattern: Draw.Pattern, surface: Surface, identity: Identity, out: bool, targeted: bool) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    points := seat.outline[:seat.count]
    *params: Part_Params
    params.gold = gold_tuning
    *low := points[0]
    *high := points[0]
    *perimeter: f32 = 0
    for q, i: points {
        next := if i + 1 < points.count then i + 1 else 0
        length := Math.length(points[next] - q)
        params.points[i] = V4⟨q.x, q.y, perimeter, length⟩
        perimeter += length
        low = Math.min(low, q)
        high = Math.max(high, q)
    }
    *left: f32 = 1e30
    *right: f32 = -1e30
    for q: points {
        l := local_of(seat.middle, seat.angle, q)
        left = Math.min(left, l.x)
        right = Math.max(right, l.x)
    }
    for c, i: colours[:Math.min(colours.count, 5)] { params.stops[i] = V4⟨c.r, c.g, c.b, 1⟩ }
    // (two colours: each half's own look; three or more: gold, lit by a
    // perimeter strip of each colour, which the shader reads only then)
    if colours.count > 1 {
        *lamp: i64 = 0
        for mana: [5] Mana⟨.WHITE, .BLUE, .BLACK, .RED, .GREEN⟩ {
            if !has_colour(identity, mana) then continue
            if colours.count == 2 {
                look := LOOKS.colours[mana]
                *hybrid_surface: Surface = .PATTERN
                if mana == .BLUE then hybrid_surface = .WATER
                else if mana == .GREEN then hybrid_surface = .FOREST
                params.hybrid_looks[lamp] = V4⟨f32'u8'mana, f32'i32'look.kind, look.strength * SURFACE_QUIET, f32'u8'hybrid_surface⟩
                lamp += 1
                continue
            }
            tint := gold_hue(mana)
            params.lamp_colours[lamp] = V4⟨tint.r, tint.g, tint.b, 1⟩
            lamp += 1
        }
    }
    params.middle = V4⟨seat.middle.x, seat.middle.y, layout.centre.x, layout.centre.y⟩
    params.toward = V4⟨seat.toward.x, seat.toward.y, Math.max(seat.reach, 1), f32'u8'surface⟩
    params.frame = V4⟨seat.angle, left, right, f32'seat.count⟩
    params.look = V4⟨f32'i32'pattern.kind, pattern.scale, pattern.strength, pattern.seed⟩
    params.more = V4⟨pattern.time, pattern.broad, pattern.grain, f32'Math.min(colours.count, 5)⟩
    dimmed: f32 = if out then 1 else 0
    lifted: f32 = if targeted then 1 else 0
    params.state = V4⟨dimmed, lifted, BEVEL_CELLS * cell, cell⟩
    tile := material_tile(identity)
    params.material = V4⟨f32'tile, 0, perimeter, 0⟩
    canvas.draw_shader_image(low, high - low, PART_SURFACE.code, PART_SURFACE.bindings.part, params, material_image, PART_SURFACE.bindings.atlas, PART_SURFACE.bindings.filtering)
}

////////////////////////////////
// The parts' surfaces kept: a part's shader is the costliest thing drawn
// (its materials, over a quarter of the screen or more), and its surface
// moves slowly, so the surfaces are kept in a canvas of their own, a part's
// drawn again each frame in turn, those whose surface has moved since they
// were (none while the surfaces are still); and all of them when anything
// else they show changes (the screen's size, the lines, a part's colours,
// who's out or aimed at).

Surface_Key :: struct {
    size:     V2
    splits:   Splits
    count:    i64
    identity: [MAX_PLAYERS] Identity
    out:      [MAX_PLAYERS] bool
    tuning_revision: i64
    targeted: i64
}

Kept_Surfaces :: struct {
    canvas:   Draw.Canvas
    made:     bool
    key:      Surface_Key
    drawn_at: [MAX_PLAYERS] f32        // the surfaces' time each part was drawn at
    next:     i64                      // the part to look at first next
}

kept_surfaces: Kept_Surfaces

// The parts' surfaces brought up to date in their canvas: whether they're
// there to draw (false: no canvas could be made, so each part's drawn as it
// is).
keep_surfaces :: (layout: Layout, game: Game, targeted: i64, time: f32 -> bool) {
    size := Wide.i32x2⟨i32'Math.round(layout.size.x), i32'Math.round(layout.size.y)⟩
    if !kept_surfaces.made or kept_surfaces.canvas.size != size {
        if kept_surfaces.made then kept_surfaces.canvas.destroy()
        kept_surfaces.made = false
        if made := Draw.create_canvas(size) { kept_surfaces.canvas = made } else if os_error { return false }
        kept_surfaces.made = true
        kept_surfaces.key = ⟨count: -1⟩
    }
    *key := Surface_Key⟨size: layout.size, splits: layout.splits, count: layout.count, identity: game.identity, targeted: targeted, tuning_revision: gold_tuning_revision⟩
    for k: 0 < layout.count { key.out[k] = is_out(game, k) }
    if key != kept_surfaces.key {
        kept_surfaces.canvas.clear(BACKGROUND)
        for k: 0 < layout.count {
            draw_surface(kept_surfaces.canvas, layout, game, k, targeted, time)
            kept_surfaces.drawn_at[k] = time
        }
        kept_surfaces.key = key
        return true
    }
    for _: 0 < layout.count {
        k := kept_surfaces.next % layout.count
        kept_surfaces.next += 1
        if kept_surfaces.drawn_at[k] != time {
            draw_surface(kept_surfaces.canvas, layout, game, k, targeted, time)
            kept_surfaces.drawn_at[k] = time
            break
        }
    }
    return true
}

// A part's surface, its colours' and its surface's at a time, out or aimed
// at as it is.
draw_surface :: (canvas: *Draw.Canvas, layout: Layout, game: Game, k: i64, targeted: i64, time: f32) {
    *colours: [Draw.MAX_GRADIENT_COLOURS] Draw.RGBA
    n, pattern, surface := part_fill(game.identity[k], cell_of(layout), k, time, layout.seats[k].angle, colours)
    draw_part(canvas, layout, k, colours[:n], pattern, surface, game.identity[k], is_out(game, k), k == targeted)
}

// What a part's surface is: its look's pattern, open water seen from above
// (blue's), rusting metal (an artifact's), or a forest floor (green's).
Surface :: enum u8 {
    PATTERN
    WATER
    RUST
    FOREST
}

// A part's fill, for its player's colours: its gradient's colours (into,
// how many), its surface (features sized in pixels, cell's share, seeded by
// its seat so neighbours differ, moved to time, turned to face its player
// as their text is: its water falls toward them), and which.
part_fill :: (identity: Identity, cell: f32, seat: i64, time: f32, angle: f32, into: [] *Draw.RGBA -> count: i64, pattern: Draw.Pattern,
              surface: Surface) #pure {
    surface = .PATTERN
    looks := LOOKS
    *colours: i64 = 0
    *only := Mana.WHITE
    for _, colour: looks.colours {
        if has_colour(identity, colour) {
            colours += 1
            only = colour
        }
    }
    *look := looks.artifact
    count = 0
    if colours >= 2 {
        // Gold, shaded across toward each colour (WUBRG).
        look = looks.gold
        for each, colour: looks.colours {
            if has_colour(identity, colour) {
                into[count] = if colours == 2 then each.ground else Math.mix(look.ground, each.ground, GOLD_TINT)
                count += 1
            }
        }
    }
    else {
        if colours == 1 then look = looks.colours[only]
        // (one colour: its ground, lit and shaded by its surface; blue's
        // open water, green's a forest floor, none's rusting metal)
        into[0] = look.ground
        count = 1
        if colours == 0 then surface = .RUST
        else if only == .BLUE then surface = .WATER
        else if only == .GREEN then surface = .FOREST
    }
    // (every part's features one size, and quieter than the looks' own
    // contrast: the surface stays behind what's on it)
    pattern = ⟨kind: look.kind, scale: SURFACE_FEATURES * SURFACE_SCALE * cell, strength: look.strength * SURFACE_QUIET, seed: f32'(seat + 1), time: time,
               angle: angle, broad: SURFACE_BROAD, grain: SURFACE_GRAIN⟩
}

// The features' size (against SURFACE_SCALE), one for every part, and how
// much of a look's contrast a part's surface keeps.
SURFACE_FEATURES :: 1.5
SURFACE_QUIET :: 0.6

// Feathered mineral deposits follow a fixed, folded grain. Time changes
// their breadth and local density; neither the grain nor stone slides.
living_marble :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, q: V2, time: f32, seed: f32 -> V3) {
    uv := q * 0.18 + V2⟨seed * 0.17, seed * 0.31⟩
    mineral := material_at(atlas, filtering, 0, uv)
    detail := Math.dot(mineral, V3⟨0.2126, 0.7152, 0.0722⟩)
    cloud := Patterns.layered(q * 2.7 + V2⟨seed, 3.1⟩, 4)
    grain := Patterns.layered(q * 23 + V2⟨seed, 1.7⟩, 3)
    mineral_variation := Math.clamp((detail - 0.65) * 0.26, -0.06, 0.07)
    ivory := V3⟨0.965, 0.945, 0.895⟩ * (0.92 + cloud * 0.08 + mineral_variation)
    warmth := Math.clamp((mineral.x - mineral.z) * 0.5, 0, 0.12)
    stone := Math.mix(ivory, ivory * V3⟨1.0, 0.94, 0.83⟩, warmth + (1 - cloud) * 0.12)
    fold := Patterns.layered(q * 0.8 + V2⟨seed, 0⟩, 5)
    branches := Patterns.layered(q * 4.5 + V2⟨1.7, seed⟩, 4)
    band := Math.abs(Math.sin(q.x * 1.3 + q.y * 2.2 + fold * 9 + branches * 1.2))
    front := Patterns.layered(q * 0.65 + V2⟨seed, 8.1⟩, 3)
    growth := 0.5 + 0.5 * Math.sin(time * (2.4 / 3.0) + front * 8)
    width := 0.035 + growth * (0.08 + branches * 0.28)
    deposit := 1 - Math.smoothstep(width * 0.2, width + 0.24, band + (grain - 0.5) * 0.24)
    threads := 1 - Math.smoothstep(0.018, 0.09, band + (grain - 0.5) * 0.10)
    // The authored mineral grain supplies granular inclusions, not black-tile seams.
    inclusions := Math.clamp((0.85 - detail) * 1.4, 0, 0.45)
    fine_band := Math.abs(Math.sin(q.x * 4.7 - q.y * 2.8 + fold * 13 + branches * 4))
    fine := (1 - Math.smoothstep(0.015, 0.12, fine_band)) * Math.smoothstep(0.35, 0.65, branches)
    density := 0.45 + cloud * 0.65
    veins := (deposit * (0.16 + growth * 0.24) + threads * growth * 0.12) * density + fine * growth * 0.13
    return Math.mix(stone, V3⟨0.63, 0.64, 0.61⟩, Math.clamp(veins + inclusions * (0.35 + growth * 0.30), 0, 0.65))
}

// Fixed rock plates, with cracks propagating along their branching boundaries.
// Time changes the fracture front and aperture, never the rock's coordinates.
living_cracks :: (q: V2, time: f32, seed: f32, base: V3 -> V3) {
    bend := V2⟨Patterns.layered(q * 1.7 + V2⟨seed, 0⟩, 3), Patterns.layered(q * 1.7 + V2⟨3.3, seed⟩, 3)⟩ - V2⟨0.5, 0.5⟩
    rock := q + bend * 0.7
    cells := Patterns.cells(rock)
    boundary := cells.y - cells.x
    front := Patterns.layered(rock * 0.65 + V2⟨seed, 4.4⟩, 3)
    cycle := 0.5 + 0.5 * Math.sin(time * (2.2 / 3.0) + front * 9 + seed)
    growth := Math.smoothstep(front - 0.12, front + 0.12, cycle)
    width := 0.003 + growth * 0.045
    crack := (1 - Math.smoothstep(width * 0.3, width, boundary)) * growth
    rim := (1 - Math.smoothstep(width, width + 0.025, boundary)) * growth
    grain := Patterns.layered(q * 7 + V2⟨seed, 1.9⟩, 3)
    plate := base * (0.95 + grain * 0.10)
    lit := plate + V3⟨0.10, 0.035, 0.012⟩ * rim
    return Math.mix(lit, base * V3⟨0.32, 0.26, 0.23⟩, crack * 0.85)
}
// Warm old artifact metal; corrosion follows granular material detail,
// with a soft, irregular growing front instead of outlined painted islands.
living_artifact :: (q: V2, texture: V3, time: f32, seed: f32 -> V3) {
    detail := Math.dot(texture, V3⟨0.2126, 0.7152, 0.0722⟩)
    grain := Patterns.layered(q * 7 + V2⟨seed, 0⟩, 3)
    bend := Patterns.layered(q * 0.8 + V2⟨seed, 2.7⟩, 3)
    reflection := Math.fract(q.x * 0.19 + q.y * 0.11 + bend * 0.16 - time * 0.08)
    shine := Math.exp(0 - (reflection - 0.42) * (reflection - 0.42) * 850)
    broad := Math.exp(0 - (reflection - 0.54) * (reflection - 0.54) * 35)
    // (the artifact's ground, 0x9A8A76: ARTIFACT)
    metal := V3⟨0.68, 0.40, 0.19⟩ * (0.34 - detail * 0.15 + grain * 0.05 - broad * 0.06 - shine * 0.045)
    growth := Patterns.layered(q * 0.6 + V2⟨time * 0.16, seed - time * 0.11⟩, 4)
    weather := Patterns.layered(q * 2.8 + V2⟨seed, 0⟩, 5) * 0.55 + grain * 0.25 + growth * 0.35
    rust := Math.smoothstep(0.46, 0.7, weather)
    pits := Math.smoothstep(0.58, 0.78, grain) * rust
    corrosion := Math.mix(texture * V3⟨0.72, 0.45, 0.26⟩, V3⟨0.30, 0.13, 0.052⟩, 0.4) * (0.75 + grain * 0.5)
    return Math.mix(metal, corrosion, rust * 0.85) * (1 - pits * 0.28)
}

// Anchored offset copies of the same forest tile. Only their local opacity
// changes: bright leaf detail is revealed within independently fading patches.
layered_forest :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, uv: V2, time: f32, seed: f32 -> V3) {
    *rgb := material_at(atlas, filtering, 4, uv)
    for i: 0 < 3 {
        salt := f32'i + seed * 0.37
        offset := V2⟨0.213 + f32'i * 0.317, 0.371 + f32'i * 0.193⟩
        at := uv + offset
        copy := material_at(atlas, filtering, 4, at)
        patch := Patterns.layered(at * 13 + V2⟨salt, 2.7⟩, 3)
        phase := Patterns.layered(at * 5 + V2⟨3.1, salt⟩, 3) * 9
        life := 0.5 + 0.5 * Math.sin(time * (0.19 + f32'i * 0.037) + phase + salt * 2)
        reveal := Math.smoothstep(0.40, 0.68, patch + (life - 0.5) * 0.42)
        detail := Math.dot(copy, V3⟨0.2126, 0.7152, 0.0722⟩)
        leaf := Math.smoothstep(0.08, 0.24, detail)
        alpha := reveal * leaf * 0.72
        rgb = Math.mix(rgb, copy, alpha)
    }
    return rgb
}


// Shared by single-colour panels and both halves of a hybrid panel.
shade_panel_material :: (p: V2, local_x: f32, local_y: f32, base: V3, look: V4, more: V4, angle: f32, surface: f32, tile: i32, atlas: Shader.Texture_2D, filtering: Shader.Sampler -> V3) {
    // These solid materials bypass the old moving pattern/light overlay entirely.
    if tile == 0 then return living_marble(atlas, filtering, V2⟨local_x, local_y⟩ * 2 / Math.max(look.y * 5, 1), more.x, look.w)
    if tile == 3 then return living_cracks(V2⟨local_x, local_y⟩ / Math.max(look.y, 1), more.x, look.w, base)
    light := Math.mix(base, PART_WARM, 0.55)
    shade := base * PART_COOL
    // (its surface: a forest floor, rusting metal, open water, or its look's pattern lighting
    // and shading it; the first two in its player's frame)
    *rgb := base
    if surface > 2.5 {
        rgb = base * 0.8
    }
    else if surface > 1.5 {
        rgb = base * 0.85
    }
    else if surface > 0.5 {
        rgb = open_water_at(V2⟨local_x, local_y⟩, base, look.y, look.w, more.x)
    }
    else {
        // (marble's: the only kind that's a pattern here, black's and gold's;
        // white and red are materials of their own, returned above, blue's
        // water, green's forest and an artifact's rust its surfaces; a kind
        // known while compiling leaves the other kinds' code out of the stage,
        // which compiled for seconds on some drivers)
        v := Patterns.at(.MARBLE, p, look.y, look.w, more.x, angle, more.y, more.z)
        t := Math.clamp((v - 0.5) * 2, -1, 1) * look.z
        rgb = if t > 0 then Math.mix(base, light, t) else Math.mix(base, shade, 0 - t)
    }
    // Authored detail under animated lighting, in the player's frame.
    // Water is entirely procedural; solid material detail stays anchored.
    at := V2⟨local_x, local_y⟩ / Math.max(look.y * 18, 1) + V2⟨look.w * 0.17, look.w * 0.31⟩
    texel := if tile == 4 then layered_forest(atlas, filtering, at, more.x, look.w) else material_at(atlas, filtering, tile, at)
    // Retain identity tint (especially multicolour gold) rather than painting
    // the atlas's colour over the panel's chosen identity.
    luma := Math.dot(texel, V3⟨0.2126, 0.7152, 0.0722⟩)
    *authored := Math.mix(base, texel, 0.4)
    if tile == 6 then authored = base * (0.65 + luma * 0.7)
    if surface > 2.5 { authored = texel * V3⟨0.8, 1.12, 0.75⟩ }
    else if surface > 1.5 { authored = Math.mix(base * (0.55 + luma), texel, 0.65) }
    else if surface > 0.5 { authored = Math.mix(base, texel, 0.8) }
    weight: f32 = if surface > 0.5 then 0.78 else 0.62
    if tile != 1 and tile != 3 then rgb = Math.mix(rgb, authored, weight * (0.65 + more.y * 0.5))
    // Slow canopy/cloud shadow gives depth without sliding solid materials.
    illumination := Patterns.layered(at * 1.6 + V2⟨more.x * 0.04, 0⟩, 3)
    if tile != 1 and tile != 3 then rgb = rgb * (0.92 + 0.16 * illumination)
    // Contrast only: preserve the original moving pattern and illumination.
    if tile == 2 then rgb = Math.max((rgb - V3⟨0.16, 0.16, 0.16⟩) * 1.35 + V3⟨0.16, 0.16, 0.16⟩, V3⟨0.006, 0.006, 0.006⟩)
    // These materials evolve in place rather than sliding a photograph.
    if tile == 5 {
        rgb = living_artifact(V2⟨local_x, local_y⟩ / Math.max(look.y * 5, 1), texel, more.x, look.w)
    }
    return rgb
}

hybrid_fills_use_their_own_colours :: () #test {
    for a: 0 < 5 {
        for b: a + 1 < 5 {
            *colours: [5] Draw.RGBA
            identity := (u8'1 << u8'a) | (u8'1 << u8'b)
            count, _, _ := part_fill(identity, 100, 0, 0, 0, colours[:])
            assert(count == 2)
            assert(colours[0] == LOOKS.colours[Mana'u8'a].ground)
            assert(colours[1] == LOOKS.colours[Mana'u8'b].ground)
        }
    }
}