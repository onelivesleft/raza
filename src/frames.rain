// How the parts look: in the manner of Magic's original card frames (1993
// to 2003: painterly, mottled and dark), each colour's frame a ground
// colour and a surface over it (Patterns': cracked rock for red, marble for
// black and gold, and so on), made as the screen's drawn, not copied from
// any card. A part of one colour is that colour's frame; of none, an
// artifact's; of several, gold, shaded across toward each of its colours in
// turn.

// A frame's look: its ground colour, and the surface over it, its features
// scale cells across.
Look :: struct {
    ground:   Draw.RGBA
    kind:     Patterns.Kind
    scale:    f32
    strength: f32
}

// The looks: an artifact's, each colour's, and gold's.
Looks :: struct {
    artifact: Look
    colours:  [Mana] Look
    gold:     Look
}

// A grey-brown artifact's grain, an ivory's soft clouds, water drops, black
// marble, cracked red rock, mottled green, marbled gold.
LOOKS :: Looks⟨
    ⟨Draw.rgb(0x9A8A76), .GRAIN, 1.0, 0.35⟩,
    ⟨
        WHITE: ⟨Draw.rgb(0xE6DFCA), .CLOUDS, 2.0, 0.22⟩,
        BLUE: ⟨Draw.rgb(0x2A5E9A), .DROPS, 1.3, 0.45⟩,
        BLACK: ⟨Draw.rgb(0x2A2521), .MARBLE, 1.8, 0.42⟩,
        RED: ⟨Draw.rgb(0xB3442B), .CRACKS, 1.6, 0.42⟩,
        GREEN: ⟨Draw.rgb(0x3A6C39), .MOTTLE, 1.3, 0.42⟩,
    ⟩,
    ⟨Draw.rgb(0xC29A3E), .MARBLE, 1.8, 0.32⟩
⟩

// The looks' feel, over them all: how much the slow variation larger than
// their features counts (broad: painterly swings), and how much fine grain
// is over it (rough).
SURFACE_BROAD :: 0.7
SURFACE_GRAIN :: 0.22

// How fast the surfaces move (a setting): still, or slowly to quickly.
Motion :: enum u8 {
    OFF
    SLOW
    MEDIUM
    FAST
}

MOTION_NAMES :: [Motion] string⟨OFF: "Off", SLOW: "Slow", MEDIUM: "Medium", FAST: "Fast"⟩

// Each speed, in a surface's features a second.
MOTION_RATES :: [Motion] f32⟨OFF: 0, SLOW: 0.04, MEDIUM: 0.24, FAST: 1.05⟩

// How big the surfaces' features are against the looks' own scales (a
// card's frame is fine-grained for its size, and a part is far bigger).
SURFACE_SCALE :: 0.32

// How far gold leans toward each of a part's colours.
GOLD_TINT :: 0.06

// An artifact's colour (a colourless player's own colour).
ARTIFACT :: LOOKS.artifact.ground

////////////////////////////////
// A part's surface, drawn by a shader of its own

// The gold background's look, as its shader is given it: its surface's
// relief and ripples, the reflections moving over it (a main light, its
// spill and glints, and their polish), the light its ambient gives, and the
// perimeter strip's light in each colour's hue.
Gold_Look :: struct {
    texture_step: f32 = 0.008
    strip_falloff: f32 = 2.0
    ambient_r: f32 = 0.72
    ambient_g: f32 = 0.56
    ambient_b: f32 = 0.27
    ambient_strength: f32 = 1.0
    ambient_shape: f32 = 0.15
    surface_scale: f32 = 4.0
    texture_scale: f32 = 18.0
    texture_slope: f32 = 0.12
    slope_x: f32 = 0.12
    slope_y: f32 = 0.12
    wave_x: f32 = 0.09
    wave_y: f32 = 0.07
    freq_x: f32 = 2.1
    freq_y: f32 = 1.7
    cross_x: f32 = 0.7
    cross_y: f32 = -0.6
    speed_x: f32 = 0.0528
    speed_y: f32 = 0.0288
    repeat: f32 = 0.72
    key_x: f32 = -0.19
    key_y: f32 = -0.13
    key_width: f32 = 0.038
    key_height: f32 = 0.095
    key_soft_start: f32 = 0.65
    key_soft_end: f32 = 1.25
    key_r: f32 = 0.34
    key_g: f32 = 0.38
    key_b: f32 = 0.3
    spill_width: f32 = 0.38
    spill_r: f32 = 0.29
    spill_g: f32 = 0.25
    spill_b: f32 = 0.14
    rim_x: f32 = 0.32
    rim_y: f32 = 0.19
    rim_width: f32 = 0.025
    rim_height: f32 = 0.06
    rim_tightness: f32 = 2.5
    glint_r: f32 = 0.38
    glint_g: f32 = 0.45
    glint_b: f32 = 0.43
    core_tightness: f32 = 6.0
    core_strength: f32 = 0.85
    rim_strength: f32 = 0.9
    polish_limit: f32 = 0.95
    polish_r: f32 = 1.0
    polish_g: f32 = 0.97
    polish_b: f32 = 0.82
    strip_reach: f32 = 1.205273
    strip_strength: f32 = 0.5
    strip_limit: f32 = 0.55
    strip_dark_floor: f32 = 0.3
    white_r: f32 = 0.9764705882352941
    white_g: f32 = 0.9803921568627451
    white_b: f32 = 0.9568627450980393
    blue_r: f32 = 0.054901960784313725
    blue_g: f32 = 0.40784313725490196
    blue_b: f32 = 0.6705882352941176
    black_r: f32 = 0.08235294117647059
    black_g: f32 = 0.043137254901960784
    black_b: f32 = 0.0
    red_r: f32 = 0.8274509803921568
    red_g: f32 = 0.12549019607843137
    red_b: f32 = 0.16470588235294117
    green_r: f32 = 0.0
    green_g: f32 = 0.45098039215686275
    green_b: f32 = 0.24313725490196078
}

GOLD :: Gold_Look⟨⟩

// A colour's hue in the gold's perimeter light.
gold_hue :: (mana: Mana -> Draw.RGBA) {
    return if mana is {
    case .WHITE: ⟨GOLD.white_r, GOLD.white_g, GOLD.white_b, 1⟩
    case .BLUE: ⟨GOLD.blue_r, GOLD.blue_g, GOLD.blue_b, 1⟩
    case .BLACK: ⟨GOLD.black_r, GOLD.black_g, GOLD.black_b, 1⟩
    case .RED: ⟨GOLD.red_r, GOLD.red_g, GOLD.red_b, 1⟩
    case .GREEN: ⟨GOLD.green_r, GOLD.green_g, GOLD.green_b, 1⟩
    }
}

// What the part's shader is given: its outline (each point's xy), its
// colours across it (left to right as its player sees it), its life's
// middle and the screen's centre, the way toward its player and how far it
// reaches that way from the centre and which surface it is, its turn and
// its left and right (in its player's frame from its middle) and how many
// points; its surface (kind, features' scale in pixels, contrast, seed;
// time, broad, grain, how many colours); and whether it's out or targeted,
// its bevel's width (pixels) and how wide its noise's octaves go.
Part_Params :: struct {
    points: [MAX_OUTLINE] V4     // position, cumulative perimeter, edge length
    stops:  [5] V4
    middle: V4
    toward: V4
    frame:  V4
    look:   V4
    more:   V4
    lamp_colours: [5] V4
    hybrid_looks: [2] V4         // tile, pattern kind, strength, surface
    material: V4                 // atlas tile, feature scale, perimeter, closing channel lit
    gold: Gold_Look
    state:  V4
}

// The light the parts are lit by: from the screen's top left (a frame's
// bevel lit on its edges facing it), warm, and their shade cool.
PART_LIGHT :: V2⟨-0.55, -0.83⟩
PART_WARM :: V3⟨1.0, 0.92, 0.76⟩
PART_COOL :: V3⟨0.5, 0.55, 0.74⟩

// What each of red, green and blue gives to how light a colour looks
// (Rec. 709's weights): Math.dot(rgb, LUMA).
LUMA :: V3⟨0.2126, 0.7152, 0.0722⟩

// A colour as it lies in a channel (between players, or where the table's
// split): a smooth recess with a dark floor and curved walls rolling up to
// a soft lip, the cosine bowl meeting both its floor and the surface with
// no slope. across: from the channel's middle (0) to its lip (1); facing:
// the wall's way out of the channel, dotted with PART_LIGHT.
channel_wall :: (rgb: V3, across: f32, facing: f32 -> V3) #pure {
    wall := Math.sin(across * f32'Math.PI)
    floor := (1 + Math.cos(across * f32'Math.PI)) * 0.5
    shaded := rgb * (1 - floor * 0.68) * (1 + Math.min(facing, 0) * wall * 0.48)
    return Math.mix(shaded, PART_WARM, Math.max(facing, 0) * wall * 0.38)
}

// A part's colour at a pixel: its colours across it; its surface lightening
// it toward a warm light and darkening it toward a cool shade (not white
// and black: a hue-shifted light and shade, as a painted frame has); darker
// toward its player's edge (a vignette, so the middle comes forward); and a bevel along
// its edges, lit where an edge faces the light and shaded where it faces
// away. A targeted seat lights the bronze in its bounding channels.
part_shade :: (from: Draw.Quad_Between, part: Shader.Uniforms(Part_Params), atlas: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    p := from.pixel
    n := i32'(part.frame.w + 0.5)
    // (inside by the even-odd rule, and how far from its nearest edge, and
    // that edge's way inward)
    *crossings: i32 = 0
    *closest: f32 = 1000000
    *channel_lit: f32 = 0
    *groove_distance: f32 = 1000000
    *inward := V2⟨0, 0⟩
    for i: 0 < n {
        j := if i + 1 < n then i + 1 else 0
        a := part.points[i].xy
        b := part.points[j].xy
        if (a.y > p.y) != (b.y > p.y) {
            x := a.x + (p.y - a.y) / (b.y - a.y) * (b.x - a.x)
            if p.x < x then crossings += 1
        }
        ab := b - a
        t := Math.clamp(Math.dot(p - a, ab) / Math.max(Math.dot(ab, ab), 0.000001), 0, 1)
        d := Math.length(p - a - ab * t)
        closest = Math.min(closest, d)
        // Only the first and closing edges separate players; the rest border the screen.
        if (i == 0 or j == 0) and d < groove_distance {
            channel_lit = if i == 0 then part.state.y else part.material.w
            groove_distance = d
            *normal := Math.normalize(V2⟨0 - ab.y, ab.x⟩)
            if Math.dot(normal, part.middle.xy - a) < 0 then normal = normal * -1.0
            inward = normal
        }
    }
    signed := if crossings % 2 == 1 then 0 - closest else closest
    coverage := Math.clamp(0.5 - signed, 0, 1)
    if coverage <= 0 then return ⟨0, 0, 0, 0⟩
    // (its colours across it)
    angle := part.frame.x
    d := p - part.middle.xy
    local_x := d.x * Math.cos(angle) + d.y * Math.sin(angle)
    u := Math.clamp((local_x - part.frame.y) / Math.max(part.frame.z - part.frame.y, 1), 0, 1)
    stops := i32'(part.more.w + 0.5)
    *base := part.stops[0].xyz
    if stops > 1 {
        s := u * f32'(stops - 1)
        k := Math.min(i32'Math.floor(s), stops - 2)
        base = Math.mix(part.stops[k].xyz, part.stops[k + 1].xyz, s - f32'k)
    }
    shade := base * PART_COOL
    local_y := d.y * Math.cos(angle) - d.x * Math.sin(angle)
    tile := i32'(part.material.x + 0.5)
    *rgb := V3⟨0, 0, 0⟩
    *gold_polish: f32 = 0
    if stops == 2 {
        left := part.hybrid_looks[0]
        right := part.hybrid_looks[1]
        left_look := V4⟨left.y, part.look.y, left.z, part.look.w⟩
        right_look := V4⟨right.y, part.look.y, right.z, part.look.w⟩
        // Centre the blend on the life total's local vertical axis, not
        // the midpoint of an asymmetric region's projected bounds.
        blend_half := Math.max((part.frame.z - part.frame.y) * 0.15, 1)
        blend := Math.smoothstep(0 - blend_half, blend_half, local_x)
        // (each side's material, as much of it as the blend takes: one call
        // in a loop, not one a side, so the material's code is in the stage
        // once, which the driver compiles in a fraction of the time)
        for side: 0 < 2 {
            weight := if side == 0 then 1 - blend else blend
            if weight > 0 {
                hybrid := part.hybrid_looks[side]
                look := if side == 0 then left_look else right_look
                rgb = rgb + shade_panel_material(p, local_x, local_y, part.stops[side].xyz, look, part.more, angle, hybrid.w, i32'hybrid.x, atlas, filtering) * weight
            }
        }
    }
    else if tile == TILE_GOLD {
        // (gold: shallow fixed undulations reflecting moving studio lights)
        slope := gold_surface_slope(atlas, filtering, local_x, local_y, part.look.y, part.look.w, part.state.w, part.gold, 1)
        normal := Math.normalize(V3⟨slope.x, slope.y, 1⟩)
        reflected := normal.xy * (2 * normal.z)
        env := reflected - V2⟨part.gold.speed_x, part.gold.speed_y⟩ * part.more.x
        key_offset := Math.fract((env - V2⟨part.gold.key_x, part.gold.key_y⟩) / part.gold.repeat + V2⟨0.5, 0.5⟩) * part.gold.repeat - V2⟨part.gold.repeat * 0.5, part.gold.repeat * 0.5⟩
        box := Math.abs(key_offset / V2⟨part.gold.key_width, part.gold.key_height⟩)
        key := 1 - Math.smoothstep(part.gold.key_soft_start, part.gold.key_soft_end, Math.max(box.x, box.y))
        spill := Math.exp(0 - Math.dot(box, box) * part.gold.spill_width)
        rim_offset := Math.fract((env - V2⟨part.gold.rim_x, part.gold.rim_y⟩) / part.gold.repeat + V2⟨0.5, 0.5⟩) * part.gold.repeat - V2⟨part.gold.repeat * 0.5, part.gold.repeat * 0.5⟩
        rim := rim_offset / V2⟨part.gold.rim_width, part.gold.rim_height⟩
        glint := Math.exp(0 - Math.dot(rim, rim) * part.gold.rim_tightness)
        // Tight ivory cores sit over the existing reflections without lowering the base.
        core := Math.exp(0 - Math.dot(box, box) * part.gold.core_tightness)
        gold_polish = Math.clamp(core * part.gold.core_strength + glint * part.gold.rim_strength, 0, part.gold.polish_limit)
        highlights := V3⟨part.gold.spill_r, part.gold.spill_g, part.gold.spill_b⟩ * spill + V3⟨part.gold.key_r, part.gold.key_g, part.gold.key_b⟩ * key + V3⟨part.gold.glint_r, part.gold.glint_g, part.gold.glint_b⟩ * glint
        // Broad warm environment fill lifts the metal between the sharp reflections.
        ambient := V3⟨part.gold.ambient_r, part.gold.ambient_g, part.gold.ambient_b⟩ * part.gold.ambient_strength * (1 - part.gold.ambient_shape + normal.z * part.gold.ambient_shape)
        rgb = ambient + highlights
    }
    else {
        rgb = shade_panel_material(p, local_x, local_y, base, part.look, part.more, angle, part.toward.w, tile, atlas, filtering)
    }
    // (darker toward its player's edge, gold too)
    depth := Math.clamp(Math.dot(p - part.middle.zw, part.toward.xy) / Math.max(part.toward.z, 1), 0, 1)
    rgb = Math.mix(rgb, shade * 0.8, Math.smoothstep(0.55, 1.0, depth) * 0.32)
    // Each colour owns an equal arc length of the polygon's perimeter.
    // Split at corners, so every strip follows the real boundary.
    if stops > 2 and part.gold.strip_reach > 0 {
        *radiance := V3⟨0, 0, 0⟩
        *energy: f32 = 0
        *pearl: f32 = 0
        *charcoal: f32 = 0
        perimeter := part.material.z
        strip_length := perimeter / f32'stops
        phase := Math.fract(part.more.x / 32)
        reach := Math.max(part.state.w * part.gold.strip_reach, 1)
        for i: 0 < stops {
            start := Math.fract(phase + f32'i / f32'stops) * perimeter
            finish := start + strip_length
            *distance: f32 = 1000000
            for edge: 0 < n {
                next := if edge + 1 < n then edge + 1 else 0
                info := part.points[edge]
                direction := (part.points[next].xy - info.xy) / Math.max(info.w, 0.0001)
                along := info.z + Math.dot(p - info.xy, direction)
                // A strip crossing the perimeter origin also lights the first edges.
                pieces := if finish > perimeter then 2 else 1
                for piece: 0 < pieces {
                    offset := f32'piece * perimeter
                    lo := Math.max(start - offset, info.z)
                    hi := Math.min(finish - offset, info.z + info.w)
                    if hi > lo {
                        nearest := info.xy + direction * (Math.clamp(along, lo, hi) - info.z)
                        distance = Math.min(distance, Math.length(p - nearest))
                    }
                }
            }
            falloff := Math.exp(0 - Math.pow(distance / reach, part.gold.strip_falloff))
            radiance = radiance + part.lamp_colours[i].xyz * falloff
            energy += falloff
            // The fourth component distinguishes the two neutral reflections.
            neutral := part.lamp_colours[i].w
            if neutral != 0 {
                // Broad, overlapping reflections vary over the metal. Their
                // glints taper out along the strip instead of tracing its outline.
                q := V2⟨local_x, local_y⟩ / Math.max(part.state.w, 1)
                wave := Math.sin(1.18 * q.x + 0.72 * q.y + 1.6 * Math.sin(0.54 * q.y) + part.more.x * 0.09)
                swell := Math.sin(0.63 * q.x - 1.13 * q.y + wave * 0.65)
                band := distance / (reach * (1.0 + 0.31 * wave + 0.16 * swell))
                if neutral > 0 {
                    glint := Math.smoothstep(-0.59, 0.64, swell + wave * 0.24)
                    ridge := band - (0.32 + 0.19 * wave)
                    pearl = (1 - Math.smoothstep(0, 1.22, band)) * 0.61 +
                            Math.exp(-32 * ridge * ridge) * glint * 0.36
                }
                else {
                    charcoal = (1 - Math.smoothstep(0.04, 1.02, band)) * 0.83
                }
            }
        }
        tint := radiance / Math.max(energy, 0.0001)
        brightness := Math.dot(rgb, LUMA)
        tint_luma := Math.dot(tint, LUMA)
        lit := tint * (brightness / Math.max(tint_luma, part.gold.strip_dark_floor))
        rgb = Math.mix(rgb, lit, Math.min(energy * part.gold.strip_strength, part.gold.strip_limit))
        sheen := 0.78 + 0.25 * Math.clamp(brightness, 0, 1)
        rgb = Math.mix(rgb, V3⟨1.0, 0.97, 0.88⟩ * sheen, pearl)
        rgb = Math.mix(rgb, V3⟨0.095, 0.09, 0.10⟩ * sheen, charcoal)
    }
    // Keep the sharpest reflections luminous even under coloured strip lighting.
    rgb = Math.mix(rgb, Math.max(rgb, V3⟨part.gold.polish_r, part.gold.polish_g, part.gold.polish_b⟩), gold_polish)
    // The channel along its edges with its neighbours (each panel shades its
    // half, so adjacent regions share one groove).
    bevel := part.state.z
    if groove_distance < bevel {
        across := Math.clamp(groove_distance / bevel, 0, 1)
        facing := Math.dot(inward * -1.0, PART_LIGHT)
        rgb = channel_wall(rgb, across, facing)
        // A narrow bronze insert occupies only the floor; the rolled edges remain.
        inset := 1 - Math.smoothstep(0.12, 0.30, across)
        bronze := V3⟨0.58, 0.38, 0.19⟩ * (0.72 + Math.max(facing, 0) * Math.sin(across * f32'Math.PI) * 0.3)
        rgb = Math.mix(rgb, Math.mix(bronze, V3⟨1.0, 0.76, 0.38⟩, channel_lit), inset)
    }
    // Dim eliminated players.
    rgb = Math.mix(rgb, V3⟨0.075, 0.075, 0.094⟩, part.state.x * 0.7)
    colour = V4⟨rgb.x * coverage, rgb.y * coverage, rgb.z * coverage, coverage⟩
}

// Sunny open water: fine broken ripples and sparse sun glints, observed in
// Order of the Sinking Star's published sunny-water screenshots. Several
// noise fields evolve against each other; no regular sine-wave mesh.
open_water_at :: (at: V2, base: V3, scale: f32, seed: f32, time: f32 -> V3) {
    q := at / Math.max(scale * 2.8, 1)
    coarse := Patterns.layered(q * 0.13 + V2⟨seed, 0⟩, 4)
    cloud := Patterns.layered(q * 0.24 + V2⟨time * 0.08, seed - time * 0.045⟩, 4)
    warp := Patterns.layered(q * 0.7 + V2⟨0 - time * 0.18, time * 0.11⟩, 3)
    ripple := Patterns.layered(V2⟨q.x * 2.85 + q.y * 0.15, q.y * 3.16 + warp * 1.7⟩ + V2⟨time * 0.13, time * 0.24⟩, 3)
    crossing := Patterns.noise(V2⟨q.x * 5.5 - q.y * 0.2, q.y * 6⟩ + V2⟨0 - time * 0.23, time * 0.16⟩)
    broken := Math.smoothstep(0.4, 0.7, crossing)
    crest := (1 - Math.smoothstep(0.008, 0.032, Math.abs(ripple - 0.54))) * broken
    glint := Math.smoothstep(0.63, 0.8, ripple) * Math.smoothstep(0.62, 0.85, crossing)
    sun := Math.smoothstep(0.43, 0.66, cloud)
    deep := Math.mix(base * V3⟨0.55, 0.8, 0.9⟩, V3⟨0.055, 0.35, 0.41⟩, coarse * 0.65)
    sky := V3⟨0.3, 0.51, 0.62⟩
    water := Math.mix(deep, sky, sun * 0.28) * (0.91 + ripple * 0.18)
    // Broad drifting clouds reflected in the surface, gently broken by its ripples.
    cloud_at := q * 0.32 + V2⟨time * 0.035 + seed * 3.1, seed - time * 0.018⟩ +
        V2⟨ripple - 0.5, crossing - 0.5⟩ * 0.075
    cloud_body := Patterns.layered(cloud_at, 4)
    cloud_cover := Math.smoothstep(0.46, 0.65, cloud_body)
    cloud_top := Math.smoothstep(0.52, 0.72, cloud_body)
    cloud_colour := Math.mix(V3⟨0.36, 0.49, 0.57⟩, V3⟨0.81, 0.87, 0.88⟩, cloud_top)
    reflected := Math.mix(water, cloud_colour, cloud_cover * 0.55)
    return reflected + V3⟨0.48, 0.66, 0.69⟩ * crest * (0.025 + sun * 0.07) + V3⟨0.95, 0.95, 0.83⟩ * glint * (0.12 + sun * 0.4)
}

Part_Surface :: shader { vertex: Draw.quad_place; fragment: part_shade }
PART_SURFACE :: Part_Surface(Draw.SHADER_TARGET)

// How wide a part's bevel is, in cells.
BEVEL_CELLS :: 0.075

// A part drawn by its shader: its colours across it and its surface
// (part_fill's), out or aimed at.
draw_part :: (canvas: *Draw.Canvas, layout: Layout, k: i64, colours: [] Draw.RGBA, pattern: Draw.Pattern, surface: Surface, identity: Identity, out: bool, targeted: i64) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    points := seat.outline[:seat.count]
    *params: Part_Params
    params.gold = GOLD
    *low := points[0]
    *high := points[0]
    *perimeter: f32 = 0
    for q, i: points {
        next := if i + 1 < points.count then i + 1 else 0
        length := Math.length(points[next] - q)
        params.points[i] = V4⟨q.x, q.y, perimeter, length⟩
        perimeter += length
        low = Math.min(low, q)
        high = Math.max(high, q)
    }
    *left: f32 = 1e30
    *right: f32 = -1e30
    for q: points {
        l := local_of(seat.middle, seat.angle, q)
        left = Math.min(left, l.x)
        right = Math.max(right, l.x)
    }
    for c, i: colours[:Math.min(colours.count, 5)] { params.stops[i] = V4⟨c.r, c.g, c.b, 1⟩ }
    // (two colours: each half's own look; three or more: gold, lit by a
    // perimeter strip of each colour, which the shader reads only then)
    if colours.count > 1 {
        *lamp: i64 = 0
        for mana: [5] Mana⟨.WHITE, .BLUE, .BLACK, .RED, .GREEN⟩ {
            if !has_colour(identity, mana) then continue
            if colours.count == 2 {
                look := LOOKS.colours[mana]
                params.hybrid_looks[lamp] = V4⟨f32'u8'mana, f32'i32'look.kind, look.strength * SURFACE_QUIET, f32'u8'surface_of(mana)⟩
                lamp += 1
                continue
            }
            tint := gold_hue(mana)
            neutral: f32 = if mana == .WHITE then 1 else if mana == .BLACK then -1 else 0
            params.lamp_colours[lamp] = V4⟨tint.r, tint.g, tint.b, neutral⟩
            lamp += 1
        }
    }
    params.middle = V4⟨seat.middle.x, seat.middle.y, layout.centre.x, layout.centre.y⟩
    params.toward = V4⟨seat.toward.x, seat.toward.y, Math.max(seat.reach, 1), f32'u8'surface⟩
    params.frame = V4⟨seat.angle, left, right, f32'seat.count⟩
    params.look = V4⟨f32'i32'pattern.kind, pattern.scale, pattern.strength, pattern.seed⟩
    params.more = V4⟨pattern.time, pattern.broad, pattern.grain, f32'Math.min(colours.count, 5)⟩
    dimmed: f32 = if out then 1 else 0
    // Each divider is drawn in halves by the two seats that share it.
    first_lit: f32 = if targeted == k or targeted == (k + layout.count - 1) % layout.count then 1 else 0
    last_lit: f32 = if targeted == k or targeted == (k + 1) % layout.count then 1 else 0
    params.state = V4⟨dimmed, first_lit, BEVEL_CELLS * cell, cell⟩
    tile := material_tile(identity)
    params.material = V4⟨f32'tile, 0, perimeter, last_lit⟩
    canvas.draw_shader_image(low, high - low, PART_SURFACE.code, PART_SURFACE.bindings.part, params, material_image, PART_SURFACE.bindings.atlas, PART_SURFACE.bindings.filtering)
}

// Gold's shallow surface undulations and mineral-grain slope in the player's frame.
gold_surface_slope :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, local_x: f32, local_y: f32, scale: f32, seed: f32, cell: f32, gold: Gold_Look, grain_boost: f32 -> V2) {
    at := V2⟨local_x, local_y⟩ / Math.max(scale * gold.texture_scale, 1) + V2⟨seed * 0.17, seed * 0.31⟩
    luma := Math.dot(material_at(atlas, filtering, TILE_GOLD, at), LUMA)
    q := V2⟨local_x, local_y⟩ / Math.max(cell * gold.surface_scale, 1)
    height_x := Math.dot(material_at(atlas, filtering, TILE_GOLD, at + V2⟨gold.texture_step, 0⟩), LUMA)
    height_y := Math.dot(material_at(atlas, filtering, TILE_GOLD, at + V2⟨0, gold.texture_step⟩), LUMA)
    return V2⟨Math.sin(q.x * gold.freq_x + q.y * gold.cross_x) * gold.wave_x + q.x * gold.slope_x,
              Math.sin(q.y * gold.freq_y + q.x * gold.cross_y) * gold.wave_y + q.y * gold.slope_y⟩ + V2⟨height_x - luma, height_y - luma⟩ * (gold.texture_slope * grain_boost)
}

// Red's branching rock boundary and recessed fracture depth (0 on flat stone plates).
crack_rock_boundary :: (q: V2, seed: f32 -> rock: V2, boundary: f32) #pure {
    bend := V2⟨Patterns.layered(q * 1.7 + V2⟨seed, 0⟩, 3), Patterns.layered(q * 1.7 + V2⟨3.3, seed⟩, 3)⟩ - V2⟨0.5, 0.5⟩
    rock = q + bend * 0.7
    cells := Patterns.cells(rock)
    boundary = cells.y - cells.x
}

crack_height :: (q: V2, time: f32, seed: f32 -> f32) #pure {
    rock, boundary := crack_rock_boundary(q, seed)
    if boundary >= 0.095 then return 0
    front := Patterns.layered(rock * 0.65 + V2⟨seed, 4.4⟩, 3)
    cycle := 0.5 + 0.5 * Math.sin(time * (2.2 / 3.0) + front * 9 + seed)
    growth := Math.smoothstep(front - 0.12, front + 0.12, cycle)
    if growth <= 0.001 then return 0
    width := 0.004 + growth * 0.046
    lip := width + 0.032
    if boundary >= lip then return 0
    shoulder := (1 - Math.smoothstep(width, lip, boundary)) * Math.smoothstep(width * 0.35, width * 1.15, boundary)
    wall := 1 - Math.smoothstep(width * 0.22, lip * 0.88, boundary)
    throat := 1 - Math.smoothstep(0, width, boundary)
    return (shoulder * 0.14 - (wall * 0.44 + throat * 0.66)) * growth
}

// Blue's ripple height: moving swell, directional ripples and crossing wavelets
// (ignoring subsurface depth and reflected clouds).
blue_water_height :: (local: V2, scale: f32, time: f32 -> f32) #pure {
    q := local / Math.max(scale * 2.8, 1)
    warp := Patterns.layered(q * 0.7 + V2⟨0 - time * 0.18, time * 0.11⟩, 3)
    ripple := Patterns.layered(V2⟨q.x * 2.85 + q.y * 0.15, q.y * 3.16 + warp * 1.7⟩ + V2⟨time * 0.13, time * 0.24⟩, 3)
    crossing := Patterns.noise(V2⟨q.x * 5.5 - q.y * 0.2, q.y * 6⟩ + V2⟨0 - time * 0.23, time * 0.16⟩)
    return warp * 0.18 + ripple * 0.58 + crossing * 0.24
}

// Black's watery surface height: smooth flowing swells and fine ripples, with no creases or rock grain.
black_water_height :: (turned: V2, local: V2, scale: f32, seed: f32, time: f32, broad: f32 -> f32) #pure {
    q := turned / Math.max(scale, 1) + V2⟨seed * 31.7, seed * 17.9⟩
    b := Math.clamp(broad, 0, 1)
    warp := V2⟨Patterns.layered(q * 0.5 + V2⟨time, 0⟩, 4), Patterns.layered(q * 0.5 + V2⟨5.2, 1.3 + time⟩, 4)⟩
    body := Patterns.layered(q + warp * 2.5, 4)
    across := Math.mix(1.1, 0.35, b)
    phase := (q.x * across + q.y * across * 0.57 + body * 2.2) * f32'Math.TAU
    showing := Math.mix(0.6, Math.smoothstep(0.35, 0.6, Patterns.layered(q * 0.7 + V2⟨9.1, 2.7 + time * 0.5⟩, 3)), b)
    swell := (0.5 + 0.5 * Math.cos(phase)) * showing
    wq := local / Math.max(scale * 2.8, 1)
    fine_warp := Patterns.layered(wq * 0.7 + V2⟨0 - time * 0.16, time * 0.10⟩, 3)
    fine_ripple := Patterns.layered(V2⟨wq.x * 2.7 + wq.y * 0.18, wq.y * 3.0 + fine_warp * 1.6⟩ + V2⟨time * 0.12, time * 0.21⟩, 3)
    crossing := Patterns.noise(V2⟨wq.x * 5.2 - wq.y * 0.2, wq.y * 5.7⟩ + V2⟨0 - time * 0.20, time * 0.15⟩)
    return body * 0.22 + swell * 0.26 + fine_ripple * 0.36 + crossing * 0.16
}

// Artifact metal's corrosion depth: flat across metal and light rust, with holes eaten only at deep pits.
artifact_rust_hole :: (q: V2, time: f32, seed: f32 -> depth: f32, rust: f32) #pure {
    grain := Patterns.layered(q * 7 + V2⟨seed, 0⟩, 3)
    growth := Patterns.layered(q * 0.6 + V2⟨time * 0.16, seed - time * 0.11⟩, 4)
    weather := Patterns.layered(q * 2.8 + V2⟨seed, 0⟩, 5) * 0.55 + grain * 0.25 + growth * 0.35
    rust = Math.smoothstep(0.46, 0.70, weather)
    eaten := Math.smoothstep(0.56, 0.72, weather)
    if eaten <= 0.001 {
        depth = 0
        return
    }
    pits := Math.smoothstep(0.60, 0.79, grain) * eaten
    depth = pits * 0.90
}

// Forest floor height, leaf-only gloss mask, local slope, isotropic leaf-edge
// undercut, and smooth sunward shadow heights from Tile 7, in a single pass.
forest_layer_sample :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, uv: V2, eps: f32, ray: V2, seed: f32, layer: i64, offset: V2
                        -> h: f32, shine: f32, gx: f32, gy: f32, undercut: f32, h_near: f32, h_far: f32) {
    at := forest_layer_uv(uv, seed, layer) + offset
    at_xp := forest_layer_uv(uv + V2⟨eps, 0⟩, seed, layer) + offset
    at_xm := forest_layer_uv(uv - V2⟨eps, 0⟩, seed, layer) + offset
    at_yp := forest_layer_uv(uv + V2⟨0, eps⟩, seed, layer) + offset
    at_ym := forest_layer_uv(uv - V2⟨0, eps⟩, seed, layer) + offset
    at_near := forest_layer_uv(uv + ray * 6.0, seed, layer) + offset
    at_far := forest_layer_uv(uv + ray * 17.5, seed, layer) + offset
    tap := material_at(atlas, filtering, TILE_FOREST_BUMP, at)
    h = tap.x
    shine = tap.y
    hxp := material_at(atlas, filtering, TILE_FOREST_BUMP, at_xp).x
    hxm := material_at(atlas, filtering, TILE_FOREST_BUMP, at_xm).x
    hyp := material_at(atlas, filtering, TILE_FOREST_BUMP, at_yp).x
    hym := material_at(atlas, filtering, TILE_FOREST_BUMP, at_ym).x
    h_near = material_at(atlas, filtering, TILE_FOREST_BUMP, at_near).x
    h_far = material_at(atlas, filtering, TILE_FOREST_BUMP, at_far).x
    gx = hxp - hxm
    gy = hyp - hym
    high_nb := Math.max(Math.max(hxp, hxm), Math.max(hyp, hym))
    undercut = Math.clamp(high_nb - h - 0.02, 0, 0.55)
}

layered_forest_relief :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, uv: V2, eps: f32, ray: V2, time: f32, seed: f32
                          -> grad: V2, height: f32, undercut: f32, cast_drop: f32, leaf_shine: f32) {
    base := forest_layer_cycle(time, seed, 0)
    h0, sh0, gx0, gy0, u0, hn0, hf0 := forest_layer_sample(atlas, filtering, uv, eps, ray, base.x, 0, V2⟨0, 0⟩)
    *h := h0
    *sh := sh0
    *gx := gx0
    *gy := gy0
    *occ := u0
    *hn := hn0
    *hf := hf0
    for i: 0 < 3 {
        cycle := forest_layer_cycle(time, seed, i + 1)
        salt := f32'i + cycle.x * 0.37
        offset := V2⟨0.213 + f32'i * 0.317, 0.371 + f32'i * 0.193⟩
        at := forest_layer_uv(uv, cycle.x, i + 1) + offset
        copy := material_at(atlas, filtering, TILE_FOREST, at)
        ch, csh, cgx, cgy, cu, chn, chf := forest_layer_sample(atlas, filtering, uv, eps, ray, cycle.x, i + 1, offset)
        patch := Patterns.layered(at * 13 + V2⟨salt, 2.7⟩, 3)
        phase := Patterns.layered(at * 5 + V2⟨3.1, salt⟩, 3) * 9
        life := 0.5 + 0.5 * Math.sin(time * (0.19 + f32'i * 0.037) + phase + salt * 2)
        reveal := Math.smoothstep(0.40, 0.68, patch + (life - 0.5) * 0.42)
        detail := Math.dot(copy, LUMA)
        leaf := Math.smoothstep(0.08, 0.24, detail)
        if i == 0 {
            h = Math.mix(ch, h, base.y)
            sh = Math.mix(csh, sh, base.y)
            gx = Math.mix(cgx, gx, base.y)
            gy = Math.mix(cgy, gy, base.y)
            occ = Math.mix(cu, occ, base.y)
            hn = Math.mix(chn, hn, base.y)
            hf = Math.mix(chf, hf, base.y)
        }
        lift := 0.04 * f32'(i + 1)
        alpha := reveal * leaf * 0.72 * cycle.y
        cover := Math.clamp(alpha * 1.35, 0, 1)
        alpha_near := reveal * Math.smoothstep(0.28, 0.44, chn) * 0.72 * cycle.y
        alpha_far := reveal * Math.smoothstep(0.28, 0.44, chf) * 0.72 * cycle.y
        h = Math.mix(h, ch + lift, alpha)
        sh = Math.mix(sh, csh, cover)
        gx = Math.mix(gx, cgx, alpha)
        gy = Math.mix(gy, cgy, alpha)
        occ = Math.mix(occ, cu, alpha)
        hn = Math.mix(hn, chn + lift, alpha_near)
        hf = Math.mix(hf, chf + lift, alpha_far)
    }
    grad = V2⟨gx, gy⟩
    height = h
    undercut = occ
    drop_near := Math.clamp(hn - h - 0.025, 0, 0.65)
    drop_far := Math.clamp(hf - h - 0.055, 0, 0.65)
    cast_drop = drop_near * 1.25 + drop_far * 0.90
    leaf_shine = sh
}

// One material's local height gradient, crevice/cast shadow, specular gloss and highlight tint/power.
material_relief :: (tile: i32, turned: V2, local: V2, local_sun: V2, scale: f32, seed: f32, time: f32, broad: f32, cell: f32, gold: Gold_Look,
                    atlas: Shader.Texture_2D, filtering: Shader.Sampler -> relief: V4, polish: V4) {
    if tile == TILE_MARBLE {
        // Smooth, unbumped polished marble with a broad solar specular reflection.
        relief = V4⟨0, 0, 0, 0.40⟩
        polish = V4⟨1.0, 0.99, 0.96, 28⟩
        return
    }
    if tile == TILE_CRACKS {
        q0 := local / Math.max(scale, 1)
        grain := Patterns.layered(q0 * 7 + V2⟨seed, 1.9⟩, 3)
        stone_gloss := 0.24 + 0.12 * Math.smoothstep(0.40, 0.78, grain)
        _, b0 := crack_rock_boundary(q0, seed)
        if b0 >= 0.11 {
            relief = V4⟨0, 0, 0, stone_gloss⟩
            polish = V4⟨1.0, 0.88, 0.64, 20⟩
            return
        }
        eps := 1.1 / Math.max(scale, 1)
        h0 := crack_height(q0, time, seed)
        hx := crack_height(q0 + V2⟨eps, 0⟩, time, seed) - crack_height(q0 - V2⟨eps, 0⟩, time, seed)
        hy := crack_height(q0 + V2⟨0, eps⟩, time, seed) - crack_height(q0 - V2⟨0, eps⟩, time, seed)
        depth := Math.clamp(0 - h0, 0, 1)
        rim_glint := Math.clamp(Math.length(V2⟨hx, hy⟩) * 2.4, 0, 0.20)
        gloss := (stone_gloss + rim_glint) * (1 - Math.smoothstep(0.18, 0.65, depth))
        relief = V4⟨hx * 3.2, hy * 3.2, depth * 0.22, gloss⟩
        polish = V4⟨1.0, 0.88, 0.64, 20⟩
        return
    }
    if tile == TILE_WATER {
        eps: f32 = 1.6
        hx := blue_water_height(local + V2⟨eps, 0⟩, scale, time) - blue_water_height(local - V2⟨eps, 0⟩, scale, time)
        hy := blue_water_height(local + V2⟨0, eps⟩, scale, time) - blue_water_height(local - V2⟨0, eps⟩, scale, time)
        relief = V4⟨hx * 1.45, hy * 1.45, 0, 0.42⟩
        polish = V4⟨1.0, 0.98, 0.90, 96⟩
        return
    }
    if tile == TILE_BLACK {
        eps: f32 = 1.6
        hx := black_water_height(turned + V2⟨eps, 0⟩, local + V2⟨eps, 0⟩, scale, seed, time, broad) -
              black_water_height(turned - V2⟨eps, 0⟩, local - V2⟨eps, 0⟩, scale, seed, time, broad)
        hy := black_water_height(turned + V2⟨0, eps⟩, local + V2⟨0, eps⟩, scale, seed, time, broad) -
              black_water_height(turned - V2⟨0, eps⟩, local - V2⟨0, eps⟩, scale, seed, time, broad)
        relief = V4⟨hx * 1.35, hy * 1.35, 0, 0.34⟩
        polish = V4⟨1.0, 0.95, 0.84, 92⟩
        return
    }
    if tile == TILE_ARTIFACT {
        inv := 1 / Math.max(scale * 5, 1)
        q0 := local * inv
        d0, r0 := artifact_rust_hole(q0, time, seed)
        eps := 1.25 * inv
        dx_p, _ := artifact_rust_hole(q0 + V2⟨eps, 0⟩, time, seed)
        dx_m, _ := artifact_rust_hole(q0 - V2⟨eps, 0⟩, time, seed)
        dy_p, _ := artifact_rust_hole(q0 + V2⟨0, eps⟩, time, seed)
        dy_m, _ := artifact_rust_hole(q0 - V2⟨0, eps⟩, time, seed)
        // Hole height is -depth, so dh/dx = -(dx_p - dx_m).
        hx := dx_m - dx_p
        hy := dy_m - dy_p
        relief = V4⟨hx * 2.1, hy * 2.1, d0 * 0.22, 0.22 * (1 - r0 * 0.85)⟩
        polish = V4⟨1.0, 0.86, 0.64, 38⟩
        return
    }
    if tile == TILE_FOREST {
        inv := 1 / Math.max(scale * 18, 1)
        uv0 := local * inv + V2⟨seed * 0.17, seed * 0.31⟩
        eps := 2.0 * inv
        // Step directly along `local_sun` (without dividing by its length) so cast
        // shadows contract smoothly to zero through noon instead of flipping 180°,
        // while isotropic undercut and crevice occlusion hold steady overhead.
        raking := Math.clamp(Math.length(local_sun), 0, 1)
        ray := local_sun * inv
        grad, h0, undercut, cast_drop, leaf_shine := layered_forest_relief(atlas, filtering, uv0, eps, ray, time, seed)
        cast_shadow := cast_drop * (raking * raking)
        ambient_shadow := Math.clamp((0.37 - h0) * 1.0, 0, 0.32) + undercut * 0.88
        recess := ambient_shadow + cast_shadow
        unshadowed := 1 - Math.clamp((undercut * 0.9 + cast_shadow) * 1.35, 0, 1)
        // Only leaves (Tile 7's green channel) carry waxy specular shine; moss,
        // soil, twigs and branches stay matte (gloss = 0).
        gloss := 0.44 * leaf_shine * unshadowed
        slope_scale := 0.36 + 0.38 * leaf_shine
        relief = V4⟨grad.x * slope_scale, grad.y * slope_scale, recess, gloss⟩
        polish = V4⟨0.99, 1.0, 0.86, 30⟩
        return
    }
    slope := gold_surface_slope(atlas, filtering, local.x, local.y, scale, seed, cell, gold, 2.8)
    relief = V4⟨slope.x * 1.25, slope.y * 1.25, 0, 0.28⟩
    polish = V4⟨1.0, 0.91, 0.60, 56⟩
}

// A part lit over its kept surface (for Restart's starting-player spin and
// its slow fade): the bronze in the channels surrounding the part (never the
// screen's edge) lit up, and a directional sun rising over the part's clockwise
// edge, arcing overhead, and setting over its anticlockwise edge (`seat_light_shade`
// illuminates the whole part; `seat_bump_shade` actuates its relief and gloss).
Seat_Light_Params :: struct {
    points: [MAX_OUTLINE] V4    // each outline vertex in xy
    sun:    V4                  // unit direction toward the sun xyz, outline point count
    axis:   V4                  // part middle along spin xy, spin_dir xy (sunrise -> sunset)
    style:  V4                  // half span along spin, bevel width (pixels), strength (0..1), marble share
    screen: V4                  // screen size xy, anticlockwise channel flash, clockwise channel flash
}

seat_light_shade :: (from: Draw.Quad_Between, light: Shader.Uniforms(Seat_Light_Params), surfaces: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    p := from.pixel
    n := i32'(light.sun.w + 0.5)
    bevel := Math.max(light.style.y, 1)
    strength := light.style.z
    *crossings: i32 = 0
    *closest: f32 = 1000000
    *groove_distance: f32 = 1000000
    *channel_flash: f32 = 0
    for i: 0 < n {
        j := if i + 1 < n then i + 1 else 0
        a := light.points[i].xy
        b := light.points[j].xy
        if (a.y > p.y) != (b.y > p.y) {
            x := a.x + (p.y - a.y) / (b.y - a.y) * (b.x - a.x)
            if p.x < x then crossings += 1
        }
        ab := b - a
        t := Math.clamp(Math.dot(p - a, ab) / Math.max(Math.dot(ab, ab), 0.000001), 0, 1)
        d := Math.length(p - a - ab * t)
        closest = Math.min(closest, d)
        // Only the first and closing edges separate players; the rest border the screen.
        if (i == 0 or j == 0) and d < groove_distance {
            groove_distance = d
            channel_flash = if i == 0 then light.screen.z else light.screen.w
        }
    }
    signed := if crossings % 2 == 1 then 0 - closest else closest
    coverage := Math.clamp(0.5 - signed, 0, 1)
    across := Math.clamp(groove_distance / bevel, 0, 1)
    inset := if groove_distance < bevel then 1 - Math.smoothstep(0.12, 0.30, across) else 0
    w := inset + (1 - inset) * coverage
    if w <= 0.0001 or strength <= 0 then return ⟨0, 0, 0, 0⟩

    inv_screen := V2⟨1 / Math.max(light.screen.x, 1), 1 / Math.max(light.screen.y, 1)⟩
    base := Shader.sample_level(surfaces, filtering, p * inv_screen, 0).xyz
    *panel_rgb := base
    if coverage > 0 {
        // Daylight across the whole part: golden and horizon-leaning at sunrise
        // and sunset, even and bright overhead at noon. Saturated crimson stone
        // (high chroma, low luma) also receives warm solar fill so it glows
        // sunlit vermilion-amber instead of clipping its red channel flatly.
        elevation := Math.clamp(light.sun.z, 0, 1)
        across_part := Math.clamp(Math.dot(p - light.axis.xy, light.sun.xy) / Math.max(light.style.x, 1), -1, 1)
        horizon_lean := 1 + 0.36 * across_part
        daylight := (0.48 + 0.56 * Math.sqrt(elevation)) * horizon_lean

        luma := Math.dot(base, LUMA)
        dampen := luma * luma
        peak := Math.max(base.x, Math.max(base.y, base.z))
        chroma := Math.max(peak - luma, 0)
        marble_hold := light.style.w * dampen
        shaded := base * (1 - 0.12 * marble_hold)
        sun_colour := Math.mix(V3⟨1.0, 0.78, 0.46⟩, V3⟨1.0, 0.94, 0.80⟩, elevation)
        warm_fill := (0.04 * (1 - dampen) + 0.40 * chroma) * daylight + elevation * (0.04 - 0.03 * luma)
        energy := base * sun_colour * ((0.58 - 0.38 * dampen) * daylight) + sun_colour * Math.max(warm_fill, 0)
        ceiling := Math.mix(V3⟨0.99, 0.96, 0.91⟩, V3⟨0.91, 0.90, 0.87⟩, dampen)
        headroom := Math.max(ceiling - shaded, V3⟨0.02, 0.02, 0.02⟩)
        knee := V3⟨1, 1, 1⟩ - Math.exp((V3⟨0, 0, 0⟩ - energy) / Math.max(headroom, V3⟨0.18, 0.18, 0.18⟩))
        panel_rgb = Math.clamp(shaded + headroom * knee, 0, 1)
    }

    // Both halves of the shared channels around the player light their bronze
    // floor insert, flashing brighter warm ivory-gold as the spin bounces off one.
    channel_rgb := Math.mix(V3⟨1.0, 0.76, 0.38⟩, V3⟨1.0, 0.95, 0.78⟩, Math.clamp(channel_flash, 0, 1))
    mixed := (panel_rgb * ((1 - inset) * coverage) + channel_rgb * inset) / w
    alpha := Math.clamp(w * strength, 0, 1)
    colour = V4⟨mixed.x, mixed.y, mixed.z, 1⟩ * alpha
}

Seat_Light :: shader { vertex: Draw.quad_place; fragment: seat_light_shade }
SEAT_LIGHT :: Seat_Light(Draw.SHADER_TARGET)

Seat_Bump_Params :: struct {
    points:  [MAX_OUTLINE] V4   // each outline vertex in xy
    sun:     V4                 // unit direction toward the sun xyz, outline point count
    axis:    V4                 // part middle along spin xy, spin_dir xy (sunrise -> sunset)
    style:   V4                 // half span along spin, bevel width (pixels), strength (0..1), unused
    frame:   V4                 // seat middle xy, seat angle, cell size
    span:    V4                 // local left, local right, pattern scale, pattern seed
    more:    V4                 // surface time, broad, colour count, atlas tile
    hybrids: V4                 // left tile, right tile, unused
    gold:    Gold_Look
}

seat_bump_shade :: (from: Draw.Quad_Between, bump: Shader.Uniforms(Seat_Bump_Params), atlas: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    p := from.pixel
    n := i32'(bump.sun.w + 0.5)
    bevel := Math.max(bump.style.y, 1)
    strength := bump.style.z
    if strength <= 0 then return ⟨0, 0, 0, 0⟩

    *crossings: i32 = 0
    *closest: f32 = 1000000
    *groove_distance: f32 = 1000000
    for i: 0 < n {
        j := if i + 1 < n then i + 1 else 0
        a := bump.points[i].xy
        b := bump.points[j].xy
        if (a.y > p.y) != (b.y > p.y) {
            x := a.x + (p.y - a.y) / (b.y - a.y) * (b.x - a.x)
            if p.x < x then crossings += 1
        }
        ab := b - a
        t := Math.clamp(Math.dot(p - a, ab) / Math.max(Math.dot(ab, ab), 0.000001), 0, 1)
        d := Math.length(p - a - ab * t)
        closest = Math.min(closest, d)
        if (i == 0 or j == 0) and d < groove_distance {
            groove_distance = d
        }
    }
    signed := if crossings % 2 == 1 then 0 - closest else closest
    coverage := Math.clamp(0.5 - signed, 0, 1)
    across := Math.clamp(groove_distance / bevel, 0, 1)
    inset := if groove_distance < bevel then 1 - Math.smoothstep(0.12, 0.30, across) else 0
    interior := if groove_distance < bevel then Math.smoothstep(0.55, 1.0, across) else 1
    mask := coverage * (1 - inset) * interior * strength
    if mask <= 0.0001 then return ⟨0, 0, 0, 0⟩

    angle := bump.frame.z
    c := Math.cos(angle)
    s := Math.sin(angle)
    turned := V2⟨p.x * c + p.y * s, p.y * c - p.x * s⟩
    rel := p - bump.frame.xy
    local := V2⟨rel.x * c + rel.y * s, rel.y * c - rel.x * s⟩
    local_sun := V2⟨bump.sun.x * c + bump.sun.y * s, bump.sun.y * c - bump.sun.x * s⟩
    stops := i32'(bump.more.z + 0.5)
    tile := i32'(bump.more.w + 0.5)

    // Single call in a loop (1 side, or 2 for hybrids) so `material_relief` is
    // inlined once in the stage and compiles quickly in the GPU driver.
    *relief := V4⟨0, 0, 0, 0⟩
    *polish := V4⟨0, 0, 0, 0⟩
    blend_half := Math.max((bump.span.y - bump.span.x) * 0.15, 1)
    blend := Math.smoothstep(0 - blend_half, blend_half, local.x)
    sides: i32 = if stops == 2 then 2 else 1
    for side: 0 < sides {
        side_weight := if side == 0 then 1 - blend else blend
        weight: f32 = if stops == 2 then side_weight else 1
        if weight > 0.001 {
            side_f := if side == 0 then bump.hybrids.x else bump.hybrids.y
            side_tile := if stops == 2 then i32'(side_f + 0.5) else tile
            r, pol := material_relief(side_tile, turned, local, local_sun, bump.span.z, bump.span.w, bump.more.x, bump.more.y, bump.frame.w, bump.gold, atlas, filtering)
            relief = relief + r * weight
            polish = polish + pol * weight
        }
    }

    // Rotate local height gradient into screen space and form outward surface normal.
    grad := V2⟨relief.x * c - relief.y * s, relief.x * s + relief.y * c⟩
    normal := Math.normalize(V3⟨0 - grad.x, 0 - grad.y, 1⟩)

    // Parallel directional sun arcing from sunrise (-spin_dir) to sunset (+spin_dir),
    // paired with perspective eye over the part so the solar reflection travels from
    // the sunrise edge across the middle to the sunset edge.
    light_dir := bump.sun.xyz
    spin_dir := bump.axis.zw
    radial_dir := V2⟨0 - spin_dir.y, spin_dir.x⟩
    rel_origin := p - bump.axis.xy
    s_spin := Math.dot(rel_origin, spin_dir)
    s_rad := Math.dot(rel_origin, radial_dir)
    eye_xy := spin_dir * (0 - s_spin) + radial_dir * (0 - s_rad * 0.22)
    view_dir := Math.normalize(V3⟨eye_xy.x, eye_xy.y, Math.max(bump.style.x * 0.62, 1)⟩)
    half_dir := Math.normalize(light_dir + view_dir)

    nl := Math.max(Math.dot(normal, light_dir), 0)
    nl_flat := Math.max(light_dir.z, 0)
    nh := Math.max(Math.dot(normal, half_dir), 0)

    grazing := 1 / Math.max(nl_flat, 0.38)
    sun_tint := Math.mix(V3⟨1.0, 0.76, 0.46⟩, V3⟨1.0, 0.96, 0.86⟩, nl_flat)
    shine_gate := Math.smoothstep(0.01, 0.14, relief.w)
    shade_slope := Math.max(nl_flat - nl, 0) * grazing * 0.72
    lit_slope := Math.max(nl - nl_flat, 0) * (0.50 + 0.22 * nl_flat) * shine_gate
    shade := Math.clamp(shade_slope + relief.z * (0.82 - 0.16 * nl_flat), 0, 0.82)

    tight := Math.pow(nh, polish.w)
    sheen := Math.pow(nh, Math.max(polish.w * 0.35, 14.0))
    horizon_fade := Math.smoothstep(0.12, 0.35, nl_flat)
    spec := (tight * 0.86 + sheen * 0.14) * relief.w * (0.35 + 0.65 * horizon_fade)
    added := (polish.xyz * sun_tint) * (spec + lit_slope) + PART_COOL * (0.015 * shade)

    colour = V4⟨added.x * mask, added.y * mask, added.z * mask, shade * mask⟩
}

Seat_Bump :: shader { vertex: Draw.quad_place; fragment: seat_bump_shade }
SEAT_BUMP :: Seat_Bump(Draw.SHADER_TARGET)

// The sun's sky arc over seat k at `sweep` (0 rising over its clockwise edge,
// 0.5 straight overhead at noon, 1 setting over its anticlockwise edge), along
// the anticlockwise spin vector across that part.
part_sun_arc :: (layout: Layout, k: i64, sweep: f32 -> sun_dir: V3, origin: V2, spin_dir: V2, half_span: f32) #pure {
    seat := layout.seats[k]
    cell := cell_of(layout)
    points := seat.outline[:seat.count]
    spin_dir = V2⟨seat.toward.y, 0 - seat.toward.x⟩
    *min_s: f32 = 1e30
    *max_s: f32 = -1e30
    for q: points {
        s := Math.dot(q - seat.middle, spin_dir)
        min_s = Math.min(min_s, s)
        max_s = Math.max(max_s, s)
    }
    origin = seat.middle + spin_dir * ((min_s + max_s) * 0.5)
    half_span = Math.max((max_s - min_s) * 0.5, cell * 2)
    u := Math.clamp(sweep, 0, 1)
    alpha := (u - 0.5) * (f32'Math.PI * 0.87)
    sun_dir = V3⟨spin_dir.x * Math.sin(alpha), spin_dir.y * Math.sin(alpha), Math.cos(alpha)⟩
}

draw_part_light :: (canvas: *Draw.Canvas, surfaces: *Draw.Canvas, layout: Layout, k: i64, identity: Identity, time: f32, sweep: f32, strength: f32,
                    acw_flash: f32 = 0, cw_flash: f32 = 0) {
    if k < 0 or k >= layout.count or strength <= 0 then return
    seat := layout.seats[k]
    cell := cell_of(layout)
    bevel := BEVEL_CELLS * cell
    points := seat.outline[:seat.count]
    sun_dir, part_origin, spin_dir, half_span := part_sun_arc(layout, k, sweep)
    *light_params: Seat_Light_Params
    *bump_params: Seat_Bump_Params
    bump_params.gold = GOLD
    *low := points[0]
    *high := points[0]
    *left: f32 = 1e30
    *right: f32 = -1e30
    for q, i: points {
        light_params.points[i] = V4⟨q.x, q.y, 0, 0⟩
        bump_params.points[i] = V4⟨q.x, q.y, 0, 0⟩
        low = Math.min(low, q)
        high = Math.max(high, q)
        l := local_of(seat.middle, seat.angle, q)
        left = Math.min(left, l.x)
        right = Math.max(right, l.x)
    }
    *colour_count: i64 = 0
    *hybrid_pair: [2] f32
    for mana: [5] Mana⟨.WHITE, .BLUE, .BLACK, .RED, .GREEN⟩ {
        if has_colour(identity, mana) {
            if colour_count < 2 then hybrid_pair[colour_count] = f32'u8'mana
            colour_count += 1
        }
    }
    stops := if colour_count >= 2 then Math.min(colour_count, 5) else 1
    tile := material_tile(identity)
    marble_share: f32 = if tile == TILE_MARBLE then 1 else if stops == 2 and has_colour(identity, .WHITE) then 0.5 else 0
    clamped := Math.clamp(strength, 0, 1)
    sun := V4⟨sun_dir.x, sun_dir.y, sun_dir.z, f32'seat.count⟩
    axis := V4⟨part_origin.x, part_origin.y, spin_dir.x, spin_dir.y⟩

    light_params.sun = sun
    light_params.axis = axis
    light_params.style = V4⟨half_span, bevel, clamped, marble_share⟩
    light_params.screen = V4⟨layout.size.x, layout.size.y, acw_flash, cw_flash⟩

    scale := SURFACE_FEATURES * SURFACE_SCALE * cell
    bump_params.sun = sun
    bump_params.axis = axis
    bump_params.style = V4⟨half_span, bevel, clamped, 0⟩
    bump_params.frame = V4⟨seat.middle.x, seat.middle.y, seat.angle, cell⟩
    bump_params.span = V4⟨left, right, scale, f32'(k + 1)⟩
    bump_params.more = V4⟨time, SURFACE_BROAD, f32'stops, f32'tile⟩
    bump_params.hybrids = V4⟨hybrid_pair[0], hybrid_pair[1], 0, 0⟩

    pad := V2⟨bevel + 2, bevel + 2⟩
    box_at := low - pad
    box_size := high - low + pad * 2
    canvas.draw_shader_canvas(box_at, box_size, SEAT_LIGHT.code, SEAT_LIGHT.bindings.light, light_params,
                              surfaces, SEAT_LIGHT.bindings.surfaces, SEAT_LIGHT.bindings.filtering)
    canvas.draw_shader_image(box_at, box_size, SEAT_BUMP.code, SEAT_BUMP.bindings.bump, bump_params,
                             material_image, SEAT_BUMP.bindings.atlas, SEAT_BUMP.bindings.filtering)
}

////////////////////////////////
// The parts' surfaces kept: a part's shader is the costliest thing drawn
// (its materials, over a quarter of the screen or more), and its surface
// moves slowly, so the surfaces are kept in a canvas of their own, a part's
// drawn again each frame in turn, those whose surface has moved since they
// were (none while the surfaces are still); a part again at once when
// anything else it shows changes (its shape, as a line beside it moves; its
// colours; whether it's out, or its channels lit as it or a neighbour's
// aimed at), drawn over what was there, so a line's drag redraws its two
// parts alone, and all of them, cleanly, the first frame nothing changes
// after; and all of them when the screen's size or the count changes.

Surface_Key :: struct {
    size:     V2
    count:    i64
}

// The frames parts drawn over what was there wait, unchanged, before all
// are drawn again from clear.
SETTLED_FRAMES :: 15

// What a part's surface shows besides its surface's movement.
Part_Key :: struct {
    seat:      Seat
    identity:  Identity
    out:       bool
    first_lit: bool
    last_lit:  bool
}

Kept_Surfaces :: struct {
    kept:     Kept_Canvas
    key:      Surface_Key
    parts:    [MAX_PLAYERS] Part_Key
    changing: bool                     // parts were redrawn over what was there: all again once they stop
    still:    i64                      // ...the frames since one last was (all again only after SETTLED_FRAMES)
    drawn_at: [MAX_PLAYERS] f32        // the surfaces' time each part was drawn at
    next:     i64                      // the part to look at first next
}

kept_surfaces: Kept_Surfaces

// The parts' surfaces brought up to date in their canvas: whether they're
// there to draw (false: no canvas could be made, so each part's drawn as it
// is).
keep_surfaces :: (layout: Layout, game: Game, targeted: i64, time: f32 -> bool) {
    size := Wide.i32x2⟨i32'Math.round(layout.size.x), i32'Math.round(layout.size.y)⟩
    // (a new size is a new key, so a canvas made or resized is drawn whole)
    if !kept_surfaces.kept.prepare(size) then return false
    key := Surface_Key⟨size: layout.size, count: layout.count⟩
    *parts: [MAX_PLAYERS] Part_Key
    n := layout.count
    for k: 0 < n {
        parts[k] = ⟨seat: layout.seats[k], identity: game.identity[k], out: is_out(game, k),
                    first_lit: targeted == k or targeted == (k + n - 1) % n, last_lit: targeted == k or targeted == (k + 1) % n⟩
    }
    // (each part whose key's changed drawn again over what was there)
    *changed := false
    if key == kept_surfaces.key {
        for k: 0 < n {
            if parts[k] == kept_surfaces.parts[k] then continue
            draw_surface(kept_surfaces.kept.canvas, layout, game, k, targeted, time)
            kept_surfaces.drawn_at[k] = time
            kept_surfaces.parts[k] = parts[k]
            changed = true
        }
    }
    if changed {
        kept_surfaces.changing = true
        kept_surfaces.still = 0
        return true
    }
    // (all of them, from clear: a new size or count, or the changes over,
    // SETTLED_FRAMES with none: a finger dragging a line doesn't move it
    // every frame, and all of them each frame it didn't cost as much as no
    // keeping)
    if kept_surfaces.changing then kept_surfaces.still += 1
    if key != kept_surfaces.key or (kept_surfaces.changing and kept_surfaces.still >= SETTLED_FRAMES) {
        kept_surfaces.kept.canvas.clear(BACKGROUND)
        for k: 0 < n {
            draw_surface(kept_surfaces.kept.canvas, layout, game, k, targeted, time)
            kept_surfaces.drawn_at[k] = time
        }
        kept_surfaces.key = key
        kept_surfaces.parts = parts
        kept_surfaces.changing = false
        return true
    }
    for _: 0 < layout.count {
        k := kept_surfaces.next % layout.count
        kept_surfaces.next += 1
        if kept_surfaces.drawn_at[k] != time {
            draw_surface(kept_surfaces.kept.canvas, layout, game, k, targeted, time)
            kept_surfaces.drawn_at[k] = time
            break
        }
    }
    return true
}

// A part's surface, its colours' and its surface's at a time, out or aimed
// at as it is.
draw_surface :: (canvas: *Draw.Canvas, layout: Layout, game: Game, k: i64, targeted: i64, time: f32) {
    *colours: [Draw.MAX_GRADIENT_COLOURS] Draw.RGBA
    n, pattern, surface := part_fill(game.identity[k], cell_of(layout), k, time, layout.seats[k].angle, colours)
    draw_part(canvas, layout, k, colours[:n], pattern, surface, game.identity[k], is_out(game, k), targeted)
}

// What a part's surface is: its look's pattern, open water seen from above
// (blue's), rusting metal (an artifact's), or a forest floor (green's).
Surface :: enum u8 {
    PATTERN
    WATER
    RUST
    FOREST
}

// A colour's surface, a part's of that colour alone or a hybrid's half's:
// blue's open water, green's forest floor, the rest their look's pattern.
surface_of :: (colour: Mana -> Surface) #pure {
    return if colour is { case .BLUE: .WATER; case .GREEN: .FOREST; case .WHITE, .BLACK, .RED: .PATTERN }
}

// A surface as the shader has it (a float of its value), compared with one.
is_surface :: (surface: f32, kind: Surface -> bool) #pure {
    return Math.abs(surface - f32'u8'kind) < 0.5
}

// A part's fill, for its player's colours: its gradient's colours (into,
// how many), its surface (features sized in pixels, cell's share, seeded by
// its seat so neighbours differ, moved to time, turned to face its player
// as their text is: its water falls toward them), and which.
part_fill :: (identity: Identity, cell: f32, seat: i64, time: f32, angle: f32, into: [] *Draw.RGBA -> count: i64, pattern: Draw.Pattern,
              surface: Surface) #pure {
    surface = .PATTERN
    looks := LOOKS
    *colours: i64 = 0
    *only := Mana.WHITE
    for _, colour: looks.colours {
        if has_colour(identity, colour) {
            colours += 1
            only = colour
        }
    }
    *look := looks.artifact
    count = 0
    if colours >= 2 {
        // Gold, shaded across toward each colour (WUBRG).
        look = looks.gold
        for each, colour: looks.colours {
            if has_colour(identity, colour) {
                into[count] = if colours == 2 then each.ground else Math.mix(look.ground, each.ground, GOLD_TINT)
                count += 1
            }
        }
    }
    else {
        if colours == 1 then look = looks.colours[only]
        // (one colour: its ground, lit and shaded by its surface; blue's
        // open water, green's a forest floor, none's rusting metal)
        into[0] = look.ground
        count = 1
        surface = if colours == 0 then .RUST else surface_of(only)
    }
    // (every part's features one size, and quieter than the looks' own
    // contrast: the surface stays behind what's on it)
    pattern = ⟨kind: look.kind, scale: SURFACE_FEATURES * SURFACE_SCALE * cell, strength: look.strength * SURFACE_QUIET, seed: f32'(seat + 1), time: time,
               angle: angle, broad: SURFACE_BROAD, grain: SURFACE_GRAIN⟩
}

// The features' size (against SURFACE_SCALE), one for every part, and how
// much of a look's contrast a part's surface keeps.
SURFACE_FEATURES :: 1.5
SURFACE_QUIET :: 0.6

// Feathered mineral deposits follow a fixed, folded grain. Time changes
// their breadth and local density; neither the grain nor stone slides.
living_marble :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, q: V2, time: f32, seed: f32 -> V3) {
    uv := q * 0.18 + V2⟨seed * 0.17, seed * 0.31⟩
    mineral := material_at(atlas, filtering, 0, uv)
    detail := Math.dot(mineral, LUMA)
    cloud := Patterns.layered(q * 2.7 + V2⟨seed, 3.1⟩, 4)
    grain := Patterns.layered(q * 23 + V2⟨seed, 1.7⟩, 3)
    mineral_variation := Math.clamp((detail - 0.65) * 0.26, -0.06, 0.07)
    ivory := V3⟨0.965, 0.945, 0.895⟩ * (0.92 + cloud * 0.08 + mineral_variation)
    warmth := Math.clamp((mineral.x - mineral.z) * 0.5, 0, 0.12)
    stone := Math.mix(ivory, ivory * V3⟨1.0, 0.94, 0.83⟩, warmth + (1 - cloud) * 0.12)
    fold := Patterns.layered(q * 0.8 + V2⟨seed, 0⟩, 5)
    branches := Patterns.layered(q * 4.5 + V2⟨1.7, seed⟩, 4)
    band := Math.abs(Math.sin(q.x * 1.3 + q.y * 2.2 + fold * 9 + branches * 1.2))
    front := Patterns.layered(q * 0.65 + V2⟨seed, 8.1⟩, 3)
    growth := 0.5 + 0.5 * Math.sin(time * (2.4 / 3.0) + front * 8)
    width := 0.035 + growth * (0.08 + branches * 0.28)
    deposit := 1 - Math.smoothstep(width * 0.2, width + 0.24, band + (grain - 0.5) * 0.24)
    threads := 1 - Math.smoothstep(0.018, 0.09, band + (grain - 0.5) * 0.10)
    // The authored mineral grain supplies granular inclusions, not black-tile seams.
    inclusions := Math.clamp((0.85 - detail) * 1.4, 0, 0.45)
    fine_band := Math.abs(Math.sin(q.x * 4.7 - q.y * 2.8 + fold * 13 + branches * 4))
    fine := (1 - Math.smoothstep(0.015, 0.12, fine_band)) * Math.smoothstep(0.35, 0.65, branches)
    density := 0.45 + cloud * 0.65
    veins := (deposit * (0.16 + growth * 0.24) + threads * growth * 0.12) * density + fine * growth * 0.13
    marble := Math.mix(stone, V3⟨0.63, 0.64, 0.61⟩, Math.clamp(veins + inclusions * (0.35 + growth * 0.30), 0, 0.65))
    facets := Math.smoothstep(0.61, 0.76, grain) * Math.smoothstep(0.15, 0.82, Math.sin(time * 1.7 + cloud * 19 + branches * 8))
    return Math.mix(marble, V3⟨1.0, 0.99, 0.95⟩, facets * 0.8)
}

// Fixed rock plates, with cracks propagating along their branching boundaries.
// Time changes the fracture front and aperture, never the rock's coordinates.
living_cracks :: (q: V2, time: f32, seed: f32, base: V3 -> V3) {
    bend := V2⟨Patterns.layered(q * 1.7 + V2⟨seed, 0⟩, 3), Patterns.layered(q * 1.7 + V2⟨3.3, seed⟩, 3)⟩ - V2⟨0.5, 0.5⟩
    rock := q + bend * 0.7
    cells := Patterns.cells(rock)
    boundary := cells.y - cells.x
    front := Patterns.layered(rock * 0.65 + V2⟨seed, 4.4⟩, 3)
    cycle := 0.5 + 0.5 * Math.sin(time * (2.2 / 3.0) + front * 9 + seed)
    growth := Math.smoothstep(front - 0.12, front + 0.12, cycle)
    width := 0.003 + growth * 0.045
    crack := (1 - Math.smoothstep(width * 0.3, width, boundary)) * growth
    rim := (1 - Math.smoothstep(width, width + 0.025, boundary)) * growth
    grain := Patterns.layered(q * 7 + V2⟨seed, 1.9⟩, 3)
    plate := base * (0.95 + grain * 0.10)
    lit := plate + V3⟨0.10, 0.035, 0.012⟩ * rim
    return Math.mix(lit, base * V3⟨0.58, 0.43, 0.36⟩, crack * 0.75)
}
// Warm old artifact metal; corrosion follows granular material detail,
// with a soft, irregular growing front instead of outlined painted islands.
living_artifact :: (q: V2, texture: V3, time: f32, seed: f32 -> V3) {
    detail := Math.dot(texture, LUMA)
    grain := Patterns.layered(q * 7 + V2⟨seed, 0⟩, 3)
    bend := Patterns.layered(q * 0.8 + V2⟨seed, 2.7⟩, 3)
    reflection := Math.fract(q.x * 0.19 + q.y * 0.11 + bend * 0.16 - time * 0.08)
    shine := Math.exp(0 - (reflection - 0.42) * (reflection - 0.42) * 850)
    broad := Math.exp(0 - (reflection - 0.54) * (reflection - 0.54) * 35)
    // (the artifact's ground, 0x9A8A76: ARTIFACT)
    metal := V3⟨0.68, 0.40, 0.19⟩ * (0.34 - detail * 0.15 + grain * 0.05 - broad * 0.06 - shine * 0.045)
    growth := Patterns.layered(q * 0.6 + V2⟨time * 0.16, seed - time * 0.11⟩, 4)
    weather := Patterns.layered(q * 2.8 + V2⟨seed, 0⟩, 5) * 0.55 + grain * 0.25 + growth * 0.35
    rust := Math.smoothstep(0.46, 0.7, weather)
    pits := Math.smoothstep(0.58, 0.78, grain) * rust
    corrosion := Math.mix(texture * V3⟨0.72, 0.45, 0.26⟩, V3⟨0.30, 0.13, 0.052⟩, 0.4) * (0.75 + grain * 0.5)
    return Math.mix(metal, corrosion, rust * 0.85) * (1 - pits * 0.28)
}

// Each layer has a fixed orientation for this seat, independent of its reveal animation.
forest_layer_uv :: (uv: V2, seed: f32, layer: i64 -> V2) {
    angle := Patterns.hash(V2⟨seed + 0.73, f32'layer + 0.31⟩) * f32'Math.TAU
    c := Math.cos(angle)
    s := Math.sin(angle)
    return V2⟨c * uv.x - s * uv.y, s * uv.x + c * uv.y⟩
}

// Four disjoint time slots on the surface clock. Change generation in the
// middle of a short, fully transparent interval on either side of the wrap.
forest_layer_cycle :: (time: f32, seed: f32, layer: i64 -> V2) #pure {
    period: f32 = 152
    cycle := (time + 38 * f32'(3 - layer)) / period
    generation := Math.floor(cycle)
    within := Math.fract(cycle) * period
    change_at := 124 + 18 * Patterns.hash(V2⟨seed + f32'layer, generation + 0.49⟩)
    since := within - change_at
    current := if since >= 0 then generation + 1 else generation
    return ⟨seed + current * 17.37, Math.smoothstep(0.20, 2.20, Math.abs(since))⟩
}

layered_forest :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, uv: V2, time: f32, seed: f32 -> V3) {
    base := forest_layer_cycle(time, seed, 0)
    *rgb := material_at(atlas, filtering, 4, forest_layer_uv(uv, base.x, 0))
    for i: 0 < 3 {
        cycle := forest_layer_cycle(time, seed, i + 1)
        salt := f32'i + cycle.x * 0.37
        offset := V2⟨0.213 + f32'i * 0.317, 0.371 + f32'i * 0.193⟩
        at := forest_layer_uv(uv, cycle.x, i + 1) + offset
        copy := material_at(atlas, filtering, 4, at)
        patch := Patterns.layered(at * 13 + V2⟨salt, 2.7⟩, 3)
        phase := Patterns.layered(at * 5 + V2⟨3.1, salt⟩, 3) * 9
        life := 0.5 + 0.5 * Math.sin(time * (0.19 + f32'i * 0.037) + phase + salt * 2)
        reveal := Math.smoothstep(0.40, 0.68, patch + (life - 0.5) * 0.42)
        detail := Math.dot(copy, LUMA)
        leaf := Math.smoothstep(0.08, 0.24, detail)
        // The first overlay supplies solid cover while the base is absent.
        if i == 0 then rgb = Math.mix(copy, rgb, base.y)
        alpha := reveal * leaf * 0.72 * cycle.y
        rgb = Math.mix(rgb, copy, alpha)
    }
    return rgb
}


// Broad moving cloud shade and warm light over the anchored material.
// Use the surface clock so pause and animation speed affect both together.
material_cloud_light :: (rgb: V3, local: V2, look: V4, time: f32 -> V3) {
    q := local / Math.max(look.y * 10, 1) + V2⟨look.w * 0.17, look.w * 0.31⟩
    cloud := Patterns.layered(q + V2⟨time * 0.12, -time * 0.055⟩, 4)
    cover := Math.smoothstep(0.32, 0.70, cloud)
    light := Math.smoothstep(0.42, 0.75, 1 - cloud)
    lit := rgb * (0.86 + 0.22 * (1 - cover))
    return Math.mix(lit, lit * V3⟨1.12, 1.08, 1.01⟩ + V3⟨0.035, 0.028, 0.014⟩, light * 0.7)
}

// Shared by single-colour panels and both halves of a hybrid panel.
shade_panel_material :: (p: V2, local_x: f32, local_y: f32, base: V3, look: V4, more: V4, angle: f32, surface: f32, tile: i32, atlas: Shader.Texture_2D, filtering: Shader.Sampler -> V3) {
    // Keep the evolving stone and cracks, with the shared light above them.
    if tile == TILE_MARBLE then return material_cloud_light(living_marble(atlas, filtering, V2⟨local_x, local_y⟩ * 2 / Math.max(look.y * 5, 1), more.x, look.w), V2⟨local_x, local_y⟩, look, more.x)
    if tile == TILE_CRACKS then return material_cloud_light(living_cracks(V2⟨local_x, local_y⟩ / Math.max(look.y, 1), more.x, look.w, base), V2⟨local_x, local_y⟩, look, more.x)
    light := Math.mix(base, PART_WARM, 0.55)
    shade := base * PART_COOL
    // (its surface: a forest floor, rusting metal, open water, or its look's pattern lighting
    // and shading it; the first two in its player's frame)
    *rgb := base
    if is_surface(surface, .FOREST) {
        rgb = base * 0.8
    }
    else if is_surface(surface, .RUST) {
        rgb = base * 0.85
    }
    else if is_surface(surface, .WATER) {
        rgb = open_water_at(V2⟨local_x, local_y⟩, base, look.y, look.w, more.x)
    }
    else {
        // (marble's: the only kind that's a pattern here, black's and gold's;
        // white and red are materials of their own, returned above, blue's
        // water, green's forest and an artifact's rust its surfaces; a kind
        // known while compiling leaves the other kinds' code out of the stage,
        // which compiled for seconds on some drivers)
        v := Patterns.at(.MARBLE, p, look.y, look.w, more.x, angle, more.y, more.z)
        t := Math.clamp((v - 0.5) * 2, -1, 1) * look.z
        rgb = if t > 0 then Math.mix(base, light, t) else Math.mix(base, shade, 0 - t)
    }
    // Authored detail under animated lighting, in the player's frame.
    // Water is entirely procedural; solid material detail stays anchored.
    at := V2⟨local_x, local_y⟩ / Math.max(look.y * 18, 1) + V2⟨look.w * 0.17, look.w * 0.31⟩
    texel := if tile == TILE_FOREST then layered_forest(atlas, filtering, at, more.x, look.w) else material_at(atlas, filtering, tile, at)
    // Retain identity tint (especially multicolour gold) rather than painting
    // the atlas's colour over the panel's chosen identity.
    luma := Math.dot(texel, LUMA)
    *authored := Math.mix(base, texel, 0.4)
    if tile == TILE_GOLD then authored = base * (0.65 + luma * 0.7)
    if is_surface(surface, .FOREST) { authored = texel * V3⟨0.8, 1.12, 0.75⟩ }
    else if is_surface(surface, .RUST) { authored = Math.mix(base * (0.55 + luma), texel, 0.65) }
    else if is_surface(surface, .WATER) { authored = Math.mix(base, texel, 0.8) }
    weight: f32 = if is_surface(surface, .PATTERN) then 0.62 else 0.78
    if tile != TILE_WATER and tile != TILE_CRACKS then rgb = Math.mix(rgb, authored, weight * (0.65 + more.y * 0.5))
    // Contrast only: preserve the original moving pattern and illumination.
    if tile == TILE_BLACK then rgb = Math.max((rgb - V3⟨0.16, 0.16, 0.16⟩) * 1.35 + V3⟨0.16, 0.16, 0.16⟩, V3⟨0.006, 0.006, 0.006⟩)
    // These materials evolve in place rather than sliding a photograph.
    if tile == TILE_ARTIFACT {
        rgb = living_artifact(V2⟨local_x, local_y⟩ / Math.max(look.y * 5, 1), texel, more.x, look.w)
    }
    if tile != TILE_WATER and tile != TILE_GOLD then return material_cloud_light(rgb, V2⟨local_x, local_y⟩, look, more.x)
    return rgb
}

hybrid_fills_use_their_own_colours :: () #test {
    for a: 0 < 5 {
        for b: a + 1 < 5 {
            *colours: [5] Draw.RGBA
            identity := (u8'1 << u8'a) | (u8'1 << u8'b)
            count, _, _ := part_fill(identity, 100, 0, 0, 0, colours[:])
            assert(count == 2)
            assert(colours[0] == LOOKS.colours[Mana'u8'a].ground)
            assert(colours[1] == LOOKS.colours[Mana'u8'b].ground)
        }
    }
}
