// The elements: each colour's damage drawn in its own element's colour
// (white's sun, blue's water, black's oil, red's fire, green's wind, an
// artifact's metal), as the volleys that carry it: a glowing dot a point,
// flying along its arc, what of it gives light drawn again into the light
// layer, which add_light adds with its bloom; and a "-1" flying off the
// life total as each lands.

V3 :: #alias Math.Vector3(f32)
V4 :: #alias Math.Vector4(f32)

Element :: enum u8 {
    SUN       // white's
    WATER     // blue's
    OIL       // black's
    FIRE      // red's
    WIND      // green's
    CHROME    // an artifact's (no colours)
}

// A player's elements, in WUBRG order (Element's first five are the
// colours', in Mana's order), or chrome with none (into; how many).
elements_of :: (identity: Identity, into: [] *Element -> count: i64) #pure {
    count = 0
    for colour, i: [5] Mana⟨.WHITE, .BLUE, .BLACK, .RED, .GREEN⟩ {
        if has_colour(identity, colour) {
            into[count] = Element'u8'i
            count += 1
        }
    }
    if count == 0 {
        into[0] = .CHROME
        count = 1
    }
}

// How the bloom spreads (cells) and how strongly it's added.
BLOOM_CELLS :: 0.25
BLOOM_STRENGTH :: 0.65

// The volleys in flight and landing, then the light they give added with
// its bloom. (At rest, a player's damage spot is its two icons,
// draw_damage_icons'.)
draw_elements :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, volleys: Volleys) {
    // (no volley, nothing lit: no light to add)
    if volleys.list.count == 0 then return
    cell := cell_of(layout)
    layer.clear(Draw.rgb(0x000000))
    for v: volleys.list {
        if v.kind == .POISON { draw_poison_volley(canvas, layer, layout, fonts, v) } else { draw_volley(canvas, layer, layout, game, v) }
    }
    canvas.add_light(layer, BLOOM_CELLS * cell, BLOOM_STRENGTH)
}

// Each bolt travels for the same duration, leaving and landing in sequence.
bolt_along :: (age: f32, j: i64, n: i64 -> f32) #pure {
    t := (age - VOLLEY_GATHER - bolt_delay(j, n)) / VOLLEY_TRAVEL
    return Math.min(t, 1)
}

// The way across a path, a unit long (to one side of start to end).
across_path :: (start: V2, end: V2 -> V2) #pure {
    along := end - start
    if Math.length(along) < 0.001 then return ⟨0, 0⟩
    return V2⟨0 - along.y, along.x⟩ / Math.length(along)
}

// Small bright cores with coloured auras, following staggered raised arcs,
// each dot one of its player's elements' colours in turn.
draw_volley :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, layout: Layout, game: Game, v: Volley) {
    cell := cell_of(layout)
    *list: [6] Element
    n := elements_of(game.identity[v.from], list)
    colours := [Element] Draw.RGBA⟨SUN: Draw.rgb(0xFFE8A3), WATER: Draw.rgb(0x39AFFF),
        OIL: Draw.rgb(0x9E6FD9), FIRE: Draw.rgb(0xFF5426), WIND: Draw.rgb(0x62DE62), CHROME: Draw.rgb(0xD6B575)⟩
    for j: 0 < i64'v.amount {
        p := bolt_along(v.age, j, i64'v.amount)
        colour := colours[list[j % n]]
        hit_age := v.age - bolt_impact(v, j)
        if hit_age >= 0 and hit_age < 0.10 {
            flash := 1 - hit_age / 0.10
            canvas.fill_glow(v.end, cell * (0.12 + hit_age * 1.4), faded(colour, flash * flash), 0.8)
            layer.fill_glow(v.end, cell * 0.08, Draw.rgba(0xFFFFF4, flash * flash), 1)
        }
        if p < 0 or p >= 1 then continue
        bend := bolt_bend(v, j, cell)
        at := curve_at(v.start, bend, v.end, p)
        tangent := Math.mix(bend - v.start, v.end - bend, p)
        axis := if Math.length(tangent) > 0.001 then Math.normalize(tangent) * 1.45 else V2⟨0, 0⟩
        // A short taper follows the curve, measured in cells rather than
        // a fraction of the entire journey, so long attacks stay compact.
        tail_span := Math.min(0.09, cell * 0.32 / Math.max(Math.length(tangent) * 2, 1))
        for t: 1 <= 5 {
            behind := f32't / 5
            tail := curve_at(v.start, bend, v.end, Math.max(p - tail_span * behind, 0))
            radius := cell * (0.055 - behind * 0.040)
            canvas.fill_glow(tail, radius * 1.6, faded(colour, (1 - behind * 0.8) * 0.75), 0.8)
            layer.fill_glow(tail, radius, faded(colour, 1 - behind * 0.8), 1)
        }
        canvas.fill_glow(at + V2⟨0.08, 0.12⟩ * cell, cell * 0.16, Draw.rgba(0x000000, 0.3))
        canvas.fill_glow(at, cell * 0.19, colour, 0.65, axis)
        layer.fill_glow(at, cell * 0.10, colour, 1, axis)
        canvas.fill_glow(at, cell * 0.055, Draw.rgb(0xFFFFF4), 1, axis)
    }
}

// A poison counter's green, and its symbol's ink on it.
POISON_GREEN :: Draw.rgb(0x6CC63F)
POISON_INK   :: Draw.rgb(0x10200A)

// A poison volley: a poison token a point (a green counter with poison's
// symbol, facing its attacker), each flying along its arc as a damage dot
// does, one after another, landing with a green flash.
draw_poison_volley :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, layout: Layout, fonts: Fonts, v: Volley) {
    cell := cell_of(layout)
    r := 0.2 * cell
    angle := layout.seats[v.from].angle
    for j: 0 < i64'v.amount {
        p := bolt_along(v.age, j, i64'v.amount)
        hit_age := v.age - bolt_impact(v, j)
        if hit_age >= 0 and hit_age < 0.12 {
            flash := 1 - hit_age / 0.12
            canvas.fill_glow(v.end, cell * (0.15 + hit_age * 1.4), faded(POISON_GREEN, flash * flash), 0.7)
        }
        if p < 0 or p >= 1 then continue
        at := curve_at(v.start, bolt_bend(v, j, cell), v.end, p)
        canvas.fill_glow(at + V2⟨0.06, 0.09⟩ * cell, r * 1.5, Draw.rgba(0x000000, 0.35))
        canvas.fill_circle(at, r + Math.max(1.5, cell * 0.025), POISON_INK)
        canvas.fill_circle(at, r, POISON_GREEN)
        layer.fill_glow(at, r * 1.2, faded(POISON_GREEN, 0.5), 1)
        draw_centred(canvas, fonts.commander_badge, at, angle, POISON_GLYPH, POISON_INK)
    }
}

// The two labels share a small texture. Projecting the lettering with the disc
// keeps it attached to the face all the way through the lifelink flip.
loss_faces: Kept_Canvas

prepare_loss_faces :: (font: Draw.Font, side: i32 -> bool) {
    size := Wide.i32x2⟨side * 2, side⟩
    if loss_faces.made and loss_faces.canvas.size == size then return true
    if !loss_faces.prepare(size) then return false
    loss_faces.canvas.clear(Draw.rgb(0x000000))
    for label, i: [2] string⟨"-1", "+1"⟩ {
        at := V2⟨(f32'i + 0.5) * f32'side, 0.5 * f32'side⟩
        draw_centred(loss_faces.canvas, font, at, 0, label, Draw.rgb(0xFFFFFF))
    }
    return true
}

Loss_Disc_Params :: struct { disc: V4; turn: V4 }
loss_disc_shade :: (from: Draw.Quad_Between, token: Shader.Uniforms(Loss_Disc_Params), labels: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    d := from.pixel - token.disc.xy
    facing := token.turn.z
    scale := Math.max(Math.abs(facing), 1 / token.disc.z)
    p := V2⟨Math.dot(d, token.turn.xy) / scale, d.y * token.turn.x - d.x * token.turn.y⟩
    length := Math.length(p)
    // Convert the ellipse's boundary distance back to screen pixels for antialiasing.
    gradient := Math.length(V2⟨p.x / scale, p.y⟩) / Math.max(length, 0.001)
    cover := Math.clamp(0.5 + (token.disc.z - length) / Math.max(gradient, 1), 0, 1)
    uv := p / (2 * token.disc.z) + V2⟨0.5, 0.5⟩
    face := token.turn.w
    glyph := Shader.sample_level(labels, filtering, V2⟨(uv.x + face) * 0.5, uv.y⟩, 0).x
    tone := Math.mix(glyph, 1 - glyph, face)
    return V4⟨tone, tone, tone, 1⟩ * (cover * token.disc.w)
}
Loss_Disc :: shader { vertex: Draw.quad_place; fragment: loss_disc_shade }
LOSS_DISC :: Loss_Disc(Draw.SHADER_TARGET)

// Positive shows the loss face, zero is edge-on, negative shows the gain.
// Only displacement back toward the attacker can reveal the gain face.
lifelink_disc_facing :: (pivot: V2, return_travel: V2, attacker: V2 -> f32) #pure {
    home := attacker - pivot
    fraction_back := Math.dot(return_travel, home) / Math.max(Math.dot(home, home), 0.001)
    flip := Math.smoothstep(0, 0.55, Math.sqrt(Math.clamp(fraction_back, 0, 1)))
    return Math.cos(f32'Math.PI * flip)
}

// Each landed point of life flies out along the impact, facing the victim:
// a "-1" of their life (poison's tokens are their own count: none).
draw_bolt_losses :: (canvas: *Draw.Canvas, layout: Layout, fonts: Fonts, volleys: Volleys) {
    cell := cell_of(layout)
    if volleys.list.count == 0 then return
    side_pixels := i32'Math.ceil(Math.max(f32'fonts.loss.text_width("+1") * 1.45, f32'fonts.loss.cap_height * 2.1))
    if !prepare_loss_faces(fonts.loss, side_pixels) then return
    radius := f32'side_pixels / 2
    for v: volleys.list {
        if v.kind == .POISON then continue
        link := has_lifelink(v.kind)
        seat := layout.seats[v.to]
        for j: 0 < i64'v.landed {
            age := v.age - bolt_impact(v, j)
            duration: f32 = if link then LIFELINK_ARRIVAL else LOSS_DURATION
            if age < 0 or age >= duration then continue
            way := bolt_direction(v, j, cell)
            spread := Math.sin(f32'j * 2.39996 + f32'v.id * 1.73)
            side := V2⟨0 - way.y, way.x⟩ * spread
            brake: f32 = if link then LIFELINK_TURN else LOSS_OUTWARD
            remaining := 1 - Math.clamp(age / brake, 0, 1)
            out_time := brake / 3 * (1 - remaining * remaining * remaining)
            origin := v.end + (way * 0.45 + side * 0.28) * cell
            push := (way * 10 + side * 5) * cell
            pivot := origin + push * (brake / 3)
            outbound := if age >= brake then pivot else origin + push * out_time
            *at := outbound
            *turn := seat.angle + spread * out_time * 1.1
            attacker := layout.seats[v.from]
            if link and age >= LIFELINK_TURN {
                progress := (age - LIFELINK_TURN) / LIFELINK_FLIGHT
                bend := (pivot + attacker.middle) / 2 + across_path(pivot, attacker.middle) * (cell * spread * 0.9)
                at = curve_at(pivot, bend, attacker.middle, progress * progress)
                delta := attacker.angle - turn
                turn += Math.atan2(Math.sin(delta), Math.cos(delta)) * Math.smoothstep(0, 1, progress)
            }
            facing: f32 = if link then lifelink_disc_facing(pivot, at - outbound, attacker.middle) else 1
            fade: f32 = if link then 1 else 1 - Math.smoothstep(LOSS_OUTWARD, duration, age)
            face: f32 = if facing < 0 then 1 else 0
            params := Loss_Disc_Params⟨⟨at.x, at.y, radius, fade⟩, ⟨Math.cos(turn), Math.sin(turn), facing, face⟩⟩
            half := V2⟨radius + 1, radius + 1⟩
            canvas.draw_shader_canvas(at - half, half * 2, LOSS_DISC.code, LOSS_DISC.bindings.token, params,
                                      loss_faces.canvas, LOSS_DISC.bindings.labels, LOSS_DISC.bindings.filtering)
        }
    }
}
