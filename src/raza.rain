// Raza: a damage tracker for Commander, for a tablet in the middle of the
// table. Each player has a part of the screen, their life total in it
// facing them, and a damage icon toward the centre: dragged into another
// player's part, it deals that player commander damage, more the further it
// goes (1 to 9 out to the life total, then a picker starting at 10). The parts start
// as wide as each other across their life totals, mirrored about the
// screen's upright middle, and a line between two is moved by dragging its
// end along the edge. The capsule in the middle undoes, shows how many play (a person
// each: touched, the other counts show above and below it, to drag to for
// a new game), and holds the settings. The text is Crimson Pro's. The game
// and each count's lines are kept from one run to the next (Defaults', the
// registry's).
//
//     rain -run src/raza.rain
//
// A dev build (rain src/raza.rain) goes in build/; for the tablet, `rain
// -release src/raza.rain` makes release/Raza.exe, optimized through LLVM,
// each frame's work about two thirds of a debug build's.

Raza :: program {
    subsystem: .WINDOWS
    debug {
        mode: .DEBUG
        output_folder: "../build/"
    }
    release {
        mode: .RELEASE
        optimization: .SPEED
        output_folder: "../release/"
    }
}

#import Draw(RENDERER: .VULKAN)
#import Window
#import Math
#import System
#import Wide
#import Arguments
#import Defaults
#import Time
#import Patterns
#import Particles
#import Shader
#import Random
#import Icons(SETS: .MDI)
#import Console
#include "icons/icons.rain"

#include "layout.rain"
#include "game.rain"
#include "background-tuning.rain"
#include "frames.rain"
#include "count-table.rain"
#include "target-arrow.rain"
#include "materials.rain"
#include "motes.rain"
#include "elements.rain"

V2 :: #alias Math.Vector2(f32)

// The fonts, carried in the program.
MANA        :: #data "../fonts/mana/mana.ttf"
CRIMSON_PRO :: #data "../fonts/crimson_pro/CrimsonPro[wght].ttf"

TEXT_FAMILY :: "Crimson Pro"
ICON_FAMILY :: "Mana"            // Magic's own symbols (the colours'); other icons are the Icons module's

// Each colour's symbol (Mana's ms-w to ms-g), in WUBRG order; its circle's
// colour (Magic's own, as the cards' mana symbols are printed); and the
// colour a player's part is in that colour (the colour pie's).
MANA_GLYPHS  :: [Mana] string⟨"\u{E600}", "\u{E601}", "\u{E602}", "\u{E603}", "\u{E604}"⟩
MANA_CIRCLES :: [Mana] Draw.RGBA⟨Draw.rgb(0xFFFBD5), Draw.rgb(0xAAE0FA), Draw.rgb(0xCBC2BF), Draw.rgb(0xF9AA8F), Draw.rgb(0x9BD3AE)⟩
MANA_GROUNDS :: [Mana] Draw.RGBA⟨Draw.rgb(0xF9FAF4), Draw.rgb(0x0E68AB), Draw.rgb(0x150B00), Draw.rgb(0xD3202A), Draw.rgb(0x00733E)⟩
MANA_INK     :: Draw.rgb(0x111111)

// The life total's ink on a light part (white's).
DARK_INK :: Draw.rgb(0x1C1A17)

// How light a colour looks, from 0 to 1.
lightness :: (c: Draw.RGBA -> f32) #pure {
    return 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b
}

// A gradient's colour at its middle (its colours evenly spaced along it).
middle_of :: (colours: [] Draw.RGBA -> Draw.RGBA) #pure {
    s := 0.5 * f32'(colours.count - 1)
    i := Math.min(i64'Math.floor(s), colours.count - 2)
    if colours.count < 2 then return colours[0]
    return Math.mix(colours[i], colours[i + 1], s - f32'i)
}

BACKGROUND :: Draw.rgb(0x131318)
INK        :: Draw.rgb(0xF4EFE6)
CAPSULE    :: Draw.rgb(0x26262E)

// The unit the controls are measured in: a share of the screen's shorter side.
CELL_SHARE :: 0.075

cell_of :: (layout: Layout -> f32) #pure {
    return Math.min(layout.size.x, layout.size.y) * CELL_SHARE
}

// A colour toward white.
lighter :: (colour: Draw.RGBA, by: f32 -> Draw.RGBA) #pure {
    return Math.mix(colour, INK, by)
}

////////////////////////////////
// Colour identity: five toggles at each player's bottom left, in a pentagon
// as Magic's card back has them, folding into one five-colour icon when
// they've been left alone a moment

TOGGLE_RADIUS :: 0.26          // in cells
TOGGLE_RING   :: 0.56          // from the pentagon's middle to each toggle's

// Whether toggles of radius r at the places are inside the part and clear
// of its sides.
toggles_fit :: (points: [] V2, places: [5] V2, r: f32 -> bool) #pure {
    for c: places {
        if !inside(c, points) then return false
        for a, i: points {
            if distance_to_segment(c, a, points[(i + 1) % points.count]) < r then return false
        }
    }
    return true
}

// Where a part's colour toggles go: folded, the five-colour icon in its
// player's bottom left corner, as near it as it fits; open, a pentagon in
// their frame, in Mana's order (WUBRG) as a card's back has them, white at
// its top as they see it, then blue, black, red and green clockwise, its
// middle as near the icon as it fits (so opening, it moves out as little as
// it can); each the gap clear of the part's sides.
toggle_places :: (layout: Layout, seat: Seat -> places: [5] V2, middle: V2, folded: V2) #pure {
    places = ⟨⟩
    middle = seat.middle
    folded = seat.middle
    cell := cell_of(layout)
    reach := (TOGGLE_RING + TOGGLE_RADIUS) * cell
    r := TOGGLE_RADIUS * cell
    gap := TOGGLE_GAP * cell
    points := seat.outline[:seat.count]
    // (the part in its player's frame: x along their text, y toward them)
    *left: f32 = 1e30
    *right: f32 = -1e30
    *top: f32 = 1e30
    *bottom: f32 = -1e30
    for p: points {
        l := local_of(seat.middle, seat.angle, p)
        left = Math.min(left, l.x)
        right = Math.max(right, l.x)
        top = Math.min(top, l.y)
        bottom = Math.max(bottom, l.y)
    }
    // The icon: of places in steps (two) across the part, the nearest its
    // player's bottom left corner (its bounds') that fits, then halved toward
    // the corner to where it only just does.
    step := 0.1 * cell
    corner_of_part := V2⟨left, bottom⟩
    *corner := V2⟨left + r + gap, bottom - r - gap⟩
    *nearest: f32 = 1e30
    *y := bottom - r - gap
    while y > top + r + gap {
        *x := left + r + gap
        while x < right - r - gap {
            d := Math.length(V2⟨x, y⟩ - corner_of_part)
            if d < nearest and icon_fits(seat, points, x, y, r + gap) {
                corner = ⟨x, y⟩
                nearest = d
            }
            x += 2 * step
        }
        y -= 2 * step
    }
    if nearest < 1e30 {
        *near := corner_of_part
        *far := corner
        for _: 0 < 12 {
            halfway := (near + far) / 2
            if icon_fits(seat, points, halfway.x, halfway.y, r + gap) then far = halfway else near = halfway
        }
        corner = far
    }
    // Intersect fixed-distance offsets of a screen edge and a channel.
    // All icons use the same clearance, including the channel's visible bevel.
    // Choose the furthest-left valid intersection in the player''s frame.
    *furthest_left: f32 = 1e30
    for edge: 1 < points.count - 1 {
        a := points[edge]
        direction := points[edge + 1] - a
        if Math.length(direction) < 0.001 then continue
        *normal := Math.normalize(V2⟨0 - direction.y, direction.x⟩)
        if Math.dot(normal, seat.middle - a) < 0 then normal = normal * -1.0
        screen_offset := Math.dot(normal, a) + r + gap
        for channel: [2] i64⟨0, points.count - 1⟩ {
            b := points[channel]
            along := points[(channel + 1) % points.count] - b
            if Math.length(along) < 0.001 then continue
            *inward := Math.normalize(V2⟨0 - along.y, along.x⟩)
            if Math.dot(inward, seat.middle - b) < 0 then inward = inward * -1.0
            channel_offset := Math.dot(inward, b) + r + gap + BEVEL_CELLS * cell
            determinant := normal.x * inward.y - normal.y * inward.x
            if Math.abs(determinant) < 0.0001 then continue
            candidate := V2⟨screen_offset * inward.y - normal.y * channel_offset,
                            normal.x * channel_offset - screen_offset * inward.x⟩ / determinant
            if !inside(candidate, points) then continue
            *fits := true
            for start, index: points {
                bevel := if index == 0 or index == points.count - 1 then BEVEL_CELLS * cell else 0
                margin := r + gap + bevel
                if distance_to_segment(candidate, start, points[(index + 1) % points.count]) < margin - 0.01 then fits = false
            }
            if !fits then continue
            local := local_of(seat.middle, seat.angle, candidate)
            // Left is measured in the player's rotated frame, not screen coordinates.
            if local.x < furthest_left - 0.01 or (Math.abs(local.x - furthest_left) <= 0.01 and local.y > corner.y) {
                corner = local
                furthest_left = local.x
            }
        }
    }
    folded = placed(seat.middle, seat.angle, corner)
    // The pentagon: of middles in steps about the icon, the nearest it that
    // fits, then halved toward the icon to where it only just does.
    span := 3 * reach
    *best := corner
    *best_distance: f32 = 1e30
    *gy := corner.y - span
    while gy <= corner.y + span {
        *gx := corner.x - span
        while gx <= corner.x + span {
            at := V2⟨gx, gy⟩
            d := Math.length(at - corner)
            if d < best_distance and pentagon_fits(layout, seat, points, gx, gy) {
                best = at
                best_distance = d
            }
            gx += step
        }
        gy += step
    }
    if best_distance == 1e30 {
        // (a part with no room: the pentagon at its player's edge, for what shows)
        places = pentagon(seat, left + reach, bottom - reach - gap, cell)
        middle = placed(seat.middle, seat.angle, ⟨left + reach, bottom - reach - gap⟩)
        return
    }
    *near := corner
    *far := best
    for _: 0 < 12 {
        halfway := (near + far) / 2
        if pentagon_fits(layout, seat, points, halfway.x, halfway.y) then far = halfway else near = halfway
    }
    places = pentagon(seat, far.x, far.y, cell)
    middle = placed(seat.middle, seat.angle, far)
}

// Whether the folded icon, its middle at x, y in a part's player's frame,
// fits: in the part, clear of its sides by clear.
icon_fits :: (seat: Seat, points: [] V2, x: f32, y: f32, clear: f32 -> bool) #pure {
    at := placed(seat.middle, seat.angle, ⟨x, y⟩)
    return inside(at, points) and clearance(at, points) >= clear
}

// Whether a part's toggle pentagon, its middle at x, y in its player's
// frame, fits: its middle in the part, each toggle the gap from its sides.
pentagon_fits :: (layout: Layout, seat: Seat, points: [] V2, x: f32, y: f32 -> bool) #pure {
    cell := cell_of(layout)
    r := TOGGLE_RADIUS * cell
    gap := TOGGLE_GAP * cell
    if !inside(placed(seat.middle, seat.angle, ⟨x, y⟩), points) then return false
    return toggles_fit(points, pentagon(seat, x, y, cell), r + gap)
}

// The five toggles' places about a middle at x, y in a part's player's
// frame: the i'th colour (Mana's order) i fifths of a turn clockwise from
// the top as they see it.
pentagon :: (seat: Seat, x: f32, y: f32, cell: f32 -> places: [5] V2) #pure {
    places = ⟨⟩
    for i: 0 < 5 {
        a := f32'i * f32'Math.TAU / 5
        places[i] = placed(seat.middle, seat.angle, ⟨x + Math.sin(a) * TOGGLE_RING * cell, y - Math.cos(a) * TOGGLE_RING * cell⟩)
    }
}

// The gap from a colour toggle to the screen's edge and to its part's
// divider, in cells.
TOGGLE_GAP :: 0.3

// The toggles fold into one five-colour icon (FIVE_COLOURS, its side in
// cells) in their player's corner once a player who's set one has left them
// TOGGLE_LINGER seconds, folding or opening over TOGGLE_FOLD seconds; the
// pentagon's middle touched folds them at once. The icon touched opens them
// for TOGGLE_OPENED seconds, each one set then giving TOGGLE_LINGER again.
// After a reset (every seat its starting colours) they're open, and stay so
// until one's set; a restart or a new count keeps the colours, and the
// toggles as they were.
TOGGLE_OPENED :: 3.0
TOGGLE_LINGER :: 2.0
TOGGLE_FOLD   :: 0.2
FIVE_COLOURS_SIDE :: 2 * TOGGLE_RADIUS / 0.84     // its dots as wide as a toggle (the image has 8% of its side clear round them)

// Each player's toggles' state: open or folded, how far open as they're
// drawn (0 folded, 1 open), and the seconds left before they fold (none:
// open until one's set).
Toggles :: struct {
    open:  [MAX_PLAYERS] bool = ⟨true, true, true, true, true, true⟩
    shown: [MAX_PLAYERS] f32 = ⟨1, 1, 1, 1, 1, 1⟩
    left:  [MAX_PLAYERS] f32 = ⟨-1, -1, -1, -1, -1, -1⟩
}

// Every player's toggles folded (a game carried on from the last run).
fold_toggles :: (toggles: *Toggles) {
    for *o: toggles.open { o = false }
    for *s: toggles.shown { s = 0 }
}

// The five-colour icon (Magic's card back's five dots, textures'), made an
// image as Raza starts.
FIVE_COLOURS_BYTES :: #data "../textures/five-colour-dots-96.png"
five_colours_image: Draw.Image

Five_Colours_Params :: struct {
    box:  V4      // its middle, and its half side (pixels), then unused
    turn: V4      // cosine, sine, overall visibility, green-dot opacity
    dots: V4      // white, blue, black and red dot opacity
}

// The five-colour icon turned about its middle as its player's text is,
// shown a share (its colour premultiplied, as the image is).
five_colours_shade :: (from: Draw.Quad_Between, badge: Shader.Uniforms(Five_Colours_Params), texture: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    d := from.pixel - badge.box.xy
    // (into the icon's own frame: turned back by its turn)
    local := V2⟨d.x * badge.turn.x + d.y * badge.turn.y, d.y * badge.turn.x - d.x * badge.turn.y⟩
    uv := local / Math.max(badge.box.z * 2, 1) + V2⟨0.5, 0.5⟩
    if uv.x < 0 or uv.x > 1 or uv.y < 0 or uv.y > 1 then return ⟨0, 0, 0, 0⟩
    // Pick the nearest dot in the unrotated texture; the gaps are transparent.
    weights := [5] f32⟨badge.dots.x, badge.dots.y, badge.dots.z, badge.dots.w, badge.turn.w⟩
    *nearest: f32 = 1e30
    *opacity: f32 = 1
    for i: 0 < 5 {
        angle := f32'i * f32'Math.TAU / 5
        centre := V2⟨0.5, 0.55⟩ + V2⟨Math.sin(angle), 0 - Math.cos(angle)⟩ * 0.29
        delta := uv - centre
        distance := Math.dot(delta, delta)
        if distance < nearest {
            nearest = distance
            opacity = weights[i]
        }
    }
    colour = Shader.sample_level(texture, filtering, uv, 0) * (badge.turn.z * opacity)
}

Five_Colours :: shader { vertex: Draw.quad_place; fragment: five_colours_shade }
FIVE_COLOURS :: Five_Colours(Draw.SHADER_TARGET)

// The five-colour icon drawn about a middle, its side side, turned by
// angle, shown a share.
draw_five_colours :: (canvas: *Draw.Canvas, middle: V2, side: f32, angle: f32, shows: f32, identity: Identity) {
    // (a square big enough for its corners however it's turned)
    reach := side * 0.75
    *weights: [5] f32
    for *weight, i: weights {
        weight = if has_colour(identity, Mana'i) then 1 else f32'1 / 3
    }
    params := Five_Colours_Params⟨V4⟨middle.x, middle.y, side / 2, 0⟩,
                                  V4⟨Math.cos(angle), Math.sin(angle), shows, weights[4]⟩,
                                  V4⟨weights[0], weights[1], weights[2], weights[3]⟩⟩
    canvas.draw_shader_image(middle - V2⟨reach, reach⟩, V2⟨reach, reach⟩ * 2, FIVE_COLOURS.code, FIVE_COLOURS.bindings.badge, params, five_colours_image,
                             FIVE_COLOURS.bindings.texture, FIVE_COLOURS.bindings.filtering)
}

// Every player's toggles open until one's set (a reset).
open_toggles :: (toggles: *Toggles) {
    for *o: toggles.open { o = true }
    for *l: toggles.left { l = -1 }
}

// A player's toggle set: open, folding TOGGLE_LINGER seconds from now.
touch_toggles :: (toggles: *Toggles, k: i64) {
    toggles.open[k] = true
    toggles.left[k] = TOGGLE_LINGER
}

// A player's five-colour icon touched: open, folding TOGGLE_OPENED seconds
// from now.
unfold_toggles :: (toggles: *Toggles, k: i64) {
    toggles.open[k] = true
    toggles.left[k] = TOGGLE_OPENED
}

// A player's open pentagon's middle touched: folding now.
fold_now :: (toggles: *Toggles, k: i64) {
    toggles.open[k] = false
    toggles.left[k] = 0
}

// Every player's toggles moved on by a frame's time: counting down to
// folding, and opening or folding as they're drawn.
step_toggles :: (toggles: *Toggles, seconds: f32) {
    for k: 0 < MAX_PLAYERS {
        if toggles.open[k] and toggles.left[k] > 0 {
            toggles.left[k] -= seconds
            if toggles.left[k] <= 0 then toggles.open[k] = false
        }
        way: f32 = if toggles.open[k] then 1 else -1
        toggles.shown[k] = Math.clamp(toggles.shown[k] + way * seconds / TOGGLE_FOLD, 0, 1)
    }
}

// The nearest a point comes to a polygon's edges.
clearance :: (p: V2, points: [] V2 -> f32) #pure {
    *least: f32 = 1e30
    for a, i: points { least = Math.min(least, distance_to_segment(p, a, points[(i + 1) % points.count])) }
    return least
}

// Each player's damage spot (seat.icon) is two icons side by side across it
// as its player sees it: combat damage's on their left (commander damage,
// toward the 21), a spell's on their right (life alone). Each is
// DAMAGE_ICON_APART cells from the spot, DAMAGE_ICON_RADIUS cells round.
DAMAGE_ICON_APART  :: 0.5
DAMAGE_ICON_RADIUS :: 0.42
COMBAT_GLYPH :: "\u{E9D1}" // Mana ms-battle
SPELL_GLYPH :: "\u{E624}" // Mana ms-sorcery

// Where a player's combat damage's icon is, or their spell damage's.
damage_icon :: (layout: Layout, k: i64, combat: bool -> V2) #pure {
    seat := layout.seats[k]
    side: f32 = if combat then -1 else 1
    return placed(seat.icon, seat.angle, V2⟨side * DAMAGE_ICON_APART * cell_of(layout), 0⟩)
}

// The visible attack circles stay clear of the channel's rounded wall.
ATTACK_CHANNEL_GAP :: 0.12
attack_buttons_clear :: (layout: Layout -> bool) #pure {
    clearance_needed := (DAMAGE_ICON_RADIUS + BEVEL_CELLS + ATTACK_CHANNEL_GAP) * cell_of(layout)
    for seat, k: layout.seats[:layout.count] {
        points := seat.outline[:seat.count]
        for combat: [2] bool⟨true, false⟩ {
            at := damage_icon(layout, k, combat)
            if !inside(at, points) then return false
            if distance_to_segment(at, points[0], points[1]) < clearance_needed then return false
            if distance_to_segment(at, points[points.count - 1], points[0]) < clearance_needed then return false
        }
    }
    return true
}

// Accept clear destinations directly; otherwise stop at the clearance limit.
move_split_with_clearance :: (splits: *Splits, k: i64, share: f32, size: V2) {
    original := splits
    *wanted := original
    wanted.move_split(k, share)
    if attack_buttons_clear(lay_out(size, wanted)) {
        splits = wanted
        return
    }
    previous := original.at[(k + original.count - 1) % original.count]
    start := wrapped_share(original.at[k] - previous)
    finish := wrapped_share(wanted.at[k] - previous)
    *safe: f32 = 0
    for step: 1 <= 32 {
        fraction := f32'step / 32
        *candidate := original
        candidate.at[k] = wrapped_share(previous + Math.mix(start, finish, fraction))
        if attack_buttons_clear(lay_out(size, candidate)) {
            safe = fraction
            splits = candidate
        } else {
            *blocked := fraction
            for _: 0 < 16 {
                halfway := (safe + blocked) / 2
                candidate.at[k] = wrapped_share(previous + Math.mix(start, finish, halfway))
                if attack_buttons_clear(lay_out(size, candidate)) {
                    safe = halfway
                    splits = candidate
                } else {
                    blocked = halfway
                }
            }
            return
        }
    }
}
// Each player's two damage icons (not a player who's out's), each on a dark
// round chip, turned to face them; the one being dragged from lit.
draw_damage_icons :: (canvas: *Draw.Canvas, layout: Layout, game: Game, drag: Drag, drum: Life_Drum, fonts: Fonts) {
    cell := cell_of(layout)
    for k: 0 < layout.count {
        if is_out(game, k) then continue
        seat := layout.seats[k]
        for combat: [2] bool⟨true, false⟩ {
            at := damage_icon(layout, k, combat)
            dragged := drag.active and drag.from == k and drag.combat == combat
            chip := if dragged then lighter(CAPSULE, 0.3) else Draw.rgba(0x16161C, 0.62)
            shows := player_controls_visibility(drum, k)
            canvas.fill_circle(at, DAMAGE_ICON_RADIUS * cell, faded(chip, shows))
            glyph := if combat then COMBAT_GLYPH else SPELL_GLYPH
            draw_centred(canvas, fonts.attack, at, seat.angle, glyph, faded(INK, shows))
        }
    }
}

// The damage icon at a point, of a player who isn't out: its player, and
// whether it's combat damage's; or absent.
icon_at :: (layout: Layout, game: Game, p: V2 -> player: i64, combat: bool) [absent] {
    player = -1
    combat = true
    reach := DAMAGE_ICON_RADIUS * cell_of(layout)
    for k: 0 < layout.count {
        if is_out(game, k) then continue
        for which: [2] bool⟨true, false⟩ {
            if Math.length(p - damage_icon(layout, k, which)) <= reach {
                player = k
                combat = which
                return
            }
        }
    }
    fail: absent
}

// Each part's toggle places, kept: toggle_places searches, and the layout
// changes only as a line moves or the screen's size does, so they're worked
// out again only then (every frame of a line's moving, as before; once
// otherwise).
Toggle_Cache :: struct {
    size:    V2
    splits:  Splits
    places:  [MAX_PLAYERS] [5] V2
    middles: [MAX_PLAYERS] V2
    folded:  [MAX_PLAYERS] V2
}

toggle_cache: Toggle_Cache

// A part's toggle places and their pentagon's middle (toggle_places'), from
// the cache.
toggles_of :: (layout: Layout, k: i64 -> [5] V2) {
    fill_toggle_cache(layout)
    return toggle_cache.places[k]
}

toggle_middle :: (layout: Layout, k: i64 -> V2) {
    fill_toggle_cache(layout)
    return toggle_cache.middles[k]
}

// Where a part's five-colour icon is, folded (toggle_places').
toggle_folded :: (layout: Layout, k: i64 -> V2) {
    fill_toggle_cache(layout)
    return toggle_cache.folded[k]
}

fill_toggle_cache :: (layout: Layout) {
    if toggle_cache.size == layout.size and toggle_cache.splits == layout.splits then return
    toggle_cache.size = layout.size
    toggle_cache.splits = layout.splits
    for seat, s: layout.seats[:layout.count] {
        places, middle, folded := toggle_places(layout, seat)
        toggle_cache.places[s] = places
        toggle_cache.middles[s] = middle
        toggle_cache.folded[s] = folded
    }
}

// The colour toggle at a point, of a part whose toggles are open: its part,
// and which colour; or absent.
toggle_at :: (layout: Layout, toggles: Toggles, p: V2 -> seat: i64, colour: i64) [absent] {
    seat = 0
    colour = 0
    r := TOGGLE_RADIUS * cell_of(layout)
    for s, k: layout.seats[:layout.count] {
        if !toggles.open[k] then continue
        for place, i: toggles_of(layout, k) {
            if Math.length(p - place) <= r * 1.15 {
                seat = k
                colour = i
                return
            }
        }
    }
    fail: absent
}

// The five-colour icon at a point, of a part whose toggles are folded: its
// part; or absent.
five_colours_at :: (layout: Layout, toggles: Toggles, p: V2 -> i64) [absent] {
    reach := FIVE_COLOURS_SIDE / 2 * cell_of(layout)
    for k: 0 < layout.count {
        if !toggles.open[k] and Math.length(p - toggle_folded(layout, k)) <= reach then return k
    }
    fail: absent
}

// The open pentagon's middle at a point (the space inside its five toggles),
// of a part whose toggles are open: its part; or absent.
pentagon_middle_at :: (layout: Layout, toggles: Toggles, p: V2 -> i64) [absent] {
    reach := (TOGGLE_RING - TOGGLE_RADIUS) * cell_of(layout)
    for k: 0 < layout.count {
        if toggles.open[k] and Math.length(p - toggle_middle(layout, k)) <= reach then return k
    }
    fail: absent
}

// A player's own colour, where one stands for them (the commander damage
// they've done, their damage icon, their drag): their identity's first
// colour (WUBRG), or an artifact's when they've none.
accent_of :: (identity: Identity, artifact: Draw.RGBA -> Draw.RGBA) #pure {
    for ground, colour: MANA_GROUNDS {
        if has_colour(identity, colour) then return ground
    }
    return artifact
}

// Ink that reads on a colour: dark on a light one.
ink_on :: (colour: Draw.RGBA -> Draw.RGBA) #pure {
    return if lightness(colour) > 0.6 then DARK_INK else INK
}


////////////////////////////////
// Fonts

Fonts :: struct {
    life:      Draw.Font         // the life totals
    life_size: i32               // ...its size
    small:     Draw.Font         // commander damage
    label:     Draw.Font         // the number grid's buttons
    output:    Draw.Font         // the number grid's number
    attack:    Draw.Font         // Mana battle and sorcery symbols
    mana:      Draw.Font         // Mana's, for the colour toggles
    change:    Draw.Font         // a life drum's change, DRUM_CHANGE of the life's size
}

// How many steps of size a cell has for the life totals: the size moves in
// these as a line's end is dragged, so only a few sizes' glyphs are ever
// drawn (each size's are kept for good once drawn).
LIFE_STEPS :: 8

// The life totals' size for a layout: as big as the smallest part has room
// for (every part's the same), from 1 to 6 cells, in steps of an eighth of
// a cell.
life_size_of :: (layout: Layout -> i32) #pure {
    cell := cell_of(layout)
    *room: f32 = 1e30
    for seat: layout.seats[:layout.count] { room = Math.min(room, seat.room) }
    wanted := Math.clamp(room * 1.15, cell, 6 * cell)
    step := cell / LIFE_STEPS
    return i32'Math.round(Math.round(wanted / step) * step)
}

// The life totals' font made again, if the layout wants another size: as a
// line's end is dragged, each frame.
resize_life :: (fonts: *Fonts, family: string, layout: Layout) [os_error: Draw.Draw_Error] {
    size := life_size_of(layout)
    if size == fonts.life_size then return
    fonts.life.destroy()
    if big := Draw.load_font(family, size, 500) { fonts.life = big } else if os_error { fail: os_error }
    fonts.life_size = size
    fonts.change.destroy()
    if change := Draw.load_font(family, i32'(f32'size * DRUM_CHANGE), 500) { fonts.change = change } else if os_error { fail: os_error }
}

// The fonts for a layout, the text in a family.
load_fonts :: (family: string, layout: Layout -> fonts: Fonts) [os_error: Draw.Draw_Error] {
    fonts = ⟨⟩
    cell := cell_of(layout)
    life := life_size_of(layout)
    if big := Draw.load_font(family, life, 500) { fonts.life = big } else if os_error { fail: os_error }
    fonts.life_size = life
    if change := Draw.load_font(family, i32'(f32'life * DRUM_CHANGE), 500) { fonts.change = change } else if os_error { fail: os_error }
    if small := Draw.load_font(family, i32'(cell * 0.42), 600) { fonts.small = small } else if os_error { fail: os_error }
    if label := Draw.load_font(family, i32'(cell * 0.45), 500) { fonts.label = label } else if os_error { fail: os_error }
    if output := Draw.load_font(family, i32'(cell * 0.8), 500) { fonts.output = output } else if os_error { fail: os_error }
    if mana := Draw.load_font(ICON_FAMILY, i32'(cell * TOGGLE_RADIUS * 1.25)) { fonts.mana = mana } else if os_error { fail: os_error }
    if attack := Draw.load_font(ICON_FAMILY, i32'(cell * 0.5)) { fonts.attack = attack } else if os_error { fail: os_error }
}

// The fonts made again, for a new layout.
reload_fonts :: (fonts: *Fonts, family: string, layout: Layout) [os_error: Draw.Draw_Error] {
    fonts.life.destroy()
    fonts.small.destroy()
    fonts.label.destroy()
    fonts.output.destroy()
    fonts.mana.destroy()
    fonts.attack.destroy()
    fonts.change.destroy()
    if loaded := load_fonts(family, layout) { fonts = loaded } else if os_error { fail: os_error }
}

////////////////////////////////
// Dragging, and the number grid

// A drag from one of a player's two damage icons, while the button's down:
// combat damage's (commander damage) or a spell's (life alone).
Drag :: struct {
    active: bool
    from:   i64
    combat: bool = true
}

// Where a line from one point to another first comes into a polygon: found
// along it, then halved down to the edge.
entry_point :: (from: V2, to: V2, points: [] V2 -> V2) #pure {
    SAMPLES :: 64
    *outside: f32 = 0
    *within: f32 = 1
    for i: 0 <= SAMPLES {
        t := f32'i / SAMPLES
        if inside(from + (to - from) * t, points) {
            within = t
            break
        }
        outside = t
    }
    for _: 0 < 16 {
        t := (outside + within) / 2
        if inside(from + (to - from) * t, points) then within = t else outside = t
    }
    return from + (to - from) * within
}

// What a drag from a player's icon to a point does: the player whose part
// it's in, and how far along the source-to-life line, starting at its
// crossing into the target. Sideways motion does not change the damage.
aim :: (layout: Layout, game: Game, from: i64, at: V2 -> to: i64, amount: Drag_Amount) [missed] {
    to = -1
    amount = Drag_Amount.damage(1)
    if target := seat_at(layout, at) is absent then fail: missed
    if target == from or is_out(game, target) then fail: missed
    seat := layout.seats[target]
    entry := entry_point(layout.seats[from].icon, seat.middle, seat.outline[:seat.count])
    axis := seat.middle - entry
    share := Math.dot(at - entry, axis) / Math.max(Math.dot(axis, axis), 1)
    to = target
    amount = amount_for(share)
}

// The number grid, asked for by a drag past the life total along the aim line: tens, then units,
// then a tick or a cross. It faces the player who dragged.
Picker :: struct {
    open:   bool
    from:   i64
    to:     i64
    tens:   i32
    units:  i32
    combat: bool = true      // the drag's: combat damage, or a spell's
}

DEFAULT_PICKED :: 10

// The parts of the number grid, in its own frame (centred on the screen,
// x along its text), in cells.
PANEL_LOW    :: V2⟨-5.4, -2.0⟩
PANEL_HIGH   :: V2⟨5.4, 2.0⟩
TENS_TOP     :: -1.8
UNITS_TOP    :: -0.75
ROW_HEIGHT   :: 0.9
BOTTOM_TOP   :: 0.4
BOTTOM_LOW   :: 1.7
OUTPUT_RIGHT :: 1.2
ACCEPT_LEFT  :: 1.4
ACCEPT_RIGHT :: 3.1
CANCEL_LEFT  :: 3.3
GRID_LEFT    :: -5.0

Picker_Part :: union {
    tens: i32
    units: i32
    accept
    cancel
    panel
    outside
}

// What of the number grid is at a point of the screen.
picker_part_at :: (layout: Layout, picker: Picker, at: V2 -> Picker_Part) #pure {
    cell := cell_of(layout)
    p := local_of(layout.centre, layout.seats[picker.from].angle, at) / cell
    if p.x < PANEL_LOW.x or p.x > PANEL_HIGH.x or p.y < PANEL_LOW.y or p.y > PANEL_HIGH.y then return Picker_Part.outside
    column := i32'Math.floor(p.x - GRID_LEFT)
    if column >= 0 and column < 10 {
        if p.y >= TENS_TOP and p.y < TENS_TOP + ROW_HEIGHT then return Picker_Part.tens(column)
        if p.y >= UNITS_TOP and p.y < UNITS_TOP + ROW_HEIGHT then return Picker_Part.units(column)
    }
    if p.y >= BOTTOM_TOP and p.y < BOTTOM_LOW {
        if p.x >= ACCEPT_LEFT and p.x < ACCEPT_RIGHT then return Picker_Part.accept
        if p.x >= CANCEL_LEFT and p.x < -GRID_LEFT then return Picker_Part.cancel
    }
    return Picker_Part.panel
}

////////////////////////////////
// The capsule in the middle, and the font button in the corner

// The icons that aren't Magic's own: Material Design Icons' (the Icons
// module's), each copied into icons/ by its tool.
UNDO_ICON   :: icon(Mdi.UNDO)
REDO_ICON   :: icon(Mdi.REDO)
RESTART_ICON :: icon(Mdi.RESTORE)
SYSTEM_ICON :: icon(Mdi.POWER)
PERSON_ICON :: icon(Mdi.ACCOUNT)
TICK_ICON   :: icon(Mdi.CHECK)
CROSS_ICON  :: icon(Mdi.CLOSE)

// An icon drawn size across, its middle at a point, turned (radians clockwise).
draw_icon_at :: (canvas: *Draw.Canvas, drawn: Icons.Icon, middle: V2, size: f32, colour: Draw.RGBA, angle: f32 = 0) {
    canvas.draw_icon(drawn, middle - V2⟨size, size⟩ / 2, size, colour, angle)
}

Capsule_Part :: enum u8 {
    UNDO
    REDO
    PLAYERS
    RESTART
    SYSTEM
}

CAPSULE_PARTS :: [5] Capsule_Part⟨.UNDO, .REDO, .PLAYERS, .RESTART, .SYSTEM⟩

// The controls at the screen's centre are a pill, across the screen, a
// button a cell across at each of its places, CAPSULE_PITCH apart: from the
// left, undo and redo, the players in the middle, then a new game and the
// system's (settings and quitting), its power button, at the right end.
// CAPSULE_REACH is how far its ends are from the middle, and CAPSULE_HALF
// its half height (its round ends' radius), in cells.
CAPSULE_PITCH :: 1.2
CAPSULE_REACH :: 2 * CAPSULE_PITCH + CAPSULE_HALF
CAPSULE_HALF  :: 0.6

// How far a damage spot's middle keeps from the pill, in cells (its
// button's half and a little).
CONTROLS_CLEAR :: 0.75

// A damage spot clear of the controls (the pill, and CONTROLS_CLEAR round
// it), on a screen of a size: moved from where it would be toward its
// part's middle (so staying in its part) till it is.
clear_of_controls :: (size: V2, centre: V2, middle: V2, spot: V2 -> V2) #pure {
    cell := Math.min(size.x, size.y) * CELL_SHARE
    *at := spot
    for _: 0 < 24 {
        d := at - centre
        across := Math.abs(d.x) / cell
        up := Math.abs(d.y) / cell
        if across >= CAPSULE_REACH + CONTROLS_CLEAR or up >= CAPSULE_HALF + CONTROLS_CLEAR then return at
        at = at + (middle - at) * 0.15
    }
    return at
}

// How far a point is from the controls' pill (0 on it), on a screen of a size.
controls_clearance :: (size: V2, centre: V2, p: V2 -> f32) #pure {
    cell := Math.min(size.x, size.y) * CELL_SHARE
    d := Math.abs(p - centre) / cell
    return Math.length(Math.max(d - V2⟨CAPSULE_REACH, CAPSULE_HALF⟩, 0)) * cell
}

capsule_centre :: (layout: Layout, part: Capsule_Part -> V2) #pure {
    place: f32 = if part is {
        case .UNDO: -2
        case .REDO: -1
        case .PLAYERS: 0
        case .RESTART: 1
        case .SYSTEM: 2
    }
    return layout.centre + V2⟨place * CAPSULE_PITCH, 0⟩ * cell_of(layout)
}

// The capsule's button at a point, or absent.
capsule_part_at :: (layout: Layout, at: V2 -> Capsule_Part) [absent] {
    cell := cell_of(layout)
    for part: CAPSULE_PARTS {
        centre := capsule_centre(layout, part)
        if Math.abs(at.x - centre.x) <= 0.55 * cell and Math.abs(at.y - centre.y) <= 0.55 * cell then return part
    }
    fail: absent
}

// The controls are cut into the parts' surface as the channels between them
// are: a recess, its floor the surface darkened, its walls the channels'
// cosine bowl, each lit or shaded as it faces the light (PART_LIGHT) or
// away. Its shape is the pill, CAPSULE_REACH either way, CAPSULE_HALF up
// and down, its ends round (in cells); the settings appear in it, in place
// of its buttons.
RECESS_WALL :: 0.12             // how wide its walls are, from the surface to its floor

// How far a point is outside a box about 0, half its size each way, its
// corners rounded by radius (negative inside).
round_box_distance :: (p: V2, half: V2, radius: f32 -> f32) #pure {
    q := Math.abs(p) - half + V2⟨radius, radius⟩
    return Math.length(Math.max(q, 0.0)) + Math.min(Math.max(q.x, q.y), 0) - radius
}

// How far a point (from the controls' middle) is outside the recess
// (negative inside), its shape as recess_shape gives it: the pill, and the
// count runner grown up and down out of its middle a share of the way.
recess_distance :: (p: V2, shape: V4, column: V4 -> f32) #pure {
    pill := round_box_distance(p, shape.zw, shape.w)
    if column.w <= 0 then return pill
    // (the runner: a rounded upright box about the middle, its ends round,
    // from the pill's height to its own length as it grows; the two joined
    // smoothly, so the corners between them are rounded)
    length := Math.mix(shape.w, column.z, column.w)
    groove := round_box_distance(p, V2⟨column.y, length⟩, column.y)
    k := Math.max(column.x, 0.0001)
    h := Math.clamp(0.5 + 0.5 * (groove - pill) / k, 0, 1)
    return Math.mix(groove, pill, h) - k * h * (1 - h)
}

// The recess's shape, in pixels: the pill's middle, its half width and half
// height (shape); and the count runner, the upright groove the count bar
// slides in, grown a share of the way (counts, eased in and out) out of the
// pill's middle: how round the corners where it meets the pill are, its half
// width and half length, and how far (column).
recess_shape :: (layout: Layout, counts: f32 = 0 -> shape: V4, column: V4) #pure {
    cell := cell_of(layout)
    shape = ⟨layout.centre.x, layout.centre.y, CAPSULE_REACH * cell, CAPSULE_HALF * cell⟩
    grooved := Math.clamp(counts, 0, 1)
    c := grooved * grooved * (3 - 2 * grooved)
    column = ⟨RUNNER_JOIN * cell, COLUMN_HALF * cell, RUNNER_HALF * cell, c⟩
}

// How round the corners where the runner meets the pill are, in cells.
RUNNER_JOIN :: 0.25

// The count runner's half width, in cells (a button's, and its round ends'),
// and its half length: as far as the count bar's end goes either way, the
// bar's half length (BAR_HALF) beyond the most it slides from the middle
// (the 2's ring at the button to MAX_PLAYERS' there).
COLUMN_HALF :: 0.6
BAR_HALF    :: f32'(MAX_PLAYERS - 2) / 2 * COUNT_PITCH + 0.55
RUNNER_HALF :: f32'(MAX_PLAYERS - 2) / 2 * COUNT_PITCH + BAR_HALF + 0.08

// Whether a point is in the controls' recess, the pill, or part of the way
// (counts) to the count runner.
in_controls :: (layout: Layout, p: V2, counts: f32 = 0 -> bool) #pure {
    shape, column := recess_shape(layout, counts)
    return recess_distance(p - shape.xy, shape, column) < 0
}

Recess_Params :: struct {
    shape:  V4
    column: V4    // the count runner, and how far toward it (recess_shape's)
    floor:  V4    // its floor's colour (opaque: the controls' own, not the surface's)
    wall:   V4    // its walls' width (pixels), then unused
}

// The recess over the surface: its walls going down from the surface to
// its floor, of a colour of its own (the capsule's), each wall shaded where
// it faces away from the light and warmly lit where it faces it, given as
// what to lay over the surface (its colour premultiplied).
recess_shade :: (from: Draw.Quad_Between, recess: Shader.Uniforms(Recess_Params), texture: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    p := from.pixel - recess.shape.xy
    d := recess_distance(p, recess.shape, recess.column)
    if d > 1 then return ⟨0, 0, 0, 0⟩
    coverage := Math.clamp(0.5 - d, 0, 1)
    // (the way out of it, toward the surface: its distance's slope)
    gx := recess_distance(p + V2⟨0.5, 0⟩, recess.shape, recess.column) - recess_distance(p - V2⟨0.5, 0⟩, recess.shape, recess.column)
    gy := recess_distance(p + V2⟨0, 0.5⟩, recess.shape, recess.column) - recess_distance(p - V2⟨0, 0.5⟩, recess.shape, recess.column)
    outward := Math.normalize(V2⟨gx, gy⟩ + V2⟨0.00001, 0⟩)
    // (as the channels are: across 0 on its floor, 1 at the surface)
    across := Math.clamp(1 + d / Math.max(recess.wall.x, 1), 0, 1)
    wall := Math.sin(across * f32'Math.PI)
    facing := Math.dot(outward * -1.0, PART_LIGHT)
    // (the surface giving way to the floor down the wall, then the wall's
    // shade, then its light, each laid over the last)
    down := (1 + Math.cos(across * f32'Math.PI)) * 0.5
    shade := Math.max(0 - facing, 0) * wall * 0.48
    light := Math.max(facing, 0) * wall * 0.38
    kept := (1 - shade) * (1 - light)
    grain := control_material(texture, filtering, from.pixel / Math.max(recess.shape.z * 3, 1))
    rgb := grain * (down * kept) + PART_WARM * light
    alpha := 1 - (1 - down) * kept
    colour = V4⟨rgb.x, rgb.y, rgb.z, alpha⟩ * coverage
}

Recess :: shader { vertex: Draw.quad_place; fragment: recess_shade }
RECESS :: Recess(Draw.SHADER_TARGET)

// The controls' recess drawn: the pill, part of the way into the count
// runner.
draw_recess :: (canvas: *Draw.Canvas, layout: Layout, counts: f32) {
    shape, column := recess_shape(layout, counts)
    // (over the pill, and the runner's ends)
    margin := shape.z + 2
    *low := shape.xy - V2⟨margin, margin⟩
    *high := shape.xy + V2⟨margin, margin⟩
    if column.w > 0 {
        low.y = Math.min(low.y, shape.y + column.x - column.z - 2)
        high.y = Math.max(high.y, shape.y + column.x + column.z + 2)
    }
    floor := V4⟨CAPSULE.r, CAPSULE.g, CAPSULE.b, 1⟩
    wall := V4⟨RECESS_WALL * cell_of(layout), 0, 0, 0⟩
    canvas.draw_shader_image(low, high - low, RECESS.code, RECESS.bindings.recess, Recess_Params⟨shape, column, floor, wall⟩, control_image, RECESS.bindings.texture,
                             RECESS.bindings.filtering)
}

// The count of players, picked by dragging: touched, the players' button
// shows every count (each a ring of people) in a column through it, fewer
// above, which moves with the finger; the count nearest the button is the
// one that's active, and as it changes the lines snap to its, animated a
// count at a time (one splitting into two, or two meeting in one). Let go,
// it's that count (the same, let go without moving), and the column goes.
Count_Picker :: struct {
    open:     bool
    held:     bool           // a finger's on the column
    grabbed:  f32            // where it went down (y)
    from:     f32            // the count the column was at then (shown)
    shown:    f32            // the count at the button now, between whole counts as it moves
    settling: bool           // let go: shown moving to the whole count it's become
    // The lines, as they're shown: a count's (laid), or moving from it to
    // the next count up or down (toward), progress of the way.
    laid:     i64
    toward:   i64
    progress: f32
}

// How long the lines take to move from a count's to the next's, in seconds:
// the step to the count they're going to, and one they're passing through
// (fast-forwarded, as the finger's gone on past it).
LINES_STEP_TIME         :: 0.18
LINES_PASSING_STEP_TIME :: 0.05

// Whether the lines are shown as anything but the game's count's.
lines_moving :: (counts: Count_Picker, players: i64 -> bool) #pure {
    return counts.laid != 0 and (counts.laid != players or counts.toward != counts.laid)
}

// The lines as the picker shows them: a count's, or part of the way to the
// next's (eased), the slot that comes or goes (GOING's) the one that opens
// or closes.
shown_splits :: (counts: Count_Picker, splits: [] Splits, size: V2 -> Splits) #pure {
    if counts.toward == counts.laid or Math.abs(counts.toward - counts.laid) != 1 then return splits_for(splits, counts.laid, size)
    // (eased in and out: smoothstep's curve)
    p := Math.clamp(counts.progress, 0, 1)
    t := p * p * (3 - 2 * p)
    more := Math.max(counts.laid, counts.toward)
    slot := slot_going(size, more)
    if counts.toward > counts.laid {
        return morph_splits(splits_for(splits, counts.laid, size), splits_for(splits, counts.toward, size), t, slot)
    }
    return morph_splits(splits_for(splits, counts.toward, size), splits_for(splits, counts.laid, size), 1 - t, slot)
}

// The seat of a count's whose slot goes as the count comes down by one
// (GOING's), by its index.
slot_going :: (size: V2, count: i64 -> i64) #pure {
    return seat_of(starting_colours(size, count), count, GOING[count])
}

// The game of to players a game becomes (each count's lines as splits_for
// gives them, on a screen of a size), a count at a time as the lines morph:
// down, the slot going (GOING's) leaving the table and each other seat's
// player, as they are, carried to the seat it becomes; up, the last to
// leave coming back as they were. No one's life, damage or colours change.
game_for :: (game: Game, to: i64, splits: [] Splits, size: V2 -> next: Game) #pure {
    *order := SEATED_AS_THEY_ARE
    *n := Math.clamp(game.players, 2, MAX_PLAYERS)
    target := Math.clamp(to, 2, MAX_PLAYERS)
    while n > target {
        order = seated_down(order, splits_for(splits, n - 1, size), splits_for(splits, n, size), slot_going(size, n))
        n -= 1
    }
    while n < target {
        order = seated_up(order, splits_for(splits, n, size), splits_for(splits, n + 1, size), slot_going(size, n + 1))
        n += 1
    }
    next = reseated(game, order, target)
}

// The lines moved on by a frame's time toward a count: a step at a time,
// starting the next when one's done; each step to a count short of the
// target fast-forwarded, the last at its own pace.
move_lines :: (counts: *Count_Picker, target: i64, seconds: f32) {
    // (the first frame: the lines start as the game's, still)
    if counts.laid == 0 {
        counts.laid = target
        counts.toward = target
        counts.progress = 0
    }
    if counts.toward == counts.laid {
        if target == counts.laid then return
        counts.toward = if target > counts.laid then counts.laid + 1 else counts.laid - 1
        counts.progress = 0
    }
    step_time: f32 = if counts.toward == target then LINES_STEP_TIME else LINES_PASSING_STEP_TIME
    counts.progress += seconds / step_time
    if counts.progress >= 1 {
        counts.laid = counts.toward
        counts.progress = 0
    }
}

COUNT_PITCH :: 0.95          // between counts in the column, in cells

// Where a count's ring is, with the column at a count (shown).
count_place :: (layout: Layout, shown: f32, count: i64 -> V2) #pure {
    return capsule_centre(layout, .PLAYERS) + V2⟨0, (f32'count - shown) * COUNT_PITCH * cell_of(layout)⟩
}

// A count's lines: as they were left (splits[count]), or as equal_splits
// starts them.
splits_for :: (splits: [] Splits, count: i64, size: V2 -> Splits) #pure {
    if splits_fit(splits[count], count) then return splits[count]
    return equal_splits(count, size)
}

////////////////////////////////
// Drawing

// Text centred on a point, turned to read the right way up at angle.
draw_centred :: (canvas: *Draw.Canvas, font: Draw.Font, middle: V2, angle: f32, text: string, colour: Draw.RGBA) {
    width := f32'font.text_width(text)
    at := placed(middle, angle, ⟨-width / 2, f32'font.cap_height / 2⟩)
    canvas.draw_text(font, at, text, colour, angle)
}

// A box of a frame turned a whole number of quarters (as every player's
// is), from at to at + size in the frame, as the rounded box it is on the
// screen.
fill_turned_box :: (canvas: *Draw.Canvas, origin: V2, angle: f32, at: V2, size: V2, radius: f32, colour: Draw.RGBA) {
    a := placed(origin, angle, at)
    b := placed(origin, angle, at + size)
    low := V2⟨Math.min(a.x, b.x), Math.min(a.y, b.y)⟩
    high := V2⟨Math.max(a.x, b.x), Math.max(a.y, b.y)⟩
    canvas.fill_rounded_rect(low, high - low, radius, colour)
}

draw_seat :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, k: i64, targeted: bool, time: f32, toggles_shown: f32 = 1,
              drum: Life_Drum = ⟨⟩, surface_kept := false) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    out := is_out(game, k)
    points := seat.outline[:seat.count]
    artifact := ARTIFACT
    // Its frame: its colours' gradient, across it as its player sees it
    // (left to right), with its surface over it.
    *colours: [Draw.MAX_GRADIENT_COLOURS] Draw.RGBA
    n, pattern, surface := part_fill(game.identity[k], cell, k, time, seat.angle, colours)
    // (drawn here, or kept: keep_surfaces')
    if !surface_kept then draw_part(canvas, layout, k, colours[:n], pattern, surface, game.identity[k], out, targeted)
    // (a part too thin for its displays, as it opens or closes, is its colour alone)
    if seat.room < 0.6 * cell then return
    // (dark ink where its colours are light at its middle, where its life is)
    // (out, its colours as dimmed as the shader dims them)
    middle_ground := middle_of(colours[:n])
    ground := if out then Math.mix(middle_ground, BACKGROUND, 0.7) else middle_ground
    ink := if out then Math.mix(ink_on(ground), ground, 0.6) else ink_on(ground)
    accent := accent_of(game.identity[k], artifact)
    // Its colour toggles: a colour's symbol in its circle when it's set, a
    // dim one when not; each over a soft shadow that quiets the surface
    // around it, so the pentagon reads the same on every frame. Folding,
    // they draw in to the five-colour icon's corner and fade, and it comes
    // in the corner (opening, the other way).
    controls_visible := player_controls_visibility(drum, k)
    places := toggles_of(layout, k)
    hub := toggle_folded(layout, k)
    opened := Math.clamp(toggles_shown, 0, 1)
    s := opened * opened * (3 - 2 * opened)
    r := TOGGLE_RADIUS * cell * (0.5 + 0.5 * s)
    alpha := s * controls_visible
    if alpha > 0 {
        for place: places { canvas.fill_glow(Math.mix(hub, place, s), r * 1.8, Draw.rgba(0x000000, 0.3 * alpha)) }
        for place, i: places {
            colour := Mana'i
            at := Math.mix(hub, place, s)
            if has_colour(game.identity[k], colour) {
                canvas.fill_circle(at, r, faded(MANA_CIRCLES[colour], alpha))
                draw_centred(canvas, fonts.mana, at, seat.angle, MANA_GLYPHS[colour], faded(MANA_INK, alpha))
            }
            else {
                canvas.fill_circle(at, r, Draw.rgba(0x000000, 0.34 * alpha))
                draw_centred(canvas, fonts.mana, at, seat.angle, MANA_GLYPHS[colour], Draw.rgba(0xF4EFE6, 0.5 * alpha))
            }
        }
    }
    if s < 1 {
        side := FIVE_COLOURS_SIDE * cell * (1 - 0.4 * s)
        canvas.fill_glow(hub, side * 0.8, Draw.rgba(0x000000, 0.3 * (1 - s) * controls_visible))
        draw_five_colours(canvas, hub, side, seat.angle, (1 - s) * controls_visible, game.identity[k])
    }
    // Its life total: white with a black border and a drop shadow, cast
    // from the screen's centre (falling away from it, toward its player: down
    // as they read it) and a little to their right, as a drop shadow falls,
    // on any part.
    cap := f32'fonts.life.cap_height
    life_colour := if out then Draw.rgba(0xFFFFFF, 0.55) else Draw.rgb(0xFFFFFF)
    *away := seat.toward
    if Math.length(seat.middle - layout.centre) > 1 then away = Math.normalize(seat.middle - layout.centre)
    reader_right := V2⟨Math.cos(seat.angle), Math.sin(seat.angle)⟩
    falls := Math.normalize(away + reader_right * LIFE_SHADOW_RIGHT)
    life_style := Draw.Text_Style⟨outline: Draw.rgb(0x000000), outline_width: Math.max(2, cap * LIFE_OUTLINE),
                                  shadow: Draw.rgba(0x000000, 0.55), shadow_offset: falls * (cap * LIFE_SHADOW * 1.4), shadow_soft: cap * LIFE_SHADOW⟩
    life_text := "«game.life[k]»"
    life_width := f32'fonts.life.text_width(life_text)
    // (touched, a drum, over the chips; let go, flat again, with its change
    // beside it a while)
    if !drum_showing(drum, k) {
        canvas.draw_text(fonts.life, placed(seat.middle, seat.angle, ⟨-life_width / 2, cap / 2⟩), life_text, life_colour, life_style, seat.angle)
        shows := change_showing(drum, k)
        if shows > 0 then draw_change(canvas, seat, fonts, drum, life_colour, shows)
    }
    // The commander damage it's taken, a chip in each commander's colour, in
    // a row below its life (or where chip_places finds room).
    *shown: i64 = 0
    for d: game.commander[k][:game.players] { if d > 0 then shown += 1 }
    chips := chip_places(layout, k, life_width, cap, shown)
    *place: i64 = 0
    for d, from: game.commander[k][:game.players] {
        if d <= 0 then continue
        middle := chips[Math.min(place, 4)]
        // (in the colour of the commander that did it: a lethal one ringed
        // in the life total's ink)
        lethal := d >= LETHAL_COMMANDER_DAMAGE
        source := accent_of(game.identity[from], artifact)
        ring := if lethal then ink else Math.mix(source, BACKGROUND, 0.35)
        canvas.fill_circle(middle, CHIP_RADIUS * cell, ring)
        canvas.fill_circle(middle, CHIP_RADIUS * cell - 3, source)
        draw_centred(canvas, fonts.small, middle, seat.angle, "«d»", ink_on(source))
        place += 1
    }
    if drum_showing(drum, k) then draw_drum(canvas, layer, seat, fonts, drum, life_colour, life_style)
}

// A life total's border, and how far its shadow falls and how soft it is,
// against its capitals' height.
LIFE_OUTLINE :: 0.045
LIFE_SHADOW :: 0.06
LIFE_SHADOW_RIGHT :: 0.5     // how far to its reader's right it falls, against how far down

////////////////////////////////
// The life drum: a life total tapped opens into wheels, a digit each, as an
// odometer's or a lock's, each on a cylinder with its digits round it (one
// more each row up, one less each row down), and beside them a wheel of
// the change since it opened (0 at the middle, +1 up, -1 down). A wheel
// dragged turns with the finger (down brings the bigger digits to the
// middle), changing the life by its place (the units' by one, the tens' by
// ten) a row at a time; the others turn only as it carries into them. Let
// go, the number at the middle is the life (undo brings each turn back). The
// a tap away from the life closes it: the wheels flatten (DRUM_FLATTEN seconds),
// and the change stays beside it, flat, DRUM_HOLD seconds, then fades over
// DRUM_FADE.

DRUM_PITCH   :: 1.3        // its rows apart, in the life's capitals' heights
DRUM_RADIUS  :: 1.1        // the cylinder's radius, in rows (so a row and a half shows each way)
DRUM_ROWS    :: 3          // the rows drawn each way from the middle
DRUM_FLATTEN :: 0.15
DRUM_HOLD    :: 1.0
DRUM_FADE    :: 1.5
DRUM_CHANGE  :: 0.45       // the change's size, against the life's
DRUM_TAP     :: 0.15       // a press that moves less than this (capitals' heights) is a tap

Life_Drum :: struct {
    open:    bool          // tapped open: its wheels turn
    player:  i64 = -1
    start:   i32           // the life as it was opened
    pressed: bool          // a finger down on it...
    moved:   bool          // ...that's moved: a turn, not a tap
    touched: V2            // where it touched, in its player's frame
    place:   i32 = 1       // the wheel being turned: its digit's place (1, 10, 100)
    from:    i32           // the life as that turn began
    turned:  f32           // how far that wheel's turned, in rows (toward its player: the bigger digits coming down)
    bend:    f32           // how round it is: 0 flat, 1 round
    change:  i32           // closed, the change it made while open
    since:   f32 = 1e9     // seconds since it was closed
}

// The life a drum's turn makes: from, and its place times the whole rows
// it's turned by.
drum_life :: (drum: Life_Drum -> i32) #pure {
    return drum.from + drum.place * i32'Math.round(drum.turned)
}

// A drum part way through its turn: the life it's turning from (base; the
// next, base + place) and how far toward the next (0 to 1).
drum_between :: (drum: Life_Drum -> base: i32, frac: f32) #pure {
    whole := Math.floor(drum.turned)
    base = drum.from + drum.place * i32'whole
    frac = drum.turned - whole
}

// A number's digit at a wheel (its place's: 0 the units), of its size.
digit_of :: (n: i32, wheel: i64 -> i64) #pure {
    *m := i64'Math.abs(n)
    for _: 0 < wheel { m /= 10 }
    return m % 10
}

// How many digits a number has (its size's; one at least).
digits_in :: (n: i32 -> i64) #pure {
    *m := i64'Math.abs(n)
    *count: i64 = 1
    while m >= 10 {
        m /= 10
        count += 1
    }
    return count
}

// Where a wheel is between two numbers, as a digit (between whole ones as
// it turns): its digit of a, turned frac of the way to b's, the short way
// round (9 to 0 forward, 0 to 9 back); a wheel whose digit doesn't change
// stays.
wheel_at :: (a: i32, b: i32, wheel: i64, frac: f32 -> f32) #pure {
    da := digit_of(a, wheel)
    db := digit_of(b, wheel)
    if da == db then return f32'da
    if db == (da + 1) % 10 then return f32'da + frac
    if db == (da + 9) % 10 then return f32'da - frac
    return f32'da + frac * f32'(db - da)
}

// A drum closed, if it's open: the change it made kept to show.
close_drum :: (drum: *Life_Drum, game: Game) {
    if !drum.open then return
    drum.open = false
    drum.change = if drum.player < game.players then game.life[drum.player] - drum.start else 0
    drum.since = 0
}

// A finger down on a player's life, or a wheel of its open drum (its
// place), at a point in their frame: a turn begins there (a drum shown for
// another player closes, and is theirs no longer).
press_drum :: (drum: *Life_Drum, game: Game, player: i64, at: V2, place: i32) {
    if drum.player != player {
        close_drum(drum, game)
        drum.player = player
        drum.bend = 0
        drum.change = 0
        drum.since = 1e9
    }
    drum.pressed = true
    drum.moved = false
    drum.touched = at
    drum.place = place
    drum.from = game.life[player]
    drum.turned = 0
}

// The finger moved (a point in the drum's player's frame): past DRUM_TAP
// it's a turn, and an open drum's wheel turns with it, a row a pitch.
move_drum :: (drum: *Life_Drum, at: V2, cap: f32) {
    if !drum.pressed then return
    if Math.length(at - drum.touched) > DRUM_TAP * cap then drum.moved = true
    if drum.open and drum.moved then drum.turned = (at.y - drum.touched.y) / Math.max(DRUM_PITCH * cap, 1)
}

// The finger lifted: a tap enters or keeps editing; a turn of an open
// one gives the life it made (changes: the game's life is to become it).
release_drum :: (drum: *Life_Drum, game: Game -> life: i32, changes: bool) {
    life = 0
    changes = false
    if !drum.pressed then return
    drum.pressed = false
    if !drum.moved {
        if !drum.open {
            drum.open = true
            drum.start = game.life[drum.player]
            drum.change = 0
            drum.since = 1e9
        }
        return
    }
    if drum.open {
        life = drum_life(drum)
        changes = life != game.life[drum.player]
    }
}

// A drum moved on by a frame's time: rounding as it opens, flattening as it
// closes, its wheel settling on the row it was let go at; and following the
// game's life when that changes otherwise (an undo, damage).
step_drum :: (drum: *Life_Drum, game: Game, seconds: f32) {
    if drum.player < 0 or drum.player >= game.players {
        drum.open = false
        drum.pressed = false
        drum.bend = 0
        drum.change = 0
        return
    }
    way: f32 = if drum.open then 1 else -1
    drum.bend = Math.clamp(drum.bend + way * seconds / DRUM_FLATTEN, 0, 1)
    if !drum.pressed {
        target := Math.round(drum.turned)
        drum.turned += (target - drum.turned) * Math.min(1, seconds * 25)
        if drum_life(drum) != game.life[drum.player] {
            drum.from = game.life[drum.player]
            drum.place = 1
            drum.turned = 0
        }
    }
    if !drum.open then drum.since += seconds
}

// Whether a player's life shows as a drum (open, or flattening), and how
// much its change shows, flat beside it (0 none).
player_controls_visibility :: (drum: Life_Drum, k: i64 -> f32) #pure {
    if drum.player != k then return 1
    t := Math.clamp(drum.bend, 0, 1)
    return 1 - t * t * (3 - 2 * t)
}

drum_showing :: (drum: Life_Drum, k: i64 -> bool) #pure {
    return drum.player == k and (drum.open or drum.bend > 0)
}

change_showing :: (drum: Life_Drum, k: i64 -> f32) #pure {
    if drum.player != k or drum.open or drum.change == 0 then return 0
    if drum.since <= DRUM_HOLD then return 1
    return Math.clamp(1 - (drum.since - DRUM_HOLD) / DRUM_FADE, 0, 1)
}

// A change as it's shown: "+3", "-2", "0".
change_text :: (change: i64 -> string) {
    return if change > 0 then "+«change»" else "«change»"
}

// The life total at a point (around its number, a little past it): its
// player; or absent.
life_at :: (layout: Layout, fonts: Fonts, game: Game, p: V2 -> i64) [absent] {
    cap := f32'fonts.life.cap_height
    for seat, k: layout.seats[:layout.count] {
        if seat.room < 0.6 * cell_of(layout) then continue
        half := Math.max(f32'fonts.life.text_width("«game.life[k]»") / 2, cap * 0.6) + cap * 0.25
        l := local_of(seat.middle, seat.angle, p)
        if Math.abs(l.x) <= half and Math.abs(l.y) <= cap * 0.85 then return k
    }
    fail: absent
}

// Where a drum's parts are, across its player's text from its middle: its
// wheels (as many as the life turning has digits, each as wide as the
// widest digit), from left to right, then the change's wheel's middle and
// half width.
Drum_Shape :: struct {
    wheels:      i64
    wheel_width: f32
    left:        f32
    right:       f32
    change_at:   f32
    change_half: f32
}

drum_shape :: (fonts: Fonts, drum: Life_Drum -> shape: Drum_Shape) {
    cap := f32'fonts.life.cap_height
    base, _ := drum_between(drum)
    *widest: f32 = 0
    for d: 0 < 10 { widest = Math.max(widest, f32'fonts.life.text_width("«d»")) }
    *widest_change: f32 = 0
    for k: -DRUM_ROWS <= DRUM_ROWS {
        widest_change = Math.max(widest_change, f32'fonts.change.text_width(change_text(i64'(base - drum.start) + k * i64'drum.place)))
    }
    shape.wheels = Math.max(digits_in(base), digits_in(base + drum.place))
    shape.wheel_width = widest + cap * 0.18
    shape.right = f32'shape.wheels * shape.wheel_width / 2
    shape.left = 0 - shape.right
    shape.change_half = widest_change / 2 + cap * 0.15
    shape.change_at = shape.right + cap * 0.3 + shape.change_half
}

// An open drum's wheel at a point of the screen: its place; or absent.
drum_wheel_at :: (layout: Layout, fonts: Fonts, drum: Life_Drum, p: V2 -> i32) [absent] {
    if !drum.open or drum.player < 0 or drum.player >= layout.count then fail: absent
    seat := layout.seats[drum.player]
    if place := wheel_at_point(fonts, drum, local_of(seat.middle, seat.angle, p)) { return place } else if absent { fail: absent }
}

// An open drum's wheel at a point (of its player's frame): its place (the
// change's wheel turns as the units'), or absent off the drum.
wheel_at_point :: (fonts: Fonts, drum: Life_Drum, at: V2 -> place: i32) [absent] {
    place = 1
    shape := drum_shape(fonts, drum)
    cap := f32'fonts.life.cap_height
    radius := DRUM_RADIUS * DRUM_PITCH * cap
    if Math.abs(at.y) > radius or at.x < shape.left - cap * 0.2 or at.x > shape.change_at + shape.change_half + cap * 0.2
        fail: absent
    if at.x > shape.right then return
    i := Math.clamp(i64'Math.floor((at.x - shape.left) / shape.wheel_width), 0, shape.wheels - 1)
    for _: 0 < shape.wheels - 1 - i { place *= 10 }
}

Drum_Params :: struct {
    middle: V4    // the drum's middle (pixels), its radius (pixels), how round it is (0 flat, 1 round)
    turn:   V4    // the cosine and sine of its player's text's turn, the layer's size (pixels)
    widths: V4    // its wheels' left and right, the change's wheel's middle and half width
    wheels: V4    // a wheel's width, then unused
    ink:    V4    // the numbers' colour (straight)
}

// A drum's numbers, drawn flat into a layer, wrapped round its cylinder:
// each place on it shows the layer as far along the cylinder's surface as
// it is round from the middle, darker as it turns away; a dark band behind
// each drum's numbers. (A canvas is opaque, so the layer has the numbers'
// parts in its channels, each drawn over black: their fill in red, their
// border in green, their shadow in blue; the border and the shadow black.)
drum_shade :: (from: Draw.Quad_Between, drum: Shader.Uniforms(Drum_Params), layer: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    d := from.pixel - drum.middle.xy
    // (into its player's frame: x along their text, y toward them)
    local := V2⟨d.x * drum.turn.x + d.y * drum.turn.y, d.y * drum.turn.x - d.x * drum.turn.y⟩
    radius := Math.max(drum.middle.z, 1)
    bend := drum.middle.w
    on_life := local.x >= drum.widths.x and local.x <= drum.widths.y
    on_change := Math.abs(local.x - drum.widths.z) <= drum.widths.w
    if !on_life and !on_change then return ⟨0, 0, 0, 0⟩
    if Math.abs(local.y) > radius then return ⟨0, 0, 0, 0⟩
    angle := Math.asin(Math.clamp(local.y / radius, -1, 1))
    facing := Math.cos(angle)
    along := Math.mix(local.y, angle * radius, bend)
    back := V2⟨local.x * drum.turn.x - along * drum.turn.y, local.x * drum.turn.y + along * drum.turn.x⟩
    parts := Shader.sample_level(layer, filtering, (drum.middle.xy + back) / drum.turn.zw, 0)
    covered := Math.clamp(parts.x + parts.y + parts.z, 0, 1) * drum.ink.w
    text := V4⟨drum.ink.x * parts.x * drum.ink.w, drum.ink.y * parts.x * drum.ink.w, drum.ink.z * parts.x * drum.ink.w, covered⟩
    shade := Math.mix(1, 0.2 + 0.8 * facing * facing, bend)
    // (the band, each wheel itself: soft at its ends across, so wheels part,
    // dark toward its edges along the cylinder, a light's gleam a little
    // above its middle)
    wheel := Math.max(drum.wheels.x, 1)
    into := local.x - drum.widths.x
    within := into - Math.floor(into / wheel) * wheel
    from_end := if on_life then Math.min(within, wheel - within) else drum.widths.w - Math.abs(local.x - drum.widths.z)
    ends := Math.clamp(from_end / 5, 0, 1)
    band := 0.7 * bend * ends
    gleam := (angle + 0.45) / 0.22
    grey := 0.05 + 0.22 * facing + 0.3 * Math.exp(0 - gleam * gleam)
    lit := text * shade
    colour = ⟨lit.x + grey * band * (1 - lit.w), lit.y + grey * band * (1 - lit.w), lit.z + grey * band * (1 - lit.w), lit.w + band * (1 - lit.w)⟩
}

Drum :: shader { vertex: Draw.quad_place; fragment: drum_shade }
DRUM :: Drum(Draw.SHADER_TARGET)

// A player's life as a drum: its rows drawn flat into the layer (cleared),
// then wrapped round the cylinder onto the canvas.
draw_drum :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, seat: Seat, fonts: Fonts, drum: Life_Drum, colour: Draw.RGBA, style: Draw.Text_Style) {
    cap := f32'fonts.life.cap_height
    pitch := DRUM_PITCH * cap
    radius := DRUM_RADIUS * pitch
    shape := drum_shape(fonts, drum)
    base, frac := drum_between(drum)
    next := base + drum.place
    change_cap := f32'fonts.change.cap_height
    // (each part in the channels: fill red, border green, shadow blue; a
    // row at the middle shows whole, the rest as round as the drum is)
    parted :: (style: Draw.Text_Style, shows: f32 -> Draw.Text_Style) {
        return ⟨outline: Draw.rgba(0x00FF00, shows), outline_width: style.outline_width,
                shadow: Draw.rgba(0x0000FF, style.shadow.a * shows), shadow_offset: style.shadow_offset, shadow_soft: style.shadow_soft⟩
    }
    change_style := Draw.Text_Style⟨outline_width: Math.max(1.5, change_cap * LIFE_OUTLINE * 1.5)⟩
    layer.clear(Draw.rgb(0x000000))
    // Each wheel: its digit where it's turned to, the digits round it above
    // (bigger) and below; a leading wheel's 0 blank.
    for i: 0 < shape.wheels {
        wheel := shape.wheels - 1 - i
        middle_x := shape.left + (f32'i + 0.5) * shape.wheel_width
        q := wheel_at(base, next, wheel, frac)
        nearest := i64'Math.round(q)
        for k: -DRUM_ROWS <= DRUM_ROWS {
            d := nearest + k
            digit := ((d % 10) + 10) % 10
            if digit == 0 and wheel == shape.wheels - 1 and shape.wheels > 1 then continue
            shows := if drum.open or k == 0 then 1.0 else drum.bend
            if shows <= 0 then continue
            y := (q - f32'd) * pitch
            text := "«digit»"
            width := f32'fonts.life.text_width(text)
            layer.draw_text(fonts.life, placed(seat.middle, seat.angle, ⟨middle_x - width / 2, y + cap / 2⟩), text, Draw.rgba(0xFF0000, shows),
                            parted(style, shows), seat.angle)
        }
    }
    // The change's wheel: the change since it opened, a row each of the
    // turning wheel's place.
    for k: -DRUM_ROWS <= DRUM_ROWS {
        shows := if drum.open or k == i64'Math.round(frac) then 1.0 else drum.bend
        if shows <= 0 then continue
        y := (frac - f32'k) * pitch
        change := change_text(i64'(base - drum.start) + k * i64'drum.place)
        width := f32'fonts.change.text_width(change)
        layer.draw_text(fonts.change, placed(seat.middle, seat.angle, ⟨shape.change_at - width / 2, y + change_cap / 2⟩), change,
                        Draw.rgba(0xFF0000, shows), ⟨outline: Draw.rgba(0x00FF00, shows), outline_width: change_style.outline_width⟩, seat.angle)
    }
    // (the quad: the screen's box round the drum's turned rectangle)
    *low := V2⟨1e30, 1e30⟩
    *high := V2⟨-1e30, -1e30⟩
    far := shape.change_at + shape.change_half
    for corner: [4] V2⟨⟨shape.left, -radius⟩, ⟨far, -radius⟩, ⟨shape.left, radius⟩, ⟨far, radius⟩⟩ {
        at := placed(seat.middle, seat.angle, corner)
        low = Math.min(low, at)
        high = Math.max(high, at)
    }
    low = Math.floor(low) - V2⟨2, 2⟩
    high = Math.ceil(high) + V2⟨2, 2⟩
    params := Drum_Params⟨V4⟨seat.middle.x, seat.middle.y, radius, drum.bend⟩,
                          V4⟨Math.cos(seat.angle), Math.sin(seat.angle), f32'layer.size[0], f32'layer.size[1]⟩,
                          V4⟨shape.left, shape.right, shape.change_at, shape.change_half⟩, V4⟨shape.wheel_width, 0, 0, 0⟩,
                          V4⟨colour.r, colour.g, colour.b, colour.a⟩⟩
    canvas.draw_shader_canvas(low, high - low, DRUM.code, DRUM.bindings.drum, params, layer, DRUM.bindings.layer, DRUM.bindings.filtering)
    // (a life below nothing: its minus, flat, before the wheels)
    if base < 0 and next <= 0 {
        minus := f32'fonts.life.text_width("-")
        canvas.draw_text(fonts.life, placed(seat.middle, seat.angle, ⟨shape.left - minus - cap * 0.1, cap / 2⟩), "-", colour, style, seat.angle)
    }
}

// A drum's change let go, flat beside the life, as much as it shows.
draw_change :: (canvas: *Draw.Canvas, seat: Seat, fonts: Fonts, drum: Life_Drum, colour: Draw.RGBA, shows: f32) {
    change_at := drum_shape(fonts, drum).change_at
    change_cap := f32'fonts.change.cap_height
    change_style := Draw.Text_Style⟨outline: Draw.rgba(0x000000, shows), outline_width: Math.max(1.5, change_cap * LIFE_OUTLINE * 1.5)⟩
    change := change_text(i64'drum.change)
    width := f32'fonts.change.text_width(change)
    canvas.draw_text(fonts.change, placed(seat.middle, seat.angle, ⟨change_at - width / 2, change_cap / 2⟩), change, faded(colour, shows), change_style, seat.angle)
}

// How big a commander damage chip is (cells), and how far apart they are.
CHIP_RADIUS :: 0.4
CHIP_PITCH :: 0.95

// Where a part's commander damage chips go (count of them, five at most):
// a row below its life total, in its player's frame; or, where that won't
// be inside the part and clear of its colour toggles, each chip in turn at
// the free place nearest that row's middle, of rows below and above the
// life and columns beside it, half a chip's pitch apart.
chip_places :: (layout: Layout, k: i64, life_width: f32, life_height: f32, count: i64 -> places: [5] V2) {
    with scratch.rewind()
    cell := cell_of(layout)
    seat := layout.seats[k]
    toggles := toggles_of(layout, k)
    points := seat.outline[:seat.count]
    r := CHIP_RADIUS * cell
    pitch := CHIP_PITCH * cell
    below := life_height / 2 + 0.75 * cell
    beside := life_width / 2 + 0.65 * cell
    // (the centred row below, if it fits)
    *row: [5] V2
    *fits := true
    for i: 0 < 5 {
        along := (f32'Math.min(i, Math.max(count - 1, 0)) - f32'Math.max(count - 1, 0) / 2) * pitch
        row[i] = placed(seat.middle, seat.angle, ⟨along, below⟩)
        if i < count and !chip_fits(row[i], points, toggles, r, cell) then fits = false
    }
    places = row
    if fits then return
    // (else each the nearest free place to it)
    *spots: [..] V2 in scratch
    for y: [5] f32⟨below, below + pitch, below + 2 * pitch, 0 - below, 0 - below - pitch⟩ {
        for j: -8 <= 8 { `scratch spots.add(V2⟨f32'j * 0.5 * pitch, y⟩) }
    }
    for x: [4] f32⟨beside, beside + pitch, 0 - beside, 0 - beside - pitch⟩ {
        for j: -4 <= 4 { `scratch spots.add(V2⟨x, f32'j * 0.5 * pitch⟩) }
    }
    for i: 0 < count {
        *best: f32 = 1e30
        for local: spots {
            if Math.abs(local.x) < life_width / 2 + r and Math.abs(local.y) < life_height / 2 + r then continue
            score := Math.length(local - V2⟨0, below⟩)
            if score >= best then continue
            at := placed(seat.middle, seat.angle, local)
            if !chip_fits(at, points, toggles, r, cell) then continue
            *taken := false
            for other: places[:i] { if Math.length(at - other) < 2 * r + 0.08 * cell then taken = true }
            if taken then continue
            best = score
            places[i] = at
        }
    }
}

// Whether a chip of radius r at a place is inside its part, clear of its
// sides, and clear of its colour toggles.
chip_fits :: (at: V2, points: [] V2, toggles: [5] V2, r: f32, cell: f32 -> bool) #pure {
    if !inside(at, points) or clearance(at, points) < 0.8 * r then return false
    for t: toggles { if Math.length(at - t) < r + TOGGLE_RADIUS * cell + 0.08 * cell then return false }
    return true
}

// A drag's amount, by the finger, facing whoever's dragging, and a slow
// pulse of the dragger's colour at the life total it's aimed at (the
// stream of motes to it is the motes').
draw_drag :: (canvas: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, drag: Drag, mouse: V2, artifact: Draw.RGBA, time: f32) {
    cell := cell_of(layout)
    seat := layout.seats[drag.from]
    if to, amount := aim(layout, game, drag.from, mouse) is not missed {
        draw_target_arrow(canvas, layout, drag, layout.seats[to].middle, layout.seats[to].toward * -1.0)
        bubble := placed(mouse, seat.angle, ⟨0, -1.15 * cell⟩)
        canvas.fill_circle(bubble, 0.55 * cell, INK)
        text := if amount is { case damage: "«damage»"; case asked: "?" }
        target := accent_of(game.identity[to], artifact)
        // (the bubble's text in the target's colour, darkened if it's light)
        bubble_ink := if lightness(target) > 0.6 then Math.mix(target, DARK_INK, 0.6) else target
        draw_centred(canvas, fonts.output, bubble, seat.angle, text, bubble_ink)
    }
    else {
        draw_target_arrow(canvas, layout, drag, mouse, seat.toward * -1.0)
    }
}

draw_picker :: (canvas: *Draw.Canvas, layout: Layout, fonts: Fonts, picker: Picker, game: Game, artifact: Draw.RGBA) {
    cell := cell_of(layout)
    origin := layout.centre
    angle := layout.seats[picker.from].angle
    accent := accent_of(game.identity[picker.from], artifact)
    canvas.fill_rect(⟨0, 0⟩, layout.size, Draw.rgba(0x000000, 0.45))
    fill_turned_box(canvas, origin, angle, PANEL_LOW * cell, (PANEL_HIGH - PANEL_LOW) * cell, 0.3 * cell, CAPSULE)
    for column: 0 < 10 {
        left := (GRID_LEFT + f32'column + 0.05) * cell
        width := 0.9 * cell
        for row: 0 < 2 {
            row_top: f32 = if row == 0 then TENS_TOP else UNITS_TOP
            top := row_top * cell
            chosen := if row == 0 then picker.tens == i32'column else picker.units == i32'column
            key := if chosen then accent else lighter(CAPSULE, 0.08)
            fill_turned_box(canvas, origin, angle, ⟨left, top⟩, ⟨width, ROW_HEIGHT * cell - 0.1 * cell⟩, 0.15 * cell, key)
            label := if row == 0 then "«column»0" else "«column»"
            middle := placed(origin, angle, ⟨left + width / 2, top + (ROW_HEIGHT - 0.1) * cell / 2⟩)
            draw_centred(canvas, fonts.label, middle, angle, label, ink_on(key))
        }
    }
    // The number, then the tick and the cross.
    top := BOTTOM_TOP * cell
    height := (BOTTOM_LOW - BOTTOM_TOP) * cell
    fill_turned_box(canvas, origin, angle, ⟨GRID_LEFT * cell, top⟩, ⟨(OUTPUT_RIGHT - GRID_LEFT) * cell, height⟩, 0.2 * cell, BACKGROUND)
    value := picker.tens * 10 + picker.units
    draw_centred(canvas, fonts.output, placed(origin, angle, ⟨(GRID_LEFT + OUTPUT_RIGHT) / 2 * cell, top + height / 2⟩), angle,
                 "«value»", INK)
    fill_turned_box(canvas, origin, angle, ⟨ACCEPT_LEFT * cell, top⟩, ⟨(ACCEPT_RIGHT - ACCEPT_LEFT) * cell, height⟩, 0.2 * cell,
                    Draw.rgb(0x2F7A4A))
    fill_turned_box(canvas, origin, angle, ⟨CANCEL_LEFT * cell, top⟩, ⟨(-GRID_LEFT - CANCEL_LEFT) * cell, height⟩, 0.2 * cell,
                    Draw.rgb(0x8A3030))
    // (the tick and the cross, turned to face the picker's player)
    tick := V2⟨(ACCEPT_LEFT + ACCEPT_RIGHT) / 2 * cell, top + height / 2⟩
    cross := V2⟨(CANCEL_LEFT - GRID_LEFT) / 2 * cell, top + height / 2⟩
    draw_icon_at(canvas, TICK_ICON, placed(origin, angle, tick), 0.75 * cell, INK, angle)
    draw_icon_at(canvas, CROSS_ICON, placed(origin, angle, cross), 0.75 * cell, INK, angle)
}

// A ring of people, a count of them, round a point, in a button a cell
// across, placed as that count's parts are: two side by side; an odd count's
// one at the bottom (three's and five's lone part is the bottom's), the
// others' one at the top.
draw_people :: (canvas: *Draw.Canvas, centre: V2, count: i64, cell: f32, colour: Draw.RGBA) {
    ring := if count == 2 then 0.15 * cell else 0.24 * cell
    start := if count == 2 then f32'Math.PI else if count % 2 == 1 then f32'Math.PI / 2 else -f32'Math.PI / 2
    for i: 0 < count {
        a := start + f32'Math.TAU * f32'i / f32'count
        draw_icon_at(canvas, PERSON_ICON, centre + V2⟨Math.cos(a), Math.sin(a)⟩ * ring, 0.26 * cell, colour)
    }
}

draw_capsule :: (canvas: *Draw.Canvas, layout: Layout, game: Game, screen: Screen_State) {
    cell := cell_of(layout)
    // (its buttons the same whether the settings are open or not: they open
    // beside it, in the table's seam)
    draw_recess(canvas, layout, 0)
    // The system's button, the power icon; undo and redo (each dim with
    // nothing to undo or redo), and a new game. (The players' button is the
    // count slider, seen through its hole in the table.)
    draw_icon_at(canvas, SYSTEM_ICON, capsule_centre(layout, .SYSTEM), 0.62 * cell, lighter(CAPSULE, 0.75))
    undo_ink := if screen.can_undo then INK else lighter(CAPSULE, 0.25)
    draw_icon_at(canvas, UNDO_ICON, capsule_centre(layout, .UNDO), 0.62 * cell, undo_ink)
    redo_ink := if screen.can_redo then INK else lighter(CAPSULE, 0.25)
    draw_icon_at(canvas, REDO_ICON, capsule_centre(layout, .REDO), 0.62 * cell, redo_ink)
    draw_icon_at(canvas, RESTART_ICON, capsule_centre(layout, .RESTART), 0.62 * cell, lighter(CAPSULE, 0.75))
}

// A colour, a share as opaque.
faded :: (colour: Draw.RGBA, share: f32 -> Draw.RGBA) #pure {
    return ⟨colour.r, colour.g, colour.b, colour.a * share⟩
}

// The full metal slider is always beneath the table, seen through its opening.
// Its selected engraving stays readable throughout the opening transition.
draw_counts :: (canvas: *Draw.Canvas, layout: Layout, screen: Screen_State, game: Game) {
    cell := cell_of(layout)
    shows: f32 = 1
    opened := Math.clamp(screen.counts_shown, 0, 1)
    shown := if opened > 0 then screen.counts.shown else f32'game.players
    middle := (count_place(layout, shown, 2) + count_place(layout, shown, MAX_PLAYERS)) / 2
    half := V2⟨BAR_WIDTH, BAR_HALF⟩ * cell
    // A close contact shadow lifts the slider above the steel and narrow guide groove.
    canvas.fill_rounded_rect(middle - half + V2⟨0.025 * cell, 0.045 * cell⟩, half * 2, half.x, Draw.rgba(0x000000, 0.38 * shows))
    draw_metal_bar(canvas, middle, half, shows)
    for count: 2 <= MAX_PLAYERS {
        away := Math.abs(f32'count - shown)
        selected := 1 - Math.smoothstep(0, 0.65, away)
        position := count_place(layout, shown, count)
        strength := (0.56 + selected * 0.4) * shows
        // A shallow engraved highlight beneath the dark cut.
        draw_people(canvas, position + V2⟨0, 0.015 * cell⟩, count, cell * (0.90 + selected * 0.10), Draw.rgba(0xFFF1D8, strength * 0.33))
        draw_people(canvas, position, count, cell * (0.90 + selected * 0.10), Draw.rgba(0x171C22, strength))
    }

}

// The count bar's half width, in cells: a little inside the runner's.
BAR_WIDTH :: 0.5

Metal_Bar_Params :: struct {
    box:  V4      // its middle, and its half width and half length (pixels)
    more: V4      // how much it shows, then unused
}

// A softly domed bronze bar, sharing the circular button's finish. Its surface turns from
// facing out along its middle to facing sideways at its edges (and its
// ends), reflecting a bright band from the light at the top left and a
// softer one from the other side, brushed along its length, darker toward
// its edges; laid over what's under it (its colour premultiplied).
metal_bar_shade :: (from: Draw.Quad_Between, bar: Shader.Uniforms(Metal_Bar_Params) -> colour: V4) {
    p := from.pixel - bar.box.xy
    radius := bar.box.z
    d := round_box_distance(p, bar.box.zw, radius)
    if d > 1 then return ⟨0, 0, 0, 0⟩
    coverage := Math.clamp(0.5 - d, 0, 1) * bar.more.x
    // (the way out of it, and how far toward its edge: 0 on its spine, 1 at its edge)
    gx := round_box_distance(p + V2⟨0.5, 0⟩, bar.box.zw, radius) - round_box_distance(p - V2⟨0.5, 0⟩, bar.box.zw, radius)
    gy := round_box_distance(p + V2⟨0, 0.5⟩, bar.box.zw, radius) - round_box_distance(p - V2⟨0, 0.5⟩, bar.box.zw, radius)
    outward := Math.normalize(V2⟨gx, gy⟩ + V2⟨0.00001, 0⟩)
    edge := Math.clamp(1 + d / Math.max(radius, 1), 0, 1)
    tilt := p / bar.box.zw * 0.65 + outward * edge * 0.35
    up := Math.sqrt(Math.max(1 - Math.dot(tilt, tilt), 0))
    // (what it reflects: a view from straight above turned by its surface)
    reflected := tilt * (2 * up)
    key := Math.exp(0 - Math.pow(Math.dot(reflected, PART_LIGHT) - 0.55, 2) * 18)
    fill := Math.exp(0 - Math.pow(Math.dot(reflected, PART_LIGHT * -1.0) - 0.7, 2) * 10)
    brushed := Patterns.noise(V2⟨p.x * 2.3, p.y * 0.15⟩ + V2⟨3.1, 0⟩)
    bronze := V3⟨0.58, 0.44, 0.30⟩ * (0.94 + 0.045 * brushed) * (1 - 0.45 * edge * edge)
    rgb := bronze + V3⟨1, 0.87, 0.65⟩ * (key * 0.30) + V3⟨0.75, 0.62, 0.46⟩ * (fill * 0.14)
    colour = V4⟨rgb.x, rgb.y, rgb.z, 1⟩ * coverage
}

Metal_Bar :: shader { vertex: Draw.quad_place; fragment: metal_bar_shade }
METAL_BAR :: Metal_Bar(Draw.SHADER_TARGET)

// The count bar drawn about a middle, half a size each way, showing a share.
draw_metal_bar :: (canvas: *Draw.Canvas, middle: V2, half: V2, shows: f32) {
    canvas.draw_shader(middle - half - V2⟨2, 2⟩, half * 2 + V2⟨4, 4⟩, METAL_BAR.code, METAL_BAR.bindings.bar, Metal_Bar_Params⟨V4⟨middle.x, middle.y, half.x, half.y⟩, V4⟨shows, 0, 0, 0⟩⟩)
}

// What's happening on the screen besides the game: what's being dragged,
// and what's open.
Screen_State :: struct {
    drag:          Drag
    picker:        Picker
    counts:        Count_Picker
    moving_end:    i64 = -1      // the line whose end is being dragged along the edge
    mouse:         V2
    can_undo:      bool
    can_redo:      bool
    previewing:    bool          // the lines are another count's, or moving to one
    settings_open: bool
    settings_shown: f32          // how far the settings have come into the pill, 0 to 1
    counts_shown:  f32           // how far it's become the count column's groove, 0 to 1
    count_ui_visible: f32 = 1    // returns only after the table reconnects
    toggles:       Toggles       // each player's colour toggles: open or folded into the five-colour icon
    drum:          Life_Drum     // a life total touched, turned as a drum
    keep_surfaces: bool          // the parts' surfaces kept between frames (keep_surfaces'); snapshots draw each
    motion:        Motion        // how fast their surfaces move
    surface_time:  f32           // how far they've moved, in features
    fps:           f32           // frames a second, over the last half second (0: none yet, not shown)
}

// How often the frames a second shown are worked out again, in seconds.
FPS_WINDOW :: 0.5

// The frames a second when nothing's being touched (the miasmas and the
// surfaces still move): a frame's work, then a wait for input for the rest.
IDLE_FPS :: 60.0

// The frames a second, top right, on a chip of the capsule's colour, upright
// to the screen.
draw_fps :: (canvas: *Draw.Canvas, layout: Layout, fonts: Fonts, fps: f32) {
    if fps <= 0 then return
    cell := cell_of(layout)
    text := "«i64'Math.round(fps)» fps"
    width := f32'fonts.label.text_width(text)
    height := f32'fonts.label.cap_height
    pad := 0.18 * cell
    size := V2⟨width + 2 * pad, height + 2 * pad⟩
    at := V2⟨layout.size.x - 0.25 * cell - size.x, 0.25 * cell⟩
    canvas.fill_rounded_rect(at, size, 0.2 * size.y, CAPSULE)
    draw_centred(canvas, fonts.label, at + size / 2, 0, text, INK)
}

////////////////////////////////
// Settings: the system's button splits the table along its horizontal
// seam (draw_settings_split), the pill staying as it is, and in the channel
// that opens are Reset, a place left of undo (every count's lines back where
// they start, each seat its starting colours, the motion slow), and the
// surfaces' motion, a place right of the system's button, one button going
// round paused, slow, medium and fast. The system's button, touched again,
// quits; anywhere else closes the table.

// The seconds the table takes to split (or close).
SETTINGS_TIME :: 0.16

PAUSE_ICON :: icon(Mdi.PAUSE)
RESET_ICON :: icon(Mdi.BACKUP_RESTORE)

Settings_Part :: union {
    animation           // the motion on to its next setting
    reset
    quit
    close               // anywhere else
}

// The motion the button goes to from one: paused, slow, medium, fast, and
// round to paused again.
next_motion :: (motion: Motion -> Motion) #pure {
    return if motion is {
        case .OFF: .SLOW
        case .SLOW: .MEDIUM
        case .MEDIUM: .FAST
        case .FAST: .OFF
    }
}

in_box :: (p: V2, low: V2, high: V2 -> bool) #pure {
    return p.x >= low.x and p.x <= high.x and p.y >= low.y and p.y <= high.y
}

// Where each of the settings' buttons is, in places from the pill's middle
// (a place CAPSULE_PITCH cells): Reset left of undo, the motion right of the
// system's button, and Quit the system's button itself.
RESET_PLACE     :: V2⟨-3, 0⟩
ANIMATION_PLACE :: V2⟨3, 0⟩
QUIT_PLACE      :: V2⟨2, 0⟩
SETTINGS_BUTTON :: 0.46        // a settings button's radius, in cells

settings_part_at :: (layout: Layout, p: V2 -> Settings_Part) #pure {
    local := (p - layout.centre) / (cell_of(layout) * CAPSULE_PITCH)
    on :: (q: V2, place: V2 -> bool) #pure {
        // (a button's half a place across, less a little)
        return Math.abs(q.x - place.x) <= 0.45 and Math.abs(q.y - place.y) <= 0.45
    }
    if on(local, ANIMATION_PLACE) then return Settings_Part.animation
    if on(local, RESET_PLACE) then return Settings_Part.reset
    if on(local, QUIT_PLACE) then return Settings_Part.quit
    return Settings_Part.close
}

// The settings' buttons in the channel, Reset and the motion's, each on a
// chip of the pill's floor, rimmed, shown a share.
draw_settings :: (canvas: *Draw.Canvas, layout: Layout, motion: Motion, shown: f32) {
    cell := cell_of(layout)
    pitch := CAPSULE_PITCH * cell
    c := layout.centre
    size := 0.62 * cell
    ink := faded(INK, shown)
    for place: [2] V2⟨RESET_PLACE, ANIMATION_PLACE⟩ {
        canvas.fill_circle(c + place * pitch + V2⟨0.03, 0.05⟩ * cell, SETTINGS_BUTTON * cell, Draw.rgba(0x000000, 0.4 * shown))
        canvas.fill_circle(c + place * pitch, SETTINGS_BUTTON * cell, faded(lighter(CAPSULE, 0.18), shown))
        canvas.fill_circle(c + place * pitch, (SETTINGS_BUTTON - 0.04) * cell, faded(CAPSULE, shown))
    }
    // (the motion as it is: paused, or its speed's triangles)
    at := c + ANIMATION_PLACE * pitch
    if motion is {
        case .OFF: draw_icon_at(canvas, PAUSE_ICON, at, size, ink)
        case .SLOW: draw_play(canvas, at, 1, size, ink)
        case .MEDIUM: draw_play(canvas, at, 2, size, ink)
        case .FAST: draw_play(canvas, at, 3, size, ink)
    }
    draw_icon_at(canvas, RESET_ICON, c + RESET_PLACE * pitch, size, ink)
}

// A speed's icon, play's triangles (one for slow, two, fast-forward's, for
// medium, three for fast), a count of them in a row centred on a point, an
// icon's size: each triangle as fast-forward's (mdi's: 8.5 of its 24 wide,
// 12 high, each against the next).
draw_play :: (canvas: *Draw.Canvas, middle: V2, count: i64, size: f32, colour: Draw.RGBA) {
    width := size * 8.5 / 24
    height := size * 12 / 24
    *left := middle.x - width * f32'count / 2
    for _: 0 < count {
        points := [3] V2⟨⟨left, middle.y - height / 2⟩, ⟨left + width, middle.y⟩, ⟨left, middle.y + height / 2⟩⟩
        canvas.fill_polygon(points[:], colour)
        left += width
    }
}

draw_player_ui :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, screen: Screen_State,
                   motes: Particles.System, elements: Elements, volleys: Volleys, targeted: i64) {
    cell := cell_of(layout)
    for k: 0 < layout.count {
        draw_seat(canvas, layer, layout, game, fonts, k, k == targeted, screen.surface_time, screen.toggles.shown[k], screen.drum, true)
    }
    // The surfaces form the grooves; a thin light marks the one being moved.
    for end, k: layout.ends[:layout.count] {
        if k == screen.moving_end {
            canvas.draw_line(layout.centre, end, Math.max(cell * 0.025, 1.5), INK)
        }
    }
    // The elements (each player's, a drag's stream, volleys) and their motes.
    draw_damage_icons(canvas, layout, game, screen.drag, screen.drum, fonts)
    draw_elements(canvas, layer, layout, game, screen, elements, volleys)
    motes.draw(canvas)
}

draw_table :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, screen: Screen_State, motes: Particles.System,
         elements: Elements, volleys: Volleys = ⟨⟩) {
    cell := cell_of(layout)
    *targeted: i64 = -1
    if screen.drag.active {
        if to, _ := aim(layout, game, screen.drag.from, screen.mouse) is not missed then targeted = to
    }
    // (the surfaces kept, a part's drawn again a frame, covering the whole
    // screen; or each drawn here, on the background)
    kept := screen.keep_surfaces and keep_surfaces(layout, game, targeted, screen.surface_time)
    if kept then canvas.draw_canvas(kept_surfaces.canvas, ⟨0, 0⟩) else canvas.clear(BACKGROUND)
    if !kept {
        for k: 0 < layout.count { draw_surface(canvas, layout, game, k, targeted, screen.surface_time) }
    }
    visible := Math.min(screen.count_ui_visible, count_player_visibility(screen.counts_shown))
    if visible >= 1 {
        draw_player_ui(canvas, layer, layout, game, fonts, screen, motes, elements, volleys, targeted)
    }
    else if visible > 0 and prepare_player_ui(canvas.size) {
        // Blend a complete UI frame over the identical bare surfaces; clear is opaque.
        player_ui_canvas.draw_canvas(canvas, ⟨0, 0⟩)
        draw_player_ui(player_ui_canvas, layer, layout, game, fonts, screen, motes, elements, volleys, targeted)
        fade := Player_Fade_Params⟨⟨layout.size.x, layout.size.y, visible, 0⟩⟩
        canvas.draw_shader_canvas(⟨0, 0⟩, layout.size, PLAYER_FADE.code, PLAYER_FADE.bindings.fade, fade,
                                  player_ui_canvas, PLAYER_FADE.bindings.content, PLAYER_FADE.bindings.filtering)
    }
    draw_capsule(canvas, layout, game, screen)

}

////////////////////////////////
// Snapshots: what each count of players looks like, without a window

// A game of a count of players part way through: some commander damage
// (one of it lethal, with six), and the drag and the grid to show.
sample_game :: (players: i64 -> game: Game) {
    game = new_game(players)
    game.deal(1, 0, 7)
    game.deal(2, 0, 3)
    game.deal(0, 1, 12)
    if players >= 3 then game.deal(1, 2, 5)
    if players >= 6 then game.deal(3, 5, 21)
    // Colours: blue and red, green alone, white, black and green.
    game.identity[0] = (u8'1 << u8'Mana.BLUE) | (u8'1 << u8'Mana.RED)
    game.identity[1] = u8'1 << u8'Mana.GREEN
    if players >= 3 then game.identity[2] = (u8'1 << u8'Mana.WHITE) | (u8'1 << u8'Mana.BLACK) | (u8'1 << u8'Mana.GREEN)
}

// Each count of players drawn as a tablet in landscape (and two in
// portrait too), a drag from the second player's icon half way into the
// first's part, into folder as raza_2.png and the like; and the number
// grid, facing the second, as raza_grid.png.
save_snapshots :: (folder: string) [failed: string] {
    sizes := [6] Wide.i32x2⟨⟨1440, 2160⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩⟩
    counts := [6] i64⟨2, 2, 3, 4, 5, 6⟩
    names := [6] string⟨"raza_2_portrait", "raza_2", "raza_3", "raza_4", "raza_5", "raza_6"⟩
    elements := settled_elements()
    for size, i: sizes {
        *canvas: Draw.Canvas
        if c := Draw.create_canvas(size) { canvas = c } else if os_error { fail: failed = "no canvas: «os_error»" }
        defer canvas.destroy()
        *layer: Draw.Canvas
        if l := Draw.create_canvas(size) { layer = l } else if os_error { fail: failed = "no layer: «os_error»" }
        defer layer.destroy()
        game := sample_game(counts[i])
        screen_size := V2⟨f32'size[0], f32'size[1]⟩
        layout := lay_out(screen_size, equal_splits(game.players, screen_size))
        *fonts: Fonts
        if fonts.reload_fonts(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"
        // Half way from where the line comes into the first's part to its
        // far edge.
        target := layout.seats[0]
        entry := entry_point(layout.seats[1].icon, target.middle, target.outline[:target.count])
        inner := Math.dot(entry - layout.centre, target.toward)
        finger := entry + target.toward * (target.reach - inner) * 0.5
        // (the second's stream to the finger)
        still, _ := settled_motes(layout, game)
        draw(canvas, layer, layout, game, fonts, ⟨drag: ⟨true, 1⟩, mouse: finger, can_undo: true, fps: 60⟩, still, elements)
        path := `scratch "«folder»/«names[i]».png"
        if canvas.save_png(path) is os_error then fail: failed = "can't write «path»: «os_error»"
        if counts[i] == 4 {
            // A volley of 12 from the second to the first, in flight, then landing.
            for age, a: [2] f32⟨0.35, 0.72⟩ {
                flying, volleys := settled_motes(layout, game, 1, finger, 0, 12, age)
                *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
                for v: volleys.list { pending[v.to][v.from] += v.amount - v.landed }
                *dealt := game
                dealt.deal(1, 0, 12)
                draw(canvas, layer, layout, shown_game(dealt, pending, volleys), fonts, ⟨can_undo: true⟩, flying, elements, volleys)
                volley_path := `scratch "«folder»/raza_volley_«a».png"
                if canvas.save_png(volley_path) is os_error then fail: failed = "can't write «volley_path»: «os_error»"
            }
            // Black's strike of 12 from the third (white, black and green) to
            // the first: its strands plunging, pulsing, then snapping.
            for age, a: [3] f32⟨0.36, 0.62, 0.92⟩ {
                striking, volleys := settled_motes(layout, game, 2, layout.seats[0].middle, 0, 12, age)
                *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
                for v: volleys.list { pending[v.to][v.from] += v.amount - v.landed }
                *dealt := game
                dealt.deal(2, 0, 12)
                draw(canvas, layer, layout, shown_game(dealt, pending, volleys), fonts, ⟨can_undo: true⟩, striking, elements, volleys)
                black_path := `scratch "«folder»/raza_black_«a».png"
                if canvas.save_png(black_path) is os_error then fail: failed = "can't write «black_path»: «os_error»"
            }
            picker := Picker⟨true, 1, 0, DEFAULT_PICKED / 10, DEFAULT_PICKED % 10⟩
            draw(canvas, layer, layout, game, fonts, ⟨picker: picker, mouse: finger, can_undo: true⟩, still, elements)
            grid_path := `scratch "«folder»/raza_grid.png"
            if canvas.save_png(grid_path) is os_error then fail: failed = "can't write «grid_path»: «os_error»"
            // The column dragged past five: the lines half way through
            // snapping from four's to five's, the game as five shown.
            *none: [MAX_PLAYERS + 1] Splits
            picking := Count_Picker⟨open: true, held: true, shown: 5.2, laid: 4, toward: 5, progress: 0.5⟩
            moving := lay_out(screen_size, shown_splits(picking, none[:], screen_size))
            preview := game_for(game, moving.count, none[:], screen_size)
            if fonts.resize_life(TEXT_FAMILY, moving) is os_error then fail: failed = "no font: «os_error»"
            moving_motes, _ := settled_motes(moving, preview)
            draw(canvas, layer, moving, preview, fonts, ⟨counts: picking, counts_shown: 1, previewing: true, can_undo: true⟩, moving_motes, elements)
            counts_path := `scratch "«folder»/raza_counts.png"
            if canvas.save_png(counts_path) is os_error then fail: failed = "can't write «counts_path»: «os_error»"
            // The colour toggles folded into the five-colour icon, and half way.
            for fold, f: [2] f32⟨0, 0.5⟩ {
                *folded: Toggles
                for *s: folded.shown { s = fold }
                for *o: folded.open { o = false }
                draw(canvas, layer, layout, game, fonts, ⟨toggles: folded, can_undo: true⟩, still, elements)
                folded_path := `scratch "«folder»/raza_folded_«f».png"
                if canvas.save_png(folded_path) is os_error then fail: failed = "can't write «folded_path»: «os_error»"
            }
            // A life drum open: its units' wheel turned up a row and two
            // fifths (carrying back into the tens'), then its tens' turned
            // down two fifths; then closing, half flattened, and closed, its
            // change flat beside it.
            if fonts.resize_life(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"
            life := game.life[0]
            drums := [4] Life_Drum⟨⟨open: true, player: 0, start: life, from: life, place: 1, turned: -1.4, bend: 1⟩,
                                   ⟨open: true, player: 0, start: life, from: life, place: 10, turned: 0.4, bend: 1⟩,
                                   ⟨player: 0, start: life - 2, from: life, bend: 0.5, change: 2, since: 0.05⟩,
                                   ⟨player: 0, start: life - 2, from: life, change: 2, since: 0.5⟩⟩
            for drum, d: drums {
                draw(canvas, layer, layout, game, fonts, ⟨drum: drum, can_undo: true⟩, still, elements)
                drum_path := `scratch "«folder»/raza_drum_«d».png"
                if canvas.save_png(drum_path) is os_error then fail: failed = "can't write «drum_path»: «os_error»"
            }
            for step, morph_index: [3] f32⟨0, 0.35, 0.7⟩ {
                draw(canvas, layer, moving, preview, fonts, ⟨counts: picking, counts_shown: step, previewing: true, can_undo: true⟩, moving_motes, elements)
                morph_path := `scratch "«folder»/raza_count_morph_«morph_index».png"
                if canvas.save_png(morph_path) is os_error then fail: failed = "can't write «morph_path»: «os_error»"
            }
            // The settings: part of the way into the pill, then in.
            for shown, s: [2] f32⟨0.4, 1⟩ {
                draw(canvas, layer, layout, game, fonts, ⟨settings_open: true, settings_shown: shown, motion: .SLOW, can_undo: true⟩, still, elements)
                settings_path := `scratch "«folder»/raza_settings_«s».png"
                if canvas.save_png(settings_path) is os_error then fail: failed = "can't write «settings_path»: «os_error»"
            }
        }
    }
    // Each element, large, on the background, at rest and drawn out, a few seconds in.
    if save_element_sheet(folder) is failed then fail: failed
    // The frames: six players, each colour alone and all five (gold).
    {
        *canvas: Draw.Canvas
        if c := Draw.create_canvas(⟨2160, 1440⟩) { canvas = c } else if os_error { fail: failed = "no canvas: «os_error»" }
        defer canvas.destroy()
        *layer: Draw.Canvas
        if l := Draw.create_canvas(⟨2160, 1440⟩) { layer = l } else if os_error { fail: failed = "no layer: «os_error»" }
        defer layer.destroy()
        *game := new_game(6)
        for k: 0 < 5 { game.identity[k] = u8'1 << u8'k }
        game.identity[5] = 0x1F
        screen_size := V2⟨2160, 1440⟩
        layout := lay_out(screen_size, equal_splits(6, screen_size))
        *fonts: Fonts
        if fonts.reload_fonts(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"
        settled, _ := settled_motes(layout, game)
        draw(canvas, layer, layout, game, fonts, ⟨can_undo: true⟩, settled, elements)
        path := `scratch "«folder»/raza_frames.png"
        if canvas.save_png(path) is os_error then fail: failed = "can't write «path»: «os_error»"
        // All ten hybrid pairs, plus gold for comparison on each sheet.
        hybrids := [10] Identity⟨3, 5, 9, 17, 6, 10, 18, 12, 20, 24⟩
        for page: 0 < 2 {
            for k: 0 < 5 { game.identity[k] = hybrids[page * 5 + k] }
            game.identity[5] = 0x1F
            hybrid_motes, _ := settled_motes(layout, game)
            draw(canvas, layer, layout, game, fonts, ⟨surface_time: 2⟩, hybrid_motes, elements)
            hybrid_path := `scratch "«folder»/raza_hybrids_«page».png"
            if canvas.save_png(hybrid_path) is os_error then fail: failed = "can't write «hybrid_path»: «os_error»"
        }
        for k: 0 < 5 { game.identity[k] = u8'1 << u8'k }
        // Fixed particles and two surface times isolate material animation.
        game.identity[5] = 0
        for moment: [2] f32⟨0, 2⟩ {
            draw(canvas, layer, layout, game, fonts, ⟨surface_time: moment⟩, settled, elements)
            material_path := `scratch "«folder»/raza_materials_«i32'moment».png"
            if canvas.save_png(material_path) is os_error then fail: failed = "can't write «material_path»: «os_error»"
        }
    }
}

// The element sheet (draw_element_sheet's), into folder as raza_elements.png.
save_element_sheet :: (folder: string) [failed: string] {
    size := Wide.i32x2⟨2400, 1300⟩
    *canvas: Draw.Canvas
    if c := Draw.create_canvas(size) { canvas = c } else if os_error { fail: failed = "no canvas: «os_error»" }
    defer canvas.destroy()
    *layer: Draw.Canvas
    if l := Draw.create_canvas(size) { layer = l } else if os_error { fail: failed = "no layer: «os_error»" }
    defer layer.destroy()
    draw_element_sheet(canvas, layer, 10)
    path := `scratch "«folder»/raza_elements.png"
    if canvas.save_png(path) is os_error then fail: failed = "can't write «path»: «os_error»"
}

////////////////////////////////
// The program

// Each count's lines (splits[n] for n players; none: equal_splits').
Lines :: #alias [MAX_PLAYERS + 1] Splits

// What undo goes back to: the game, and each count's lines.
Moment :: struct {
    game:  Game
    lines: Lines
}

// The moments before this one, to undo to, and those undone, to redo: doing
// something new forgets what was undone. A player's colours tapped one
// after another, while their toggles stay open, are one step (colours_of:
// whose, or -1).
Timeline :: struct {
    past:       [..] Moment
    future:     [..] Moment
    colours_of: i64 = -1
}

// The game and the lines as they are, kept to undo to, before something's
// done to them.
remember :: (timeline: *Timeline, game: Game, lines: Lines) {
    timeline.past.add(⟨game, lines⟩)
    timeline.future.clear()
    timeline.colours_of = -1
}

// A player's colour tapped: remembered, unless it's one more of their run of
// taps.
remember_colours :: (timeline: *Timeline, game: Game, lines: Lines, player: i64) {
    if timeline.colours_of == player then return
    timeline.remember(game, lines)
    timeline.colours_of = player
}

// The moment before this one (undo) or after it (redo), if there's one.
undo :: (timeline: *Timeline, game: *Game, lines: *Lines -> bool) {
    if timeline.past.count == 0 then return false
    timeline.future.add(⟨game, lines⟩)
    moment := timeline.past.pop()
    game = moment.game
    lines = moment.lines
    timeline.colours_of = -1
    return true
}

redo :: (timeline: *Timeline, game: *Game, lines: *Lines -> bool) {
    if timeline.future.count == 0 then return false
    timeline.past.add(⟨game, lines⟩)
    moment := timeline.future.pop()
    game = moment.game
    lines = moment.lines
    timeline.colours_of = -1
    return true
}

// Each count's lines stored, as they are now (a count's none: forgotten).
store_lines :: (lines: Lines) {
    with scratch.rewind()
    for n: 2 <= MAX_PLAYERS {
        key := `scratch "splits.«n»"
        if lines[n] == Splits⟨⟩ {
            if Defaults.remove(key) is { case absent, os_error: _ }
        }
        else if Defaults.set(key, lines[n]) is os_error { }
    }
}

Options :: struct {
    tune: bool
    background_tuning: string = "background-tuning.json"
    elements: string ⟦help: "draw each element, at rest and drawn out, into raza_elements.png in this folder, and quit"⟧
    snapshot: string ⟦help: "draw each count of players into PNGs in this folder (raza_2.png to raza_6.png, and raza_grid.png), and quit"⟧
    quit_after: f64 = 0 ⟦help: "quit after this many seconds, as if Quit were pressed (to profile it: rain -profile raza.rain -quit_after:15)"⟧
}

main :: (args: [] string) [failed: string] {
    // (the screen kept on while it runs: it's watched, not typed into)
    with System.keep_awake()
    defer destroy_count_table()
    if Draw.add_font(MANA) is bad_font then fail: failed = "Mana isn't a font Draw can read"
    if Draw.add_font(CRIMSON_PRO) is bad_font then fail: failed = "Crimson Pro isn't a font Draw can read"
    *options: Options
    if parsed := args.parse(Options, about: "Raza: a damage tracker for Commander, for a tablet in the middle of the table.") {
        options = parsed
    }
    else if help {
        fail: failed = help
    }
    else if bad_arguments {
        fail: failed = bad_arguments
    }
    tuning_loaded := load_gold_tuning(options.background_tuning)
    if loaded := Draw.image_from_bytes(MATERIAL_BYTES[:]) { material_image = loaded }
    else if bad_image { fail: failed = "cannot load textures/materials-v1.png" }
    defer material_image.destroy()
    if loaded_controls := Draw.image_from_bytes(CONTROL_BYTES[:]) { control_image = loaded_controls }
    else if bad_image { fail: failed = "cannot load textures/control-metal-v1.png" }
    defer control_image.destroy()
    if loaded_steel := Draw.image_from_bytes(UNDER_TABLE_BYTES[:]) { under_table_image = loaded_steel }
    else if bad_image { fail: failed = "cannot load textures/under-table-steel-v1.png" }
    defer under_table_image.destroy()
    if loaded_five := Draw.image_from_bytes(FIVE_COLOURS_BYTES[:]) { five_colours_image = loaded_five }
    else if bad_image { fail: failed = "cannot load textures/five-colour-dots-96.png" }
    defer five_colours_image.destroy()
    if options.elements != "" {
        if save_element_sheet(options.elements) is failed then fail: failed
        return
    }
    if options.snapshot != "" {
        if save_snapshots(options.snapshot) is failed then fail: failed
        return
    }
    *w: ^Window = null
    if made := Window.create_window("", ⟨1280, 800⟩, background: 0x131318) { w = made } else if os_error {
        fail: failed = "can't open a window: «os_error»"
    }
    w.set_fullscreen(true)
    *tuner: Gold_Tuner
    tuner.saved = tuning_loaded
    defer close_gold_tuner(tuner)
    if options.tune {
        if open_gold_tuner(tuner, w) is failed then fail: failed
    }
    *canvas: Draw.Canvas
    if c := Draw.create_canvas(w.size, w.handle) { canvas = c } else if os_error { fail: failed = "no canvas: «os_error»" }
    // (the light the elements give, drawn each frame, then added with its bloom)
    *layer: Draw.Canvas
    if l := Draw.create_canvas(w.size) { layer = l } else if os_error { fail: failed = "no light layer: «os_error»" }

    // The game and each count of players' lines (splits[n] for n players),
    // as they were left last time (Defaults': the registry's), or a new game
    // of four and lines as equal_splits starts them. (The font and the
    // frames' era were settings once: what was kept of them goes.)
    *game := Defaults.get("game", new_game(4))
    if game.players < 2 or game.players > MAX_PLAYERS then game = new_game(4)
    *timeline: Timeline
    // (the lines as a line's drag began, to undo it to)
    *lines_before: Lines
    if Defaults.remove("font") is { case absent, os_error: _ }
    if Defaults.remove("era") is { case absent, os_error: _ }
    *splits: [MAX_PLAYERS + 1] Splits
    for n: 2 <= MAX_PLAYERS { splits[n] = Defaults.get(`scratch "splits.«n»", Splits⟨⟩) }
    *speed := Defaults.get("motion", Motion.SLOW)
    // (how far the surfaces have moved, in their features)
    *surface_time: f32 = 0
    // (what was last stored, to store again only what's changed)
    *stored_game := game
    *stored_speed := speed
    *last_frame := Time.seconds_since_start()
    *fps_since := last_frame
    *fps_frames: i64 = 0
    *layout: Layout
    *fonts: Fonts
    *fonts_for := V2⟨0, 0⟩           // the size the fonts were made for (0: none yet)
    *fonts_players: i64 = 0          // ...and the count of players
    *screen: Screen_State
    screen.keep_surfaces = true
    // (the game carried on from the last run: its colours set, so each
    // player's toggles start folded, the five-colour icon to open them)
    fold_toggles(screen.toggles)
    // The motes (miasmas, a drag's stream, volleys), and the damage dealt
    // whose volleys haven't landed yet (pending[to][from]: shown undone).
    *motes: Particles.System
    *random := Random.generator()
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    *volleys: Volleys
    *elements: Elements

    // (for -quit_after's report: each frame's work, from its start to its
    // present, its waits for input left out)
    started := Time.seconds_since_start()
    *busy: f64 = 0
    *slowest: f64 = 0
    *busy_frames: i64 = 0
    *woke := started
    defer if options.quit_after > 0 and busy_frames > 0 {
        echo("«busy_frames» frames in «Time.seconds_since_start() - started, ⟨precision: 1⟩» s; each frame's work «busy / f64'busy_frames * 1000, ⟨precision: 2⟩» ms on average, «slowest * 1000, ⟨precision: 2⟩» ms at most")
    }
    while Window.update_windows() {
        frame_start := Time.seconds_since_start()
        if w.close_requested then w.destroy()
        if options.quit_after > 0 and Time.seconds_since_start() - started >= options.quit_after then w.destroy()
        if !w.is_open then break
        if w.keys[.F8].PRESSED {
            if tuner.open then tuner.open = false
            else if open_gold_tuner(tuner, w) is failed then fail: failed
        }
        tuning_input := step_gold_tuner(tuner, w, options.background_tuning)
        size := V2⟨f32'w.size[0], f32'w.size[1]⟩
        if canvas.size != w.size {
            if canvas.resize(w.size) is os_error then fail: failed = "can't resize the canvas"
            if layer.resize(w.size) is os_error then fail: failed = "can't resize the light layer"
        }
        // The screen laid out each frame (its lines may be moving), and its
        // fonts made again for a new size or count, or once a line's let go.
        if !splits_fit(splits[game.players], game.players) then splits[game.players] = equal_splits(game.players, size)
        layout = lay_out(size, splits[game.players])
        if size != fonts_for or game.players != fonts_players {
            if fonts.reload_fonts(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"
            fonts_for = size
            fonts_players = game.players
        }
        mouse := V2⟨f32'w.mouse.position[0], f32'w.mouse.position[1]⟩
        screen.mouse = mouse
        cell := cell_of(layout)

        if w.keys[.F11].PRESSED then w.set_fullscreen(!w.is_fullscreen)
        if w.keys[.ESCAPE].PRESSED {
            if tuner.open then tuner.open = false
            else if screen.picker.open then screen.picker.open = false
            else if screen.settings_open then screen.settings_open = false
            else if screen.counts.open then screen.counts.open = false
            else if w.is_fullscreen then w.set_fullscreen(false)
        }
        // (Control+Z undoes; Control+Y, or Control+Shift+Z, redoes)
        if w.modifiers.CONTROL and (w.keys[.Z].PRESSED or w.keys[.Y].PRESSED) {
            again := w.keys[.Y].PRESSED or w.modifiers.SHIFT
            moved := if again then timeline.redo(game, splits) else timeline.undo(game, splits)
            if moved {
                call_off_volleys(motes, volleys, pending)
                store_lines(splits)
            }
        }

        if !tuning_input and w.mouse.buttons[.LEFT].PRESSED {
            if screen.drum.open {
                if wheel := drum_wheel_at(layout, fonts, screen.drum, mouse) is not absent {
                    editing := layout.seats[screen.drum.player]
                    press_drum(screen.drum, game, screen.drum.player, local_of(editing.middle, editing.angle, mouse), wheel)
                } else {
                    close_drum(screen.drum, game)
                }
            }
            else if screen.picker.open {
                part := picker_part_at(layout, screen.picker, mouse)
                if part is {
                case tens: screen.picker.tens = tens
                case units: screen.picker.units = units
                case accept:
                    value := screen.picker.tens * 10 + screen.picker.units
                    if value > 0 {
                        timeline.remember(game, splits)
                        // (from the grid: straight at them)
                        target := layout.seats[screen.picker.to].middle
                        strike(game, motes, volleys, random, layout, pending, screen.picker.from, screen.picker.to, value, target, screen.picker.combat)
                    }
                    screen.picker.open = false
                case cancel, outside: screen.picker.open = false
                case panel: _
                }
            }
            else if screen.settings_open {
                setting := settings_part_at(layout, mouse)
                if setting is {
                case animation: speed = next_motion(speed)
                case reset:
                    // Every count's lines forgotten, here and stored: a count
                    // whose lines don't fit is laid out as equal_splits starts it.
                    // Then each seat its starting colours, those who've left
                    // the table forgotten, and the motion its default, slow.
                    // (Undo brings the colours, those players and the lines
                    // back; the motion's a setting, and stays.)
                    timeline.remember(game, splits)
                    for n: 2 <= MAX_PLAYERS {
                        splits[n] = ⟨⟩
                        if Defaults.remove(`scratch "splits.«n»") is { case absent, os_error: _ }
                    }
                    splits[game.players] = equal_splits(game.players, size)
                    layout = lay_out(size, splits[game.players])
                    reset_colours := starting_colours(size, game.players)
                    for k: 0 < game.players { game.identity[k] = reset_colours[k] }
                    forget_the_absent(game, reset_colours)
                    speed = Motion.SLOW
                    open_toggles(screen.toggles)
                case quit:
                    // (what's changed is already stored, each frame's as it's made)
                    w.destroy()
                    break
                case close: screen.settings_open = false
                }
            }
            else if part := capsule_part_at(layout, mouse) is not absent {
                if part is {
                case .UNDO:
                    if timeline.undo(game, splits) {
                        call_off_volleys(motes, volleys, pending)
                        store_lines(splits)
                    }
                case .REDO:
                    if timeline.redo(game, splits) {
                        call_off_volleys(motes, volleys, pending)
                        store_lines(splits)
                    }
                case .PLAYERS:
                    count := f32'game.players
                    screen.counts = ⟨open: true, held: true, grabbed: mouse.y, from: count, shown: count, laid: screen.counts.laid,
                                     toward: screen.counts.toward, progress: screen.counts.progress⟩
                case .RESTART:
                    // A new game of as many players, each seat's colours kept:
                    // every life back to the start's (those off the table's
                    // too), no damage (undo brings the old one back).
                    timeline.remember(game, splits)
                    game = new_game(game.players, game.identity)
                    call_off_volleys(motes, volleys, pending)
                case .SYSTEM:
                    screen.settings_open = true
                }
            }
            else if place := drum_wheel_at(layout, fonts, screen.drum, mouse) is not absent {
                // (an open drum's wheel: a turn of it, or a tap that keeps editing)
                spun := layout.seats[screen.drum.player]
                press_drum(screen.drum, game, screen.drum.player, local_of(spun.middle, spun.angle, mouse), place)
            }
            else if seat, colour := toggle_at(layout, screen.toggles, mouse) is not absent {
                // (one set: its pentagon folds TOGGLE_LINGER seconds from now,
                // unless another's set before then; undone with the rest of
                // that player's run of taps)
                timeline.remember_colours(game, splits, seat)
                bit := u8'1 << u8'colour
                was := game.identity[seat]
                game.identity[seat] = if was & bit != 0 then was & ~bit else was | bit
                touch_toggles(screen.toggles, seat)
            }
            else if folded := five_colours_at(layout, screen.toggles, mouse) is not absent {
                unfold_toggles(screen.toggles, folded)
            }
            else if opened := pentagon_middle_at(layout, screen.toggles, mouse) is not absent {
                fold_now(screen.toggles, opened)
            }
            else if spot, combat := icon_at(layout, game, mouse) is not absent {
                screen.drag = ⟨true, spot, combat⟩
            }
            else if who := life_at(layout, fonts, game, mouse) is not absent {
                // (a life touched: a tap opens its drum)
                touched := layout.seats[who]
                press_drum(screen.drum, game, who, local_of(touched.middle, touched.angle, mouse), 1)
            }
            else if line := line_at(layout, mouse, 0.5 * cell) is not absent {
                screen.moving_end = line
                lines_before = splits
            }
        }
        // A dragged line follows the finger: its end goes where a line from
        // the centre through the finger meets the edge, kept between its
        // neighbours.
        if screen.moving_end >= 0 {
            if aimed := share_through(layout, mouse) is not absent then splits[game.players].move_split_with_clearance(screen.moving_end, aimed, size)
            layout = lay_out(size, splits[game.players])
        }
        // A drum's wheel turns with the finger, toward its player and away.
        if screen.drum.pressed and screen.drum.player < layout.count {
            turning := layout.seats[screen.drum.player]
            screen.drum.move_drum(local_of(turning.middle, turning.angle, mouse), f32'fonts.life.cap_height)
        }
        if w.mouse.buttons[.LEFT].RELEASED and screen.drum.pressed {
            // Let go: a tap enters or keeps editing; a turn's number at the
            // middle is the life (undo brings the old one back).
            life, changes := screen.drum.release_drum(game)
            if changes {
                timeline.remember(game, splits)
                game.life[screen.drum.player] = life
            }
        }
        if w.mouse.buttons[.LEFT].RELEASED {
            if screen.drag.active {
                if to, amount := aim(layout, game, screen.drag.from, mouse) is not missed {
                    if amount is {
                    case damage:
                        timeline.remember(game, splits)
                        strike(game, motes, volleys, random, layout, pending, screen.drag.from, to, damage, mouse, screen.drag.combat)
                    case asked:
                        screen.picker = ⟨true, screen.drag.from, to, DEFAULT_PICKED / 10, DEFAULT_PICKED % 10, screen.drag.combat⟩
                    }
                }
                screen.drag.active = false
            }
            if screen.moving_end >= 0 {
                // (a line moved: a step to undo, the lines as they were)
                screen.moving_end = -1
                if splits[game.players] != lines_before[game.players] then timeline.remember(game, lines_before)
                if Defaults.set(`scratch "splits.«game.players»", splits[game.players]) is os_error { }
            }
            if screen.counts.open and screen.counts.held {
                // Let go: the count at the button is the game's (the same,
                // let go without moving), the column and the lines settling
                // on it, and the runner going back to the pill.
                screen.counts.held = false
                count := i64'Math.round(screen.counts.shown)
                if count != game.players {
                    timeline.remember(game, splits)
                    game = game_for(game, count, splits[:], size)
                    call_off_volleys(motes, volleys, pending)
                }
                screen.counts.open = false
                screen.counts.settling = true
            }
        }
        // The column follows the finger: the count at the button is where
        // it's been dragged to, between whole counts as it goes; let go, it
        // eases to the game's.
        if screen.counts.held {
            moved := (mouse.y - screen.counts.grabbed) / (COUNT_PITCH * cell)
            screen.counts.shown = Math.clamp(screen.counts.from - moved, 2, f32'MAX_PLAYERS)
        }
        else if screen.counts.settling {
            target := f32'game.players
            screen.counts.shown += (target - screen.counts.shown) * 0.3
            if Math.abs(target - screen.counts.shown) < 0.01 {
                screen.counts.shown = target
                screen.counts.settling = false
            }
        }
        // The lines snap to the count at the button as it changes (or, let
        // go, to the game's), a count at a time; while they're another
        // count's, the parts show the game as that count would have it.
        now := Time.seconds_since_start()
        seconds := f32'Math.min(now - last_frame, 0.1)
        last_frame = now
        // (the frames a second: those counted over the last window)
        fps_frames += 1
        if now - fps_since >= FPS_WINDOW {
            screen.fps = f32'(f64'fps_frames / (now - fps_since))
            fps_frames = 0
            fps_since = now
        }
        target := if screen.counts.open then i64'Math.round(screen.counts.shown) else game.players
        screen.counts.move_lines(target, seconds)
        *shown := game
        screen.previewing = lines_moving(screen.counts, game.players)
        if screen.previewing {
            layout = lay_out(size, shown_splits(screen.counts, splits[:], size))
            if layout.count != game.players then shown = game_for(game, layout.count, splits[:], size)
        }

        // The elements and their motes moved on: each stirred or settling,
        // a drag's stream fed, the volleys' landings; and the game shown with
        // what's still in flight not yet done.
        stir_elements(elements, layout, game, screen, volleys, seconds)
        motes.flow_scale = MOTE_FLOW * cell
        feed_volleys(motes, random, layout, game, volleys, seconds)
        motes.update(seconds)
        steer_volleys(motes, volleys, random, layout, game, pending, seconds)
        if !screen.previewing then shown = shown_game(game, pending, volleys)

        // What changed this frame, stored (a failure to store isn't the game's).
        if game != stored_game {
            if Defaults.set("game", game) is os_error { }
            stored_game = game
        }
        if speed != stored_speed {
            if Defaults.set("motion", speed) is os_error { }
            stored_speed = speed
        }

        // The life totals sized for the parts drawn, whatever moved them
        // (a dragged line, lines settling on a count, a reset); the font's
        // made again only when the size changes.
        if fonts.resize_life(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"

        screen.can_undo = timeline.past.count > 0
        screen.can_redo = timeline.future.count > 0
        // (the settings coming into the pill, or going)
        opening: f32 = if screen.settings_open then 1 else -1
        screen.settings_shown = Math.clamp(screen.settings_shown + opening * seconds / SETTINGS_TIME, 0, 1)
        // (and into the count column's groove while a finger's on the
        // column, back as it's let go)
        screen.counts_shown = step_count_opening(screen.counts_shown, screen.counts.held, seconds)
        screen.count_ui_visible = step_count_player_ui(screen.count_ui_visible, screen.counts_shown, screen.counts.held, seconds)
        // (each player's toggles counting down to folding, and folding or opening)
        step_toggles(screen.toggles, seconds)
        // (a player's run of colour taps ends as their toggles fold)
        if timeline.colours_of >= 0 and !screen.toggles.open[timeline.colours_of] then timeline.colours_of = -1
        step_drum(screen.drum, game, seconds)
        // (the surfaces moved on by the frame's time at the chosen speed)
        surface_time += seconds * MOTION_RATES[speed]
        screen.motion = speed
        screen.surface_time = surface_time
        draw(canvas, layer, layout, shown, fonts, screen, motes, elements, volleys)
        draw_gold_tuner(canvas, tuner)
        canvas.present(w.handle, vsync: true)
        worked := Time.seconds_since_start() - frame_start
        busy += worked
        slowest = Math.max(slowest, worked)
        busy_frames += 1
        scratch.reset()
        still := !screen.drag.active and screen.moving_end < 0 and !screen.counts.held and !screen.counts.settling and !screen.previewing
        // (still, it waits for input, but only for what's left of the frame
        // after its work: the miasmas always swirl, at IDLE_FPS, and anything
        // touched is answered at once)
        if still {
            // (the frame's whole time, its windows' messages too, from the
            // last wait's end)
            left := 1.0 / IDLE_FPS - (Time.seconds_since_start() - woke)
            if left > 0.001 {
                if _ := Window.wait_for_input(milliseconds: u32'(left * 1000)) is timed_out { }
            }
        }
        woke = Time.seconds_since_start()
    }
}
