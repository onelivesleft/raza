// Raza: a damage tracker for Commander, for a tablet in the middle of the
// table. Each player has a part of the screen, their life total in it
// facing them, and a damage icon toward the centre: dragged into another
// player's part, it deals that player commander damage, more the further it
// goes (1 to 9 out to the life total, then a picker starting at 10). The parts start
// as wide as each other across their life totals, mirrored about the
// screen's upright middle, and a line between two is moved by dragging its
// end along the edge. The capsule in the middle undoes, shows how many play (a person
// each: touched, the other counts show above and below it, to drag to for
// a new game), and holds the settings. The text is Crimson Pro's. The game
// and each count's lines are kept from one run to the next (Defaults', the
// registry's).
//
//     rain -run src/raza.rain
//
// A dev build (rain src/raza.rain) goes in build/; for the tablet, `rain
// -release src/raza.rain` makes release/Raza.exe, optimized through LLVM,
// each frame's work about two thirds of a debug build's.

Raza :: program {
    icon: "../textures/raza.ico"
    subsystem: .WINDOWS
    debug {
        mode: .DEBUG
        output_folder: "../build/"
    }
    release {
        mode: .RELEASE
        optimization: .SPEED
        output_folder: "../release/"
    }
}

#import Draw(RENDERER: .VULKAN)
#import Window
#if #program.os == .WINDOWS { #import OS_Windows }
#import Math
#import System
#import Wide
#import Arguments
#import Defaults
#import Time
#import Patterns
#import Shader
#import Random
#import Icons(SETS: .MDI)
#import Console
#import Image_Files
#include "icons/icons.rain"

#include "layout.rain"
#include "game.rain"
#include "frames.rain"
#include "count-table.rain"
#include "target-arrow.rain"
#include "materials.rain"
#include "motes.rain"
#include "elements.rain"

V2 :: #alias Math.Vector2(f32)

// The fonts, carried in the program.
MANA        :: #data "../fonts/mana/mana-mirrored-power.ttf"
CRIMSON_PRO :: #data "../fonts/crimson_pro/CrimsonPro[wght].ttf"

TEXT_FAMILY :: "Crimson Pro"
ICON_FAMILY :: "Mana"            // Magic's own symbols (the colours'); other icons are the Icons module's

// Each colour's symbol (Mana's ms-w to ms-g), in WUBRG order; its circle's
// colour (Magic's own, as the cards' mana symbols are printed); and the
// colour a player's part is in that colour (the colour pie's).
MANA_GLYPHS  :: [Mana] string⟨"\u{E600}", "\u{E601}", "\u{E602}", "\u{E603}", "\u{E604}"⟩
MANA_CIRCLES :: [Mana] Draw.RGBA⟨Draw.rgb(0xFFFBD5), Draw.rgb(0xAAE0FA), Draw.rgb(0xCBC2BF), Draw.rgb(0xF9AA8F), Draw.rgb(0x9BD3AE)⟩
MANA_GROUNDS :: [Mana] Draw.RGBA⟨Draw.rgb(0xF9FAF4), Draw.rgb(0x0E68AB), Draw.rgb(0x150B00), Draw.rgb(0xD3202A), Draw.rgb(0x00733E)⟩
MANA_INK     :: Draw.rgb(0x111111)

// The life total's ink on a light part (white's).
DARK_INK :: Draw.rgb(0x1C1A17)

// How light a colour looks, from 0 to 1.
lightness :: (c: Draw.RGBA -> f32) #pure {
    return 0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b
}

// A gradient's colour at its middle (its colours evenly spaced along it).
middle_of :: (colours: [] Draw.RGBA -> Draw.RGBA) #pure {
    s := 0.5 * f32'(colours.count - 1)
    i := Math.min(i64'Math.floor(s), colours.count - 2)
    if colours.count < 2 then return colours[0]
    return Math.mix(colours[i], colours[i + 1], s - f32'i)
}

BACKGROUND :: Draw.rgb(0x131318)
INK        :: Draw.rgb(0xF4EFE6)
CAPSULE    :: Draw.rgb(0x26262E)

// The unit the controls are measured in: a share of the screen's shorter side.
CELL_SHARE :: 0.075

cell_of :: (layout: Layout -> f32) #pure {
    return Math.min(layout.size.x, layout.size.y) * CELL_SHARE
}

// A colour toward white.
lighter :: (colour: Draw.RGBA, by: f32 -> Draw.RGBA) #pure {
    return Math.mix(colour, INK, by)
}

////////////////////////////////
// Colour identity: five toggles at each player's bottom left, in a pentagon
// as Magic's card back has them, folding into one five-colour icon when
// they've been left alone a moment

TOGGLE_RADIUS :: 0.26          // in cells
TOGGLE_RING   :: 0.56          // from the pentagon's middle to each toggle's

// Whether toggles of radius r at the places (the first count) are inside
// the part and clear of its sides.
toggles_fit :: (points: [] V2, places: [] V2, r: f32, count: i64 = 5 -> bool) #pure {
    for c: places[:count] {
        if !inside(c, points) then return false
        for a, i: points {
            if distance_to_segment(c, a, points[(i + 1) % points.count]) < r then return false
        }
    }
    return true
}

// Where a part's colour toggles go: folded, the five-colour icon in its
// player's bottom left corner, as near it as it fits; open, a pentagon in
// their frame, in Mana's order (WUBRG) as a card's back has them, white at
// its top as they see it, then blue, black, red and green clockwise, its
// middle as near the icon as it fits (so opening, it moves out as little as
// it can); each the gap clear of the part's sides. The options' are the
// same in its player's bottom right corner (on_right), four round their
// middle (count).
toggle_places :: (layout: Layout, seat: Seat, on_right := false, count: i64 = 5 -> places: [8] V2, middle: V2, folded: V2) #pure {
    places = ⟨⟩
    middle = seat.middle
    folded = seat.middle
    cell := cell_of(layout)
    reach := (toggle_ring_radius(count) + TOGGLE_RADIUS) * cell
    r := TOGGLE_RADIUS * cell
    gap := TOGGLE_GAP * cell
    points := seat.outline[:seat.count]
    // (the part in its player's frame: x along their text, y toward them)
    *left: f32 = 1e30
    *right: f32 = -1e30
    *top: f32 = 1e30
    *bottom: f32 = -1e30
    for p: points {
        l := local_of(seat.middle, seat.angle, p)
        left = Math.min(left, l.x)
        right = Math.max(right, l.x)
        top = Math.min(top, l.y)
        bottom = Math.max(bottom, l.y)
    }
    // The icon: of places in steps (two) across the part, the nearest its
    // player's bottom left corner (its bounds') that fits, then halved toward
    // the corner to where it only just does.
    step := 0.1 * cell
    corner_x := if on_right then right else left
    corner_of_part := V2⟨corner_x, bottom⟩
    first_x := if on_right then right - r - gap else left + r + gap
    *corner := V2⟨first_x, bottom - r - gap⟩
    *nearest: f32 = 1e30
    *y := bottom - r - gap
    while y > top + r + gap {
        *x := left + r + gap
        while x < right - r - gap {
            d := Math.length(V2⟨x, y⟩ - corner_of_part)
            if d < nearest and icon_fits(seat, points, x, y, r + gap) {
                corner = ⟨x, y⟩
                nearest = d
            }
            x += 2 * step
        }
        y -= 2 * step
    }
    if nearest < 1e30 {
        *near := corner_of_part
        *far := corner
        for _: 0 < 12 {
            halfway := (near + far) / 2
            if icon_fits(seat, points, halfway.x, halfway.y, r + gap) then far = halfway else near = halfway
        }
        corner = far
    }
    // Intersect inset screen edges with other screen edges or player channels.
    // All icons use the same clearance, including the channel's visible bevel.
    // Choose the farthest valid point left of the region bisector.
    *furthest: f32 = -1
    bisector := seat.middle - layout.centre
    bisector_right := V2⟨bisector.y, 0 - bisector.x⟩
    for edge: 1 < points.count - 1 {
        a := points[edge]
        direction := points[edge + 1] - a
        if Math.length(direction) < 0.001 then continue
        *normal := Math.normalize(V2⟨0 - direction.y, direction.x⟩)
        if Math.dot(normal, seat.middle - a) < 0 then normal = normal * -1.0
        screen_offset := Math.dot(normal, a) + r + gap
        for channel: 0 < points.count {
            b := points[channel]
            along := points[(channel + 1) % points.count] - b
            if Math.length(along) < 0.001 then continue
            *inward := Math.normalize(V2⟨0 - along.y, along.x⟩)
            if Math.dot(inward, seat.middle - b) < 0 then inward = inward * -1.0
            edge_bevel := if channel == 0 or channel == points.count - 1 then BEVEL_CELLS * cell else 0
            channel_offset := Math.dot(inward, b) + r + gap + edge_bevel
            determinant := normal.x * inward.y - normal.y * inward.x
            if Math.abs(determinant) < 0.0001 then continue
            candidate := V2⟨screen_offset * inward.y - normal.y * channel_offset,
                            normal.x * channel_offset - screen_offset * inward.x⟩ / determinant
            if !inside(candidate, points) then continue
            *fits := true
            for start, index: points {
                bevel := if index == 0 or index == points.count - 1 then BEVEL_CELLS * cell else 0
                margin := r + gap + bevel
                if distance_to_segment(candidate, start, points[(index + 1) % points.count]) < margin - 0.01 then fits = false
            }
            if !fits then continue
            local := local_of(seat.middle, seat.angle, candidate)
            // Use the actual region bisector, not the snapped text orientation
            // (left of it for the colours, right for the options).
            from_centre := candidate - layout.centre
            across := Math.dot(from_centre, bisector_right)
            if (on_right and across <= 0) or (!on_right and across >= 0) then continue
            distance := Math.length(from_centre)
            if distance > furthest {
                corner = local
                furthest = distance
            }
        }
    }
    folded = placed(seat.middle, seat.angle, corner)
    if on_right {
        button_margin := (FIVE_COLOURS_SIDE / 2 + TOGGLE_BUTTON_GAP) * cell
        folded = Math.clamp(folded, V2⟨button_margin, button_margin⟩, layout.size - V2⟨button_margin, button_margin⟩)
        corner = local_of(seat.middle, seat.angle, folded)
    }
    // The pentagon: of middles in steps about the icon, the nearest it that
    // fits, then halved toward the icon to where it only just does.
    span := if on_right then 6 * reach else 3 * reach
    *best := corner
    *best_distance: f32 = 1e30
    *gy := corner.y - span
    while gy <= corner.y + span {
        *gx := corner.x - span
        while gx <= corner.x + span {
            at := V2⟨gx, gy⟩
            d := Math.length(at - corner)
            if d < best_distance and pentagon_fits(layout, seat, points, gx, gy, count, corner) {
                best = at
                best_distance = d
            }
            gx += step
        }
        gy += step
    }
    if best_distance == 1e30 {
        if on_right {
            // Search the viewport when the player's wedge cannot contain the pane.
            half := option_panel_half(cell)
            c := Math.abs(Math.cos(seat.angle))
            s := Math.abs(Math.sin(seat.angle))
            inset := V2⟨c * half.x + s * half.y + gap, s * half.x + c * half.y + gap⟩
            low := inset
            high := layout.size - inset
            *wy := low.y
            while wy <= high.y {
                *wx := low.x
                while wx <= high.x {
                    candidate := V2⟨wx, wy⟩
                    d := Math.length(candidate - folded)
                    if d < best_distance {
                        local := local_of(seat.middle, seat.angle, candidate)
                        if option_button_clear(local - corner, half, cell) {
                            best = local
                            best_distance = d
                        }
                    }
                    wx += step
                }
                wy += step
            }
            middle = placed(seat.middle, seat.angle, best)
            places = pentagon(seat, best.x, best.y, cell, count)
            return
        }
        // (a part with no room: the pentagon at its player's edge, for what shows)
        edge_x := if on_right then right - reach else left + reach
        places = pentagon(seat, edge_x, bottom - reach - gap, cell, count)
        middle = placed(seat.middle, seat.angle, ⟨edge_x, bottom - reach - gap⟩)
        return
    }
    *near := corner
    *far := best
    for _: 0 < 12 {
        halfway := (near + far) / 2
        if pentagon_fits(layout, seat, points, halfway.x, halfway.y, count, corner) then far = halfway else near = halfway
    }
    places = pentagon(seat, far.x, far.y, cell, count)
    middle = placed(seat.middle, seat.angle, far)
}

// Whether the folded icon, its middle at x, y in a part's player's frame,
// fits: in the part, clear of its sides by clear.
icon_fits :: (seat: Seat, points: [] V2, x: f32, y: f32, clear: f32 -> bool) #pure {
    at := placed(seat.middle, seat.angle, ⟨x, y⟩)
    return inside(at, points) and clearance(at, points) >= clear
}

// Whether a part's toggle pentagon, its middle at x, y in its player's
// frame, fits: its middle in the part, each toggle the gap from its sides.
// (and clear of their button at hub, in the same frame, which shows while
// they're open)
pentagon_fits :: (layout: Layout, seat: Seat, points: [] V2, x: f32, y: f32, count: i64 = 5, hub: V2 = ⟨1e30, 1e30⟩ -> bool) #pure {
    cell := cell_of(layout)
    r := TOGGLE_RADIUS * cell
    gap := TOGGLE_GAP * cell
    if !inside(placed(seat.middle, seat.angle, ⟨x, y⟩), points) then return false
    if count == OPTION_KINDS.count {
        half := option_panel_half(cell)
        for sx: [2] f32⟨-1, 1⟩ { for sy: [2] f32⟨-1, 1⟩ {
            if !icon_fits(seat, points, x + sx * half.x, y + sy * half.y, gap) then return false
        } }
        return option_button_clear(V2⟨x, y⟩ - hub, half, cell)
    }
    places := pentagon(seat, x, y, cell, count)
    if hub.x < 1e29 {
        button := placed(seat.middle, seat.angle, hub)
        for place: places[:count] { if Math.length(place - button) < r + (FIVE_COLOURS_SIDE / 2 + TOGGLE_BUTTON_GAP) * cell then return false }
    }
    return toggles_fit(points, places[:], r + gap, count)
}

// The gap between a part's open toggles and their button (cells).
TOGGLE_BUTTON_GAP :: 0.08

// The toggles' places about a middle at x, y in a part's player's frame
// (five, or count): the i'th (a colour, in Mana's order; an option, in
// Attack's) i fifths (or counts) of a turn clockwise from the top as they
// see it.
toggle_ring_radius :: (count: i64 -> f32) #pure {
    return Math.max(TOGGLE_RING, (TOGGLE_RADIUS + 0.05) / Math.sin(f32'Math.PI / f32'count))
}

option_button_clear :: (offset: V2, half: V2, cell: f32 -> bool) #pure {
    radius := (FIVE_COLOURS_SIDE / 2 + TOGGLE_BUTTON_GAP) * cell
    return Math.abs(offset.x) >= half.x + radius or Math.abs(offset.y) >= half.y + radius
}

OPTION_PITCH :: 0.70
option_panel_half :: (cell: f32 -> V2) #pure { return V2⟨2 * OPTION_PITCH + 0.08, OPTION_PITCH + 0.08⟩ * cell }

pentagon :: (seat: Seat, x: f32, y: f32, cell: f32, count: i64 = 5 -> places: [8] V2) #pure {
    places = ⟨⟩
    for i: 0 < count {
        if count == OPTION_KINDS.count {
            places[i] = placed(seat.middle, seat.angle, ⟨x + (f32'(i % 4) - 1.5) * OPTION_PITCH * cell, y + (f32'(i / 4) - 0.5) * OPTION_PITCH * cell⟩)
            continue
        }
        a := f32'i * f32'Math.TAU / f32'count
        places[i] = placed(seat.middle, seat.angle, ⟨x + Math.sin(a) * toggle_ring_radius(count) * cell, y - Math.cos(a) * toggle_ring_radius(count) * cell⟩)
    }
}

// The gap from a colour toggle to the screen's edge and to its part's
// divider, in cells.
TOGGLE_GAP :: 0.3

// The toggles fold into one five-colour icon (FIVE_COLOURS, its side in
// cells) in their player's corner once a player who's set one has left them
// TOGGLE_LINGER seconds, folding or opening over TOGGLE_FOLD seconds; the
// pentagon's middle touched folds them at once. The icon touched opens them
// for TOGGLE_OPENED seconds, each one set then giving TOGGLE_LINGER again.
// After a reset (every seat its starting colours) they're open, and stay so
// until one's set; a restart or a new count keeps the colours, and the
// toggles as they were.
TOGGLE_OPENED :: 3.0
TOGGLE_LINGER :: 2.0
TOGGLE_FOLD   :: 0.2
FIVE_COLOURS_SIDE :: 2 * TOGGLE_RADIUS / 0.84     // its dots as wide as a toggle (the image has 8% of its side clear round them)

// Each player's toggles' state: open or folded, how far open as they're
// drawn (0 folded, 1 open), and the seconds left before they fold (none:
// open until one's set).
Toggles :: struct {
    open:  [MAX_PLAYERS] bool = ⟨true, true, true, true, true, true⟩
    shown: [MAX_PLAYERS] f32 = ⟨1, 1, 1, 1, 1, 1⟩
    left:  [MAX_PLAYERS] f32 = ⟨-1, -1, -1, -1, -1, -1⟩
}

// Every player's toggles folded (a game carried on from the last run).
fold_toggles :: (toggles: *Toggles) {
    for *o: toggles.open { o = false }
    for *s: toggles.shown { s = 0 }
}

// The five-colour icon (Magic's card back's five dots, textures'), made an
// image as Raza starts.
FIVE_COLOURS_BYTES :: #data "../textures/five-colour-dots-96.png"
five_colours_image: Draw.Image

Five_Colours_Params :: struct {
    box:  V4      // its middle, and its half side (pixels), then unused
    turn: V4      // cosine, sine, overall visibility, green-dot opacity
    dots: V4      // white, blue, black and red dot opacity
}

// The five-colour icon turned about its middle as its player's text is,
// shown a share (its colour premultiplied, as the image is).
five_colours_shade :: (from: Draw.Quad_Between, badge: Shader.Uniforms(Five_Colours_Params), texture: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    d := from.pixel - badge.box.xy
    // (into the icon's own frame: turned back by its turn)
    local := V2⟨d.x * badge.turn.x + d.y * badge.turn.y, d.y * badge.turn.x - d.x * badge.turn.y⟩
    uv := local / Math.max(badge.box.z * 2, 1) + V2⟨0.5, 0.5⟩
    if uv.x < 0 or uv.x > 1 or uv.y < 0 or uv.y > 1 then return ⟨0, 0, 0, 0⟩
    // Pick the nearest dot in the unrotated texture; the gaps are transparent.
    weights := [5] f32⟨badge.dots.x, badge.dots.y, badge.dots.z, badge.dots.w, badge.turn.w⟩
    *nearest: f32 = 1e30
    *opacity: f32 = 1
    for i: 0 < 5 {
        angle := f32'i * f32'Math.TAU / 5
        centre := V2⟨0.5, 0.55⟩ + V2⟨Math.sin(angle), 0 - Math.cos(angle)⟩ * 0.29
        delta := uv - centre
        distance := Math.dot(delta, delta)
        if distance < nearest {
            nearest = distance
            opacity = weights[i]
        }
    }
    colour = Shader.sample_level(texture, filtering, uv, 0) * (badge.turn.z * opacity)
}

Five_Colours :: shader { vertex: Draw.quad_place; fragment: five_colours_shade }
FIVE_COLOURS :: Five_Colours(Draw.SHADER_TARGET)

// The five-colour icon drawn about a middle, its side side, turned by
// angle, shown a share.
draw_five_colours :: (canvas: *Draw.Canvas, middle: V2, side: f32, angle: f32, shows: f32, identity: Identity) {
    // (a square big enough for its corners however it's turned)
    reach := side * 0.75
    *weights: [5] f32
    for *weight, i: weights {
        weight = if has_colour(identity, Mana'i) then 1 else f32'1 / 3
    }
    params := Five_Colours_Params⟨V4⟨middle.x, middle.y, side / 2, 0⟩,
                                  V4⟨Math.cos(angle), Math.sin(angle), shows, weights[4]⟩,
                                  V4⟨weights[0], weights[1], weights[2], weights[3]⟩⟩
    canvas.draw_shader_image(middle - V2⟨reach, reach⟩, V2⟨reach, reach⟩ * 2, FIVE_COLOURS.code, FIVE_COLOURS.bindings.badge, params, five_colours_image,
                             FIVE_COLOURS.bindings.texture, FIVE_COLOURS.bindings.filtering)
}

// Every player's toggles open until one's set (a reset).
open_toggles :: (toggles: *Toggles) {
    for *o: toggles.open { o = true }
    for *l: toggles.left { l = -1 }
}

// A player's toggle set: open, folding TOGGLE_LINGER seconds from now.
touch_toggles :: (toggles: *Toggles, k: i64) {
    toggles.open[k] = true
    toggles.left[k] = TOGGLE_LINGER
}

// A player's five-colour icon touched: open, folding TOGGLE_OPENED seconds
// from now.
unfold_toggles :: (toggles: *Toggles, k: i64) {
    toggles.open[k] = true
    toggles.left[k] = TOGGLE_OPENED
}

// A player's open pentagon's middle touched: folding now.
fold_now :: (toggles: *Toggles, k: i64) {
    toggles.open[k] = false
    toggles.left[k] = 0
}

// Every player's toggles moved on by a frame's time: counting down to
// folding, and opening or folding as they're drawn.
step_toggles :: (toggles: *Toggles, seconds: f32) {
    for k: 0 < MAX_PLAYERS {
        if toggles.open[k] and toggles.left[k] > 0 {
            toggles.left[k] -= seconds
            if toggles.left[k] <= 0 then toggles.open[k] = false
        }
        way: f32 = if toggles.open[k] then 1 else -1
        toggles.shown[k] = Math.clamp(toggles.shown[k] + way * seconds / TOGGLE_FOLD, 0, 1)
    }
}

// The nearest a point comes to a polygon's edges.
clearance :: (p: V2, points: [] V2 -> f32) #pure {
    *least: f32 = 1e30
    for a, i: points { least = Math.min(least, distance_to_segment(p, a, points[(i + 1) % points.count])) }
    return least
}

// Each player's damage spot (seat.icon) is two icons side by side across it
// as its player sees it: damage's on their left (life alone: a spell's, an
// ability's, another creature's), commander damage's on their right (their
// commander's combat damage: life, and toward the 21). Each is
// DAMAGE_ICON_APART cells from the spot, DAMAGE_ICON_RADIUS cells round.
DAMAGE_ICON_APART  :: 0.5
DAMAGE_ICON_RADIUS :: 0.42
COMMANDER_GLYPH :: "\u{E9C6}" // Mana ms-commander
DAMAGE_GLYPH :: "\u{EA2F}" // Mana ms-power-mtga
LIFELINK_GLYPH :: "\u{EA4B}" // Mana ms-ability-lifelink
POISON_GLYPH :: "\u{EA73}" // Mana ms-ability-infect

// A player's attack icons stand in lines, the first their spot's (centred
// on it), each further line ATTACK_ROW_PITCH cells above the last (further
// from them, toward the table's centre), its icons twice DAMAGE_ICON_APART
// apart, centred. Plain damage's leftmost as they see it, then each they've
// turned on, in Attack's order; a line holds as many as fit across their
// part (attacks_across), the rest wrapping into the lines above.
ATTACK_ROW_PITCH :: 1.0

// The i'th of count attack icons, in lines of across, in its player's frame
// from their spot: the lines after the first above it, never below (toward
// them), apart and the lines' pitch times squeeze (1 as far apart as they
// go), and the whole moved down (toward them) by down cells.
row_place :: (i: i64, count: i64, across: i64, squeeze: f32, down: f32, cell: f32 -> V2) #pure {
    row := i / across
    in_row := Math.min(across, count - row * across)
    column := i - row * across
    return ⟨(f32'column - f32'(in_row - 1) / 2) * 2 * DAMAGE_ICON_APART * squeeze * cell, (down - f32'row * ATTACK_ROW_PITCH * squeeze) * cell⟩
}

// How close attack icons may come, as row_place's squeeze: as far apart as
// they go, then closer, to the most they're pulled together.
ATTACK_SQUEEZES :: [3] f32⟨1, 0.9, 0.8⟩

// How far (cells) a part's attack icons may be moved down from its spot,
// toward its player, where even pulled together their lines won't fit
// above it, and by what steps.
ATTACK_MOST_DOWN :: 2.0
ATTACK_DOWN_STEP :: 0.1

// Whether an attack icon at a point is inside its part, clear of its
// channels' walls, and clear of the controls in the middle.
attack_fits :: (layout: Layout, seat: Seat, at: V2 -> bool) #pure {
    cell := cell_of(layout)
    clearance_needed := (DAMAGE_ICON_RADIUS + BEVEL_CELLS + ATTACK_CHANNEL_GAP) * cell
    points := seat.outline[:seat.count]
    if !inside(at, points) then return false
    if distance_to_segment(at, points[0], points[1]) < clearance_needed then return false
    if distance_to_segment(at, points[points.count - 1], points[0]) < clearance_needed then return false
    shape, column := recess_shape(layout, 0)
    return recess_distance(at - shape.xy, shape, column) >= (DAMAGE_ICON_RADIUS + ATTACK_CHANNEL_GAP) * cell
}

// How a part's count attack icons are laid out (row_place's across, squeeze
// and down): their lines always going up, as many in a line as fit with
// every line they'd make fitting, pulled closer together before they're
// fewer; where nothing fits even at their closest (every option on, in a
// narrow part), the least move down toward their player that fits them, at
// their closest, its lines still going up (and past ATTACK_MOST_DOWN, one
// a line).
attack_rows :: (layout: Layout, k: i64, count: i64 -> across: i64, squeeze: f32, down: f32) #pure {
    seat := layout.seats[k]
    cell := cell_of(layout)
    all_fit :: (layout: Layout, seat: Seat, count: i64, across: i64, squeeze: f32, down: f32, cell: f32 -> bool) #pure {
        for i: 0 < count { if !attack_fits(layout, seat, placed(seat.icon, seat.angle, row_place(i, count, across, squeeze, down, cell))) then return false }
        return true
    }
    down = 0
    for close, level: ATTACK_SQUEEZES {
        squeeze = close
        across = count
        while across >= 1 {
            if all_fit(layout, seat, count, across, squeeze, down, cell) {
                if level > 0 {
                    *upper := ATTACK_SQUEEZES[level - 1]
                    for _: 0 < 8 {
                        trial := (upper + squeeze) / 2
                        if all_fit(layout, seat, count, across, trial, down, cell) then squeeze = trial else upper = trial
                    }
                }
                return
            }
            across -= 1
        }
    }
    squeeze = ATTACK_SQUEEZES[# - 1]
    *steps: i64 = 1
    while f32'steps * ATTACK_DOWN_STEP <= ATTACK_MOST_DOWN {
        down = f32'steps * ATTACK_DOWN_STEP
        across = count
        while across >= 1 {
            if all_fit(layout, seat, count, across, squeeze, down, cell) {
                *lower := down - ATTACK_DOWN_STEP
                for _: 0 < 8 {
                    trial := (down + lower) / 2
                    if all_fit(layout, seat, count, across, squeeze, trial, cell) then down = trial else lower = trial
                }
                return
            }
            across -= 1
        }
        steps += 1
    }
    across = 1
    down = 0
}

// Where a player's icon for an attack is (one they've turned on; plain
// damage's for one they haven't).
attack_icon :: (layout: Layout, game: Game, k: i64, kind: Attack -> V2) #pure {
    seat := layout.seats[k]
    kinds, count := attacks_of(game.attacks[k])
    *n: i64 = 0
    *i: i64 = 0
    for each: kinds[:count] {
        if self_life_delta(each) != 0 then continue
        if each == kind then i = n
        n += 1
    }
    across, squeeze, down := attack_rows(layout, k, n)
    return placed(seat.icon, seat.angle, row_place(i, n, across, squeeze, down, cell_of(layout)))

}

// An attack's symbol (Mana's): plain damage's, a commander's (with a
// badge: the damage it does), lifelink's, poison's.
attack_glyph :: (kind: Attack -> string) #pure {
    return if kind is {
    case .DAMAGE: DAMAGE_GLYPH
    case .COMMANDER, .COMMANDER_LIFELINK: COMMANDER_GLYPH
    case .LIFELINK: LIFELINK_GLYPH
    case .GAIN_ONE, .LOSE_ONE, .GAIN_TWO, .LOSE_TWO: unreachable "self-life controls draw a heart"
    case .POISON: POISON_GLYPH
    }
}

// The visible attack circles stay clear of the channel's rounded wall.
ATTACK_CHANNEL_GAP :: 0.12
attack_buttons_clear :: (layout: Layout -> bool) #pure {
    clearance_needed := (DAMAGE_ICON_RADIUS + BEVEL_CELLS + ATTACK_CHANNEL_GAP) * cell_of(layout)
    for seat, k: layout.seats[:layout.count] {
        points := seat.outline[:seat.count]
        for side: [2] f32⟨-1, 1⟩ {
            at := placed(seat.icon, seat.angle, V2⟨side * DAMAGE_ICON_APART * cell_of(layout), 0⟩)
            if !inside(at, points) then return false
            if distance_to_segment(at, points[0], points[1]) < clearance_needed then return false
            if distance_to_segment(at, points[points.count - 1], points[0]) < clearance_needed then return false
        }
    }
    return true
}

// Accept clear destinations directly; otherwise stop at the clearance limit.
move_split_with_clearance :: (splits: *Splits, k: i64, share: f32, size: V2) {
    original := splits
    *wanted := original
    wanted.move_split(k, share)
    if attack_buttons_clear(lay_out(size, wanted)) {
        splits = wanted
        return
    }
    previous := original.at[(k + original.count - 1) % original.count]
    start := wrapped_share(original.at[k] - previous)
    finish := wrapped_share(wanted.at[k] - previous)
    *safe: f32 = 0
    for step: 1 <= 32 {
        fraction := f32'step / 32
        *candidate := original
        candidate.at[k] = wrapped_share(previous + Math.mix(start, finish, fraction))
        if attack_buttons_clear(lay_out(size, candidate)) {
            safe = fraction
            splits = candidate
        } else {
            *blocked := fraction
            for _: 0 < 16 {
                halfway := (safe + blocked) / 2
                candidate.at[k] = wrapped_share(previous + Math.mix(start, finish, halfway))
                if attack_buttons_clear(lay_out(size, candidate)) {
                    safe = halfway
                    splits = candidate
                } else {
                    blocked = halfway
                }
            }
            return
        }
    }
}
// An attack's symbol, in the player's frame, in both the controls and the
// pending damage label: commander damage's the commander (bronze) with the
// power symbol (an attack) as a badge at its lower right, and with
// lifelink's at its lower left too where it has lifelink; lifelink's the
// heart in hands (the hands bronze) with the power symbol's badge.
draw_damage_symbol :: (canvas: *Draw.Canvas, fonts: Fonts, at: V2, angle: f32, cell: f32, kind: Attack, shows: f32, style: Draw.Text_Style) {
    if self_life_delta(kind) != 0 {
        draw_life_shortcut(canvas, fonts, at, angle, cell, kind, shows, style)
        return
    }
    if kind == .LIFELINK {
        draw_lifelink(canvas, at, angle, f32'i32'(cell * ATTACK_EM), Draw.rgba(0xFFFFFF, shows), faded(COMMANDER_BRONZE, shows), style)
    }
    else {
        glyph := attack_glyph(kind)
        width := f32'fonts.attack.text_width(glyph)
        ink := if is_commander(kind) then faded(COMMANDER_BRONZE, shows) else if kind == .POISON then faded(POISON_GREEN, shows) else Draw.rgba(0xFFFFFF, shows)
        canvas.draw_text(fonts.attack, placed(at, angle, ⟨-width / 2, f32'fonts.attack.cap_height / 2⟩),
                         glyph, ink, style, angle)
    }
    *badge_style := style
    badge_style.outline_width = Math.max(1, cell * 0.018)
    badge :: (canvas: *Draw.Canvas, fonts: Fonts, at: V2, angle: f32, glyph: string, shows: f32, style: Draw.Text_Style) {
        width := f32'fonts.commander_badge.text_width(glyph)
        canvas.draw_text(fonts.commander_badge, placed(at, angle, ⟨-width / 2, f32'fonts.commander_badge.cap_height / 2⟩),
                         glyph, Draw.rgba(0xFFFFFF, shows), style, angle)
    }
    if is_commander(kind) or kind == .LIFELINK {
        badge(canvas, fonts, placed(at, angle, ⟨cell * 0.17, cell * 0.16⟩), angle, DAMAGE_GLYPH, shows, badge_style)
    }
    if kind == .COMMANDER_LIFELINK {
        badge(canvas, fonts, placed(at, angle, ⟨0 - cell * 0.17, cell * 0.16⟩), angle, LIFELINK_GLYPH, shows, badge_style)
    }
}

// The attack icons' symbols' size, in cells (fonts.attack's em).
ATTACK_EM :: 0.5

draw_life_shortcut :: (canvas: *Draw.Canvas, fonts: Fonts, at: V2, angle: f32, cell: f32, kind: Attack, shows: f32, style: Draw.Text_Style) {
    size := cell * 0.62
    corner := at - V2⟨size, size⟩ / 2
    if style.shadow.a > 0 then Icons.draw_svg(canvas, LIFELINK_HEART, corner + style.shadow_offset, size, style.shadow, angle)
    for j: 0 < 8 {
        turn := f32'j * f32'Math.TAU / 8
        offset := V2⟨Math.cos(turn), Math.sin(turn)⟩ * Math.max(1, cell * 0.018)
        Icons.draw_svg(canvas, LIFELINK_HEART, corner + offset, size, Draw.rgba(0x000000, shows), angle)
    }
    Icons.draw_svg(canvas, LIFELINK_HEART, corner, size, Draw.rgba(0xFFFFFF, shows), angle)
    delta := self_life_delta(kind)
    text := change_text(i64'delta)
    label := placed(at, angle, ⟨cell * 0.20, cell * 0.19⟩)
    ink := Draw.rgba(0xFFFFFF, shows)
    width := f32'fonts.small.text_width(text)
    canvas.draw_text(fonts.small, placed(label, angle, ⟨0 - width / 2, f32'fonts.small.cap_height / 2⟩), text, ink,
                     ⟨outline: Draw.rgba(0x000000, shows), outline_width: Math.max(1, cell * 0.018)⟩, angle)
}

// Lifelink's symbol, Mana's ms-ability-lifelink (LIFELINK_GLYPH) drawn from
// its glyph's own two outlines (its TrueType contours, in its font's units,
// y down), so that each takes its own colour: the heart, and the hands
// holding it. Each viewBox is the glyph's em (1000 of 1024 units) about its
// middle, so at an em's size it's the glyph's size.
LIFELINK_HEART_PATH :: "M444 -300Q418 -305 358.5 -343.5Q299 -382 246 -444Q212 -483 183 -527Q154 -572 137 -616.5Q120 -661 118 -704Q116 -747 134 -783Q148 -810 180.5 -838.5Q213 -867 267 -872Q356 -880 400 -819Q444 -758 444 -758L444 -758Q444 -758 487.5 -818.5Q531 -879 620 -872Q675 -867 707.5 -838.5Q740 -810 753 -782Q772 -746 769 -703Q767 -660 750 -615.5Q733 -571 704 -527Q676 -482 642 -443Q588 -382 528.5 -343Q469 -304 444 -299L444 -300Z"
LIFELINK_HANDS_PATH :: "M444 19Q441 20 437.5 17Q434 14 432 7Q430 2 429 -6Q428 -14 425 -21Q400 -77 366 -108.5Q332 -140 313 -159Q242 -227 175.5 -264Q109 -301 56 -348Q8 -389 3 -449Q-2 -509 6 -548Q15 -586 39.5 -616.5Q64 -647 91 -663Q101 -669 109.5 -662.5Q118 -656 112 -645Q106 -635 94 -618.5Q82 -602 72 -568Q67 -546 70.5 -521.5Q74 -497 81 -479Q99 -432 161 -392Q223 -352 345 -293Q395 -268 414 -211Q433 -154 438 -98Q438 -97 438.5 -96.5Q439 -96 439 -96Q440 -91 445 -92Q450 -93 450 -97Q456 -154 474 -210.5Q492 -267 543 -292Q665 -351 727 -391Q789 -431 806 -478Q813 -497 817 -521.5Q821 -546 815 -567Q806 -601 794 -617.5Q782 -634 776 -645Q770 -655 778.5 -661.5Q787 -668 796 -663Q824 -647 848.5 -616Q873 -585 881 -547Q890 -509 884.5 -448.5Q879 -388 832 -347Q778 -301 712 -263.5Q646 -226 575 -158Q556 -140 522 -108Q488 -76 462 -20Q459 -14 458 -6.5Q457 1 455 7Q453 13 450 16Q447 19 444 19Z"
LIFELINK_SVG_START :: #"<svg xmlns="http://www.w3.org/2000/svg" viewBox="-56 -931 1000 1000"><path d=""#
LIFELINK_SVG_END   :: #""/></svg>"#
LIFELINK_HEART :: LIFELINK_SVG_START + LIFELINK_HEART_PATH + LIFELINK_SVG_END
LIFELINK_HANDS :: LIFELINK_SVG_START + LIFELINK_HANDS_PATH + LIFELINK_SVG_END
LIFELINK_WHOLE :: LIFELINK_SVG_START + LIFELINK_HEART_PATH + " " + LIFELINK_HANDS_PATH + LIFELINK_SVG_END

// Lifelink's symbol centred on a point, turned, at a font's em (pixels):
// its heart and its hands each in their colour, with style's outline and
// drop shadow (an outline's a ring of the whole, as the tick's is; no
// outline where its width is 0).
draw_lifelink :: (canvas: *Draw.Canvas, at: V2, angle: f32, em: f32, heart: Draw.RGBA, hands: Draw.RGBA, style: Draw.Text_Style = ⟨⟩) {
    size := em * 1000 / 1024
    corner := at - V2⟨size, size⟩ / 2
    if style.shadow.a > 0 then Icons.draw_svg(canvas, LIFELINK_WHOLE, corner + style.shadow_offset, size, style.shadow, angle)
    if style.outline_width > 0 and style.outline.a > 0 {
        for step: 0 < 8 {
            a := f32'step * f32'Math.TAU / 8
            Icons.draw_svg(canvas, LIFELINK_WHOLE, corner + V2⟨Math.cos(a), Math.sin(a)⟩ * style.outline_width, size, style.outline, angle)
        }
    }
    Icons.draw_svg(canvas, LIFELINK_HEART, corner, size, heart, angle)
    Icons.draw_svg(canvas, LIFELINK_HANDS, corner, size, hands, angle)
}

// The commander's symbol (its badge white), in bronze.
COMMANDER_BRONZE :: Draw.rgb(0xD09A5C)

// Each player's damage symbols: white, outlined in black, with a soft
// down-right shadow, turned to match their life total.
draw_damage_icons :: (canvas: *Draw.Canvas, layout: Layout, game: Game, screen: Screen_State, fonts: Fonts) {
    cell := cell_of(layout)
    for k: 0 < layout.count {
        // (a player who isn't out, but for those whose number grids are open)
        if is_out(game, k) or screen.pickers[k].open then continue
        seat := layout.seats[k]
        kinds, count := attacks_of(game.attacks[k])
        for kind: kinds[:count] {
            if self_life_delta(kind) != 0 then continue
            at := attack_icon(layout, game, k, kind)
            shows := player_controls_visibility(screen.drums[k], k)
            if shows <= 0 then continue
            style := Draw.Text_Style⟨outline: Draw.rgba(0x000000, shows), outline_width: Math.max(1.5, cell * 0.025),
                                     shadow: Draw.rgba(0x000000, 0.55 * shows), shadow_offset: V2⟨0.04, 0.055⟩ * cell,
                                     shadow_soft: 0.04 * cell⟩
            draw_damage_symbol(canvas, fonts, at, seat.angle, cell, kind, shows, style)
        }
    }
}

// The attack icon at a point, of a player who isn't out: its player, and
// its attack; or absent.
icon_at :: (layout: Layout, game: Game, p: V2 -> player: i64, kind: Attack) [absent] {
    player = -1
    kind = .DAMAGE
    reach := DAMAGE_ICON_RADIUS * cell_of(layout)
    for k: 0 < layout.count {
        if is_out(game, k) then continue
        kinds, count := attacks_of(game.attacks[k])
        for which: kinds[:count] {
            if self_life_delta(which) != 0 then continue
            if Math.length(p - attack_icon(layout, game, k, which)) <= reach {
                player = k
                kind = which
                return
            }
        }
    }
    fail: absent
}

// Each part's toggle places, kept: toggle_places searches, and the layout
// changes only as a line moves or the screen's size does, so they're worked
// out again only then (every frame of a line's moving, as before; once
// otherwise).
Toggle_Cache :: struct {
    size:    V2
    splits:  Splits
    places:  [MAX_PLAYERS] [5] V2
    middles: [MAX_PLAYERS] V2
    folded:  [MAX_PLAYERS] V2
    // (the options', the same in the bottom right corner, four round their middle)
    option_places:  [MAX_PLAYERS] [8] V2
    option_middles: [MAX_PLAYERS] V2
    option_folded:  [MAX_PLAYERS] V2
}

toggle_cache: Toggle_Cache

// A part's toggle places and their pentagon's middle (toggle_places'), from
// the cache.
toggles_of :: (layout: Layout, k: i64 -> [5] V2) {
    fill_toggle_cache(layout)
    return toggle_cache.places[k]
}

toggle_middle :: (layout: Layout, k: i64 -> V2) {
    fill_toggle_cache(layout)
    return toggle_cache.middles[k]
}

// Where a part's five-colour icon is, folded (toggle_places').
toggle_folded :: (layout: Layout, k: i64 -> V2) {
    fill_toggle_cache(layout)
    return toggle_cache.folded[k]
}

fill_toggle_cache :: (layout: Layout) {
    if toggle_cache.size == layout.size and toggle_cache.splits == layout.splits then return
    toggle_cache.size = layout.size
    toggle_cache.splits = layout.splits
    for seat, s: layout.seats[:layout.count] {
        places, middle, folded := toggle_places(layout, seat)
        for i: 0 < 5 { toggle_cache.places[s][i] = places[i] }
        toggle_cache.middles[s] = middle
        toggle_cache.folded[s] = folded
        option_places, option_middle, option_folded := toggle_places(layout, seat, true, OPTION_KINDS.count)
        toggle_cache.option_places[s] = option_places
        toggle_cache.option_middles[s] = option_middle
        toggle_cache.option_folded[s] = option_folded
    }
}

////////////////////////////////
// Options: each player's attacks to turn on (Attack's after plain damage),
// two rows on glass in their bottom right corner, each its
// attack's symbol, lit when it's on, folding into the options button
// (OPTIONS_GLYPH) as the colours fold into theirs, and opened by it; turned
// on and off as the colours are, a run of taps one step to undo.

OPTION_KINDS :: [8] Attack⟨.GAIN_ONE, .GAIN_TWO, .COMMANDER, .COMMANDER_LIFELINK, .LOSE_ONE, .LOSE_TWO, .LIFELINK, .POISON⟩
OPTIONS_GLYPH :: "\u{E9DE}" // Mana ms-ability-improvise

// Every player's options folded, as they start.
FOLDED_TOGGLES :: Toggles⟨open: ⟨false, false, false, false, false, false⟩, shown: ⟨0, 0, 0, 0, 0, 0⟩⟩

// A part's options' places, their middle, and its options button.
options_of :: (layout: Layout, k: i64 -> [8] V2) {
    fill_toggle_cache(layout)
    return toggle_cache.option_places[k]
}

options_middle :: (layout: Layout, k: i64 -> V2) {
    fill_toggle_cache(layout)
    return toggle_cache.option_middles[k]
}

options_folded :: (layout: Layout, k: i64 -> V2) {
    fill_toggle_cache(layout)
    return toggle_cache.option_folded[k]
}

// The option at a point, of a part whose options are open: its part, and
// which attack; or absent.
option_at :: (layout: Layout, screen: Screen_State, p: V2 -> seat: i64, kind: Attack) [absent] {
    seat = 0
    kind = .COMMANDER
    r := TOGGLE_RADIUS * cell_of(layout)
    for i: 0 < layout.count {
        k := layout.count - 1 - i
        if controls_hidden(layout, screen, k) then continue
        if !screen.options.open[k] then continue
        places := options_of(layout, k)
        for each, index: OPTION_KINDS {
            if Math.length(p - places[index]) <= r * 1.15 {
                seat = k
                kind = each
                return
            }
        }
    }
    fail: absent
}

// The options button at a point (shown whether its options are open or
// not), or the middle of its open options: its part; or absent.
options_button_at :: (layout: Layout, screen: Screen_State, p: V2 -> i64) [absent] {
    reach := FIVE_COLOURS_SIDE / 2 * cell_of(layout)
    for i: 0 < layout.count {
        k := layout.count - 1 - i
        if controls_hidden(layout, screen, k) then continue
        if Math.length(p - options_folded(layout, k)) <= reach then return k
    }
    fail: absent
}

// A player's options opened by their button: open until it's touched again
// (or their middle is), with no time to fold.
open_options :: (options: *Toggles, k: i64) {
    options.open[k] = true
    options.left[k] = -1
}

options_middle_at :: (layout: Layout, screen: Screen_State, p: V2 -> i64) [absent] {
    half := option_panel_half(cell_of(layout))
    for i: 0 < layout.count {
        k := layout.count - 1 - i
        if controls_hidden(layout, screen, k) then continue
        if !screen.options.open[k] then continue
        local := local_of(options_middle(layout, k), layout.seats[k].angle, p)
        if Math.abs(local.x) <= half.x and Math.abs(local.y) <= half.y then return k
    }
    fail: absent
}

// A player's attack turned on, or off (plain damage is always on).
toggle_attack :: (game: *Game, k: i64, kind: Attack) {
    if kind == .DAMAGE then return
    bit := attack_bit(kind)
    game.attacks[k] = if game.attacks[k] & bit != 0 then game.attacks[k] & ~bit else game.attacks[k] | bit
}

// A player's colour toggles, over everything else on the screen (draw's
// last): a colour's symbol in its circle when it's set, a dim one when not;
// each over a soft shadow that quiets the surface around it, so the
// pentagon reads the same on every frame; and the five-colour icon in their
// bottom left corner, shown whether they're open or not (touched, it opens
// or folds them), the toggles coming out of it as they open and going back
// as they fold.
draw_colours :: (canvas: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, screen: Screen_State, k: i64) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    if seat.room < 0.6 * cell then return
    shows := player_controls_visibility(screen.drums[k], k) * screen.count_ui_visible
    if shows <= 0 then return
    places := toggles_of(layout, k)
    hub := toggle_folded(layout, k)
    opened := Math.clamp(screen.toggles.shown[k], 0, 1)
    s := opened * opened * (3 - 2 * opened)
    r := TOGGLE_RADIUS * cell * (0.5 + 0.5 * s)
    alpha := s * shows
    if alpha > 0 {
        for place: places { canvas.fill_glow(Math.mix(hub, place, s), r * 1.8, Draw.rgba(0x000000, 0.3 * alpha)) }
        for place, i: places {
            colour := Mana'i
            at := Math.mix(hub, place, s)
            if has_colour(game.identity[k], colour) {
                canvas.fill_circle(at, r, faded(MANA_CIRCLES[colour], alpha))
                draw_centred(canvas, fonts.mana, at, seat.angle, MANA_GLYPHS[colour], faded(MANA_INK, alpha))
            }
            else {
                canvas.fill_circle(at, r, Draw.rgba(0x000000, 0.34 * alpha))
                draw_centred(canvas, fonts.mana, at, seat.angle, MANA_GLYPHS[colour], Draw.rgba(0xF4EFE6, 0.5 * alpha))
            }
        }
    }
    side := FIVE_COLOURS_SIDE * cell
    canvas.fill_glow(hub, side * 0.8, Draw.rgba(0x000000, 0.3 * shows))
    draw_five_colours(canvas, hub, side, seat.angle, shows, game.identity[k])
}

// A player's options, over everything else on the screen (draw's last): the
// options button in their bottom right corner, shown whether they're open
// or not, and, open, each attack's symbol in its circle round their middle,
// lit when it's on, a dim one when not, coming out of the button as they
// open and going back as they fold.
draw_options :: (canvas: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, screen: Screen_State, k: i64) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    if seat.room < 0.6 * cell then return
    shows := player_controls_visibility(screen.drums[k], k) * screen.count_ui_visible
    if shows <= 0 then return
    spots := options_of(layout, k)
    opened := Math.clamp(screen.options.shown[k], 0, 1)
    s := opened * opened * (3 - 2 * opened)
    r := TOGGLE_RADIUS * cell * (0.5 + 0.5 * s)
    alpha := s * shows
    if alpha > 0 {
        centre := options_middle(layout, k)
        draw_pane(canvas, centre, seat.angle, ⟨0, 0⟩, option_panel_half(cell) * s,
                  0.17 * cell * s, ⟨0, 0, 0, 0⟩, kept_surfaces.canvas, surfaces_kept_now, cell, alpha)
        for kind, i: OPTION_KINDS {
            at := Math.mix(centre, spots[i], s)
            canvas.fill_glow(at, r * 1.8, Draw.rgba(0x000000, 0.3 * alpha))
            selected := has_attack(game.attacks[k], kind)
            poison := kind == .POISON
            face := if poison then faded(POISON_BADGE_FACE, alpha) else Draw.rgba(0x000000, 0.34 * alpha)
            canvas.fill_circle(at, r, face)
            if selected {
                draw_ring(canvas, at, r, Math.max(1.5, cell * 0.03), Draw.rgba(0xFFFFFF, alpha))
            }
            ink := if poison then POISON_GREEN else Draw.rgb(0xFFFFFF)
            draw_option_symbol(canvas, fonts, at, seat.angle, cell, kind, faded(ink, alpha), faded(COMMANDER_BRONZE, alpha))
        }
    }
}

draw_options_button :: (canvas: *Draw.Canvas, layout: Layout, fonts: Fonts, screen: Screen_State, k: i64) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    if seat.room < 0.6 * cell then return
    hub := options_folded(layout, k)
    shows := player_controls_visibility(screen.drums[k], k) * screen.count_ui_visible
    if shows <= 0 then return
    button_shows := Math.mix(0.5, 0.8, screen.options.shown[k]) * shows
    style := Draw.Text_Style⟨outline: Draw.rgba(0x000000, button_shows), outline_width: Math.max(1.5, cell * 0.025),
                             shadow: Draw.rgba(0x000000, 0.45 * button_shows), shadow_offset: V2⟨0.04, 0.055⟩ * cell, shadow_soft: 0.04 * cell⟩
    width := f32'fonts.attack.text_width(OPTIONS_GLYPH)
    canvas.draw_text(fonts.attack, placed(hub, seat.angle, ⟨-width / 2, f32'fonts.attack.cap_height / 2⟩), OPTIONS_GLYPH,
                     Draw.rgba(0xFFFFFF, button_shows), style, seat.angle)
}

// An option's symbol in its toggle, as its attack icon is: a commander's
// (in bronze, bronze_colour) with the power symbol's badge at its lower
// right, and lifelink's at its lower left with lifelink; lifelink's heart
// in hands (the hands bronze) with the power symbol's badge.
draw_option_symbol :: (canvas: *Draw.Canvas, fonts: Fonts, at: V2, angle: f32, cell: f32, kind: Attack, colour: Draw.RGBA, bronze_colour: Draw.RGBA) {
    if self_life_delta(kind) != 0 {
        draw_life_shortcut(canvas, fonts, at, angle, cell * 0.70, kind, colour.a, ⟨⟩)
        return
    }
    if kind == .LIFELINK {
        draw_lifelink(canvas, at, angle, f32'i32'(cell * MANA_EM), colour, bronze_colour)
    }
    else {
        glyph_colour := if is_commander(kind) then bronze_colour else colour
        draw_centred(canvas, fonts.mana, at, angle, attack_glyph(kind), glyph_colour)
    }
    if is_commander(kind) or kind == .LIFELINK {
        draw_centred(canvas, fonts.option_badge, placed(at, angle, ⟨cell * 0.11, cell * 0.1⟩), angle, DAMAGE_GLYPH, colour)
    }
    if kind == .COMMANDER_LIFELINK {
        draw_centred(canvas, fonts.option_badge, placed(at, angle, ⟨0 - cell * 0.11, cell * 0.1⟩), angle, LIFELINK_GLYPH, colour)
    }
}

// The toggles' symbols' size, in cells (fonts.mana's em).
MANA_EM :: TOGGLE_RADIUS * 1.25

// A circle's outline: its middle, its radius (to the line's middle), the
// line's width, its colour (short lines round it, each overlapping the next).
draw_ring :: (canvas: *Draw.Canvas, at: V2, radius: f32, width: f32, colour: Draw.RGBA) {
    steps :: 48
    for i: 0 < steps {
        a := f32'i * f32'Math.TAU / f32'steps
        b := f32'(i + 1) * f32'Math.TAU / f32'steps
        canvas.draw_line(at + V2⟨Math.cos(a), Math.sin(a)⟩ * radius, at + V2⟨Math.cos(b), Math.sin(b)⟩ * radius, width, colour)
    }
}

// The colour toggle at a point, of a part whose toggles are open: its part,
// and which colour; or absent.
toggle_at :: (layout: Layout, screen: Screen_State, p: V2 -> seat: i64, colour: i64) [absent] {
    seat = 0
    colour = 0
    r := TOGGLE_RADIUS * cell_of(layout)
    for s, k: layout.seats[:layout.count] {
        if !screen.toggles.open[k] or controls_hidden(layout, screen, k) then continue
        for place, i: toggles_of(layout, k) {
            if Math.length(p - place) <= r * 1.15 {
                seat = k
                colour = i
                return
            }
        }
    }
    fail: absent
}

// The five-colour icon at a point (shown whether its toggles are open or
// not): its part; or absent.
five_colours_at :: (layout: Layout, screen: Screen_State, p: V2 -> i64) [absent] {
    reach := FIVE_COLOURS_SIDE / 2 * cell_of(layout)
    for k: 0 < layout.count {
        if !controls_hidden(layout, screen, k) and Math.length(p - toggle_folded(layout, k)) <= reach then return k
    }
    fail: absent
}

// Whether a part's colour toggles and options are hidden, and so take no
// touch, as draw_colours and draw_options leave them out: the part too thin
// for them, its drum open, or the count column taking the table.
controls_hidden :: (layout: Layout, screen: Screen_State, k: i64 -> bool) #pure {
    return screen.drums[k].open or layout.seats[k].room < 0.6 * cell_of(layout) or screen.count_ui_visible <= 0
}

// The open pentagon's middle at a point (the space inside its five toggles),
// of a part whose toggles are open: its part; or absent.
pentagon_middle_at :: (layout: Layout, screen: Screen_State, p: V2 -> i64) [absent] {
    reach := (TOGGLE_RING - TOGGLE_RADIUS) * cell_of(layout)
    for k: 0 < layout.count {
        if screen.toggles.open[k] and !controls_hidden(layout, screen, k) and Math.length(p - toggle_middle(layout, k)) <= reach then return k
    }
    fail: absent
}

// A player's own colour, where one stands for them (the commander damage
// they've done, their damage icon, their drag): their identity's first
// colour (WUBRG), or an artifact's when they've none.
accent_of :: (identity: Identity, artifact: Draw.RGBA -> Draw.RGBA) #pure {
    for ground, colour: MANA_GROUNDS {
        if has_colour(identity, colour) then return ground
    }
    return artifact
}

// Ink that reads on a colour: dark on a light one.
ink_on :: (colour: Draw.RGBA -> Draw.RGBA) #pure {
    return if lightness(colour) > 0.6 then DARK_INK else INK
}


////////////////////////////////
// Fonts

Fonts :: struct {
    life:      Draw.Font         // the life totals
    life_size: i32               // ...its size
    loss:      Draw.Font         // small per-bolt loss labels
    small:     Draw.Font         // commander damage
    label:     Draw.Font         // the number grid's buttons
    output:    Draw.Font         // the number grid's number
    attack:    Draw.Font         // Mana power symbol
    commander_badge: Draw.Font   // lower-right commander overlay
    mana:      Draw.Font         // Mana's, for the colour toggles
    option_badge: Draw.Font      // Mana's, an option's commander's badge
    change:    Draw.Font         // a life drum's change, DRUM_CHANGE of the life's size
}

// The shared life font's size, to the nearest display pixel (lay_out's,
// fitted_life_size's).
life_size_of :: (layout: Layout -> i32) #pure {
    return layout.life_size
}

// The life totals' size (one for all): as big as the smallest part's room
// allows (1.15 of it, from a cell to 6 cells), so a total fits its part;
// and no bigger than lets every part's spinner, open, fit on the screen
// whole, its cross and tick too (a cell at least, whatever fits). The
// spinner's moved onto the screen as it opens (drum_middle), its glass
// lying over the table, so it may reach into another's part.
fitted_life_size :: (layout: Layout -> i32) #pure {
    cell := cell_of(layout)
    *room: f32 = 1e30
    for seat: layout.seats[:layout.count] { room = Math.min(room, seat.room) }
    *high := Math.clamp(room * 1.15, cell, 6 * cell)
    if spinners_fit(layout, high) then return i32'Math.round(high)
    *low := cell
    for _: 0 < 16 {
        middle := (low + high) / 2
        if spinners_fit(layout, middle) then low = middle else high = middle
    }
    return i32'Math.floor(low)
}

// How far an open spinner reaches from its life total's middle, across its
// player's text and up and down, for life totals of a size (pixels): two
// wheels (a digit each, LIFE_DIGIT_SHARE of the size wide) and the
// change's (three characters at DRUM_CHANGE of it), the glass round them,
// and the cross and tick either side, as tall as the glass.
LIFE_DIGIT_SHARE :: 0.5
spinner_half :: (size: f32, cell: f32 -> V2) #pure {
    cap := size * LIFE_CAP_SHARE
    wheel := size * LIFE_DIGIT_SHARE + cap * 0.18
    change := 3 * size * DRUM_CHANGE * LIFE_DIGIT_SHARE + cap * 0.3
    across := f32'DRUM_LEAST_WHEELS * wheel + cap * 0.3 + change
    buttons: f32 = GLASS_PAD + PICK_BUTTON_GAP + PICK_BUTTON_TALL
    return V2⟨across / 2 + buttons * cell, DRUM_RADIUS * DRUM_PITCH * cap + GLASS_PAD * cell⟩
}

// Whether every part's spinner, for life totals of a size, turned as its
// player's text is, would fit on the screen somewhere (it's moved onto it
// as it opens), DRUM_SCREEN_MARGIN inside each edge.
spinners_fit :: (layout: Layout, size: f32 -> bool) #pure {
    half := spinner_half(size, cell_of(layout))
    room := layout.size - V2⟨2, 2⟩ * (DRUM_SCREEN_MARGIN * cell_of(layout))
    for seat: layout.seats[:layout.count] {
        c := Math.abs(Math.cos(seat.angle))
        s := Math.abs(Math.sin(seat.angle))
        across := V2⟨c * half.x + s * half.y, s * half.x + c * half.y⟩ * 2
        if across.x > room.x or across.y > room.y then return false
    }
    return true
}

// The life totals' font made again, if the layout wants another size: as a
// line's end is dragged, each frame.
resize_life :: (fonts: *Fonts, family: string, layout: Layout) [os_error: Draw.Draw_Error] {
    size := life_size_of(layout)
    if size == fonts.life_size then return
    fonts.life.destroy()
    if big := Draw.load_font(family, size, 500) { fonts.life = big } else if os_error { fail: os_error }
    fonts.life_size = size
    fonts.change.destroy()
    if change := Draw.load_font(family, i32'(f32'size * DRUM_CHANGE), 500) { fonts.change = change } else if os_error { fail: os_error }
}

// The fonts for a layout, the text in a family.
load_fonts :: (family: string, layout: Layout -> fonts: Fonts) [os_error: Draw.Draw_Error] {
    fonts = ⟨⟩
    cell := cell_of(layout)
    life := life_size_of(layout)
    if big := Draw.load_font(family, life, 500) { fonts.life = big } else if os_error { fail: os_error }
    fonts.life_size = life
    if change := Draw.load_font(family, i32'(f32'life * DRUM_CHANGE), 500) { fonts.change = change } else if os_error { fail: os_error }
    if small := Draw.load_font(family, i32'(cell * 0.3), 600) { fonts.small = small } else if os_error { fail: os_error }
    if loss := Draw.load_font(family, 2 * i32'(cell * 0.27), 600) { fonts.loss = loss } else if os_error { fail: os_error }
    if label := Draw.load_font(family, i32'(cell * 0.45), 500) { fonts.label = label } else if os_error { fail: os_error }
    if output := Draw.load_font(family, i32'(cell * 0.8), 500) { fonts.output = output } else if os_error { fail: os_error }
    if mana := Draw.load_font(ICON_FAMILY, i32'(cell * MANA_EM)) { fonts.mana = mana } else if os_error { fail: os_error }
    if option_badge := Draw.load_font(ICON_FAMILY, i32'(cell * 0.15)) { fonts.option_badge = option_badge } else if os_error { fail: os_error }
    if attack := Draw.load_font(ICON_FAMILY, i32'(cell * ATTACK_EM)) { fonts.attack = attack } else if os_error { fail: os_error }
    if badge := Draw.load_font(ICON_FAMILY, i32'(cell * 0.25)) { fonts.commander_badge = badge } else if os_error { fail: os_error }
}

// The fonts made again, for a new layout.
reload_fonts :: (fonts: *Fonts, family: string, layout: Layout) [os_error: Draw.Draw_Error] {
    fonts.life.destroy()
    fonts.small.destroy()
    fonts.label.destroy()
    fonts.output.destroy()
    fonts.mana.destroy()
    fonts.option_badge.destroy()
    fonts.attack.destroy()
    fonts.commander_badge.destroy()
    fonts.change.destroy()
    if loaded := load_fonts(family, layout) { fonts = loaded } else if os_error { fail: os_error }
}

////////////////////////////////
// Dragging, and the number grid

// A drag from one of a player's attack icons, while its finger's down: its
// attack's (deal_attack's). Each player has their own, so several drag at
// once.
Drag :: struct {
    active:  bool
    from:    i64
    kind:    Attack = .COMMANDER
    finger:  V2           // where its finger is
    pointer: u32          // which finger (Pointer's id)
}

// Whether any player's dragging.
dragging :: (screen: Screen_State -> bool) #pure {
    for d: screen.drags { if d.active then return true }
    return false
}

// Whether any player's number grid is open.
any_grid_open :: (screen: Screen_State -> bool) #pure {
    for p: screen.pickers { if p.open then return true }
    return false
}

// Every player's gesture ended and their grids closed (the count column or
// the settings opening, which are the table's alone); an open drum stays
// open, as only its cross or its tick ends it.
end_gestures :: (screen: *Screen_State) {
    for *d: screen.drags { d.active = false }
    for *p: screen.pickers { p.open = false }
}

// Whether anything's under way: a drag, a number grid or a drum open (or a
// drum held or spinning), a line being moved, the count column or the
// settings open. Undo and redo wait till it's done.
under_way :: (screen: Screen_State -> bool) #pure {
    if dragging(screen) or any_grid_open(screen) or screen.moving_end >= 0 or screen.counts.open or screen.settings_open then return true
    for drum: screen.drums {
        if drum.open or drum.pressed or drum.spinning then return true
    }
    return false
}

// An undo (again: a redo), unless something's under way: whether it moved.
step_history :: (screen: *Screen_State, timeline: *Timeline, game: *Game, lines: *Lines, again: bool -> bool) {
    if under_way(screen) then return false
    before := game
    moved := if again then timeline.redo(game, lines) else timeline.undo(game, lines)
    if !moved then return false
    show_history_changes(screen, before, game, !again)
    return true
}

// The player first dragging and whom they're aimed at, for the part lit as
// aimed at; -1 for none.
first_aimed :: (layout: Layout, game: Game, screen: Screen_State -> i64) {
    for d: screen.drags {
        if !d.active then continue
        if to, _ := aim(layout, game, d.from, d.finger, d.kind) is not missed then return to
    }
    return -1
}

// A finger on the screen, or the mouse's left button, as the table reads
// them: each finger its own, so several players act at once, each gesture
// following the finger that began it.
Pointer :: struct {
    id:       u32
    at:       V2
    pressed:  bool        // this frame
    released: bool        // this frame (it's gone the next)
}

// The mouse's id among the fingers'; and -busy's made-up fingers' first.
MOUSE_POINTER :: u32'0xFFFF_FFFF
BUSY_POINTER :: u32'0xFFFF_FF00

// The window's fingers this frame, and its mouse while its left button's down
// (or let go this frame), each in the landscape drawing (turned: the
// window's taller than wide, its drawing turned onto it).
pointers_of :: (w: ^Window, turned: bool, made_up: [] Pointer = ⟨⟩ -> list: [] Pointer) {
    *found: [..] Pointer
    for p: made_up { found.add(p) }
    width := f32'w.size[0]
    for t: w.touches {
        found.add(⟨t.id, landscape_point(V2⟨t.position[0], t.position[1]⟩, turned, width), t.state.PRESSED, t.state.RELEASED⟩)
    }
    left := w.mouse.buttons[.LEFT]
    if left.HELD or left.PRESSED or left.RELEASED {
        at := landscape_point(V2⟨f32'w.mouse.position[0], f32'w.mouse.position[1]⟩, turned, width)
        found.add(⟨MOUSE_POINTER, at, left.PRESSED, left.RELEASED⟩)
    }
    list = found
}

// The finger with an id, or absent if it's not on the screen.
pointer_with :: (pointers: [] Pointer, id: u32 -> Pointer) [absent] {
    for p: pointers { if p.id == id then return p }
    fail: absent
}

// Whether the finger with an id has let go: this frame, or it's gone.
let_go :: (pointers: [] Pointer, id: u32 -> bool) #pure {
    for p: pointers { if p.id == id then return p.released }
    return true
}

// Where a line from one point to another first comes into a polygon: found
// along it, then halved down to the edge.
entry_point :: (from: V2, to: V2, points: [] V2 -> V2) #pure {
    SAMPLES :: 64
    *outside: f32 = 0
    *within: f32 = 1
    for i: 0 <= SAMPLES {
        t := f32'i / SAMPLES
        if inside(from + (to - from) * t, points) {
            within = t
            break
        }
        outside = t
    }
    for _: 0 < 16 {
        t := (outside + within) / 2
        if inside(from + (to - from) * t, points) then within = t else outside = t
    }
    return from + (to - from) * within
}

// What a drag from a player's icon to a point does: the player whose part
// it's in, and how far along the source-to-life line, starting at its
// crossing into the target. Sideways motion does not change the damage.
aim :: (layout: Layout, game: Game, from: i64, at: V2, kind: Attack = .DAMAGE -> to: i64, amount: Drag_Amount) [missed] {
    to = -1
    amount = Drag_Amount.damage(1)
    if target := seat_at(layout, at) is absent then fail: missed
    if target == from or is_out(game, target) then fail: missed
    seat := layout.seats[target]
    entry := entry_point(layout.seats[from].icon, seat.middle, seat.outline[:seat.count])
    axis := seat.middle - entry
    share := Math.dot(at - entry, axis) / Math.max(Math.dot(axis, axis), 1)
    to = target
    amount = amount_for(share, kind)
}

// The number grid, asked for by a drag past the life total along the aim
// line: five keys across and four up, its bottom along the top of the
// dragger's damage icons (hidden while it's open). The two rows nearest
// them are the units, 0 to 4 then 5 to 9; the two above, the tens, 00 to
// 40 then 50 to 90. It opens at 10 (10 and 0 chosen, shown green); a tens
// or a units touched is chosen. Below its keys are two glass buttons, each
// half its width: the cross (tinted red, on its player's left) cancels,
// and the tick (tinted green, showing the attack it makes) deals the two
// together (00 and 0 none). Only they end it: a touch anywhere else is
// whatever it would be without it. It faces the player who dragged.
Picker :: struct {
    open:        bool
    from:        i64
    to:          i64
    tens:        i32 = 10      // the tens chosen (0, 10, ... 90)
    units:       i32           // the units chosen (0 to 9)
    kind:        Attack = .COMMANDER   // the drag's attack
}

// A key touched: its tens or units chosen.
pick :: (picker: *Picker, part: Picker_Part) {
    if part is {
    case tens: picker.tens = tens
    case units: picker.units = units
    case accept, cancel, outside: _
    }
}

// A key's pitch in the grid, in cells, and the grid's keys across and up.
PICK_PITCH   :: 1.0
PICK_COLUMNS :: 5
PICK_ROWS    :: 4

// The way the number grid faces: its player's, as their life total does.
picker_angle :: (layout: Layout, picker: Picker -> f32) #pure {
    return layout.seats[picker.from].angle
}

// Where the number grid is: the middle of its keys' bottom edge (the
// bottom of the dragger's damage icons, as their player sees it, moved so
// the grid's on the screen), the way it faces, and a key's pitch. In its
// frame the keys are PICK_COLUMNS pitches across, centred on that point,
// and PICK_ROWS up from it.
picker_frame :: (layout: Layout, picker: Picker -> origin: V2, angle: f32, pitch: f32) #pure {
    cell := cell_of(layout)
    pitch = PICK_PITCH * cell
    angle = picker_angle(layout, picker)
    seat := layout.seats[picker.from]
    // (just above the cross and the tick, which take the damage icons' places)
    origin = placed(seat.icon, seat.angle, V2⟨0, 0 - DAMAGE_ICON_RADIUS * cell⟩)
    // (moved, if it must be, to keep the keys and the buttons below them a
    // little in from the screen's edges)
    margin := 0.15 * cell
    half := f32'PICK_COLUMNS / 2 * pitch + GLASS_PAD * cell
    up := f32'PICK_ROWS * pitch
    below := (GLASS_PAD + PICK_BUTTON_GAP + PICK_BUTTON_TALL) * cell
    *low := V2⟨1e30, 1e30⟩
    *high := V2⟨-1e30, -1e30⟩
    for corner: [4] V2⟨⟨0 - half, below⟩, ⟨half, below⟩, ⟨0 - half, 0 - up⟩, ⟨half, 0 - up⟩⟩ {
        at := placed(origin, angle, corner)
        low = Math.min(low, at)
        high = Math.max(high, at)
    }
    *shift := V2⟨0, 0⟩
    if low.x < margin then shift.x = margin - low.x
    else if high.x > layout.size.x - margin then shift.x = layout.size.x - margin - high.x
    if low.y < margin then shift.y = margin - low.y
    else if high.y > layout.size.y - margin then shift.y = layout.size.y - margin - high.y
    origin = origin + shift
}

// The number grid's buttons: in cells, the gap between them and the keys'
// pane (and between the two), and how tall they are; their glass's tints
// (a colour, and how much of it); and the chosen keys' colour.
PICK_BUTTON_GAP  :: 0.12
PICK_BUTTON_TALL :: 0.8
PICK_CROSS_TINT  :: V4⟨0.85, 0.12, 0.10, 0.38⟩
PICK_TICK_TINT   :: V4⟨0.15, 0.75, 0.30, 0.38⟩
PICK_CHOSEN      :: Draw.rgb(0x7CE08C)

// The number grid's cross or tick, in its frame (x across as its player
// sees it, y down from its keys' bottom): a glass button below the keys'
// pane, half its width, the cross on its player's left and the tick on
// their right: its middle and half size.
picker_button :: (layout: Layout, tick: bool -> middle: V2, half: V2) #pure {
    cell := cell_of(layout)
    pad := GLASS_PAD * cell
    edge := f32'PICK_COLUMNS / 2 * PICK_PITCH * cell + pad
    gap := PICK_BUTTON_GAP * cell
    tall := PICK_BUTTON_TALL * cell
    half = ⟨(edge - gap / 2) / 2, tall / 2⟩
    side: f32 = if tick then 1 else -1
    middle = ⟨side * (gap / 2 + half.x), pad + gap + tall / 2⟩
}

// Where in the grid's frame a key's middle is, by its row (0 the bottom)
// and column (0 the left).
pick_key_middle :: (row: i64, column: i64, pitch: f32 -> V2) #pure {
    return V2⟨(f32'column - f32'(PICK_COLUMNS - 1) / 2) * pitch, 0 - (f32'row + 0.5) * pitch⟩
}

Picker_Part :: union {
    tens: i32         // a tens key: 0, 10, ... 90
    units: i32        // a units key: 0 to 9
    accept            // the tick: the grid's button on its player's right
    cancel            // the cross: its button on their left
    outside
}

// The key at a row (0 the bottom) and column: the units 0 to 4, then 5 to
// 9; the tens 00 to 40, then 50 to 90.
pick_key :: (row: i64, column: i64 -> Picker_Part) #pure {
    return if row is {
        case 0: Picker_Part.units(i32'column)
        case 1: Picker_Part.units(i32'(5 + column))
        case 2: Picker_Part.tens(i32'(column * 10))
        case: Picker_Part.tens(i32'((5 + column) * 10))
    }
}

// A tick (accept) or a cross (cancel) at a point of the screen, given where
// each is and their half size, turned by angle; else outside.
tick_or_cross_at :: (layout: Layout, angle: f32, cross: V2, tick: V2, half: V2, at: V2 -> Picker_Part) #pure {
    radius := 0.2 * cell_of(layout)
    if round_box_distance(local_of(tick, angle, at), half, radius) <= 0 then return Picker_Part.accept
    if round_box_distance(local_of(cross, angle, at), half, radius) <= 0 then return Picker_Part.cancel
    return Picker_Part.outside
}

// What of the number grid is at a point of the screen: the tick or the
// cross, a key (the gaps between keys their nearest's), or outside it.
picker_part_at :: (layout: Layout, picker: Picker, at: V2 -> Picker_Part) #pure {
    origin, angle, pitch := picker_frame(layout, picker)
    local := local_of(origin, angle, at)
    for tick: [2] bool⟨false, true⟩ {
        middle, half := picker_button(layout, tick)
        off := Math.abs(local - middle)
        if off.x <= half.x and off.y <= half.y then return if tick then Picker_Part.accept else Picker_Part.cancel
    }
    p := local / pitch
    column := i64'Math.floor(p.x + f32'PICK_COLUMNS / 2)
    row := i64'Math.floor(0 - p.y)
    if column < 0 or column >= PICK_COLUMNS or row < 0 or row >= PICK_ROWS then return Picker_Part.outside
    return pick_key(row, column)
}

////////////////////////////////
// The capsule in the middle, and the font button in the corner

// The icons that aren't Magic's own: Material Design Icons' (the Icons
// module's), each copied into icons/ by its tool.
UNDO_ICON   :: icon(Mdi.UNDO)
REDO_ICON   :: icon(Mdi.REDO)
RESTART_ICON :: icon(Mdi.RESTORE)
SYSTEM_ICON :: icon(Mdi.DOTS_HORIZONTAL)
QUIT_ICON   :: icon(Mdi.POWER)
PERSON_ICON :: icon(Mdi.ACCOUNT)
TICK_ICON   :: icon(Mdi.CHECK)
CROSS_ICON  :: icon(Mdi.CLOSE)

// An icon drawn size across, its middle at a point, turned (radians clockwise).
draw_icon_at :: (canvas: *Draw.Canvas, drawn: Icons.Icon, middle: V2, size: f32, colour: Draw.RGBA, angle: f32 = 0) {
    canvas.draw_icon(drawn, middle - V2⟨size, size⟩ / 2, size, colour, angle)
}

Capsule_Part :: enum u8 {
    UNDO
    REDO
    PLAYERS
    RESTART
    SYSTEM
}

CAPSULE_PARTS :: [5] Capsule_Part⟨.UNDO, .REDO, .PLAYERS, .RESTART, .SYSTEM⟩

// The controls at the screen's centre are a pill, across the screen, a
// button a cell across at each of its places, CAPSULE_PITCH apart: from the
// left, undo and redo, the players in the middle, then a new game and the
// system's (settings and quitting), its power button, at the right end.
// CAPSULE_REACH is how far its ends are from the middle, and CAPSULE_HALF
// its half height (its round ends' radius), in cells.
CAPSULE_PITCH :: 1.2
CAPSULE_REACH :: 2 * CAPSULE_PITCH + CAPSULE_HALF
CAPSULE_HALF  :: 0.6

// How far a damage spot's middle keeps from the pill, in cells (its
// button's half and a little).
CONTROLS_CLEAR :: 0.75

// A damage spot clear of the controls (the pill, and CONTROLS_CLEAR round
// it), on a screen of a size: moved from where it would be toward its
// part's middle (so staying in its part) till it is.
clear_of_controls :: (size: V2, centre: V2, middle: V2, spot: V2 -> V2) #pure {
    cell := Math.min(size.x, size.y) * CELL_SHARE
    *at := spot
    for _: 0 < 24 {
        d := at - centre
        across := Math.abs(d.x) / cell
        up := Math.abs(d.y) / cell
        if across >= CAPSULE_REACH + CONTROLS_CLEAR or up >= CAPSULE_HALF + CONTROLS_CLEAR then return at
        at = at + (middle - at) * 0.15
    }
    return at
}

// How far a point is from the controls' pill (0 on it), on a screen of a size.
controls_clearance :: (size: V2, centre: V2, p: V2 -> f32) #pure {
    cell := Math.min(size.x, size.y) * CELL_SHARE
    d := Math.abs(p - centre) / cell
    return Math.length(Math.max(d - V2⟨CAPSULE_REACH, CAPSULE_HALF⟩, 0)) * cell
}

capsule_centre :: (layout: Layout, part: Capsule_Part -> V2) #pure {
    // Balance visible gaps between the small icons, the larger count ring,
    // and the pill ends rather than giving unequal-sized controls equal pitches.
    place: f32 = if part is {
        case .UNDO: -2.28
        case .REDO: -1.29
        case .PLAYERS: 0
        case .RESTART: 1.29
        case .SYSTEM: 2.28
    }
    return layout.centre + V2⟨place, 0⟩ * cell_of(layout)
}

// The capsule's button at a point, or absent.
capsule_part_at :: (layout: Layout, at: V2 -> Capsule_Part) [absent] {
    cell := cell_of(layout)
    for part: CAPSULE_PARTS {
        centre := capsule_centre(layout, part)
        half_width: f32 = if part == .PLAYERS then 0.55 else 0.46
        if Math.abs(at.x - centre.x) <= half_width * cell and Math.abs(at.y - centre.y) <= 0.55 * cell then return part
    }
    fail: absent
}

// The controls are cut into the parts' surface as the channels between them
// are: a recess, its floor the surface darkened, its walls the channels'
// cosine bowl, each lit or shaded as it faces the light (PART_LIGHT) or
// away. Its shape is the pill, CAPSULE_REACH either way, CAPSULE_HALF up
// and down, its ends round (in cells); the settings appear in it, in place
// of its buttons.
RECESS_WALL :: 0.06             // how wide its bronze piping is, round its edge

// How far a point is outside a box about 0, half its size each way, its
// corners rounded by radius (negative inside).
round_box_distance :: (p: V2, half: V2, radius: f32 -> f32) #pure {
    q := Math.abs(p) - half + V2⟨radius, radius⟩
    return Math.length(Math.max(q, 0.0)) + Math.min(Math.max(q.x, q.y), 0) - radius
}

// How far a point (from the controls' middle) is outside the recess
// (negative inside), its shape as recess_shape gives it: the pill, and the
// count runner grown up and down out of its middle a share of the way.
recess_distance :: (p: V2, shape: V4, column: V4 -> f32) #pure {
    pill := round_box_distance(p, shape.zw, shape.w)
    if column.w <= 0 then return pill
    // (the runner: a rounded upright box about the middle, its ends round,
    // from the pill's height to its own length as it grows; the two joined
    // smoothly, so the corners between them are rounded)
    length := Math.mix(shape.w, column.z, column.w)
    groove := round_box_distance(p, V2⟨column.y, length⟩, column.y)
    k := Math.max(column.x, 0.0001)
    h := Math.clamp(0.5 + 0.5 * (groove - pill) / k, 0, 1)
    return Math.mix(groove, pill, h) - k * h * (1 - h)
}

// The recess's shape, in pixels: the pill's middle, its half width and half
// height (shape); and the count runner, the upright groove the count bar
// slides in, grown a share of the way (counts, eased in and out) out of the
// pill's middle: how round the corners where it meets the pill are, its half
// width and half length, and how far (column).
recess_shape :: (layout: Layout, counts: f32 = 0 -> shape: V4, column: V4) #pure {
    cell := cell_of(layout)
    shape = ⟨layout.centre.x, layout.centre.y, CAPSULE_REACH * cell, CAPSULE_HALF * cell⟩
    grooved := Math.clamp(counts, 0, 1)
    c := grooved * grooved * (3 - 2 * grooved)
    column = ⟨RUNNER_JOIN * cell, COLUMN_HALF * cell, RUNNER_HALF * cell, c⟩
}

// How round the corners where the runner meets the pill are, in cells.
RUNNER_JOIN :: 0.25

// The count runner's half width, in cells (a button's, and its round ends'),
// and its half length: as far as the count bar's end goes either way, the
// bar's half length (BAR_HALF) beyond the most it slides from the middle
// (the 2's ring at the button to MAX_PLAYERS' there).
COLUMN_HALF :: 0.6
BAR_HALF    :: f32'(MAX_PLAYERS - 2) / 2 * COUNT_PITCH + 0.55
RUNNER_HALF :: f32'(MAX_PLAYERS - 2) / 2 * COUNT_PITCH + BAR_HALF + 0.08

// Whether a point is in the controls' recess, the pill, or part of the way
// (counts) to the count runner.
in_controls :: (layout: Layout, p: V2, counts: f32 = 0 -> bool) #pure {
    shape, column := recess_shape(layout, counts)
    return recess_distance(p - shape.xy, shape, column) < 0
}

Recess_Params :: struct {
    shape:  V4
    column: V4    // the count runner, and how far toward it (recess_shape's)
    floor:  V4    // its floor's colour (opaque: the controls' own, not the surface's)
    wall:   V4    // its walls' width (pixels), then unused
}

// The pill over the surface: its floor, of its own (the controls' metal),
// edged with raised bronze piping, a round bead lit from the light at the
// top left (a highlight along it where it turns toward the light), which
// casts a soft shadow away from the light: onto the floor inside its upper
// left edges, onto the surface outside its lower right ones. Given as what to
// lay over the surface (its colour premultiplied).
recess_shade :: (from: Draw.Quad_Between, recess: Shader.Uniforms(Recess_Params), texture: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    p := from.pixel - recess.shape.xy
    d := recess_distance(p, recess.shape, recess.column)
    width := Math.max(recess.wall.x, 1)
    if d > width * 1.2 + 1 then return ⟨0, 0, 0, 0⟩
    // (the way out of it, toward the surface: its distance's slope; and how
    // squarely that edge faces the light)
    gx := recess_distance(p + V2⟨0.5, 0⟩, recess.shape, recess.column) - recess_distance(p - V2⟨0.5, 0⟩, recess.shape, recess.column)
    gy := recess_distance(p + V2⟨0, 0.5⟩, recess.shape, recess.column) - recess_distance(p - V2⟨0, 0.5⟩, recess.shape, recess.column)
    outward := Math.normalize(V2⟨gx, gy⟩ + V2⟨0.00001, 0⟩)
    toward := Math.dot(outward, PART_LIGHT)
    // The piping: a half round from its inner side (across 0) to its outer
    // (1), its surface turning from inward through up to outward.
    across := Math.clamp(1 + d / width, 0, 1)
    t := 2 * across - 1
    normal := V3⟨outward.x * t, outward.y * t, Math.sqrt(Math.max(1 - t * t, 0))⟩
    light := Math.normalize(V3⟨PART_LIGHT.x, PART_LIGHT.y, 1⟩)
    diffuse := Math.max(Math.dot(normal, light), 0)
    gleam := Math.pow(Math.max(Math.dot(normal, Math.normalize(light + V3⟨0, 0, 1⟩)), 0), 24)
    bronze := V3⟨0.62, 0.45, 0.26⟩ * (0.3 + 0.8 * diffuse) + V3⟨1, 0.9, 0.7⟩ * (gleam * 0.55)
    // The floor, its shadow from the piping along the edges facing the light.
    floor := control_material(texture, filtering, from.pixel / Math.max(recess.shape.z * 3, 1))
    within := Math.max(0 - d - width, 0)
    shadow_in := Math.max(toward, 0) * (1 - Math.smoothstep(0, width * 1.2, within)) * 0.5
    piped := Math.clamp(d + width + 0.5, 0, 1)
    rgb := Math.mix(floor * (1 - shadow_in), bronze, piped)
    // Outside, the piping's shadow on the surface along the edges facing away.
    shadow_out := Math.max(0 - toward, 0) * (1 - Math.smoothstep(0, width * 1.2, Math.max(d, 0))) * 0.45
    coverage := Math.clamp(0.5 - d, 0, 1)
    colour = V4⟨rgb.x, rgb.y, rgb.z, 1⟩ * coverage + V4⟨0, 0, 0, shadow_out⟩ * (1 - coverage)
}

Recess :: shader { vertex: Draw.quad_place; fragment: recess_shade }
RECESS :: Recess(Draw.SHADER_TARGET)

// The controls' recess drawn: the pill, part of the way into the count
// runner.
draw_recess :: (canvas: *Draw.Canvas, layout: Layout, counts: f32) {
    shape, column := recess_shape(layout, counts)
    // (over the pill, and the runner's ends)
    margin := shape.z + 2
    *low := shape.xy - V2⟨margin, margin⟩
    *high := shape.xy + V2⟨margin, margin⟩
    if column.w > 0 {
        low.y = Math.min(low.y, shape.y + column.x - column.z - 2)
        high.y = Math.max(high.y, shape.y + column.x + column.z + 2)
    }
    floor := V4⟨CAPSULE.r, CAPSULE.g, CAPSULE.b, 1⟩
    wall := V4⟨RECESS_WALL * cell_of(layout), 0, 0, 0⟩
    canvas.draw_shader_image(low, high - low, RECESS.code, RECESS.bindings.recess, Recess_Params⟨shape, column, floor, wall⟩, control_image, RECESS.bindings.texture,
                             RECESS.bindings.filtering)
}

// The count of players, picked by dragging: touched, the players' button
// shows every count (each a ring of people) in a column through it, fewer
// above, which moves with the finger; the count nearest the button is the
// one that's active, and as it changes the lines snap to its, animated a
// count at a time (one splitting into two, or two meeting in one). Let go,
// it's that count (the same, let go without moving), and the column goes.
Count_Picker :: struct {
    open:     bool
    held:     bool           // a finger's on the column
    grabbed:  f32            // where it went down (y)
    from:     f32            // the count the column was at then (shown)
    shown:    f32            // the count at the button now, between whole counts as it moves
    settling: bool           // let go: shown moving to the whole count it's become
    // The lines, as they're shown: a count's (laid), or moving from it to
    // the next count up or down (toward), progress of the way.
    laid:     i64
    toward:   i64
    progress: f32
}

// How long the lines take to move from a count's to the next's, in seconds:
// the step to the count they're going to, and one they're passing through
// (fast-forwarded, as the finger's gone on past it).
LINES_STEP_TIME         :: 0.18
LINES_PASSING_STEP_TIME :: 0.05

// Whether the lines are shown as anything but the game's count's.
lines_moving :: (counts: Count_Picker, players: i64 -> bool) #pure {
    return counts.laid != 0 and (counts.laid != players or counts.toward != counts.laid)
}

// The lines as the picker shows them: a count's, or part of the way to the
// next's (eased), the slot that comes or goes (GOING's) the one that opens
// or closes.
shown_splits :: (counts: Count_Picker, splits: [] Splits, size: V2 -> Splits) #pure {
    if counts.toward == counts.laid or Math.abs(counts.toward - counts.laid) != 1 then return splits_for(splits, counts.laid, size)
    // (eased in and out: smoothstep's curve)
    p := Math.clamp(counts.progress, 0, 1)
    t := p * p * (3 - 2 * p)
    more := Math.max(counts.laid, counts.toward)
    slot := slot_going(size, more)
    if counts.toward > counts.laid {
        return morph_splits(splits_for(splits, counts.laid, size), splits_for(splits, counts.toward, size), t, slot)
    }
    return morph_splits(splits_for(splits, counts.toward, size), splits_for(splits, counts.laid, size), 1 - t, slot)
}

// The seat of a count's whose slot goes as the count comes down by one
// (GOING's), by its index.
slot_going :: (size: V2, count: i64 -> i64) #pure {
    return seat_of(starting_colours(size, count), count, GOING[count])
}

// The game of to players a game becomes (each count's lines as splits_for
// gives them, on a screen of a size), a count at a time as the lines morph:
// down, the slot going (GOING's) leaving the table and each other seat's
// player, as they are, carried to the seat it becomes; up, the last to
// leave coming back as they were. No one's life, damage or colours change.
game_for :: (game: Game, to: i64, splits: [] Splits, size: V2 -> next: Game) #pure {
    *order := SEATED_AS_THEY_ARE
    *n := Math.clamp(game.players, 2, MAX_PLAYERS)
    target := Math.clamp(to, 2, MAX_PLAYERS)
    while n > target {
        order = seated_down(order, splits_for(splits, n - 1, size), splits_for(splits, n, size), slot_going(size, n))
        n -= 1
    }
    while n < target {
        order = seated_up(order, splits_for(splits, n, size), splits_for(splits, n + 1, size), slot_going(size, n + 1))
        n += 1
    }
    next = reseated(game, order, target)
}

// The lines moved on by a frame's time toward a count: a step at a time,
// starting the next when one's done; each step to a count short of the
// target fast-forwarded, the last at its own pace.
move_lines :: (counts: *Count_Picker, target: i64, seconds: f32) {
    // (the first frame: the lines start as the game's, still)
    if counts.laid == 0 {
        counts.laid = target
        counts.toward = target
        counts.progress = 0
    }
    if counts.toward == counts.laid {
        if target == counts.laid then return
        counts.toward = if target > counts.laid then counts.laid + 1 else counts.laid - 1
        counts.progress = 0
    }
    step_time: f32 = if counts.toward == target then LINES_STEP_TIME else LINES_PASSING_STEP_TIME
    counts.progress += seconds / step_time
    if counts.progress >= 1 {
        counts.laid = counts.toward
        counts.progress = 0
    }
}

COUNT_PITCH :: 0.95          // between counts in the column, in cells

// Where a count's ring is, with the column at a count (shown).
count_place :: (layout: Layout, shown: f32, count: i64 -> V2) #pure {
    return capsule_centre(layout, .PLAYERS) + V2⟨0, (f32'count - shown) * COUNT_PITCH * cell_of(layout)⟩
}

// A count's lines: as they were left (splits[count]), or as equal_splits
// starts them.
splits_for :: (splits: [] Splits, count: i64, size: V2 -> Splits) #pure {
    if splits_fit(splits[count], count) then return splits[count]
    return equal_splits(count, size)
}

////////////////////////////////
// Drawing

// Text centred on a point, turned to read the right way up at angle.
draw_centred :: (canvas: *Draw.Canvas, font: Draw.Font, middle: V2, angle: f32, text: string, colour: Draw.RGBA) {
    width := f32'font.text_width(text)
    at := placed(middle, angle, ⟨-width / 2, f32'font.cap_height / 2⟩)
    canvas.draw_text(font, at, text, colour, angle)
}

// A box of a frame turned a whole number of quarters (as every player's
// is), from at to at + size in the frame, as the rounded box it is on the
// screen.
// A rounded box in a frame turned a quarter turn (or two, or three) about an
// origin: the screen's box between its turned corners (so square to the
// screen only at a quarter turn: picker_angle's).
fill_turned_box :: (canvas: *Draw.Canvas, origin: V2, angle: f32, at: V2, size: V2, radius: f32, colour: Draw.RGBA) {
    a := placed(origin, angle, at)
    b := placed(origin, angle, at + size)
    low := V2⟨Math.min(a.x, b.x), Math.min(a.y, b.y)⟩
    high := V2⟨Math.max(a.x, b.x), Math.max(a.y, b.y)⟩
    canvas.fill_rounded_rect(low, high - low, radius, colour)
}

draw_seat :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, k: i64, targeted: i64, time: f32,
              drum: Life_Drum = ⟨⟩, surface_kept := false, recoil: V2 = ⟨0, 0⟩, recoil_turn: f32 = 0, poison_bump: f32 = 0, tax_slide: Tax_Slide = ⟨⟩) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    out := is_out(game, k)
    points := seat.outline[:seat.count]
    artifact := ARTIFACT
    // Its frame: its colours' gradient, across it as its player sees it
    // (left to right), with its surface over it.
    *colours: [Draw.MAX_GRADIENT_COLOURS] Draw.RGBA
    n, pattern, surface := part_fill(game.identity[k], cell, k, time, seat.angle, colours)
    // (drawn here, or kept: keep_surfaces')
    if !surface_kept then draw_part(canvas, layout, k, colours[:n], pattern, surface, game.identity[k], out, targeted)
    // (a part too thin for its displays, as it opens or closes, is its colour alone)
    if seat.room < 0.6 * cell then return
    // (dark ink where its colours are light at its middle, where its life is)
    // (out, its colours as dimmed as the shader dims them)
    middle_ground := middle_of(colours[:n])
    ground := if out then Math.mix(middle_ground, BACKGROUND, 0.7) else middle_ground
    ink := if out then Math.mix(ink_on(ground), ground, 0.6) else ink_on(ground)
    accent := accent_of(game.identity[k], artifact)
    // (its colour toggles and its options are drawn over everything else,
    // last: draw_colours, draw_options)
    // Its life total: white with a black border and a drop shadow, cast
    // from the screen's centre (falling away from it, toward its player: down
    // as they read it) and a little to their right, as a drop shadow falls,
    // on any part.
    cap := f32'fonts.life.cap_height
    life_colour := if out then Draw.rgba(0xFFFFFF, 0.55) else Draw.rgb(0xFFFFFF)
    *away := seat.toward
    if Math.length(seat.middle - layout.centre) > 1 then away = Math.normalize(seat.middle - layout.centre)
    reader_right := V2⟨Math.cos(seat.angle), Math.sin(seat.angle)⟩
    falls := Math.normalize(away + reader_right * LIFE_SHADOW_RIGHT)
    life_style := Draw.Text_Style⟨outline: Draw.rgb(0x000000), outline_width: Math.max(2, cap * LIFE_OUTLINE),
                                  shadow: Draw.rgba(0x000000, 0.55), shadow_offset: falls * (cap * LIFE_SHADOW * 1.4), shadow_soft: cap * LIFE_SHADOW⟩
    life_text := "«game.life[k]»"
    life_width := f32'fonts.life.text_width(life_text)
    // (touched, a drum, over the chips; let go, flat again, with its change
    // beside it a while)
    if !drum_showing(drum, k) {
        canvas.draw_text(fonts.life, placed(seat.middle + recoil, seat.angle + recoil_turn, ⟨-life_width / 2, cap / 2⟩), life_text, life_colour, life_style, seat.angle + recoil_turn)
        shows := change_showing(drum, k)
        if shows > 0 then draw_change(canvas, seat, fonts, drum, life_colour, shows, life_width)
    }
    // The commander damage it's taken: a small map of the table below its
    // life (chip_places'), one for each other commander: a dark hollow
    // until they have dealt damage, then a chip in their colour.
    chips := chip_places(layout, k, life_width, cap, game.poison[k] > 0)
    for from: 0 < layout.count {
        if from == k then continue
        d := if from < game.players then game.commander[k][from] else 0
        middle := chips[from]
        if d <= 0 {
            canvas.fill_circle(middle, CHIP_RADIUS * cell, Draw.rgba(0x000000, 0.22))
            continue
        }
        // (in the colour of the commander that did it: a lethal one ringed
        // in the life total's ink)
        lethal := d >= LETHAL_COMMANDER_DAMAGE
        source := accent_of(game.identity[from], artifact)
        ring := if lethal then ink else Math.mix(source, BACKGROUND, 0.35)
        canvas.fill_circle(middle, CHIP_RADIUS * cell, ring)
        canvas.fill_circle(middle, CHIP_RADIUS * cell - Math.max(2, 0.04 * cell), source)
        draw_centred(canvas, fonts.small, middle, seat.angle, "«d»", ink_on(source))
    }
    if !out {
        visibility := player_controls_visibility(drum, k)
        for kind: LIFE_SHORTCUTS {
            if visibility <= 0 or !has_attack(game.attacks[k], kind) then continue
            at := life_shortcut_place(layout, k, kind, game.attacks[k], chips, life_width)
            draw_life_shortcut(canvas, fonts, at, seat.angle, cell * 0.78, kind, visibility, ⟨⟩)
        }
    }
    poison_visible := game.poison[k] > 0 and !drum_showing(drum, k)
    poison_at, _ := poison_tax_places(seat, chips[k], cell, game.poison[k] > 0)
    tax_at := sliding_tax_place(layout, k, life_width, cap, chips[k], game.poison[k] > 0, tax_slide)
    if poison_visible {
        draw_poison_badge(canvas, poison_at, seat.angle, fonts, game.poison[k], cell, poison_bump)
    }
    if !out then draw_tax_button(canvas, fonts, tax_at, seat.angle, cell, game.tax[k], player_controls_visibility(drum, k))
    if drum_showing(drum, k) {
        // (the spinner moved onto the screen as it opens: drum_middle's)
        *spinning := seat
        spinning.middle = drum_middle(layout, fonts, drum, k)
        draw_drum_glass(canvas, spinning, fonts, drum, cell)
        draw_drum(canvas, layer, spinning, fonts, drum, life_colour, life_style, colours[:n])
    }
}

// A life total's border, and how far its shadow falls and how soft it is,
// against its capitals' height.
LIFE_OUTLINE :: 0.045
LIFE_SHADOW :: 0.06
LIFE_SHADOW_RIGHT :: 0.5     // how far to its reader's right it falls, against how far down

////////////////////////////////
// The life drum: a life total tapped opens into wheels, a digit each, as an
// odometer's or a lock's, each on a cylinder with its digits round it (one
// more each row up, one less each row down), and beside them a wheel of
// the change since it opened (0 at the middle, +1 up, -1 down). A wheel
// dragged turns with the finger (down brings the bigger digits to the
// middle), changing the life by its place (the units' by one, the tens' by
// ten) a row at a time; the others turn only as it carries into them. Let
// go, the number at the middle is the life (undo brings each turn back). The
// a tap away from the life closes it: the wheels flatten (DRUM_FLATTEN seconds),
// and the change stays beside it, flat, DRUM_HOLD seconds, then fades over
// DRUM_FADE.

DRUM_PITCH   :: 1.3        // its rows apart, in the life's capitals' heights
DRUM_RADIUS  :: 1.1        // the cylinder's radius, in rows (so a row and a half shows each way)
DRUM_ROWS    :: 3          // the rows drawn each way from the middle
DRUM_FLATTEN :: 0.15
DRUM_HOLD    :: 1.0
DRUM_FADE    :: 1.5
DRUM_CHANGE  :: 0.45       // the change's size, against the life's
DRUM_TAP     :: 0.15       // a press that moves less than this (capitals' heights) is a tap
DRUM_FLICK   :: 3.0        // let go turning faster than this (rows a second), a wheel spins on
DRUM_FRICTION :: 0.8       // how fast a spinning wheel slows: its speed's share lost a second, as e^-(this)
DRUM_SETTLE  :: 1.5        // slower than this (rows a second), it settles on the next row its way

Life_Drum :: struct {
    open:    bool          // tapped open: its wheels turn
    player:  i64 = -1
    start:   i32           // the life as it was opened (moved on by others' changes: the drum's own are the rest)
    seen:    i32           // the game's life as it last saw it, while a finger's on it or it spins
    pressed: bool          // a finger down on it (pointer, Pointer's id)...
    pointer: u32
    moved:   bool          // ...that's moved: a turn, not a tap
    touched: V2            // where it touched, in its player's frame
    place:   i32 = 1       // the wheel being turned: its digit's place (1, 10, 100)
    from:    i32           // the life as that turn began
    turned:  f32           // how far that wheel's turned, in rows (toward its player: the bigger digits coming down)
    grabbed: f32           // ...as the finger touched it (a spinning wheel's caught where it is)
    last:    f32           // ...last frame, while it's pressed (for its speed)
    speed:   f32           // how fast it's turning, rows a second
    spinning: bool         // let go with a flick: turning on, slowing
    goal:    f32           // the row it's settling on, still
    settled: bool          // a spin's just settled on a row: settled_life is to be the game's
    settled_life: i32
    bend:    f32           // how round it is: 0 flat, 1 round
    crossed: bool          // history undo: strike out the original change
    change:  i32           // closed, the change it made while open
    since:   f32 = 1e9     // seconds since it was closed
    opening_step: i64 = -1 // opened at 0 from below it: the undo steps there were once that was remembered (-1: it wasn't)
}

// The life a drum's turn makes: from, and its place times the whole rows
// it's turned by.
drum_life :: (drum: Life_Drum -> i32) #pure {
    return drum.from + drum.place * i32'Math.round(drum.turned)
}

// A drum part way through its turn: the life it's turning from (base; the
// next, base + place) and how far toward the next (0 to 1).
drum_between :: (drum: Life_Drum -> base: i32, frac: f32) #pure {
    whole := Math.floor(drum.turned)
    base = drum.from + drum.place * i32'whole
    frac = drum.turned - whole
}

// A number's digit at a wheel (its place's: 0 the units), of its size.
digit_of :: (n: i32, wheel: i64 -> i64) #pure {
    *m := i64'Math.abs(n)
    for _: 0 < wheel { m /= 10 }
    return m % 10
}

// How many digits a number has (its size's; one at least).
digits_in :: (n: i32 -> i64) #pure {
    *m := i64'Math.abs(n)
    *count: i64 = 1
    while m >= 10 {
        m /= 10
        count += 1
    }
    return count
}

// Where a wheel is between two numbers, as a digit (between whole ones as
// it turns): its digit of a, turned frac of the way to b's, the short way
// round (9 to 0 forward, 0 to 9 back); a wheel whose digit doesn't change
// stays.
wheel_at :: (a: i32, b: i32, wheel: i64, frac: f32 -> f32) #pure {
    da := digit_of(a, wheel)
    db := digit_of(b, wheel)
    if da == db then return f32'da
    if db == (da + 1) % 10 then return f32'da + frac
    if db == (da + 9) % 10 then return f32'da - frac
    return f32'da + frac * f32'(db - da)
}

// A drum closed, if it's open: the change it made kept to show.
// A drum's cross: the life as the drum opened, a step to undo, and the drum
// closed; one opened at 0 from below it with nothing done since has that
// step taken back rather than another made.
cancel_drum :: (drum: *Life_Drum, game: *Game, timeline: *Timeline, lines: Lines) {
    k := drum.player
    if k >= 0 and k < game.players and game.life[k] != drum.start {
        if drum.opening_step == timeline.past.count {
            _ := timeline.past.pop()
        }
        else {
            timeline.remember(game, lines)
        }
        game.life[k] = drum.start
    }
    close_drum(drum, game)
}

close_drum :: (drum: *Life_Drum, game: Game) {
    if !drum.open then return
    drum.open = false
    drum.spinning = false
    drum.change = if drum.player < game.players then game.life[drum.player] - drum.start else 0
    drum.since = 0
    drum.opening_step = -1
}

// A drum's own turn made the game's life (a spin stopped where it is, a
// turn a finger's still making as far as it's gone), a step to undo if it
// changes it, and the drum closed: its tick (only it and the cross end it).
commit_drum :: (drum: *Life_Drum, game: *Game, timeline: *Timeline, lines: Lines) {
    if drum.player < 0 or drum.player >= game.players {
        drum.pressed = false
        close_drum(drum, game)
        return
    }
    *life := game.life[drum.player]
    if drum.spinning {
        stopped, _ := stop_drum(drum, game)
        life = stopped
    }
    else if drum.pressed and drum.open and drum.moved {
        life = drum_life(drum)
    }
    drum.pressed = false
    if life != game.life[drum.player] {
        timeline.remember(game, lines)
        game.life[drum.player] = life
    }
    close_drum(drum, game)
}

// A finger down on a player's life, or a wheel of its open drum (its
// place), at a point in their frame: a turn begins there (a drum shown for
// another player closes, and is theirs no longer).
press_drum :: (drum: *Life_Drum, game: Game, player: i64, at: V2, place: i32) {
    if drum.player != player {
        close_drum(drum, game)
        drum.player = player
        drum.bend = 0
        drum.change = 0
        drum.since = 1e9
    }
    drum.pressed = true
    drum.moved = false
    drum.touched = at
    if drum.spinning {
        // (a spinning wheel caught where it is: the same wheel turns on from
        // there; another starts from the row the spin had reached)
        drum.spinning = false
        if place != drum.place {
            drum.from = drum_life(drum)
            drum.turned = 0
        }
    }
    else {
        drum.from = game.life[player]
        drum.turned = 0
    }
    drum.place = place
    drum.grabbed = drum.turned
    drum.last = drum.turned
    drum.speed = 0
    drum.seen = game.life[player]
}

// A spinning drum stopped at the row it's nearest (before it's closed with
// the tick, or a touch away): the life that makes (changes: the game's life
// is to become it).
stop_drum :: (drum: *Life_Drum, game: Game -> life: i32, changes: bool) {
    life = 0
    changes = false
    if !drum.spinning then return
    drum.spinning = false
    drum.speed = 0
    drum.goal = Math.round(drum.turned)
    life = drum.from + drum.place * i32'drum.goal
    changes = life != game.life[drum.player]
}

// The furthest a drum's wheel turns back, in whole rows: a turn takes the
// life no lower than 0 (damage can; then no lower than it is).
drum_lowest :: (drum: Life_Drum -> f32) #pure {
    return Math.ceil(f32'(Math.min(0, drum.from) - drum.from) / f32'Math.max(drum.place, 1))
}

// The finger moved (a point in the drum's player's frame): past DRUM_TAP
// it's a turn, and an open drum's wheel turns with it, a row a pitch, no
// further back than drum_lowest (the finger past it moves the wheel again
// as soon as it comes back).
move_drum :: (drum: *Life_Drum, at: V2, cap: f32) {
    if !drum.pressed then return
    if Math.length(at - drum.touched) > DRUM_TAP * cap then drum.moved = true
    if !drum.open or !drum.moved then return
    pitch := Math.max(DRUM_PITCH * cap, 1)
    lowest := drum_lowest(drum)
    drum.turned = drum.grabbed + (at.y - drum.touched.y) / pitch
    if drum.turned < lowest {
        drum.touched.y = at.y - (lowest - drum.grabbed) * pitch
        drum.turned = lowest
    }
}

// The finger lifted: a tap enters or keeps editing; a turn of an open
// one gives the life it made (changes: the game's life is to become it).
release_drum :: (drum: *Life_Drum, game: Game -> life: i32, changes: bool) {
    life = 0
    changes = false
    if !drum.pressed then return
    drum.pressed = false
    if !drum.moved and !drum.open {
        drum.open = true
        drum.start = game.life[drum.player]
        drum.change = 0
        drum.since = 1e9
        // (a life below 0 opens at 0, its change what that adds: the cross
        // takes it back)
        if drum.start < 0 {
            drum.from = 0
            drum.place = 1
            drum.turned = 0
            drum.goal = 0
            life = 0
            changes = true
        }
        return
    }
    if !drum.open then return
    // (a flick spins on, the life its when it settles; otherwise the row
    // it's nearest, a tap on a caught wheel's too)
    if drum.moved and Math.abs(drum.speed) >= DRUM_FLICK {
        drum.spinning = true
        return
    }
    drum.goal = Math.round(drum.turned)
    life = drum.from + drum.place * i32'drum.goal
    changes = life != game.life[drum.player]
}

// A drum moved on by a frame's time: rounding as it opens, flattening as it
// closes; its wheel's speed measured while a finger turns it; let go with a
// flick, spinning on and slowing (DRUM_FRICTION) till it's slow enough to
// settle on the next row its way (settled: that's the life); and otherwise
// settling on its row, and following the game's life when that changes
// otherwise (an undo, damage).
step_drum :: (drum: *Life_Drum, game: Game, seconds: f32) {
    if drum.player < 0 or drum.player >= game.players {
        drum.open = false
        drum.pressed = false
        drum.spinning = false
        drum.bend = 0
        drum.change = 0
        return
    }
    // (the life changed by something else while a finger's on it or it
    // spins, damage or an undo: its turn and its start move on with it, so
    // what it settles on keeps that change, and the cross undoes only its own)
    if drum.pressed or drum.spinning {
        outside := game.life[drum.player] - drum.seen
        drum.from += outside
        drum.start += outside
        drum.seen = game.life[drum.player]
    }
    way: f32 = if drum.open then 1 else -1
    drum.bend = Math.clamp(drum.bend + way * seconds / DRUM_FLATTEN, 0, 1)
    if drum.pressed {
        // (eased, so a finger held still a moment before it's lifted is no flick)
        if seconds > 0 then drum.speed = Math.mix(drum.speed, (drum.turned - drum.last) / seconds, 0.5)
        drum.last = drum.turned
    }
    else if drum.spinning {
        drum.turned += drum.speed * seconds
        drum.speed *= Math.exp(0 - DRUM_FRICTION * seconds)
        // (a spin back stops at 0: settling there)
        if drum.turned <= drum_lowest(drum) {
            drum.turned = drum_lowest(drum)
            drum.speed = 0
        }
        if Math.abs(drum.speed) < DRUM_SETTLE {
            drum.spinning = false
            drum.goal = if drum.speed > 0 then Math.ceil(drum.turned) else Math.floor(drum.turned)
            drum.speed = 0
            drum.settled_life = drum.from + drum.place * i32'drum.goal
            drum.settled = drum.settled_life != game.life[drum.player]
        }
    }
    else {
        drum.turned += (drum.goal - drum.turned) * Math.min(1, seconds * 25)
        resting := drum.from + drum.place * i32'drum.goal
        if resting != game.life[drum.player] and !drum.settled {
            drum.start += game.life[drum.player] - resting
            drum.from = game.life[drum.player]
            drum.place = 1
            drum.turned = 0
            drum.goal = 0
        }
    }
    if !drum.open then drum.since += seconds
}

// Whether a player's life shows as a drum (open, or flattening), and how
// much its change shows, flat beside it (0 none).
player_controls_visibility :: (drum: Life_Drum, k: i64 -> f32) #pure {
    if drum.player != k then return 1
    t := Math.clamp(drum.bend, 0, 1)
    return 1 - t * t * (3 - 2 * t)
}

drum_showing :: (drum: Life_Drum, k: i64 -> bool) #pure {
    return drum.player == k and (drum.open or drum.bend > 0)
}

change_showing :: (drum: Life_Drum, k: i64 -> f32) #pure {
    if drum.player != k or drum.open or drum.change == 0 then return 0
    if drum.since <= DRUM_HOLD then return 1
    return Math.clamp(1 - (drum.since - DRUM_HOLD) / DRUM_FADE, 0, 1)
}

// A change as it's shown: "+3", "-2", "0".
change_text :: (change: i64 -> string) {
    return if change > 0 then "+«change»" else "«change»"
}

// The life total at a point (around its number, a little past it): its
// player; or absent.
life_at :: (layout: Layout, fonts: Fonts, game: Game, p: V2 -> i64) [absent] {
    cap := f32'fonts.life.cap_height
    for seat, k: layout.seats[:layout.count] {
        if seat.room < 0.6 * cell_of(layout) then continue
        half := Math.max(f32'fonts.life.text_width("«game.life[k]»") / 2, cap * 0.6) + cap * 0.25
        l := local_of(seat.middle, seat.angle, p)
        if Math.abs(l.x) <= half and Math.abs(l.y) <= cap * 0.85 then return k
    }
    fail: absent
}

// Where a drum's parts are, across its player's text from its middle: its
// wheels (as many as the life turning has digits, two at least: a life
// below 10 has its tens' wheel, blank at 0; each as wide as the widest
// digit), from left to right, then the change's wheel's middle and half
// width; and how many of its leading wheels are blank (a life below 10's
// tens).
Drum_Shape :: struct {
    wheels:      i64
    wheel_width: f32
    left:        f32
    right:       f32
    change_at:   f32
    change_half: f32
    blank:       i64
}

// The fewest wheels a drum has: the units' and the tens', the tens' blank
// below 10, so a life of one digit can be turned by ten too.
DRUM_LEAST_WHEELS :: 2

// The signed-change wheel always advances one unit per row. A tens/hundreds
// gesture traverses ten/a hundred rows for each row of the selected life wheel.
change_wheel_position :: (drum: Life_Drum -> f32) #pure {
    return f32'(drum.from - drum.start) + drum.turned * f32'drum.place
}

drum_shape :: (fonts: Fonts, drum: Life_Drum -> shape: Drum_Shape) {
    cap := f32'fonts.life.cap_height
    base, _ := drum_between(drum)
    *widest: f32 = 0
    for d: 0 < 10 { widest = Math.max(widest, f32'fonts.life.text_width("«d»")) }
    *widest_change: f32 = 0
    change_nearest := i64'Math.round(change_wheel_position(drum))
    for k: -DRUM_ROWS <= DRUM_ROWS {
        widest_change = Math.max(widest_change, f32'fonts.change.text_width(change_text(change_nearest + k)))
    }
    digits := Math.max(digits_in(base), digits_in(base + drum.place))
    shape.wheels = Math.max(digits, DRUM_LEAST_WHEELS)
    shape.blank = shape.wheels - digits
    shape.wheel_width = widest + cap * 0.18
    shape.right = f32'shape.wheels * shape.wheel_width / 2
    shape.left = 0 - shape.right
    shape.change_half = widest_change / 2 + cap * 0.15
    shape.change_at = shape.right + cap * 0.3 + shape.change_half
    // (centred on the life total as it opens: its digits where the total's
    // drawn while it's flat, a blank tens' wheel to their left; the whole
    // drum, wheels and change, once it's round)
    flat := 0 - f32'shape.blank * shape.wheel_width / 2
    round := 0 - (shape.left + shape.change_at + shape.change_half) / 2
    shift := Math.mix(flat, round, Math.clamp(drum.bend, 0, 1))
    shape.left += shift
    shape.right += shift
    shape.change_at += shift
}

// An open drum's wheel at a point of the screen: its place; or absent.
drum_wheel_at :: (layout: Layout, fonts: Fonts, drum: Life_Drum, p: V2 -> i32) [absent] {
    if !drum.open or drum.player < 0 or drum.player >= layout.count then fail: absent
    seat := layout.seats[drum.player]
    middle := drum_middle(layout, fonts, drum, drum.player)
    if place := wheel_at_point(fonts, drum, local_of(middle, seat.angle, p)) { return place } else if absent { fail: absent }
}

// An open drum's buttons' half size, in its player's frame: as tall as its
// glass; and how far out from its ends their middles are.
drum_button_half :: (layout: Layout, fonts: Fonts -> half: V2, away: f32) #pure {
    cell := cell_of(layout)
    pad := GLASS_PAD * cell
    half = ⟨PICK_BUTTON_TALL * cell / 2, DRUM_RADIUS * DRUM_PITCH * f32'fonts.life.cap_height + pad⟩
    away = pad + PICK_BUTTON_GAP * cell + half.x
}

// Where a player's drum's frame is (the origin its shape's measured from):
// their life total's middle while it's flat; as it rounds, moved as far as
// keeps the whole of it, glass, cross and tick, DRUM_SCREEN_MARGIN cells
// inside the screen (its life total fits its part; the spinner, wider, the
// screen).
DRUM_SCREEN_MARGIN :: 0.1
drum_middle :: (layout: Layout, fonts: Fonts, drum: Life_Drum, player: i64 -> V2) {
    seat := layout.seats[player]
    shape := drum_shape(fonts, drum)
    half, away := drum_button_half(layout, fonts)
    from := shape.left - away - half.x
    to := shape.change_at + shape.change_half + away + half.x
    *low := V2⟨1e30, 1e30⟩
    *high := V2⟨-1e30, -1e30⟩
    for corner: [4] V2⟨⟨from, 0 - half.y⟩, ⟨to, 0 - half.y⟩, ⟨from, half.y⟩, ⟨to, half.y⟩⟩ {
        at := placed(seat.middle, seat.angle, corner)
        low = Math.min(low, at)
        high = Math.max(high, at)
    }
    margin := DRUM_SCREEN_MARGIN * cell_of(layout)
    offset := V2⟨Math.max(0, margin - low.x) - Math.max(0, high.x - (layout.size.x - margin)),
                 Math.max(0, margin - low.y) - Math.max(0, high.y - (layout.size.y - margin))⟩
    return seat.middle + offset * Math.clamp(drum.bend, 0, 1)
}

// An open drum's cross and tick, on the screen: glass buttons as tall as
// its glass, at its ends along its player's text, the cross before its
// wheels and the tick after its change; and their half size (in that
// frame).
drum_buttons :: (layout: Layout, fonts: Fonts, drum: Life_Drum, player: i64 -> cross: V2, tick: V2, half: V2) {
    seat := layout.seats[player]
    shape := drum_shape(fonts, drum)
    middle := drum_middle(layout, fonts, drum, player)
    button, away := drum_button_half(layout, fonts)
    half = button
    cross = placed(middle, seat.angle, V2⟨shape.left - away, 0⟩)
    tick = placed(middle, seat.angle, V2⟨shape.change_at + shape.change_half + away, 0⟩)
}

// Whether a point is under an open drum: the band from its cross's far edge
// to its tick's, as tall as they are (its glass between them), turned as
// its player's text.
under_open_drum :: (layout: Layout, fonts: Fonts, drums: [MAX_PLAYERS] Life_Drum, p: V2 -> bool) {
    for drum, k: drums {
        if k >= layout.count or !drum.open then continue
        seat := layout.seats[k]
        middle := drum_middle(layout, fonts, drum, k)
        cross, tick, half := drum_buttons(layout, fonts, drum, k)
        from := local_of(middle, seat.angle, cross).x - half.x
        to := local_of(middle, seat.angle, tick).x + half.x
        at := local_of(middle, seat.angle, p)
        if at.x >= from and at.x <= to and Math.abs(at.y) <= half.y then return true
    }
    return false
}

// An open drum's wheel at a point (of its player's frame): its place (the
// change's wheel turns as the units'), or absent off the drum.
wheel_at_point :: (fonts: Fonts, drum: Life_Drum, at: V2 -> place: i32) [absent] {
    place = 1
    shape := drum_shape(fonts, drum)
    cap := f32'fonts.life.cap_height
    radius := DRUM_RADIUS * DRUM_PITCH * cap
    if Math.abs(at.y) > radius or at.x < shape.left - cap * 0.2 or at.x > shape.change_at + shape.change_half + cap * 0.2
        fail: absent
    if at.x > shape.right then return
    i := Math.clamp(i64'Math.floor((at.x - shape.left) / shape.wheel_width), 0, shape.wheels - 1)
    for _: 0 < shape.wheels - 1 - i { place *= 10 }
}

Drum_Params :: struct {
    middle: V4    // the drum's middle (pixels), its radius (pixels), how round it is (0 flat, 1 round)
    turn:   V4    // the cosine and sine of its player's text's turn, the layer's size (pixels)
    source: V4    // source image centre; unrotated, padded beyond the cylinder
    widths: V4    // its wheels' left and right, the change's wheel's middle and half width
    wheels: V4    // wheel width and number of player colours
    ink:    V4    // the numbers' colour (straight)
    tints: [5] V4
}

// A drum's numbers, drawn flat into a layer, wrapped round its cylinder:
// each place on it shows the layer as far along the cylinder's surface as
// it is round from the middle, darker as it turns away; a dark band behind
// each drum's numbers. (A canvas is opaque, so the layer has the numbers'
// parts in its channels, each drawn over black: their fill in red, their
// border in green, their shadow in blue; the border and the shadow black.)
drum_shade :: (from: Draw.Quad_Between, drum: Shader.Uniforms(Drum_Params), layer: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    d := from.pixel - drum.middle.xy
    // (into its player's frame: x along their text, y toward them)
    local := V2⟨d.x * drum.turn.x + d.y * drum.turn.y, d.y * drum.turn.x - d.x * drum.turn.y⟩
    radius := Math.max(drum.middle.z, 1)
    bend := drum.middle.w
    on_life := local.x >= drum.widths.x and local.x <= drum.widths.y
    on_change := Math.abs(local.x - drum.widths.z) <= drum.widths.w
    if !on_life and !on_change then return ⟨0, 0, 0, 0⟩
    if Math.abs(local.y) > radius then return ⟨0, 0, 0, 0⟩
    angle := Math.asin(Math.clamp(local.y / radius, -1, 1))
    facing := Math.cos(angle)
    along := Math.mix(local.y, angle * radius, bend)
    parts := Shader.sample_level(layer, filtering, (drum.source.xy + V2⟨local.x, along⟩) / drum.turn.zw, 0)
    covered := Math.clamp(parts.x + parts.y + parts.z, 0, 1) * drum.ink.w
    text := V4⟨drum.ink.x * parts.x * drum.ink.w, drum.ink.y * parts.x * drum.ink.w, drum.ink.z * parts.x * drum.ink.w, covered⟩
    shade := Math.mix(1, 0.2 + 0.8 * facing * facing, bend)
    // (the band, each wheel itself: soft at its ends across, so wheels part,
    // dark toward its edges along the cylinder, a light's gleam a little
    // above its middle)
    wheel := Math.max(drum.wheels.x, 1)
    into := local.x - drum.widths.x
    within := into - Math.floor(into / wheel) * wheel
    from_end := if on_life then Math.min(within, wheel - within) else drum.widths.w - Math.abs(local.x - drum.widths.z)
    ends := Math.clamp(from_end / 5, 0, 1)
    band := 0.7 * bend * ends
    gleam := (angle + 0.45) / 0.22
    grey := 0.05 + 0.22 * facing + 0.3 * Math.exp(0 - gleam * gleam)
    lit := text * shade
    last := i32'drum.wheels.y - 1
    stop := Math.clamp(into / (drum.widths.z + drum.widths.w - drum.widths.x), 0, 1) * f32'last
    i := i32'Math.floor(stop)
    tint := Math.mix(drum.tints[i].xyz, drum.tints[Math.min(i + 1, last)].xyz, Math.smoothstep(0, 1, Math.fract(stop)))
    metal := (V3⟨0.30, 0.30, 0.30⟩ + tint * 1.15) * grey
    rgb := lit.xyz + metal * (band * (1 - lit.w))
    colour = ⟨rgb.x, rgb.y, rgb.z, lit.w + band * (1 - lit.w)⟩
}

Drum :: shader { vertex: Draw.quad_place; fragment: drum_shade }
DRUM :: Drum(Draw.SHADER_TARGET)

// A player's life as a drum: its rows drawn flat into the layer (cleared),
// then wrapped round the cylinder onto the canvas.
// The unwrapped cylinder must not be clipped by the player's screen position.
drum_source: Draw.Canvas
drum_source_made: bool
prepare_drum_source :: (size: Wide.i32x2 -> bool) {
    if !drum_source_made {
        if made := Draw.create_canvas(size) { drum_source = made } else if os_error { return false }
        drum_source_made = true
    } else if drum_source.size != size {
        if drum_source.resize(size) is os_error then return false
    }
    return true
}
destroy_drum_source :: () {
    if drum_source_made { drum_source.destroy(); drum_source_made = false }
}

draw_drum :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, seat: Seat, fonts: Fonts, drum: Life_Drum, colour: Draw.RGBA, style: Draw.Text_Style, colours: [] Draw.RGBA) {
    cap := f32'fonts.life.cap_height
    pitch := DRUM_PITCH * cap
    radius := DRUM_RADIUS * pitch
    shape := drum_shape(fonts, drum)
    base, frac := drum_between(drum)
    next := base + drum.place
    change_cap := f32'fonts.change.cap_height
    // (each part in the channels: fill red, border green, shadow blue; a
    // row at the middle shows whole, the rest as round as the drum is)
    parted :: (style: Draw.Text_Style, shows: f32 -> Draw.Text_Style) {
        return ⟨outline: Draw.rgba(0x00FF00, shows), outline_width: style.outline_width,
                shadow: Draw.rgba(0x0000FF, style.shadow.a * shows), shadow_offset: style.shadow_offset, shadow_soft: style.shadow_soft⟩
    }
    change_style := Draw.Text_Style⟨outline_width: Math.max(1.5, change_cap * LIFE_OUTLINE * 1.5)⟩
    source_height := Math.ceil((f32'DRUM_ROWS + 1) * pitch * 2)
    source_width := Math.ceil(shape.change_at + shape.change_half - shape.left + cap * 2)
    if !prepare_drum_source(⟨i32'source_width, i32'source_height⟩) then return
    source_middle := V2⟨cap - shape.left, source_height / 2⟩
    drum_source.clear(Draw.rgb(0x000000))
    // Each wheel: its digit where it's turned to, the digits round it above
    // (bigger) and below; a leading wheel's 0 blank, and nothing below the 0
    // of a wheel whose higher wheels are all 0 (a turn stops there: the
    // leading wheel's, and a life below 10's units', its tens blank) unless
    // the life's below 0.
    for i: 0 < shape.wheels {
        wheel := shape.wheels - 1 - i
        middle_x := shape.left + (f32'i + 0.5) * shape.wheel_width
        q := wheel_at(base, next, wheel, frac)
        nearest := i64'Math.round(q)
        *above: i64 = 10
        for _: 0 < wheel { above *= 10 }
        floored := base >= 0 and next >= 0 and i64'base < above and i64'next < above
        for k: -DRUM_ROWS <= DRUM_ROWS {
            d := nearest + k
            digit := ((d % 10) + 10) % 10
            if floored and d < 0 then continue
            if digit == 0 and wheel == shape.wheels - 1 and shape.wheels > 1 then continue
            shows := if drum.open or k == 0 then 1.0 else drum.bend
            if shows <= 0 then continue
            y := (q - f32'd) * pitch
            text := "«digit»"
            width := f32'fonts.life.text_width(text)
            drum_source.draw_text(fonts.life, source_middle + V2⟨middle_x - width / 2, y + cap / 2⟩, text, Draw.rgba(0xFF0000, shows),
                            parted(style, shows), 0)
        }
    }
    // Consecutive signed values, moving proportionally faster for higher
    // places; none that would take the life below where a turn stops.
    change_position := change_wheel_position(drum)
    change_nearest := i64'Math.round(change_position)
    for k: -DRUM_ROWS <= DRUM_ROWS {
        shows := if drum.open or k == 0 then 1.0 else drum.bend
        if shows <= 0 then continue
        if i64'drum.start + change_nearest + k < i64'Math.min(0, drum.from) then continue
        y := (change_position - f32'(change_nearest + k)) * pitch
        change := change_text(change_nearest + k)
        width := f32'fonts.change.text_width(change)
        drum_source.draw_text(fonts.change, source_middle + V2⟨shape.change_at - width / 2, y + change_cap / 2⟩, change,
                        Draw.rgba(0xFF0000, shows), ⟨outline: Draw.rgba(0x00FF00, shows), outline_width: change_style.outline_width⟩, 0)
    }
    // (the quad: the screen's box round the drum's turned rectangle)
    *low := V2⟨1e30, 1e30⟩
    *high := V2⟨-1e30, -1e30⟩
    far := shape.change_at + shape.change_half
    for corner: [4] V2⟨⟨shape.left, -radius⟩, ⟨far, -radius⟩, ⟨shape.left, radius⟩, ⟨far, radius⟩⟩ {
        at := placed(seat.middle, seat.angle, corner)
        low = Math.min(low, at)
        high = Math.max(high, at)
    }
    low = Math.floor(low) - V2⟨2, 2⟩
    high = Math.ceil(high) + V2⟨2, 2⟩
    *params := Drum_Params⟨V4⟨seat.middle.x, seat.middle.y, radius, drum.bend⟩,
                          V4⟨Math.cos(seat.angle), Math.sin(seat.angle), source_width, source_height⟩,
                          V4⟨source_middle.x, source_middle.y, 0, 0⟩,
                          V4⟨shape.left, shape.right, shape.change_at, shape.change_half⟩, V4⟨shape.wheel_width, f32'colours.count, 0, 0⟩,
                          V4⟨colour.r, colour.g, colour.b, colour.a⟩, ⟨⟩⟩
    for tint, i: colours { params.tints[i] = V4⟨tint.r, tint.g, tint.b, 1⟩ }
    canvas.draw_shader_canvas(low, high - low, DRUM.code, DRUM.bindings.drum, params, drum_source, DRUM.bindings.layer, DRUM.bindings.filtering)
    // (a life below nothing: its minus, flat, before its digits' wheels)
    if base < 0 and next <= 0 {
        minus := f32'fonts.life.text_width("-")
        digits_left := shape.left + f32'shape.blank * shape.wheel_width
        canvas.draw_text(fonts.life, placed(seat.middle, seat.angle, ⟨digits_left - minus - cap * 0.1, cap / 2⟩), "-", colour, style, seat.angle)
    }
}

// Accelerate into the resting place, rebound twice, and settle before fading away.
change_fall :: (since: f32 -> f32) #pure {
    t := Math.clamp(since / (DRUM_FADE * 0.8), 0, 1)
    if t < 1 / 2.75 then return 7.5625 * t * t
    if t < 2 / 2.75 {
        u := t - 1.5 / 2.75
        return 7.5625 * u * u + 0.75
    }
    if t < 2.5 / 2.75 {
        u := t - 2.25 / 2.75
        return 7.5625 * u * u + 0.9375
    }
    u := t - 2.625 / 2.75
    return 7.5625 * u * u + 0.984375
}

// A closed drum's signed change falls toward the actual text edge, not the
// wider spinner columns; local coordinates keep the bounce facing its player.
draw_change :: (canvas: *Draw.Canvas, seat: Seat, fonts: Fonts, drum: Life_Drum, colour: Draw.RGBA, shows: f32, life_width: f32) {
    change_at := drum_shape(fonts, drum).change_at
    change_cap := f32'fonts.change.cap_height
    change_style := Draw.Text_Style⟨outline: Draw.rgba(0x000000, shows), outline_width: Math.max(1.5, change_cap * LIFE_OUTLINE * 1.5)⟩
    change := change_text(i64'drum.change)
    width := f32'fonts.change.text_width(change)
    resting := life_width / 2 + f32'fonts.life.cap_height * 0.14 + width / 2
    at := Math.mix(change_at, Math.min(change_at, resting), change_fall(drum.since))
    canvas.draw_text(fonts.change, placed(seat.middle, seat.angle, ⟨at - width / 2, change_cap / 2⟩), change, faded(colour, shows), change_style, seat.angle)
    if drum.crossed {
        a := placed(seat.middle, seat.angle, ⟨at - width / 2 - change_cap * 0.06, 0⟩)
        b := placed(seat.middle, seat.angle, ⟨at + width / 2 + change_cap * 0.06, 0⟩)
        canvas.draw_line(a, b, Math.max(3, change_cap * 0.11), Draw.rgba(0x000000, shows))
        canvas.draw_line(a, b, Math.max(1.5, change_cap * 0.045), Draw.rgba(0xF03932, shows))
    }
}

// The last poison impact kicks the badge up briefly in the player's frame.
poison_hit_bump :: (volleys: Volleys, player: i64 -> f32) #pure {
    *bump: f32 = 0
    for v: volleys.list {
        if v.to != player or v.kind != .POISON or v.landed == 0 then continue
        age := v.age - bolt_impact(v, i64'v.landed - 1)
        if age >= 0 and age < 0.22 {
            bump = Math.max(bump, 1 - Math.smoothstep(0, 0.22, age))
        }
    }
    return bump
}

POISON_BADGE_FACE :: Draw.rgb(0x10281D)
POISON_BADGE_RIM :: Draw.rgb(0x427942)

draw_poison_badge :: (canvas: *Draw.Canvas, slot: V2, angle: f32, fonts: Fonts, count: i32, cell: f32, bump: f32) {
    text := "«count»"
    symbol_width := f32'fonts.commander_badge.text_width(POISON_GLYPH)
    number_width := f32'fonts.small.text_width(text)
    gap := 0.08 * cell
    radius := 0.22 * cell
    width := Math.max(number_width, f32'fonts.small.text_width("10")) + symbol_width + gap + 0.24 * cell
    left := 0 - width / 2
    y := 0 - 0.12 * cell * bump
    a := placed(slot, angle, ⟨left + radius, y⟩)
    b := placed(slot, angle, ⟨left + width - radius, y⟩)
    rim := if count >= LETHAL_POISON then Draw.rgb(0xEF4540) else if count == LETHAL_POISON - 1 then Draw.rgb(0xBBF466) else POISON_BADGE_RIM
    canvas.draw_line(a, b, radius * 2, rim)
    canvas.draw_line(a, b, radius * 2 - 2 * Math.max(1, 0.025 * cell), POISON_BADGE_FACE)
    content := left + (width - symbol_width - gap - number_width) / 2
    symbol := placed(slot, angle, ⟨content + symbol_width / 2, y⟩)
    number := placed(slot, angle, ⟨content + symbol_width + gap + number_width / 2, y⟩)
    draw_centred(canvas, fonts.commander_badge, symbol, angle, POISON_GLYPH, POISON_GREEN)
    draw_centred(canvas, fonts.small, number, angle, text, Draw.rgb(0xFFFFFF))
}

// How big a commander damage chip is (cells), and the gap between two
// beside each other (cells).
CHIP_RADIUS :: 0.28
CHIP_GAP    :: 0.06

// Commander circles surround the life total. Their directions match the
// commanders' places around the table; tight regions use the nearest free spot.
chip_places :: (layout: Layout, k: i64, life_width: f32, life_height: f32, has_poison := true -> places: [MAX_PLAYERS] V2) {
    with scratch.rewind()
    places = ⟨⟩
    cell := cell_of(layout)
    seat := layout.seats[k]
    toggles := toggles_of(layout, k)
    points := seat.outline[:seat.count]
    r := CHIP_RADIUS * cell
    apart := 2 * r + CHIP_GAP * cell
    below := life_height / 2 + r + 0.25 * cell
    n := layout.count
    // (its own: the middle of its poison and its tax, either side of its
    // centre line, below its life, or above it where there's no room below)
    places[k] = own_pair_place(seat, points, toggles, life_width, life_height, cell, has_poison)
    poison, tax := poison_tax_places(seat, places[k], cell, has_poison)
    clear := (PAIR_REACH + CHIP_GAP) * cell + r
    *fits: [MAX_PLAYERS] bool
    fits[k] = true
    for j: 0 < n {
        if j == k then continue
        direction := Math.normalize(layout.seats[j].middle - layout.centre)
        local := local_of(V2⟨0, 0⟩, seat.angle, direction)
        // A rounded rectangle around the number leaves diagonal chips clear too.
        gap := 0.20 * cell
        edge_x := (life_width / 2 + r + gap) / Math.max(Math.abs(local.x), 0.001)
        edge_y := (life_height / 2 + r + gap) / Math.max(Math.abs(local.y), 0.001)
        radius := Math.min(edge_x, edge_y)
        places[j] = seat.middle + direction * radius
        fits[j] = chip_fits(places[j], points, toggles, r, cell)
        if Math.length(places[j] - poison) < clear or Math.length(places[j] - tax) < clear then fits[j] = false
        for m: 0 < j { if m != k and Math.length(places[j] - places[m]) < apart then fits[j] = false }
    }
    // (one that doesn't fit: the free place nearest its own)
    beside := life_width / 2 + r + 0.25 * cell
    *spots: [..] V2 in scratch
    for y: [5] f32⟨below, below + apart, below + 2 * apart, 0 - below, 0 - below - apart⟩ {
        for i: -10 <= 10 { `scratch spots.add(V2⟨f32'i * 0.5 * apart, y⟩) }
    }
    for x: [4] f32⟨beside, beside + apart, 0 - beside, 0 - beside - apart⟩ {
        for i: -5 <= 5 { `scratch spots.add(V2⟨x, f32'i * 0.5 * apart⟩) }
    }
    for j: 0 < layout.count {
        if fits[j] then continue
        own := places[j]
        *best: f32 = 1e30
        for local: spots {
            if Math.abs(local.x) < life_width / 2 + r and Math.abs(local.y) < life_height / 2 + r then continue
            at := placed(seat.middle, seat.angle, local)
            score := Math.length(at - own)
            if score >= best or !chip_fits(at, points, toggles, r, cell) then continue
            *taken := Math.length(at - poison) < clear or Math.length(at - tax) < clear
            for m: 0 < layout.count {
                if m == j or m == k or !(fits[m] or m < j) then continue
                if Math.length(at - places[m]) < apart then taken = true
            }
            if taken then continue
            best = score
            places[j] = at
        }
    }
}

// A commander with the current extra mana cost at its lower-right corner.
draw_tax_button :: (canvas: *Draw.Canvas, fonts: Fonts, at: V2, angle: f32, cell: f32, tax: i32, shows: f32) {
    if shows <= 0 then return
    width := f32'fonts.attack.text_width(COMMANDER_GLYPH)
    style := Draw.Text_Style⟨outline: Draw.rgba(0x000000, shows), outline_width: Math.max(1, cell * 0.018),
                             shadow: Draw.rgba(0x000000, 0.45 * shows), shadow_offset: V2⟨0.03, 0.04⟩ * cell, shadow_soft: cell * 0.025⟩
    canvas.draw_text(fonts.attack, placed(at, angle, ⟨-width / 2, f32'fonts.attack.cap_height / 2⟩),
                     COMMANDER_GLYPH, Draw.rgba(0xFFFFFF, shows), style, angle)
    text := "+«tax»"
    badge_width := f32'fonts.small.text_width(text)
    badge := placed(at, angle, ⟨cell * 0.22, cell * 0.23⟩)
    canvas.draw_text(fonts.small, placed(badge, angle, ⟨-badge_width / 2, f32'fonts.small.cap_height / 2⟩),
                     text, Draw.rgba(0xFFFFFF, shows), style, angle)
}

// A player's poison counter and commander tax sit either side of their
// centre line (the line through their life total, straight toward them),
// the poison on their left, the tax on their right, each's near edge
// PAIR_GAP cells from the line: the poison's counter POISON_HALF cells
// across its middle, the tax's commander TAX_HALF; each reaches PAIR_REACH
// cells round its place.
PAIR_GAP    :: 0.2
POISON_HALF :: 0.45
TAX_HALF    :: 0.24
PAIR_REACH  :: 0.45

// The poison's and the tax's places, either side of the middle of their
// pair (own_pair_place's, on the centre line).
poison_tax_places :: (seat: Seat, pair: V2, cell: f32, has_poison := true -> poison: V2, tax: V2) #pure {
    if !has_poison { poison = pair; tax = pair; return }
    poison = placed(pair, seat.angle, ⟨0 - (PAIR_GAP + POISON_HALF) * cell, 0⟩)
    tax = placed(pair, seat.angle, ⟨(PAIR_GAP + TAX_HALF) * cell, 0⟩)
}

Tax_Slide :: struct { phase: f32 = -1 }
TAX_SLIDE_SECONDS :: 0.28

step_tax_slide :: (slide: *Tax_Slide, has_poison: bool, seconds: f32) {
    target: f32 = if has_poison then 1 else 0
    if slide.phase < 0 then slide.phase = target
    else {
        distance := seconds / TAX_SLIDE_SECONDS
        slide.phase += Math.clamp(target - slide.phase, -distance, distance)
    }
}

// In a tight seat the paired badges may need a different anchor than the solo
// tax. Interpolate both coordinates, using the same position for taps and drawing.
sliding_tax_place :: (layout: Layout, k: i64, width: f32, cap: f32, current: V2, has_poison: bool, slide: Tax_Slide -> V2) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    _, target := poison_tax_places(seat, current, cell, has_poison)
    t := slide.phase
    if t < 0 or (has_poison and t == 1) or (!has_poison and t == 0) then return target
    other := own_pair_place(seat, seat.outline[:seat.count], toggles_of(layout, k), width, cap, cell, !has_poison)
    _, opposite := poison_tax_places(seat, other, cell, !has_poison)
    eased := t * t * (3 - 2 * t)
    if has_poison then return Math.mix(opposite, target, eased)
    return Math.mix(target, opposite, eased)
}

// The middle of a player's poison and tax, where both fit (inside the part,
// clear of its edges and colour toggles): on their centre line just below
// their life total (toward them), else just above it, else further out
// each way along the line, a tenth of a cell at a time; and where the line
// has no room for them, off it, the place nearest just below that's clear
// of the life total. (None anywhere: just below.)
PAIR_LINE_STEPS :: 30
PAIR_SEARCH_CELLS :: 5.0
own_pair_place :: (seat: Seat, points: [] V2, toggles: [5] V2, life_width: f32, life_height: f32, cell: f32, has_poison: bool -> V2) #pure {
    away := life_height / 2 + (PAIR_REACH + 0.2) * cell
    pair_fits :: (seat: Seat, points: [] V2, toggles: [5] V2, pair: V2, cell: f32, has_poison: bool -> bool) #pure {
        poison, tax := poison_tax_places(seat, pair, cell, has_poison)
        return (!has_poison or chip_fits(poison, points, toggles, PAIR_REACH * cell, cell)) and chip_fits(tax, points, toggles, PAIR_REACH * cell, cell)
    }
    for i: 0 < PAIR_LINE_STEPS {
        for side: [2] f32⟨1, -1⟩ {
            pair := placed(seat.middle, seat.angle, ⟨0, side * (away + f32'i * 0.1 * cell)⟩)
            if pair_fits(seat, points, toggles, pair, cell, has_poison) then return pair
        }
    }
    // (off the line: the pair spans from its poison's far edge to its tax's,
    // PAIR_REACH up and down, and stays clear of the life total)
    left := if has_poison then (PAIR_GAP + 2 * POISON_HALF) * cell else TAX_HALF * cell
    right := if has_poison then (PAIR_GAP + 2 * TAX_HALF) * cell else TAX_HALF * cell
    reach := PAIR_REACH * cell
    wanted := V2⟨0, away⟩
    *best := wanted
    *best_distance: f32 = 1e30
    step := 0.25 * cell
    steps := i64'(PAIR_SEARCH_CELLS * cell / step)
    for i: -steps <= steps {
        for j: -steps <= steps {
            local := V2⟨f32'i * step, f32'j * step⟩
            if local.x + right > 0 - life_width / 2 and local.x - left < life_width / 2 and
               local.y + reach > 0 - life_height / 2 and local.y - reach < life_height / 2 then continue
            distance := Math.length(local - wanted)
            if distance >= best_distance then continue
            if !pair_fits(seat, points, toggles, placed(seat.middle, seat.angle, local), cell, has_poison) then continue
            best = local
            best_distance = distance
        }
    }
    return placed(seat.middle, seat.angle, best)
}

LIFE_SHORTCUTS :: [4] Attack⟨.GAIN_ONE, .GAIN_TWO, .LOSE_ONE, .LOSE_TWO⟩

life_shortcut_place :: (layout: Layout, k: i64, kind: Attack, enabled: Attacks, chips: [MAX_PLAYERS] V2, width: f32 -> V2) #pure {
    seat := layout.seats[k]
    cell := cell_of(layout)
    *left := -width / 2
    for chip, j: chips[:layout.count] {
        if j != k then left = Math.min(left, local_of(seat.middle, seat.angle, chip).x - CHIP_RADIUS * cell)
    }
    pitch := f32'OPTION_PITCH * cell
    inner := left - 0.45 * cell
    *keys: [4] Attack
    *count: i64 = 0
    *ones: i64 = 0
    *index: i64 = 0
    for key: [4] Attack⟨.GAIN_TWO, .GAIN_ONE, .LOSE_ONE, .LOSE_TWO⟩ {
        if !has_attack(enabled, key) then continue
        if key == kind then index = count
        if Math.abs(self_life_delta(key)) == 1 then ones += 1
        keys[count] = key
        count += 1
    }
    *places: [4] V2
    points := seat.outline[:seat.count]
    for tall: [2] bool⟨true, false⟩ {
        *rows: [2] i64
        for key, j: keys[:count] {
            two := Math.abs(self_life_delta(key)) == 2
            col := if !tall and two then 1 else 0
            length := if tall then count else if two then count - ones else ones
            x := if col == 1 and ones > 0 then inner - pitch else inner
            y := (f32'rows[col] - f32'(length - 1) / 2) * pitch
            places[j] = ⟨x, y⟩
            rows[col] += 1
        }
        // Intersect the allowed vertical shifts for each enabled key against
        // every wall. The nearest feasible shift follows a moving wall continuously.
        *low: f32 = -4 * cell
        *high: f32 = 4 * cell
        for point, edge: points {
            a := local_of(seat.middle, seat.angle, point)
            b := local_of(seat.middle, seat.angle, points[(edge + 1) % points.count])
            if Math.length(b - a) < 0.001 then continue
            *normal := Math.normalize(V2⟨a.y - b.y, b.x - a.x⟩)
            if Math.dot(normal, a) > 0 then normal = normal * -1.0
            for place: places[:count] {
                need := 0.35 * cell - Math.dot(normal, place - a)
                if normal.y > 0.00001 then low = Math.max(low, need / normal.y)
                else if normal.y < -0.00001 then high = Math.min(high, need / normal.y)
                else if need > 0 then low = 1e30
            }
        }
        if low <= high then return placed(seat.middle, seat.angle, places[index] + V2⟨0, Math.clamp(0, low, high)⟩)
    }
    // A crowded grid may cross a channel. Keep its enabled keys on screen together.
    *low := layout.size
    *high := V2⟨0, 0⟩
    for place: places[:count] {
        world := placed(seat.middle, seat.angle, place)
        low = Math.min(low, world)
        high = Math.max(high, world)
    }
    pad := V2⟨0.35, 0.35⟩ * cell
    offset := Math.clamp(V2⟨0, 0⟩, pad - low, layout.size - pad - high)
    return placed(seat.middle, seat.angle, places[index]) + offset
}

life_shortcut_at :: (layout: Layout, fonts: Fonts, game: Game, screen: Screen_State, p: V2 -> player: i64, delta: i32) [absent] {
    player = -1
    delta = 0
    for i: 0 < layout.count {
        k := layout.count - 1 - i
        if is_out(game, k) or screen.pickers[k].open or screen.drums[k].open then continue
        width := f32'fonts.life.text_width("«game.life[k]»")
        chips := chip_places(layout, k, width, f32'fonts.life.cap_height, game.poison[k] > 0)
        for kind: LIFE_SHORTCUTS {
            if !has_attack(game.attacks[k], kind) then continue
            if Math.length(life_shortcut_place(layout, k, kind, game.attacks[k], chips, width) - p) <= OPTION_PITCH * 0.5 * cell_of(layout) {
                player = k
                delta = self_life_delta(kind)
                return
            }
        }
    }
    fail: absent
}

tax_button_at :: (layout: Layout, fonts: Fonts, game: Game, screen: Screen_State, at: V2 -> player: i64) [absent] {
    for k: 0 < layout.count {
        if is_out(game, k) or screen.pickers[k].open or screen.drums[k].open then continue
        width := f32'fonts.life.text_width("«game.life[k]»")
        places := chip_places(layout, k, width, f32'fonts.life.cap_height, game.poison[k] > 0)
        button := sliding_tax_place(layout, k, width, f32'fonts.life.cap_height, places[k], game.poison[k] > 0, screen.tax_slides[k])
        if Math.length(at - button) <= 0.42 * cell_of(layout) then return k
    }
    fail: absent
}

raise_commander_tax :: (game: *Game, ready_at: *f64, player: i64, now: f64 -> bool) {
    if now < ready_at then return false
    game.tax[player] += 2
    ready_at = now + 1
    return true
}

// Whether a chip of radius r at a place is inside its part, clear of its
// sides, and clear of its colour toggles.
chip_fits :: (at: V2, points: [] V2, toggles: [5] V2, r: f32, cell: f32 -> bool) #pure {
    if !inside(at, points) or clearance(at, points) < 0.8 * r then return false
    for t: toggles { if Math.length(at - t) < r + TOGGLE_RADIUS * cell + 0.08 * cell then return false }
    return true
}

// A translucent landing panel. The foil reflection travels in the attacker's frame.
Foil_Params :: struct { box: V4; turn: V4; hues: [3] V4 }
foil_shade :: (from: Draw.Quad_Between, foil: Shader.Uniforms(Foil_Params) -> colour: V4) {
    offset := from.pixel - foil.box.xy
    p := V2⟨Math.dot(offset, foil.turn.xy), offset.y * foil.turn.x - offset.x * foil.turn.y⟩
    cell := foil.turn.z
    d := round_box_distance(p, foil.box.zw, cell * 0.17)
    coverage := Math.clamp(0.5 - d, 0, 1)
    // The user's pinned foil (glass_foil) in the panel's own frame, moving
    // with time (turn.w, seconds), over a dark glass.
    shine := glass_foil(p / Math.max(Math.min(foil.box.z, foil.box.w), 1), foil.turn.w)
    rim := Math.smoothstep(0 - Math.max(1.5, cell * 0.025), 0, d)
    backing := Math.smoothstep(0, 0.18 * cell, 0 - d)
    glass := Math.mix(V3⟨0.16, 0.17, 0.20⟩, shine * 1.15, 0.85 - 0.12 * backing)
    rgb := Math.mix(glass, V3⟨0.98, 0.80, 0.47⟩, rim * 0.70)
    alpha := coverage * (0.62 + 0.33 * backing + rim * 0.13)
    return V4⟨rgb.x, rgb.y, rgb.z, 1⟩ * alpha
}
Attack_Foil :: shader { vertex: Draw.quad_place; fragment: foil_shade }
ATTACK_FOIL :: Attack_Foil(Draw.SHADER_TARGET)

// A drag's arrow, from its damage icon to the life total it's aimed at (or
// to the finger, aimed at no one), and its amount on glass at the tip,
// facing whoever's dragging.
draw_drag :: (canvas: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, drag: Drag, foil_time: f32) {
    cell := cell_of(layout)
    seat := layout.seats[drag.from]
    if to, amount := aim(layout, game, drag.from, drag.finger, drag.kind) is not missed {
        tip := layout.seats[to].middle
        back := layout.seats[to].toward * -1.0
        draw_target_arrow(canvas, layout, game, drag, tip, back)
        text := if amount is { case damage: "«damage»"; case asked: "?" }
        glyph := attack_glyph(drag.kind)
        icon_width := Math.max(f32'fonts.attack.text_width(glyph), cell * 0.6)
        number_width := f32'fonts.output.text_width(text)
        gap := 0.16 * cell
        left := (0 - icon_width - gap - number_width) / 2
        half := V2⟨0 - left + 0.20 * cell, Math.max(f32'fonts.output.cap_height, f32'fonts.attack.cap_height) / 2 + 0.20 * cell⟩
        c := Math.cos(seat.angle)
        sn := Math.sin(seat.angle)
        pad := V2⟨Math.abs(c) * half.x + Math.abs(sn) * half.y, Math.abs(sn) * half.x + Math.abs(c) * half.y⟩ + V2⟨1, 1⟩
        // (beyond the arrow's tip, along the way it points: the box's
        // nearest edge a little past the tip, so it's not over the arrow)
        ahead := back * -1.0
        across := Math.abs(Math.dot(ahead, V2⟨c, sn⟩)) * half.x + Math.abs(Math.dot(ahead, V2⟨0 - sn, c⟩)) * half.y
        // (kept on the screen, its edges a little inside it)
        edge := pad + V2⟨0.1, 0.1⟩ * cell
        label := Math.clamp(tip + ahead * (across + 0.15 * cell), edge, layout.size - edge)
        *params: Foil_Params
        params.box = V4⟨label.x, label.y, half.x, half.y⟩
        params.turn = V4⟨c, sn, cell, foil_time⟩
        for mana, i: [3] Mana⟨.BLUE, .RED, .GREEN⟩ {
            hue := gold_hue(mana)
            params.hues[i] = V4⟨hue.r, hue.g, hue.b, 1⟩
        }
        canvas.draw_shader(label - pad, pad * 2, ATTACK_FOIL.code, ATTACK_FOIL.bindings.foil, params)
        style := Draw.Text_Style⟨outline: Draw.rgb(0x000000), outline_width: Math.max(1.5, 0.025 * cell)⟩
        symbol_at := placed(label, seat.angle, ⟨left + icon_width / 2, 0⟩)
        number_at := placed(label, seat.angle, ⟨left + icon_width + gap, f32'fonts.output.cap_height / 2⟩)
        draw_damage_symbol(canvas, fonts, symbol_at, seat.angle, cell, drag.kind, 1, style)
        canvas.draw_text(fonts.output, number_at, text, Draw.rgb(0xFFFFFF), style, seat.angle)
    }
    else {
        back := free_arrow_back(attack_icon(layout, game, drag.from, drag.kind), drag.finger, seat.toward)
        draw_target_arrow(canvas, layout, game, drag, drag.finger, back)
    }
}

// A pane of frosted glass behind the number grid: the table under it
// blurred (seven by seven samples, a gaussian, GLASS_BLUR cells apart),
// lifted a little toward a cool pale grey and darkened, a fine bright rim
// round it lit from the top left.
GLASS_BLUR :: 0.05
GLASS_PAD  :: 0.15

Glass_Params :: struct {
    box:   V4    // its middle and half size (pixels)
    style: V4    // its corners' radius, the blur's step (pixels), the scene's size
    turn:  V4    // the cosine and sine of its turn (as placed's), how much it shows (0 to 1), unused
    tint:  V4    // a colour it's tinted, and how much (0: clear)
}

// The foil the user pinned (DESIGN's ideas kept for later), the drag's
// damage label's glass: the place warped by stacked waves (each step a tan
// of y nudging x and a cos of x nudging y, finer and weaker each time, all
// moving with time), coloured in rainbow bands of the warped place that
// brighten where a cosine of the diagonal nears zero, so streaks of light
// sweep across as on a foil card. Softened from the original: each tan held
// to FOIL_TAN either way (its jumps, where it runs off to infinity, were
// sharp lines), and the streaks to 1 / FOIL_STREAK at their brightest. p is
// from the glass's middle, in its own frame, as a share of its shorter half.
// It swirls rather than drifting up and down: its waves push across as
// much as up and down (FOIL_SWIRL each), the two moving opposite ways, so
// they curl into eddies all over the glass, none about its middle.
FOIL_TAN :: 3.0
FOIL_STREAK :: 0.85
FOIL_SWIRL :: 0.45

glass_foil :: (p: V2, t: f32 -> V3) {
    *uv := p
    for i: 1 < 10 {
        step := f32'i
        uv.x += 0.009 / step * Math.clamp(Math.tan(step * 2.5 * uv.y + t), 0 - FOIL_TAN, FOIL_TAN)
        uv.x += FOIL_SWIRL / step * Math.sin(step * 1.5 * uv.y - t)
        uv.y += FOIL_SWIRL / step * Math.cos(step * 1.5 * uv.x + t)
    }
    bands := V3⟨0.5, 0.5, 0.5⟩ + Math.sin(V3⟨t + uv.x, t + uv.y + 2, t + uv.x + 4⟩) * 0.5
    return bands / Math.max(2.1 * Math.abs(Math.cos(t - uv.y - uv.x)), FOIL_STREAK)
}

glass_shade :: (from: Draw.Quad_Between, glass: Shader.Uniforms(Glass_Params), scene: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    // (into the pane's own frame)
    offset := from.pixel - glass.box.xy
    p := V2⟨offset.x * glass.turn.x + offset.y * glass.turn.y, offset.y * glass.turn.x - offset.x * glass.turn.y⟩
    d := round_box_distance(p, glass.box.zw, glass.style.x)
    if d > 1 then return ⟨0, 0, 0, 0⟩
    coverage := Math.clamp(0.5 - d, 0, 1)
    *sum := V3⟨0, 0, 0⟩
    *weights: f32 = 0
    for i: 0 < 7 {
        for j: 0 < 7 {
            x := f32'i - 3
            y := f32'j - 3
            w := Math.exp(0 - (x * x + y * y) / 8)
            at := from.pixel + V2⟨x, y⟩ * glass.style.y
            sum = sum + Shader.sample_level(scene, filtering, at / glass.style.zw, 0).xyz * w
            weights += w
        }
    }
    *rgb := Math.mix(sum / weights, V3⟨0.82, 0.85, 0.9⟩, 0.18) * 0.8
    rgb = Math.mix(rgb, glass.tint.xyz, glass.tint.w)
    // (the rim: brightest where it faces the light)
    rim := 1 - Math.smoothstep(0, 2.5, 0 - d)
    lit := Math.max(Math.dot(Math.normalize(p / glass.box.zw + V2⟨0.00001, 0⟩), PART_LIGHT), 0)
    rgb = rgb + V3⟨1, 1, 1⟩ * (rim * (0.1 + 0.3 * lit))
    colour = V4⟨rgb.x, rgb.y, rgb.z, 1⟩ * (coverage * glass.turn.z)
}

Glass :: shader { vertex: Draw.quad_place; fragment: glass_shade }
GLASS :: Glass(Draw.SHADER_TARGET)

// Which way Raza's drawn (the settings' choice, kept between runs): AUTO,
// as its window is (the display turning as the tablet's held); LANDSCAPE
// or PORTRAIT, the display asked to stay so (keep_orientation), and where
// it won't (Linux's desktops, or Windows refusing), the table drawn that
// way into a canvas of its own, then onto the window turned a quarter turn
// clockwise, the drawing's top left at the window's top right; and the
// fingers turned back.
Orientation :: enum u8 {
    AUTO
    LANDSCAPE
    PORTRAIT
}

// What Window's asked to keep the display to, for an orientation.
display_orientation :: (orientation: Orientation -> Window.Display_Orientation) #pure {
    return if orientation is {
        case .AUTO: .ANY
        case .LANDSCAPE: .LANDSCAPE
        case .PORTRAIT: .PORTRAIT
    }
}

// Whether the table's drawn the other way about from a window of a size,
// and turned onto it: kept landscape on a window taller than wide, or kept
// portrait on one wider than tall (never in AUTO).
turned_onto_window :: (orientation: Orientation, window: Wide.i32x2 -> bool) #pure {
    tall := window[1] > window[0]
    return if orientation is {
        case .AUTO: false
        case .LANDSCAPE: tall
        case .PORTRAIT: !tall and window[0] != window[1]
    }
}

Turn_Params :: struct { unused: V4 }
turn_shade :: (from: Draw.Quad_Between, turn: Shader.Uniforms(Turn_Params), drawing: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    colour = Shader.sample_level(drawing, filtering, V2⟨from.uv.y, 1 - from.uv.x⟩, 0)
    colour.w = 1
}
Turn :: shader { vertex: Draw.quad_place; fragment: turn_shade }
TURN :: Turn(Draw.SHADER_TARGET)

// A window's point in the table as it's drawn (turned: the drawing's turned
// onto the window), for a window window_width wide.
landscape_point :: (at: V2, turned: bool, window_width: f32 -> V2) #pure {
    return if turned then V2⟨at.y, window_width - at.x⟩ else at
}

// Whether the parts' surfaces are kept this frame (kept_surfaces.canvas,
// the table's bare, what an open drum's glass blurs).
surfaces_kept_now: bool

// The number grid's glass behind an open drum: its wheels and its change,
// GLASS_PAD round them, turned as its player's text, coming and going as
// the drum rounds and flattens. It blurs the parts' surfaces, kept (the
// drum's drawn into the table as it's made, so the table can't be what it
// blurs); without them, a plain dark pane.
draw_drum_glass :: (canvas: *Draw.Canvas, seat: Seat, fonts: Fonts, drum: Life_Drum, cell: f32) {
    shows := Math.clamp(drum.bend, 0, 1)
    if shows <= 0 then return
    shape := drum_shape(fonts, drum)
    cap := f32'fonts.life.cap_height
    pad := GLASS_PAD * cell
    left := shape.left - pad
    right := shape.change_at + shape.change_half + pad
    reach := DRUM_RADIUS * DRUM_PITCH * cap + pad
    middle := placed(seat.middle, seat.angle, V2⟨(left + right) / 2, 0⟩)
    *low := V2⟨1e30, 1e30⟩
    *high := V2⟨-1e30, -1e30⟩
    for corner: [4] V2⟨⟨left, 0 - reach⟩, ⟨right, 0 - reach⟩, ⟨left, reach⟩, ⟨right, reach⟩⟩ {
        at := placed(seat.middle, seat.angle, corner)
        low = Math.min(low, at)
        high = Math.max(high, at)
    }
    radius := 0.3 * cell
    if surfaces_kept_now {
        scene := kept_surfaces.canvas.size
        params := Glass_Params⟨V4⟨middle.x, middle.y, (right - left) / 2, reach⟩,
                                V4⟨radius, GLASS_BLUR * cell, f32'scene[0], f32'scene[1]⟩,
                                V4⟨Math.cos(seat.angle), Math.sin(seat.angle), shows, 0⟩, V4⟨0, 0, 0, 0⟩⟩
        canvas.draw_shader_canvas(low - V2⟨2, 2⟩, high - low + V2⟨4, 4⟩, GLASS.code, GLASS.bindings.glass, params, kept_surfaces.canvas,
                                  GLASS.bindings.scene, GLASS.bindings.filtering)
    }
    else {
        canvas.fill_rounded_rect(low, high - low, radius, Draw.rgba(0x14161A, 0.7 * shows))
    }
}

// The number grid, over the glass (scene: the table as it's drawn, blurred
// where it holds it; else a plain dark pane).
draw_picker :: (canvas: *Draw.Canvas, layout: Layout, fonts: Fonts, picker: Picker, game: Game, artifact: Draw.RGBA, scene: *Draw.Canvas,
                holds_table: bool) {
    cell := cell_of(layout)
    origin, angle, pitch := picker_frame(layout, picker)
    // The glass: the grid's keys, and GLASS_PAD round them.
    pad := GLASS_PAD * cell
    tall := f32'PICK_ROWS * pitch
    draw_pane(canvas, origin, angle, V2⟨0, 0 - tall / 2⟩, V2⟨f32'PICK_COLUMNS / 2 * pitch + pad, tall / 2 + pad⟩, 0.3 * cell, V4⟨0, 0, 0, 0⟩,
              scene, holds_table, cell)
    // Each key's number straight over the table: white (the tens and units
    // chosen green), outlined in black, with a drop shadow down and to the
    // right, as the life totals have.
    cap := f32'fonts.output.cap_height
    style := Draw.Text_Style⟨outline: Draw.rgb(0x000000), outline_width: Math.max(1.5, cell * 0.03),
                              shadow: Draw.rgba(0x000000, 0.65), shadow_offset: V2⟨0.1, 0.14⟩ * cap, shadow_soft: 0.07 * cap⟩
    for row: 0 < PICK_ROWS {
        for column: 0 < PICK_COLUMNS {
            *label := ""
            *colour := Draw.rgb(0xFFFFFF)
            if pick_key(row, column) is {
            case tens:
                label = if tens == 0 then "00" else "«tens»"
                if tens == picker.tens then colour = PICK_CHOSEN
            case units:
                label = "«units»"
                if units == picker.units then colour = PICK_CHOSEN
            case accept, cancel, outside: _
            }
            width := f32'fonts.output.text_width(label)
            middle := pick_key_middle(row, column, pitch)
            canvas.draw_text(fonts.output, placed(origin, angle, middle + V2⟨0 - width / 2, cap / 2⟩), label, colour, style, angle)
        }
    }
    // The cross and the tick: glass buttons below the keys' pane, tinted red
    // and green, the cross's a cross and the tick's the attack it makes (its
    // damage icon's symbol).
    icon_style := Draw.Text_Style⟨outline: Draw.rgb(0x000000), outline_width: Math.max(1.5, cell * 0.025),
                                   shadow: Draw.rgba(0x000000, 0.55), shadow_offset: V2⟨0.04, 0.055⟩ * cell, shadow_soft: 0.04 * cell⟩
    for tick: [2] bool⟨false, true⟩ {
        middle, half := picker_button(layout, tick)
        tint := if tick then PICK_TICK_TINT else PICK_CROSS_TINT
        draw_pane(canvas, origin, angle, middle, half, 0.2 * cell, tint, scene, holds_table, cell)
        at := placed(origin, angle, middle)
        if tick {
            draw_damage_symbol(canvas, fonts, at, angle, cell, picker.kind, 1, icon_style)
        }
        else {
            draw_outlined_icon(canvas, layout, CROSS_ICON, at, angle, style.shadow_offset, 1)
        }
    }
}

// A pane of the number grid's glass, in a frame (origin, angle): its middle
// and half size there, its corners' radius, tinted (a colour, and how
// much). It blurs scene where it holds the table, else it's a plain dark
// pane of the tint.
draw_pane :: (canvas: *Draw.Canvas, origin: V2, angle: f32, middle: V2, half: V2, radius: f32, tint: V4, scene: *Draw.Canvas, holds_table: bool,
              cell: f32, shows: f32 = 1) {
    *low := V2⟨1e30, 1e30⟩
    *high := V2⟨-1e30, -1e30⟩
    for corner: [4] V2⟨⟨0 - half.x, 0 - half.y⟩, ⟨half.x, 0 - half.y⟩, ⟨0 - half.x, half.y⟩, ⟨half.x, half.y⟩⟩ {
        at := placed(origin, angle, middle + corner)
        low = Math.min(low, at)
        high = Math.max(high, at)
    }
    centre := placed(origin, angle, middle)
    if holds_table {
        params := Glass_Params⟨V4⟨centre.x, centre.y, half.x, half.y⟩,
                                V4⟨radius, GLASS_BLUR * cell, f32'scene.size[0], f32'scene.size[1]⟩,
                                V4⟨Math.cos(angle), Math.sin(angle), shows, 0⟩, tint⟩
        canvas.draw_shader_canvas(low - V2⟨2, 2⟩, high - low + V2⟨4, 4⟩, GLASS.code, GLASS.bindings.glass, params, scene, GLASS.bindings.scene,
                                  GLASS.bindings.filtering)
    }
    else {
        plain := Math.mix(V3⟨0.078, 0.086, 0.102⟩, tint.xyz, tint.w)
        canvas.fill_rounded_rect(low, high - low, radius, Draw.RGBA⟨plain.x, plain.y, plain.z, 0.7 * shows⟩)
    }
}

// A cross and a tick on glass buttons (their half size), turned (radians
// clockwise, as what they answer is): white, outlined in black, with a drop
// shadow (offset), all as shown (0 to 1).
draw_tick_and_cross :: (canvas: *Draw.Canvas, layout: Layout, angle: f32, cross: V2, tick: V2, half: V2, shadow: V2, shows: f32) {
    cell := cell_of(layout)
    draw_pane(canvas, cross, angle, ⟨0, 0⟩, half, 0.2 * cell, PICK_CROSS_TINT, kept_surfaces.canvas, surfaces_kept_now, cell, shows)
    draw_pane(canvas, tick, angle, ⟨0, 0⟩, half, 0.2 * cell, PICK_TICK_TINT, kept_surfaces.canvas, surfaces_kept_now, cell, shows)
    draw_outlined_icon(canvas, layout, CROSS_ICON, cross, angle, shadow, shows)
    draw_outlined_icon(canvas, layout, TICK_ICON, tick, angle, shadow, shows)
}

// An icon at the damage icons' size, turned: white, outlined in black, with
// a drop shadow (offset), all as shown (0 to 1).
draw_outlined_icon :: (canvas: *Draw.Canvas, layout: Layout, drawn: Icons.Icon, at: V2, angle: f32, shadow: V2, shows: f32) {
    cell := cell_of(layout)
    size := 0.7 * cell
    draw_icon_at(canvas, drawn, at + shadow, size, Draw.rgba(0x000000, 0.65 * shows), angle)
    ring := Math.max(1.5, cell * 0.03)
    for step: 0 < 8 {
        a := f32'step * f32'Math.TAU / 8
        draw_icon_at(canvas, drawn, at + V2⟨Math.cos(a), Math.sin(a)⟩ * ring, size, Draw.rgba(0x000000, shows), angle)
    }
    draw_icon_at(canvas, drawn, at, size, Draw.rgba(0xFFFFFF, shows), angle)
}

// A ring of people, a count of them, round a point, in a button a cell
// across, placed as that count's parts are: two side by side; an odd count's
// one at the bottom (three's and five's lone part is the bottom's), the
// others' one at the top.
draw_people :: (canvas: *Draw.Canvas, centre: V2, count: i64, cell: f32, colour: Draw.RGBA) {
    ring := if count == 2 then 0.15 * cell else 0.24 * cell
    start := if count == 2 then f32'Math.PI else if count % 2 == 1 then f32'Math.PI / 2 else -f32'Math.PI / 2
    for i: 0 < count {
        a := start + f32'Math.TAU * f32'i / f32'count
        draw_icon_at(canvas, PERSON_ICON, centre + V2⟨Math.cos(a), Math.sin(a)⟩ * ring, 0.26 * cell, colour)
    }
}

draw_capsule :: (canvas: *Draw.Canvas, layout: Layout, game: Game, screen: Screen_State) {
    cell := cell_of(layout)
    // (its buttons the same whether the settings are open or not: they open
    // beside it, in the table's seam)
    draw_recess(canvas, layout, 0)
    // The system's button, the power icon; undo and redo (each dim with
    // nothing to undo or redo), and a new game. (The players' button is the
    // count slider, seen through its hole in the table.)
    draw_icon_at(canvas, SYSTEM_ICON, capsule_centre(layout, .SYSTEM), 0.62 * cell, lighter(CAPSULE, 0.75))
    undo_ink := if screen.can_undo then INK else lighter(CAPSULE, 0.25)
    draw_icon_at(canvas, UNDO_ICON, capsule_centre(layout, .UNDO), 0.62 * cell, undo_ink)
    redo_ink := if screen.can_redo then INK else lighter(CAPSULE, 0.25)
    draw_icon_at(canvas, REDO_ICON, capsule_centre(layout, .REDO), 0.62 * cell, redo_ink)
    draw_icon_at(canvas, RESTART_ICON, capsule_centre(layout, .RESTART), 0.62 * cell, lighter(CAPSULE, 0.75))
}

// The motion's button's icon, as the motion is: pause, or play's triangles
// (one slow, two medium, three fast).
draw_motion :: (canvas: *Draw.Canvas, at: V2, motion: Motion, size: f32, ink: Draw.RGBA) {
    if motion is {
        case .OFF: draw_icon_at(canvas, PAUSE_ICON, at, size, ink)
        case .SLOW: draw_play(canvas, at, 1, size, ink)
        case .MEDIUM: draw_play(canvas, at, 2, size, ink)
        case .FAST: draw_play(canvas, at, 3, size, ink)
    }
}

// A colour, a share as opaque.
faded :: (colour: Draw.RGBA, share: f32 -> Draw.RGBA) #pure {
    return ⟨colour.r, colour.g, colour.b, colour.a * share⟩
}

// The full metal slider is always beneath the table, seen through its opening.
// Its selected engraving stays readable throughout the opening transition.
draw_counts :: (canvas: *Draw.Canvas, layout: Layout, screen: Screen_State, game: Game) {
    cell := cell_of(layout)
    shows: f32 = 1
    opened := Math.clamp(screen.counts_shown, 0, 1)
    shown := if opened > 0 then screen.counts.shown else f32'game.players
    middle := (count_place(layout, shown, 2) + count_place(layout, shown, MAX_PLAYERS)) / 2
    half := V2⟨BAR_WIDTH, BAR_HALF⟩ * cell
    // A close contact shadow lifts the slider above the steel and narrow guide groove.
    canvas.fill_rounded_rect(middle - half + V2⟨0.025 * cell, 0.045 * cell⟩, half * 2, half.x, Draw.rgba(0x000000, 0.38 * shows))
    draw_metal_bar(canvas, middle, half, shows)
    for count: 2 <= MAX_PLAYERS {
        away := Math.abs(f32'count - shown)
        selected := 1 - Math.smoothstep(0, 0.65, away)
        position := count_place(layout, shown, count)
        strength := (0.56 + selected * 0.4) * shows
        // A shallow engraved highlight beneath the dark cut.
        draw_people(canvas, position + V2⟨0, 0.015 * cell⟩, count, cell * (0.90 + selected * 0.10), Draw.rgba(0xFFF1D8, strength * 0.33))
        draw_people(canvas, position, count, cell * (0.90 + selected * 0.10), Draw.rgba(0x171C22, strength))
    }

}

// The count bar's half width, in cells: a little inside the runner's.
BAR_WIDTH :: 0.5

Metal_Bar_Params :: struct {
    box:  V4      // its middle, and its half width and half length (pixels)
    more: V4      // how much it shows, then unused
}

// A softly domed bronze bar, sharing the circular button's finish. Its surface turns from
// facing out along its middle to facing sideways at its edges (and its
// ends), reflecting a bright band from the light at the top left and a
// softer one from the other side, brushed along its length, darker toward
// its edges; laid over what's under it (its colour premultiplied).
metal_bar_shade :: (from: Draw.Quad_Between, bar: Shader.Uniforms(Metal_Bar_Params) -> colour: V4) {
    p := from.pixel - bar.box.xy
    radius := bar.box.z
    d := round_box_distance(p, bar.box.zw, radius)
    if d > 1 then return ⟨0, 0, 0, 0⟩
    coverage := Math.clamp(0.5 - d, 0, 1) * bar.more.x
    // (the way out of it, and how far toward its edge: 0 on its spine, 1 at its edge)
    gx := round_box_distance(p + V2⟨0.5, 0⟩, bar.box.zw, radius) - round_box_distance(p - V2⟨0.5, 0⟩, bar.box.zw, radius)
    gy := round_box_distance(p + V2⟨0, 0.5⟩, bar.box.zw, radius) - round_box_distance(p - V2⟨0, 0.5⟩, bar.box.zw, radius)
    outward := Math.normalize(V2⟨gx, gy⟩ + V2⟨0.00001, 0⟩)
    edge := Math.clamp(1 + d / Math.max(radius, 1), 0, 1)
    tilt := p / bar.box.zw * 0.65 + outward * edge * 0.35
    up := Math.sqrt(Math.max(1 - Math.dot(tilt, tilt), 0))
    // (what it reflects: a view from straight above turned by its surface)
    reflected := tilt * (2 * up)
    key := Math.exp(0 - Math.pow(Math.dot(reflected, PART_LIGHT) - 0.55, 2) * 18)
    fill := Math.exp(0 - Math.pow(Math.dot(reflected, PART_LIGHT * -1.0) - 0.7, 2) * 10)
    brushed := Patterns.noise(V2⟨p.x * 2.3, p.y * 0.15⟩ + V2⟨3.1, 0⟩)
    bronze := V3⟨0.58, 0.44, 0.30⟩ * (0.94 + 0.045 * brushed) * (1 - 0.45 * edge * edge)
    rgb := bronze + V3⟨1, 0.87, 0.65⟩ * (key * 0.30) + V3⟨0.75, 0.62, 0.46⟩ * (fill * 0.14)
    colour = V4⟨rgb.x, rgb.y, rgb.z, 1⟩ * coverage
}

Metal_Bar :: shader { vertex: Draw.quad_place; fragment: metal_bar_shade }
METAL_BAR :: Metal_Bar(Draw.SHADER_TARGET)

// The count bar drawn about a middle, half a size each way, showing a share.
draw_metal_bar :: (canvas: *Draw.Canvas, middle: V2, half: V2, shows: f32) {
    canvas.draw_shader(middle - half - V2⟨2, 2⟩, half * 2 + V2⟨4, 4⟩, METAL_BAR.code, METAL_BAR.bindings.bar, Metal_Bar_Params⟨V4⟨middle.x, middle.y, half.x, half.y⟩, V4⟨shows, 0, 0, 0⟩⟩)
}

// What's happening on the screen besides the game: what's being dragged,
// and what's open.
Screen_State :: struct {
    tax_slides: [MAX_PLAYERS] Tax_Slide
    tax_ready_at: [MAX_PLAYERS] f64 // real-time debounce, independent of animation speed
    drags:         [MAX_PLAYERS] Drag   // each player's drag
    pickers:       [MAX_PLAYERS] Picker   // each player's number grid (pickers[k].from is k)
    counts:        Count_Picker
    moving_end:    i64 = -1      // the line whose end is being dragged along the edge
    line_finger:   V2            // ...and where its finger is
    turning:       bool          // ...and a second finger's on a line: every line turns together
    can_undo:      bool
    can_redo:      bool
    orientation:   Orientation   // which way it's drawn (the settings' choice)
    previewing:    bool          // the lines are another count's, or moving to one
    settings_open: bool
    settings_shown: f32          // how far the settings have come into the pill, 0 to 1
    counts_shown:  f32           // how far it's become the count column's groove, 0 to 1
    count_ui_visible: f32 = 1    // returns only after the table reconnects
    toggles:       Toggles       // each player's colour toggles: open or folded into the five-colour icon
    options:       Toggles = FOLDED_TOGGLES   // each player's options: open or folded into the options button
    history_changes: [MAX_PLAYERS] Life_Drum
    drums:         [MAX_PLAYERS] Life_Drum   // each player's life total, turned as a drum once touched
    keep_surfaces: bool          // the parts' surfaces kept between frames (keep_surfaces'); snapshots draw each
    motion:        Motion        // how fast their surfaces move
    brightness:    f32 = 1       // how bright everything's drawn (MIN_BRIGHTNESS to 1)
    foil_phase: f32
    foil_time:  f32           // seconds, for the drag's damage label's foil (wrapping round, a while on)
    surface_time:  f32           // how far they've moved, in features
    fps:           f32           // frames a second, over the last half second (0: none yet, not shown)
    show_fps:      bool = #program.mode == .DEBUG   // shown: a debug build's from the start, a release build's not; F12 toggles
}

// How often the frames a second shown are worked out again, in seconds.
FPS_WINDOW :: 0.5

// The frames a second when nothing's being touched (the surfaces still
// move): a frame's work, then a wait for input for the rest.
IDLE_FPS :: 60.0

// The frames a second, top right, on a chip of the capsule's colour, upright
// to the screen.
draw_fps :: (canvas: *Draw.Canvas, layout: Layout, fonts: Fonts, fps: f32) {
    if fps <= 0 then return
    cell := cell_of(layout)
    text := "«i64'Math.round(fps)» fps"
    width := f32'fonts.label.text_width(text)
    height := f32'fonts.label.cap_height
    pad := 0.18 * cell
    size := V2⟨width + 2 * pad, height + 2 * pad⟩
    at := V2⟨layout.size.x - 0.25 * cell - size.x, 0.25 * cell⟩
    canvas.fill_rounded_rect(at, size, 0.2 * size.y, CAPSULE)
    draw_centred(canvas, fonts.label, at + size / 2, 0, text, INK)
}

////////////////////////////////
// Settings: the system's button splits the table along its horizontal
// seam (draw_settings_split), the pill staying as it is, and in the channel
// that opens are pause, slow, medium and fast (fast a place left of undo),
// and Reset, a place right of the
// system's button (every count's lines back where they start, each seat its
// starting colours, the motion slow), and Quit, a place right of Reset.
// Anywhere else, the system's button too, closes the table.

// The seconds the table takes to split (or close).
SETTINGS_TIME :: 0.16

PAUSE_ICON :: icon(Mdi.PAUSE)
RESET_ICON :: icon(Mdi.BACKUP_RESTORE)
// (the orientation's: auto's a screen turning; kept, a tablet, upright for
// portrait)
AUTO_TURN_ICON :: icon(Mdi.SCREEN_ROTATION)
TABLET_ICON    :: icon(Mdi.TABLET)

Settings_Part :: union {
    animation: Motion   // a directly selected animation speed
    brightness: f32     // the brightness slider, at the brightness where it's touched
    orientation         // the orientation's button: on to the next
    reset
    quit
    close               // anywhere else
}

// The orientation the button goes to from one: auto, kept landscape, kept
// portrait, and round to auto again.
next_orientation :: (orientation: Orientation -> Orientation) #pure {
    return if orientation is {
        case .AUTO: .LANDSCAPE
        case .LANDSCAPE: .PORTRAIT
        case .PORTRAIT: .AUTO
    }
}

// The motion the button goes to from one: paused, slow, medium, fast, and
// round to paused again.
next_motion :: (motion: Motion -> Motion) #pure {
    return if motion is {
        case .OFF: .SLOW
        case .SLOW: .MEDIUM
        case .MEDIUM: .FAST
        case .FAST: .OFF
    }
}

in_box :: (p: V2, low: V2, high: V2 -> bool) #pure {
    return p.x >= low.x and p.x <= high.x and p.y >= low.y and p.y <= high.y
}

// Where each of the settings' buttons is, in places from the pill's middle
// (a place CAPSULE_PITCH cells): the motion left of undo; right of the
// system's button, Reset, then the orientation's, then the brightness
// slider, and Quit at the channel's far right.
ANIMATION_PLACE :: V2⟨-3, 0⟩
animation_place :: (motion: Motion -> V2) #pure {
    return ANIMATION_PLACE + V2⟨(f32'i32'motion - 3) * 0.7, 0⟩
}
RESET_PLACE       :: V2⟨3, 0⟩
ORIENTATION_PLACE :: V2⟨4, 0⟩
SETTINGS_BUTTON :: 0.46        // a settings button's radius, in cells

// Quit's place: at the channel's far right, its button QUIT_MARGIN places
// in from the screen's edge (and never over the orientation's).
QUIT_MARGIN :: 0.6
quit_place :: (layout: Layout -> V2) #pure {
    half := layout.size.x / 2 / (CAPSULE_PITCH * cell_of(layout))
    return V2⟨Math.max(half - QUIT_MARGIN, ORIENTATION_PLACE.x + 0.9), 0⟩
}

// The brightness: everything drawn dimmed toward black, from 1 (as drawn)
// down to MIN_BRIGHTNESS. Its slider is between the orientation's button
// and Quit, in places as theirs are, at most BRIGHTNESS_LONGEST places
// long; on a screen with no room there (portrait), it isn't shown (fits
// false).
MIN_BRIGHTNESS     :: 0.3
BRIGHTNESS_LONGEST :: 2.4
BRIGHTNESS_SUN     :: 0.3      // the room past either end of its travel, for its bar, in places
BRIGHTNESS_KNOB    :: V2⟨0.28, 0.28⟩   // its knob's half width and half height, in cells: a circle

brightness_track :: (layout: Layout -> from: f32, to: f32, fits: bool) #pure {
    from = ORIENTATION_PLACE.x + 0.4 + 0.1 + 2 * BRIGHTNESS_SUN
    to = Math.min(quit_place(layout).x - 0.4 - 0.1 - 2 * BRIGHTNESS_SUN, from + BRIGHTNESS_LONGEST)
    fits = to - from >= 1
}

// A sun: a disc of a radius and eight rays round it.
draw_sun :: (canvas: *Draw.Canvas, at: V2, radius: f32, colour: Draw.RGBA) {
    canvas.fill_circle(at, radius * 0.55, colour)
    for i: 0 < 8 {
        way := V2⟨Math.cos(f32'i * f32'Math.TAU / 8), Math.sin(f32'i * f32'Math.TAU / 8)⟩
        canvas.draw_line(at + way * radius * 0.8, at + way * radius * 1.25, radius * 0.22, colour)
    }
}

// The brightness at a place along its slider (x, in places).
brightness_at :: (layout: Layout, x: f32 -> f32) #pure {
    from, to, _ := brightness_track(layout)
    return Math.mix(MIN_BRIGHTNESS, 1, Math.clamp((x - from) / Math.max(to - from, 0.001), 0, 1))
}

settings_part_at :: (layout: Layout, p: V2 -> Settings_Part) #pure {
    local := (p - layout.centre) / (cell_of(layout) * CAPSULE_PITCH)
    on :: (q: V2, place: V2 -> bool) #pure {
        // (a button's half a place across, less a little)
        return Math.abs(q.x - place.x) <= 0.45 and Math.abs(q.y - place.y) <= 0.45
    }
    for choice: [4] Motion⟨.OFF, .SLOW, .MEDIUM, .FAST⟩ {
        place := animation_place(choice)
        if Math.abs(local.x - place.x) <= 0.32 and Math.abs(local.y - place.y) <= 0.38 then return Settings_Part.animation(choice)
    }
    from, to, fits := brightness_track(layout)
    if fits and Math.abs(local.y) <= 0.38 and local.x >= from - BRIGHTNESS_SUN and local.x <= to + BRIGHTNESS_SUN {
        return Settings_Part.brightness(brightness_at(layout, local.x))
    }
    if on(local, RESET_PLACE) then return Settings_Part.reset
    if on(local, ORIENTATION_PLACE) then return Settings_Part.orientation
    if on(local, quit_place(layout)) then return Settings_Part.quit
    return Settings_Part.close
}

// The settings' buttons in the channel, the motion's, Reset and Quit, each
// on a chip of the pill's floor, rimmed, shown a share; and the brightness
// slider left of the motion's, as the count runner is: a narrow
// bronze-lined groove in the steel, and a short domed bronze bar riding in
// it, a sun engraved on it.
draw_settings :: (canvas: *Draw.Canvas, layout: Layout, motion: Motion, shown: f32, brightness: f32 = 1, orientation := Orientation.AUTO) {
    cell := cell_of(layout)
    pitch := CAPSULE_PITCH * cell
    c := layout.centre
    size := 0.62 * cell
    ink := faded(INK, shown)
    from, to, fits := brightness_track(layout)
    if fits {
        low := c + V2⟨from * pitch, 0⟩
        high := c + V2⟨to * pitch, 0⟩
        knob := Math.mix(low, high, (brightness - MIN_BRIGHTNESS) / (1 - MIN_BRIGHTNESS))
        // (the groove, its ends where the bar's middle stops; the steel round
        // it drawn again with it, as the count bed's)
        middle := (low + high) / 2
        along := (high.x - low.x) / 2 + COUNT_GROOVE_RADIUS * cell
        bed := Count_Bed_Params⟨⟨middle.x, middle.y, along, COUNT_GROOVE_RADIUS * cell⟩, ⟨cell * 6, cell * 0.018, 0, 0⟩⟩
        reach := V2⟨along, COUNT_GROOVE_RADIUS * cell⟩ + V2⟨0.1, 0.1⟩ * cell
        canvas.draw_shader_image(middle - reach, reach * 2, COUNT_BED.code, COUNT_BED.bindings.bed, bed, under_table_image,
                                 COUNT_BED.bindings.steel, COUNT_BED.bindings.filtering)
        // (the bar: a close contact shadow under it, then it, then its sun,
        // in ivory with a faint shadow for contrast)
        half := V2⟨BRIGHTNESS_KNOB.x, BRIGHTNESS_KNOB.y⟩ * cell
        canvas.fill_rounded_rect(knob - half + V2⟨0.025, 0.045⟩ * cell, half * 2, half.x, Draw.rgba(0x000000, 0.38 * shown))
        draw_metal_bar(canvas, knob, half, shown)
        draw_sun(canvas, knob + V2⟨0, 0.015 * cell⟩, 0.12 * cell, Draw.rgba(0x171C22, 0.45 * shown))
        draw_sun(canvas, knob, 0.12 * cell, Draw.rgba(0xFFF1D8, shown))
    }
    quit := quit_place(layout)
    for place: [3] V2⟨RESET_PLACE, ORIENTATION_PLACE, quit⟩ {
        canvas.fill_circle(c + place * pitch + V2⟨0.03, 0.05⟩ * cell, SETTINGS_BUTTON * cell, Draw.rgba(0x000000, 0.4 * shown))
        face := if place == quit then Math.mix(CAPSULE, Draw.rgb(0x913935), 0.22) else CAPSULE
        canvas.fill_circle(c + place * pitch, SETTINGS_BUTTON * cell, faded(lighter(face, 0.18), shown))
        canvas.fill_circle(c + place * pitch, (SETTINGS_BUTTON - 0.04) * cell, faded(face, shown))
    }
    turning := c + ORIENTATION_PLACE * pitch
    if orientation is {
    case .AUTO: draw_icon_at(canvas, AUTO_TURN_ICON, turning, size, ink)
    case .LANDSCAPE: draw_icon_at(canvas, TABLET_ICON, turning, size, ink)
    case .PORTRAIT: draw_icon_at(canvas, TABLET_ICON, turning, size, ink, f32'Math.TAU / 4)
    }
    for choice: [4] Motion⟨.OFF, .SLOW, .MEDIUM, .FAST⟩ {
        at := c + animation_place(choice) * pitch
        selected := choice == motion
        rim := if selected then Draw.rgb(0xBA925A) else lighter(CAPSULE, 0.18)
        strength: f32 = if selected then 1 else 0.45
        canvas.fill_circle(at + V2⟨0.03, 0.05⟩ * cell, 0.38 * cell, Draw.rgba(0x000000, 0.4 * shown))
        canvas.fill_circle(at, 0.38 * cell, faded(rim, shown))
        canvas.fill_circle(at, 0.34 * cell, faded(CAPSULE, shown))
        draw_motion(canvas, at, choice, 0.55 * cell, faded(INK, shown * strength))
    }
    draw_icon_at(canvas, RESET_ICON, c + RESET_PLACE * pitch, size, ink)
    draw_icon_at(canvas, QUIT_ICON, c + quit * pitch, size, ink)
}

// A speed's icon, play's triangles (one for slow, two, fast-forward's, for
// medium, three for fast), a count of them in a row centred on a point, an
// icon's size: each triangle as fast-forward's (mdi's: 8.5 of its 24 wide,
// 12 high, each against the next).
draw_play :: (canvas: *Draw.Canvas, middle: V2, count: i64, size: f32, colour: Draw.RGBA) {
    width := size * 8.5 / 24
    height := size * 12 / 24
    // Right-facing triangles carry their area one sixth of a width left of the box centre.
    *left := middle.x - width * f32'count / 2 + width / 6
    for _: 0 < count {
        points := [3] V2⟨⟨left, middle.y - height / 2⟩, ⟨left + width, middle.y⟩, ⟨left, middle.y + height / 2⟩⟩
        canvas.fill_polygon(points[:], colour)
        left += width
    }
}

// A continuous line-distance field: no overlapping segment caps at the touch point.
Channel_Touch_Params :: struct {
    ends: V4
    finger: V4              // position, cell size, line half width
}
channel_touch_shade :: (from: Draw.Quad_Between, touch: Shader.Uniforms(Channel_Touch_Params) -> colour: V4) {
    edge := touch.ends.zw - touch.ends.xy
    along := Math.clamp(Math.dot(from.pixel - touch.ends.xy, edge) / Math.max(Math.dot(edge, edge), 0.0001), 0, 1)
    distance := Math.length(from.pixel - touch.ends.xy - edge * along)
    coverage := Math.clamp(touch.finger.w + 0.5 - distance, 0, 1)
    offset := (from.pixel - touch.finger.xy) / touch.finger.z
    glow := Math.exp(0 - Math.dot(offset, offset) / 0.72)
    alpha := coverage * glow * 0.85
    return V4⟨0.91, 0.718, 0.424, 1⟩ * alpha
}
Channel_Touch :: shader { vertex: Draw.quad_place; fragment: channel_touch_shade }
CHANNEL_TOUCH :: Channel_Touch(Draw.SHADER_TARGET)

draw_player_ui :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, screen: Screen_State,
                   volleys: Volleys, targeted: i64) {
    cell := cell_of(layout)
    for k: 0 < layout.count {
        // (the life jolted as bolts land, but not turned: text at a new angle
        // is new glyphs, outlines and shadows, made and kept, every frame of a
        // recoil, which filled the glyph atlas over and over; moved, it's the
        // same glyphs)
        recoil, _ := life_recoil(volleys, k, cell)
        draw_seat(canvas, layer, layout, game, fonts, k, targeted, screen.surface_time, screen.drums[k], true, recoil, 0, poison_hit_bump(volleys, k), screen.tax_slides[k])
        history := screen.history_changes[k]
        shows := change_showing(history, k)
        if shows > 0 and !drum_showing(screen.drums[k], k) {
            width := f32'fonts.life.text_width("«game.life[k]»")
            draw_change(canvas, layout.seats[k], fonts, history, Draw.rgb(0xFFFFFF), shows, width)
        }
    }
    // The surfaces form the grooves; a thin light marks the one being moved.
    for end, k: layout.ends[:layout.count] {
        if k == screen.moving_end {
            radius := cell * 2.5
            params := Channel_Touch_Params⟨⟨layout.centre.x, layout.centre.y, end.x, end.y⟩,
                                           ⟨screen.line_finger.x, screen.line_finger.y, cell, Math.max(cell * 0.0125, 0.5)⟩⟩
            canvas.draw_shader(screen.line_finger - V2⟨radius, radius⟩, V2⟨radius * 2, radius * 2⟩,
                               CHANNEL_TOUCH.code, CHANNEL_TOUCH.bindings.touch, params)
        }
    }
    // The damage icons (the dragger's hidden while their number grid's
    // open), then the volleys and the points they take.
    draw_damage_icons(canvas, layout, game, screen, fonts)
    // (an open drum's tick and cross, coming in as its damage icons go)
    for drum, k: screen.drums {
        if k >= layout.count or screen.pickers[k].open or !drum_showing(drum, k) then continue
        shows := 1 - player_controls_visibility(drum, k)
        cross, tick, half := drum_buttons(layout, fonts, drum, k)
        if shows > 0 then draw_tick_and_cross(canvas, layout, layout.seats[k].angle, cross, tick, half, V2⟨0.1, 0.14⟩ * f32'fonts.output.cap_height, shows)
    }
    draw_elements(canvas, layer, layout, game, fonts, volleys)
    draw_bolt_losses(canvas, layout, fonts, volleys)
}

draw_table :: (canvas: *Draw.Canvas, layer: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, screen: Screen_State,
         volleys: Volleys = ⟨⟩, with_pill := true) {
    cell := cell_of(layout)
    targeted := first_aimed(layout, game, screen)
    // (the surfaces kept, a part's drawn again a frame, covering the whole
    // screen; or each drawn here, on the background)
    kept := screen.keep_surfaces and keep_surfaces(layout, game, targeted, screen.surface_time)
    surfaces_kept_now = kept
    if kept then canvas.draw_canvas(kept_surfaces.canvas, ⟨0, 0⟩) else canvas.clear(BACKGROUND)
    if !kept {
        for k: 0 < layout.count { draw_surface(canvas, layout, game, k, targeted, screen.surface_time) }
    }
    visible := Math.min(screen.count_ui_visible, count_player_visibility(Math.max(screen.counts_shown, screen.settings_shown)))
    if visible >= 1 {
        draw_player_ui(canvas, layer, layout, game, fonts, screen, volleys, targeted)
    }
    else if visible > 0 and prepare_player_ui(canvas.size) {
        // Blend a complete UI frame over the identical bare surfaces; clear is opaque.
        player_ui_canvas.draw_canvas(canvas, ⟨0, 0⟩)
        draw_player_ui(player_ui_canvas, layer, layout, game, fonts, screen, volleys, targeted)
        fade := Player_Fade_Params⟨⟨layout.size.x, layout.size.y, visible, 0⟩⟩
        canvas.draw_shader_canvas(⟨0, 0⟩, layout.size, PLAYER_FADE.code, PLAYER_FADE.bindings.fade, fade,
                                  player_ui_canvas, PLAYER_FADE.bindings.content, PLAYER_FADE.bindings.filtering)
    }
    // (the pill, unless it's drawn apart, lying over the table split)
    if with_pill then draw_capsule(canvas, layout, game, screen)
}

////////////////////////////////
// Snapshots: what each count of players looks like, without a window

// A game of a count of players part way through: some commander damage
// (one of it lethal, with six), and the drag and the grid to show.
sample_game :: (players: i64 -> game: Game) {
    game = new_game(players)
    game.deal(1, 0, 7)
    game.deal(2, 0, 3)
    game.deal(0, 1, 12)
    if players >= 3 then game.deal(1, 2, 5)
    if players >= 6 then game.deal(3, 5, 21)
    // Colours: blue and red, green alone, white, black and green.
    game.identity[0] = (u8'1 << u8'Mana.BLUE) | (u8'1 << u8'Mana.RED)
    game.identity[1] = u8'1 << u8'Mana.GREEN
    if players >= 3 then game.identity[2] = (u8'1 << u8'Mana.WHITE) | (u8'1 << u8'Mana.BLACK) | (u8'1 << u8'Mana.GREEN)
}

// Each count of players drawn as a tablet in landscape (and two in
// portrait too), a drag from the second player's icon half way into the
// first's part, into folder as raza_2.png and the like; and the number
// grid, facing the second, as raza_grid.png.
save_attack_frames :: (folder: string) [failed: string] {
    with scratch.rewind()
    `scratch {
    size := Wide.i32x2⟨960, 640⟩
    *canvas: Draw.Canvas
    if c := Draw.create_canvas(size) { canvas = c } else if os_error { fail: failed = "no canvas: " }
    defer canvas.destroy()
    *layer: Draw.Canvas
    if l := Draw.create_canvas(size) { layer = l } else if os_error { fail: failed = "no layer: " }
    defer layer.destroy()
    layout := lay_out(⟨960, 640⟩, equal_splits(4, ⟨960, 640⟩))
    *fonts: Fonts
    if fonts.reload_fonts(TEXT_FAMILY, layout) is os_error then fail: failed = "no fonts: "
    *game := new_game(4)
    game.identity[1] = mono(.RED)
    game.identity[2] = mono(.BLUE) | mono(.GREEN)
    *volleys: Volleys
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    strike(game, volleys, layout, pending, 1, 0, 12)
    for frame: 0 < 72 {
        if frame == 12 then strike(game, volleys, layout, pending, 2, 0, 5, .DAMAGE)
        draw(canvas, layer, layout, shown_game(game, pending, volleys), fonts, ⟨surface_time: 2⟩, volleys)
        path := `scratch "«folder»/frame_«frame».png"
        if canvas.save_png(path) is os_error then fail: failed = "can't write frame: "
        steer_volleys(volleys, pending, 1.0 / 24)
    }
    }
}

save_snapshots :: (folder: string) [failed: string] {
    sizes := [8] Wide.i32x2⟨⟨1440, 2160⟩, ⟨1440, 2160⟩, ⟨1440, 2160⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩⟩
    counts := [8] i64⟨2, 4, 6, 2, 3, 4, 5, 6⟩
    names := [8] string⟨"raza_2_portrait", "raza_4_portrait", "raza_6_portrait", "raza_2", "raza_3", "raza_4", "raza_5", "raza_6"⟩
    for size, i: sizes {
        *canvas: Draw.Canvas
        if c := Draw.create_canvas(size) { canvas = c } else if os_error { fail: failed = "no canvas: «os_error»" }
        defer canvas.destroy()
        *layer: Draw.Canvas
        if l := Draw.create_canvas(size) { layer = l } else if os_error { fail: failed = "no layer: «os_error»" }
        defer layer.destroy()
        game := sample_game(counts[i])
        screen_size := V2⟨f32'size[0], f32'size[1]⟩
        layout := lay_out(screen_size, equal_splits(game.players, screen_size))
        *fonts: Fonts
        if fonts.reload_fonts(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"
        // Half way from where the line comes into the first's part to its
        // far edge.
        target := layout.seats[0]
        entry := entry_point(layout.seats[1].icon, target.middle, target.outline[:target.count])
        inner := Math.dot(entry - layout.centre, target.toward)
        finger := entry + target.toward * (target.reach - inner) * 0.5
        // (the second's arrow to the finger)
        *dragged: Screen_State = ⟨can_undo: true, fps: 60, foil_time: 3.7⟩
        dragged.drags[1] = ⟨active: true, from: 1, finger: finger⟩
        draw(canvas, layer, layout, game, fonts, dragged)
        path := `scratch "«folder»/«names[i]».png"
        if canvas.save_png(path) is os_error then fail: failed = "can't write «path»: «os_error»"
        if counts[i] == 5 and size[0] > size[1] {
            // (the number grid of a slanted seat's player, as raza_grid_5.png)
            *slanted: Screen_State = ⟨can_undo: true⟩
            slanted.pickers[1] = ⟨open: true, from: 1, to: 0⟩
            draw(canvas, layer, layout, game, fonts, slanted)
            slanted_path := `scratch "«folder»/raza_grid_5.png"
            if canvas.save_png(slanted_path) is os_error then fail: failed = "can't write «slanted_path»: «os_error»"
        }
        if counts[i] == 4 and size[0] > size[1] {
            // (as a window taller than wide shows it: the landscape drawing
            // turned onto it a quarter turn clockwise, as raza_turned.png)
            *upright: Draw.Canvas
            if u := Draw.create_canvas(Wide.i32x2⟨size[1], size[0]⟩) { upright = u } else if os_error { fail: failed = "no turned canvas: «os_error»" }
            defer upright.destroy()
            upright.draw_shader_canvas(V2⟨0, 0⟩, V2⟨f32'size[1], f32'size[0]⟩, TURN.code, TURN.bindings.turn, Turn_Params⟨⟩, canvas,
                                       TURN.bindings.drawing, TURN.bindings.filtering)
            turned_path := `scratch "«folder»/raza_turned.png"
            if upright.save_png(turned_path) is os_error then fail: failed = "can't write «turned_path»: «os_error»"
            // A volley of 12 from the second to the first, in flight, then landing.
            for age, a: [2] f32⟨0.35, 0.72⟩ {
                volleys := settled_volleys(layout, game, 1, 0, 12, age)
                *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
                for v: volleys.list { pending[v.to][v.from] += v.amount - v.landed }
                *dealt := game
                dealt.deal(1, 0, 12)
                draw(canvas, layer, layout, shown_game(dealt, pending, volleys), fonts, ⟨can_undo: true⟩, volleys)
                volley_path := `scratch "«folder»/raza_volley_«a».png"
                if canvas.save_png(volley_path) is os_error then fail: failed = "can't write «volley_path»: «os_error»"
            }
            // A volley of 12 from the third (white, black and green: its dots
            // in those three colours) to the first, in flight, then landing.
            for age, a: [3] f32⟨0.36, 0.62, 0.92⟩ {
                volleys := settled_volleys(layout, game, 2, 0, 12, age)
                *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
                for v: volleys.list { pending[v.to][v.from] += v.amount - v.landed }
                *dealt := game
                dealt.deal(2, 0, 12)
                draw(canvas, layer, layout, shown_game(dealt, pending, volleys), fonts, ⟨can_undo: true⟩, volleys)
                black_path := `scratch "«folder»/raza_black_«a».png"
                if canvas.save_png(black_path) is os_error then fail: failed = "can't write «black_path»: «os_error»"
            }
            *gridded: Screen_State = ⟨can_undo: true⟩
            gridded.pickers[1] = ⟨open: true, from: 1, to: 0⟩
            draw(canvas, layer, layout, game, fonts, gridded)
            grid_path := `scratch "«folder»/raza_grid.png"
            if canvas.save_png(grid_path) is os_error then fail: failed = "can't write «grid_path»: «os_error»"
            // The column dragged past five: the lines half way through
            // snapping from four's to five's, the game as five shown.
            *none: [MAX_PLAYERS + 1] Splits
            picking := Count_Picker⟨open: true, held: true, shown: 5.2, laid: 4, toward: 5, progress: 0.5⟩
            moving := lay_out(screen_size, shown_splits(picking, none[:], screen_size))
            preview := game_for(game, moving.count, none[:], screen_size)
            if fonts.resize_life(TEXT_FAMILY, moving) is os_error then fail: failed = "no font: «os_error»"
            draw(canvas, layer, moving, preview, fonts, ⟨counts: picking, counts_shown: 1, previewing: true, can_undo: true⟩)
            counts_path := `scratch "«folder»/raza_counts.png"
            if canvas.save_png(counts_path) is os_error then fail: failed = "can't write «counts_path»: «os_error»"
            // The colour toggles folded into the five-colour icon, and half way.
            for fold, f: [2] f32⟨0, 0.5⟩ {
                *folded: Toggles
                for *s: folded.shown { s = fold }
                for *o: folded.open { o = false }
                draw(canvas, layer, layout, game, fonts, ⟨toggles: folded, can_undo: true⟩)
                folded_path := `scratch "«folder»/raza_folded_«f».png"
                if canvas.save_png(folded_path) is os_error then fail: failed = "can't write «folded_path»: «os_error»"
            }
            // The options: the first player's open (commander damage on,
            // lifelink on), the second with every attack on (their icons
            // wrapping into a second line), the third poisoned, and a poison
            // volley of 3 from the second to the first in flight.
            {
                *optioned := game
                optioned.attacks[0] = STARTING_ATTACKS | Attacks'(1 << u8'Attack.LIFELINK)
                optioned.attacks[1] = 31
                optioned.poison[2] = 4
                *opened: Toggles = FOLDED_TOGGLES
                opened.open[0] = true
                opened.shown[0] = 1
                volleys := settled_volleys(layout, optioned, 1, 0, 3, 0.62, .POISON)
                *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
                *dealt := optioned
                dealt.deal_attack(.POISON, 1, 0, 3)
                draw(canvas, layer, layout, shown_game(dealt, pending, volleys), fonts, ⟨options: opened, can_undo: true⟩, volleys)
                options_path := `scratch "«folder»/raza_options.png"
                if canvas.save_png(options_path) is os_error then fail: failed = "can't write «options_path»: «os_error»"
            }
            // A life drum open: its units' wheel turned up a row and two
            // fifths (carrying back into the tens'), then its tens' turned
            // down two fifths; then closing, half flattened, and closed, its
            // change flat beside it; and a life of one digit, 3, open, its
            // tens' wheel blank, its units' turned up a fifth.
            if fonts.resize_life(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"
            life := game.life[0]
            drums := [5] Life_Drum⟨⟨open: true, player: 0, start: life, from: life, place: 1, turned: -1.4, bend: 1⟩,
                                   ⟨open: true, player: 0, start: life, from: life, place: 10, turned: 0.4, bend: 1⟩,
                                   ⟨player: 0, start: life - 2, from: life, bend: 0.5, change: 2, since: 0.05⟩,
                                   ⟨player: 0, start: life - 2, from: life, change: 2, since: 0.5⟩,
                                   ⟨open: true, player: 0, start: 3, from: 3, place: 1, turned: -0.2, bend: 1⟩⟩
            for drum, d: drums {
                // (the surfaces kept, as the program does, for the drum's glass to blur)
                *drummed: Screen_State = ⟨can_undo: true, keep_surfaces: true⟩
                drummed.drums[0] = drum
                draw(canvas, layer, layout, game, fonts, drummed)
                drum_path := `scratch "«folder»/raza_drum_«d».png"
                if canvas.save_png(drum_path) is os_error then fail: failed = "can't write «drum_path»: «os_error»"
            }
            for step, morph_index: [3] f32⟨0, 0.35, 0.7⟩ {
                draw(canvas, layer, moving, preview, fonts, ⟨counts: picking, counts_shown: step, previewing: true, can_undo: true⟩)
                morph_path := `scratch "«folder»/raza_count_morph_«morph_index».png"
                if canvas.save_png(morph_path) is os_error then fail: failed = "can't write «morph_path»: «os_error»"
            }
            // The settings: part of the way into the pill, then in.
            for shown, s: [2] f32⟨0.4, 1⟩ {
                draw(canvas, layer, layout, game, fonts, ⟨settings_open: true, settings_shown: shown, motion: .SLOW, can_undo: true, brightness: 0.75⟩)
                settings_path := `scratch "«folder»/raza_settings_«s».png"
                if canvas.save_png(settings_path) is os_error then fail: failed = "can't write «settings_path»: «os_error»"
            }
        }
    }
    // The frames: six players, each colour alone and all five (gold).
    {
        *canvas: Draw.Canvas
        if c := Draw.create_canvas(⟨2160, 1440⟩) { canvas = c } else if os_error { fail: failed = "no canvas: «os_error»" }
        defer canvas.destroy()
        *layer: Draw.Canvas
        if l := Draw.create_canvas(⟨2160, 1440⟩) { layer = l } else if os_error { fail: failed = "no layer: «os_error»" }
        defer layer.destroy()
        *game := new_game(6)
        for k: 0 < 5 { game.identity[k] = u8'1 << u8'k }
        game.identity[5] = 0x1F
        screen_size := V2⟨2160, 1440⟩
        layout := lay_out(screen_size, equal_splits(6, screen_size))
        *fonts: Fonts
        if fonts.reload_fonts(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"
        draw(canvas, layer, layout, game, fonts, ⟨can_undo: true⟩)
        path := `scratch "«folder»/raza_frames.png"
        if canvas.save_png(path) is os_error then fail: failed = "can't write «path»: «os_error»"
        // All ten hybrid pairs, plus gold for comparison on each sheet.
        hybrids := [10] Identity⟨3, 5, 9, 17, 6, 10, 18, 12, 20, 24⟩
        for page: 0 < 2 {
            for k: 0 < 5 { game.identity[k] = hybrids[page * 5 + k] }
            game.identity[5] = 0x1F
            draw(canvas, layer, layout, game, fonts, ⟨surface_time: 2⟩)
            hybrid_path := `scratch "«folder»/raza_hybrids_«page».png"
            if canvas.save_png(hybrid_path) is os_error then fail: failed = "can't write «hybrid_path»: «os_error»"
        }
        for k: 0 < 5 { game.identity[k] = u8'1 << u8'k }
        // Two surface times isolate material animation.
        game.identity[5] = 0
        for moment: [2] f32⟨0, 2⟩ {
            draw(canvas, layer, layout, game, fonts, ⟨surface_time: moment⟩)
            material_path := `scratch "«folder»/raza_materials_«i32'moment».png"
            if canvas.save_png(material_path) is os_error then fail: failed = "can't write «material_path»: «os_error»"
        }
    }
}

////////////////////////////////
// The program

// Each count's lines (splits[n] for n players; none: equal_splits').
Lines :: #alias [MAX_PLAYERS + 1] Splits

// What undo goes back to: the game, and each count's lines.
Moment :: struct {
    game:  Game
    lines: Lines
}

// The moments before this one, to undo to, and those undone, to redo: doing
// something new forgets what was undone. A player's colours tapped one
// after another, while their toggles stay open, are one step (colours_of:
// whose, or -1).
Timeline :: struct {
    past:       [..] Moment
    future:     [..] Moment
    colours_of: i64 = -1
}

// The game and the lines as they are, kept to undo to, before something's
// done to them.
remember :: (timeline: *Timeline, game: Game, lines: Lines) {
    timeline.past.add(⟨game, lines⟩)
    timeline.future.clear()
    timeline.colours_of = -1
}

// A player's colour tapped: remembered, unless it's one more of their run of
// taps.
remember_colours :: (timeline: *Timeline, game: Game, lines: Lines, player: i64) {
    if timeline.colours_of == player then return
    timeline.remember(game, lines)
    timeline.colours_of = player
}

// The moment before this one (undo) or after it (redo), if there's one.
undo :: (timeline: *Timeline, game: *Game, lines: *Lines -> bool) {
    if timeline.past.count == 0 then return false
    timeline.future.add(⟨game, lines⟩)
    moment := timeline.past.pop()
    game = moment.game
    lines = moment.lines
    timeline.colours_of = -1
    return true
}

redo :: (timeline: *Timeline, game: *Game, lines: *Lines -> bool) {
    if timeline.future.count == 0 then return false
    timeline.past.add(⟨game, lines⟩)
    moment := timeline.future.pop()
    game = moment.game
    lines = moment.lines
    timeline.colours_of = -1
    return true
}

// Each count's lines stored, as they are now (a count's none: forgotten).
store_lines :: (lines: Lines) {
    with scratch.rewind()
    for n: 2 <= MAX_PLAYERS {
        key := `scratch "splits.«n»"
        if lines[n] == Splits⟨⟩ {
            if Defaults.remove(key) is { case absent, os_error: _ }
        }
        else if Defaults.set(key, lines[n]) is os_error { }
    }
}

Options :: struct {
    attack_frames: string ⟦help: "render a three-second attack sequence as PNG frames, without opening a window"⟧
    snapshot: string ⟦help: "draw each count of players into PNGs in this folder (raza_2.png to raza_6.png, and raza_grid.png), and quit"⟧
    quit_after: f64 = 0 ⟦help: "quit after this many seconds, as if Quit were pressed (to profile it: rain -profile raza.rain -quit_after:15)"⟧
    busy: bool ⟦help: "a busy table, to measure: a strike between two players every half second and two players dragging, nothing stored (with -quit_after)"⟧
}

apply_life_shortcut :: (timeline: *Timeline, game: *Game, lines: Lines, screen: *Screen_State, player: i64, delta: i32) {
    timeline.remember(game, lines)
    game.life[player] += delta
    total := game.life[player]
    screen.history_changes[player] = ⟨player: player, from: total, start: total, change: delta, since: 0⟩
}

// Display the original operation on undo (crossed out), the applied delta on redo.
show_history_changes :: (screen: *Screen_State, before: Game, after: Game, undone: bool) {
    // (the change each drum shows gives way to the step's)
    for *drum: screen.drums { drum = ⟨⟩ }
    screen.history_changes = ⟨⟩
    for k: 0 < Math.min(before.players, after.players) {
        delta := if undone then before.life[k] - after.life[k] else after.life[k] - before.life[k]
        if delta == 0 then continue
        screen.history_changes[k] = ⟨player: k, from: after.life[k], start: after.life[k], change: delta, crossed: undone, since: 0⟩
    }
}

main :: (args: [] string) [failed: string] {
    // (the screen kept on while it runs: it's watched, not typed into)
    with System.keep_awake()
    defer destroy_count_table()
    defer destroy_drum_source()
    defer { if loss_faces_ready then loss_faces.destroy() }
    if Draw.add_font(MANA) is bad_font then fail: failed = "Mana isn't a font Draw can read"
    if Draw.add_font(CRIMSON_PRO) is bad_font then fail: failed = "Crimson Pro isn't a font Draw can read"
    *options: Options
    if parsed := args.parse(Options, about: "Raza: a damage tracker for Commander, for a tablet in the middle of the table.") {
        options = parsed
    }
    else if help {
        fail: failed = help
    }
    else if bad_arguments {
        fail: failed = bad_arguments
    }
    // (the textures decoding, a thread each, while the window and the
    // device are made; made images once they are, take_textures')
    *decoders: [Texture] Thread
    start_textures(decoders)
    defer material_image.destroy()
    defer control_image.destroy()
    defer under_table_image.destroy()
    defer five_colours_image.destroy()
    if options.attack_frames != "" {
        if take_textures(decoders) is failed then fail: failed
        if save_attack_frames(options.attack_frames) is failed then fail: failed
        return
    }
    if options.snapshot != "" {
        if take_textures(decoders) is failed then fail: failed
        if save_snapshots(options.snapshot) is failed then fail: failed
        return
    }
    *w: ^Window = null
    // (TOUCHES: each finger the table's own, no mouse made of them, nor a
    // right click of a held finger)
    if made := Window.create_window("", ⟨1280, 800⟩, .DEFAULT | .TOUCHES, background: 0x131318) { w = made } else if os_error {
        fail: failed = "can't open a window: «os_error»"
    }
    w.set_fullscreen(true)
    // (the orientation, as it was left: the display asked to turn as the
    // tablet's held, or kept landscape or portrait)
    *orientation := Defaults.get("orientation", Orientation.AUTO)
    *stored_orientation := orientation
    _ := Window.keep_orientation(display_orientation(orientation))
    *canvas: Draw.Canvas
    if c := Draw.create_canvas(w.size, w.handle) { canvas = c } else if os_error { fail: failed = "no canvas: «os_error»" }
    // (the light the volleys give, drawn each frame, then added with its bloom)
    *layer: Draw.Canvas
    if l := Draw.create_canvas(w.size) { layer = l } else if os_error { fail: failed = "no light layer: «os_error»" }
    // (the table drawn the other way about from the window, made when it's
    // first needed, to be turned onto it)
    *turned_table: Draw.Canvas
    *turned_made := false
    defer if turned_made { turned_table.destroy() }
    if take_textures(decoders) is failed then fail: failed

    // The game and each count of players' lines (splits[n] for n players),
    // as they were left last time (Defaults': the registry's), or a new game
    // of four and lines as equal_splits starts them. (The font and the
    // frames' era were settings once: what was kept of them goes.)
    // (none kept, or one this build can't read: a new game of four, given
    // Reset's colours on the first frame, once the screen's size, and so
    // which seat's at the top, is known)
    *game, *colours_pending := kept_game(Defaults.get("game", Game⟨players: 0⟩))
    *timeline: Timeline
    // (the lines as a line's drag began, to undo it to)
    *lines_before: Lines
    // (the fingers moving a line and the count column: Pointer's ids)
    *line_pointer: u32 = 0
    // (two fingers on the lines: the second's, the lines as they were when it
    // touched, and the angle about the centre the fingers' middle had then)
    *turn_pointer: u32 = 0
    *turn_from: Splits
    *turn_angle: f32 = 0
    *counts_pointer: u32 = 0
    // (Reset touched: done once the table's closed)
    *reset_pending := false
    if Defaults.remove("font") is { case absent, os_error: _ }
    if Defaults.remove("era") is { case absent, os_error: _ }
    *splits: [MAX_PLAYERS + 1] Splits
    for n: 2 <= MAX_PLAYERS { splits[n] = Defaults.get(`scratch "splits.«n»", Splits⟨⟩) }
    *speed := Defaults.get("motion", Motion.SLOW)
    // (how far the surfaces have moved, in their features)
    *surface_time: f32 = 0
    // (what was last stored, to store again only what's changed)
    *stored_game := game
    *stored_speed := speed
    // (the brightness, as it was left; and the finger on its slider, while one is)
    *bright := Math.clamp(Defaults.get("brightness", f32'1), MIN_BRIGHTNESS, 1)
    *stored_brightness := bright
    *brightness_pointer: u32 = 0
    *brightness_held := false
    *last_frame := Time.seconds_since_start()
    *fps_since := last_frame
    *fps_frames: i64 = 0
    *layout: Layout
    *fonts: Fonts
    *fonts_for := V2⟨0, 0⟩           // the size the fonts were made for (0: none yet)
    *fonts_players: i64 = 0          // ...and the count of players
    *screen: Screen_State
    screen.keep_surfaces = true
    // (the game carried on from the last run: its colours set, so each
    // player's toggles start folded, the five-colour icon to open them)
    fold_toggles(screen.toggles)
    // The volleys, and the damage dealt whose volleys haven't landed yet
    // (pending[to][from]: shown undone); and -busy's strikes' numbers.
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    *volleys: Volleys
    *random := Random.generator()

    // (for -quit_after's report: each frame's work, from its start to its
    // present, its waits for input left out)
    started := Time.seconds_since_start()
    *busy: f64 = 0
    *slowest: f64 = 0
    *busy_frames: i64 = 0
    *woke := started
    // (and when the first frame was shown, from the process's start, and the
    // frames after it: the steady work, the first's making left out)
    *first_shown: f64 = 0
    *steady: f64 = 0
    *steady_slowest: f64 = 0
    *busy_clock: f32 = 0
    defer if options.quit_after > 0 and busy_frames > 0 {
        echo("«busy_frames» frames in «Time.seconds_since_start() - started, ⟨precision: 1⟩» s; each frame's work «busy / f64'busy_frames * 1000, ⟨precision: 2⟩» ms on average, «slowest * 1000, ⟨precision: 2⟩» ms at most")
        echo("the first frame shown «first_shown * 1000, ⟨precision: 0⟩» ms from the start (the window opened at «started * 1000, ⟨precision: 0⟩» ms)")
        if busy_frames > 1 {
            echo("after it, each frame's work «steady / f64'(busy_frames - 1) * 1000, ⟨precision: 2⟩» ms on average, «steady_slowest * 1000, ⟨precision: 2⟩» ms at most")
            echo("«f64'(busy_frames - 1) / (Time.seconds_since_start() - first_shown), ⟨precision: 1⟩» frames a second after it")
        }
    }
    #if #program.os == .WINDOWS { *was_minimized := false }
    while Window.update_windows() {
        frame_start := Time.seconds_since_start()
        if w.close_requested then w.destroy()
        if options.quit_after > 0 and Time.seconds_since_start() - started >= options.quit_after then w.destroy()
        if !w.is_open then break
        // Taskbar restoration can precede keyboard focus. Repaint once on
        // restore, then use the current foreground window to resume frames.
        idle_window := #if #program.os == .WINDOWS {
            minimized := w.handle.is_iconic()
            restored := was_minimized and !minimized
            was_minimized = minimized
            minimized or (!restored and OS_Windows.foreground_window() != w.handle)
        } #else { !w.has_focus }
        if idle_window and options.quit_after <= 0 {
            if _ := Window.wait_for_input(milliseconds: 100) is timed_out { }
            scratch.reset()
            last_frame = Time.seconds_since_start()
            woke = last_frame
            continue
        }
        // (drawn as the orientation says: auto, as the window is; kept
        // landscape or portrait, where keep_orientation couldn't turn the
        // display, the table drawn that way and turned onto the window)
        sideways := turned_onto_window(orientation, w.size)
        drawn := if sideways then Wide.i32x2⟨w.size[1], w.size[0]⟩ else w.size
        size := V2⟨f32'drawn[0], f32'drawn[1]⟩
        if colours_pending {
            game.identity = starting_colours(size, game.players)
            colours_pending = false
        }
        if canvas.size != w.size {
            if canvas.resize(w.size) is os_error then fail: failed = "can't resize the canvas"
        }
        if layer.size != drawn {
            if layer.resize(drawn) is os_error then fail: failed = "can't resize the light layer"
        }
        if sideways {
            if !turned_made {
                if made_turned := Draw.create_canvas(drawn) { turned_table = made_turned } else if os_error { fail: failed = "no turned canvas: «os_error»" }
                turned_made = true
            }
            else if turned_table.size != drawn {
                if turned_table.resize(drawn) is os_error then fail: failed = "can't resize the turned canvas"
            }
        }
        // The screen laid out each frame (its lines may be moving), and its
        // fonts made again for a new size or count, or once a line's let go.
        if !splits_fit(splits[game.players], game.players) then splits[game.players] = equal_splits(game.players, size)
        layout = lay_out(size, splits[game.players])
        if size != fonts_for or game.players != fonts_players {
            if fonts.reload_fonts(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"
            fonts_for = size
            fonts_players = game.players
        }
        // (each finger this frame, and the mouse's left button)
        // (-busy: two made-up fingers, each dragging from a player toward
        // another, swaying, never lifted)
        *made_up: [2] Pointer
        *made_up_count: i64 = 0
        if options.busy and layout.count >= 3 {
            sway := f32'(Time.seconds_since_start() - started)
            for k: 0 < 2 {
                aimed := layout.seats[(k + 2) % layout.count].middle
                along := 0.55 + 0.35 * Math.sin(sway * (1.3 + f32'k * 0.4))
                made_up[k] = ⟨BUSY_POINTER + u32'k, Math.mix(layout.seats[k].icon, aimed, along), false, false⟩
                if !screen.drags[k].active then screen.drags[k] = ⟨active: true, from: k, finger: made_up[k].at, pointer: BUSY_POINTER + u32'k⟩
            }
            made_up_count = 2
        }
        pointers := `scratch pointers_of(w, sideways, made_up[:made_up_count])
        cell := cell_of(layout)

        // (F11 fullscreen or a window; F12 shows the frames a second, or
        // hides them)
        if w.keys[.F11].PRESSED then w.set_fullscreen(!w.is_fullscreen)
        if w.keys[.F12].PRESSED then screen.show_fps = !screen.show_fps
        if w.keys[.ESCAPE].PRESSED {
            if any_grid_open(screen) { for *grid: screen.pickers { grid.open = false } }
            else if screen.settings_open then screen.settings_open = false
            else if screen.counts.open {
                // (the count column let go of, the count as it was)
                screen.counts.held = false
                screen.counts.open = false
                screen.counts.settling = true
            }
            else if w.is_fullscreen then w.set_fullscreen(false)
        }
        // (Control+Z undoes; Control+Y, or Control+Shift+Z, redoes)
        if w.modifiers.CONTROL and (w.keys[.Z].PRESSED or w.keys[.Y].PRESSED) {
            again := w.keys[.Y].PRESSED or w.modifiers.SHIFT
            if step_history(screen, timeline, game, splits, again) {
                call_off_volleys(volleys, pending)
                store_lines(splits)
            }
        }

        // Each finger's touch, in the order they came: one on what's open
        // (the settings, a player's number grid or drum) is that's; otherwise
        // it begins what it's on. Several players act at once, each gesture
        // following the finger that began it; but the count column and the
        // settings are the table's alone: opening either ends what else is
        // going on, and while it's open no other finger begins anything.
        *quitting := false
        *locked := false
        for p: pointers {
            if !p.pressed or screen.counts.open then continue
            pressed_at := p.at
            if screen.settings_open {
                setting := settings_part_at(layout, pressed_at)
                if setting is {
                case animation: speed = animation
                case brightness:
                    // (set where it's touched, then following that finger)
                    bright = brightness
                    brightness_held = true
                    brightness_pointer = p.id
                case orientation:
                    // (on to the next: the display asked to keep to it, and
                    // it kept for next time)
                    orientation = next_orientation(orientation)
                    _ := Window.keep_orientation(display_orientation(orientation))
                    if orientation != stored_orientation {
                        if Defaults.set("orientation", orientation) is os_error { }
                        stored_orientation = orientation
                    }
                case reset:
                    // (the table closes, then resets: reset_pending's)
                    screen.settings_open = false
                    reset_pending = true
                case quit:
                    // (what's changed is already stored, each frame's as it's made)
                    w.destroy()
                    quitting = true
                case close: screen.settings_open = false
                }
                continue
            }
            if option_button := options_button_at(layout, screen, pressed_at) is not absent {
                // (the options button: opens them, or, open, folds them)
                if screen.options.open[option_button] { fold_now(screen.options, option_button) } else { open_options(screen.options, option_button) }
                continue
            }
            else if chooser, option := option_at(layout, screen, pressed_at) is not absent {
                // (one turned on or off: undone as colours are, a run of taps
                // one step)
                timeline.remember_colours(game, splits, MAX_PLAYERS + chooser)
                toggle_attack(game, chooser, option)
                // (one turned off: a drag of it, or its number grid, ends
                // without making it)
                if !has_attack(game.attacks[chooser], option) {
                    if screen.drags[chooser].active and screen.drags[chooser].kind == option then screen.drags[chooser].active = false
                    if screen.pickers[chooser].open and screen.pickers[chooser].kind == option then screen.pickers[chooser].open = false
                }
                continue
            }
            else if options_hub := options_middle_at(layout, screen, pressed_at) is not absent {
                fold_now(screen.options, options_hub)
                continue
            }
            // (a number grid's key, tick or cross)
            *gridded := false
            for *picker: screen.pickers {
                if gridded or !picker.open then continue
                key := picker_part_at(layout, picker, pressed_at)
                if key is {
                case tens, units:
                    picker.pick(key)
                    gridded = true
                case accept:
                    // (the tick: what's chosen, straight at them)
                    value := picker.tens + picker.units
                    if value > 0 {
                        timeline.remember(game, splits)
                        strike(game, volleys, layout, pending, picker.from, picker.to, value, picker.kind)
                    }
                    picker.open = false
                    gridded = true
                case cancel:
                    picker.open = false
                    gridded = true
                case outside: _
                }
            }
            if gridded then continue
            // (an open drum's wheel: a turn of it, or a tap that keeps editing)
            *wheeled := false
            for *drum, k: screen.drums {
                if wheeled or k >= layout.count or !drum.open then continue
                cross, tick, half := drum_buttons(layout, fonts, drum, k)
                button := tick_or_cross_at(layout, layout.seats[k].angle, cross, tick, half, pressed_at)
                if button is {
                case accept:
                    // (the tick: the life as turned, a spin stopped where it
                    // is, the drum closed)
                    commit_drum(drum, game, timeline, splits)
                    wheeled = true
                case cancel:
                    cancel_drum(drum, game, timeline, splits)
                    wheeled = true
                case tens, units, outside: _
                }
                if wheeled then continue
                if place := drum_wheel_at(layout, fonts, drum, pressed_at) is not absent {
                    spun := layout.seats[k]
                    press_drum(drum, game, k, local_of(spun.middle, spun.angle, pressed_at), place)
                    drum.pointer = p.id
                    wheeled = true
                }
            }
            if wheeled then continue
            if part := capsule_part_at(layout, pressed_at) is not absent {
                if part is {
                case .UNDO, .REDO:
                    if step_history(screen, timeline, game, splits, part == .REDO) {
                        call_off_volleys(volleys, pending)
                        store_lines(splits)
                    }
                case .PLAYERS:
                    // (refused while anything's under way, as undo is: a
                    // drag, a number grid, a drum, a line moving; it isn't
                    // greyed, as undo is)
                    if under_way(screen) then continue
                    end_gestures(screen)
                    locked = true
                    count := f32'game.players
                    screen.counts = ⟨open: true, held: true, grabbed: pressed_at.y, from: count, shown: count, laid: screen.counts.laid,
                                     toward: screen.counts.toward, progress: screen.counts.progress⟩
                    counts_pointer = p.id
                case .RESTART:
                    // A new game of as many players, each seat's colours kept:
                    // every life back to the start's (those off the table's
                    // too), no damage (undo brings the old one back).
                    timeline.remember(game, splits)
                    game = new_game(game.players, game.identity, game.attacks)
                    call_off_volleys(volleys, pending)
                case .SYSTEM:
                    end_gestures(screen)
                    locked = true
                    screen.settings_open = true
                }
                continue
            }
            // (a touch elsewhere in the part of a player whose drum is open
            // does nothing: their controls are hidden while it's open, and
            // only its cross or tick ends it, as a number grid's do; but a
            // line there is still dragged, where the drum doesn't cover it)
            *at_line := false
            if mine := seat_at(layout, pressed_at) is not absent {
                if screen.drums[mine].open {
                    if _ := line_at(layout, pressed_at, 0.5 * cell) is absent then continue
                    at_line = true
                }
            }
            if !at_line {
                if tax_player := tax_button_at(layout, fonts, shown_game(game, pending, volleys), screen, pressed_at) is not absent {
                    before := game
                    if raise_commander_tax(game, screen.tax_ready_at[tax_player], tax_player, frame_start) then timeline.remember(before, splits)
                    continue
                }
                if seat, colour := toggle_at(layout, screen, pressed_at) is not absent {
                    // (one set: its pentagon folds TOGGLE_LINGER seconds from
                    // now, unless another's set before then; undone with the
                    // rest of that player's run of taps)
                    timeline.remember_colours(game, splits, seat)
                    bit := u8'1 << u8'colour
                    was := game.identity[seat]
                    game.identity[seat] = if was & bit != 0 then was & ~bit else was | bit
                    touch_toggles(screen.toggles, seat)
                }
                else if folded := five_colours_at(layout, screen, pressed_at) is not absent {
                    // (the five-colour icon: opens them, or, open, folds them)
                    if screen.toggles.open[folded] { fold_now(screen.toggles, folded) } else { unfold_toggles(screen.toggles, folded) }
                }
                else if opened := pentagon_middle_at(layout, screen, pressed_at) is not absent {
                    fold_now(screen.toggles, opened)
                }
                else if shortcut_player, amount := life_shortcut_at(layout, fonts, shown_game(game, pending, volleys), screen, pressed_at) is not absent {
                    apply_life_shortcut(timeline, game, splits, screen, shortcut_player, amount)
                }
                else if spot, kind := icon_at(layout, game, pressed_at) is not absent {
                    screen.drags[spot] = ⟨active: true, from: spot, kind: kind, finger: pressed_at, pointer: p.id⟩
                }
                else if who := life_at(layout, fonts, game, pressed_at) is not absent {
                    // (a life touched: a tap opens its drum)
                    touched := layout.seats[who]
                    press_drum(screen.drums[who], game, who, local_of(touched.middle, touched.angle, pressed_at), 1)
                    screen.drums[who].pointer = p.id
                }
                else {
                    at_line = true
                }
            }
            // (a line: not where an open drum covers it, its glass or its
            // cross and tick)
            if !at_line or under_open_drum(layout, fonts, screen.drums, pressed_at) then continue
            if line := line_at(layout, pressed_at, 0.5 * cell) is not absent {
                if screen.moving_end >= 0 and p.id != line_pointer {
                    // (a second finger on a line while one's dragged: every
                    // line turns together about the centre, as the fingers'
                    // middle goes round it)
                    if !screen.turning {
                        screen.turning = true
                        turn_pointer = p.id
                        turn_from = splits[game.players]
                        turn_angle = angle_about(layout.centre, (screen.line_finger + pressed_at) / 2)
                    }
                }
                else {
                    lines_before = splits
                    screen.moving_end = line
                    screen.line_finger = pressed_at
                    line_pointer = p.id
                }
            }
        }
        if quitting then break
        // A dragged line follows its finger: its end goes where a line from
        // the centre through the finger meets the edge, kept between its
        // neighbours. With a second finger, every line turns by as much as
        // the fingers' middle has gone round the centre since it touched (a
        // turn that would crowd an attack button stops where it is).
        if screen.moving_end >= 0 {
            if line_held := pointer_with(pointers, line_pointer) is not absent then screen.line_finger = line_held.at
            if screen.turning {
                if second := pointer_with(pointers, turn_pointer) is not absent {
                    now := angle_about(layout.centre, (screen.line_finger + second.at) / 2)
                    turned := turned_splits(turn_from, size, turn_between(turn_angle, now))
                    if splits_fit(turned, game.players) and attack_buttons_clear(lay_out(size, turned)) then splits[game.players] = turned
                }
            }
            else if aimed := share_through(layout, screen.line_finger) is not absent {
                splits[game.players].move_split_with_clearance(screen.moving_end, aimed, size)
            }
            layout = lay_out(size, splits[game.players])
        }
        // Each drum's wheel turns with its finger, toward its player and
        // away. Let go: a tap enters or keeps editing; a turn's number at the
        // middle is the life (undo brings the old one back).
        for *drum, k: screen.drums {
            if !drum.pressed or k >= layout.count then continue
            if drum_held := pointer_with(pointers, drum.pointer) is not absent {
                turning := layout.seats[k]
                drum.move_drum(local_of(turning.middle, turning.angle, drum_held.at), f32'fonts.life.cap_height)
            }
            if let_go(pointers, drum.pointer) {
                was_open := drum.open
                life, changes := drum.release_drum(game)
                if changes {
                    timeline.remember(game, splits)
                    game.life[k] = life
                    // (a tap that opened it at 0 from below: the step the
                    // cross takes back, while nothing's done after it)
                    if !was_open and drum.open then drum.opening_step = timeline.past.count
                }
            }
        }
        // Each drag follows its finger; let go over a player, it strikes them
        // (or, past their life, opens the dragger's number grid).
        for *d: screen.drags {
            if !d.active then continue
            if drag_held := pointer_with(pointers, d.pointer) is not absent then d.finger = drag_held.at
            if !let_go(pointers, d.pointer) then continue
            if to, amount := aim(layout, game, d.from, d.finger, d.kind) is not missed {
                if amount is {
                case damage:
                    timeline.remember(game, splits)
                    strike(game, volleys, layout, pending, d.from, to, damage, d.kind)
                case asked:
                    screen.pickers[d.from] = ⟨open: true, from: d.from, to: to, kind: d.kind⟩
                }
            }
            d.active = false
        }
        if screen.moving_end >= 0 and (locked or let_go(pointers, line_pointer) or (screen.turning and let_go(pointers, turn_pointer))) {
            // (a line moved, or all turned, till a finger's lifted: a step to
            // undo, the lines as they were)
            screen.moving_end = -1
            screen.turning = false
            if splits[game.players] != lines_before[game.players] then timeline.remember(game, lines_before)
            if Defaults.set(`scratch "splits.«game.players»", splits[game.players]) is os_error { }
        }
        if screen.counts.open and screen.counts.held and let_go(pointers, counts_pointer) {
            // Let go: the count at the button is the game's (the same, let
            // go without moving), the column and the lines settling on it,
            // and the runner going back to the pill.
            screen.counts.held = false
            count := i64'Math.round(screen.counts.shown)
            if count != game.players {
                timeline.remember(game, splits)
                game = game_for(game, count, splits[:], size)
                call_off_volleys(volleys, pending)
            }
            screen.counts.open = false
            screen.counts.settling = true
        }
        // The column follows its finger: the count at the button is where
        // it's been dragged to, between whole counts as it goes; let go, it
        // eases to the game's.
        if screen.counts.held {
            if column := pointer_with(pointers, counts_pointer) is not absent {
                moved := (column.at.y - screen.counts.grabbed) / (COUNT_PITCH * cell)
                screen.counts.shown = Math.clamp(screen.counts.from - moved, 2, f32'MAX_PLAYERS)
            }
        }
        else if screen.counts.settling {
            target := f32'game.players
            screen.counts.shown += (target - screen.counts.shown) * 0.3
            if Math.abs(target - screen.counts.shown) < 0.01 {
                screen.counts.shown = target
                screen.counts.settling = false
            }
        }
        // The lines snap to the count at the button as it changes (or, let
        // go, to the game's), a count at a time; while they're another
        // count's, the parts show the game as that count would have it.
        now := Time.seconds_since_start()
        seconds := f32'Math.min(now - last_frame, 0.1)
        last_frame = now
        // (the frames a second: those counted over the last window)
        fps_frames += 1
        if now - fps_since >= FPS_WINDOW {
            screen.fps = f32'(f64'fps_frames / (now - fps_since))
            fps_frames = 0
            fps_since = now
        }
        target := if screen.counts.open then i64'Math.round(screen.counts.shown) else game.players
        screen.counts.move_lines(target, seconds)
        *shown := game
        screen.previewing = lines_moving(screen.counts, game.players)
        if screen.previewing {
            layout = lay_out(size, shown_splits(screen.counts, splits[:], size))
            if layout.count != game.players then shown = game_for(game, layout.count, splits[:], size)
        }

        // The volleys moved on, their points landing; and the game shown with
        // what's still in flight not yet done.
        // (-busy: a strike between two players every half second, a new game
        // when a life runs low, so no one's out)
        if options.busy and layout.count >= 2 {
            busy_clock += seconds
            if busy_clock >= 0.5 {
                busy_clock -= 0.5
                striker := random.below(layout.count)
                struck := (striker + 1 + random.below(layout.count - 1)) % layout.count
                busy_kind := if random.chance(0.5) then Attack.COMMANDER else Attack.DAMAGE
                strike(game, volleys, layout, pending, striker, struck, i32'random.through(1, 9), busy_kind)
                *low := false
                for life: game.life[:game.players] { if life < 12 then low = true }
                if low {
                    call_off_volleys(volleys, pending)
                    game = new_game(game.players, game.identity, game.attacks)
                }
            }
        }
        steer_volleys(volleys, pending, seconds)
        if !screen.previewing then shown = shown_game(game, pending, volleys)
        for *slide, k: screen.tax_slides { step_tax_slide(slide, shown.poison[k] > 0, seconds) }

        // What changed this frame, stored (a failure to store isn't the game's).
        if game != stored_game and !options.busy {
            if Defaults.set("game", game) is os_error { }
            stored_game = game
        }
        if speed != stored_speed {
            if Defaults.set("motion", speed) is os_error { }
            stored_speed = speed
        }

        // The life totals sized for the parts drawn, whatever moved them
        // (a dragged line, lines settling on a count, a reset); the font's
        // made again only when the size changes.
        if fonts.resize_life(TEXT_FAMILY, layout) is os_error then fail: failed = "no font: «os_error»"

        // (greyed while something's under way, as they wait till it's done)
        screen.can_undo = timeline.past.count > 0 and !under_way(screen)
        screen.can_redo = timeline.future.count > 0 and !under_way(screen)
        // (the settings coming into the pill, or going)
        opening: f32 = if screen.settings_open then 1 else -1
        screen.settings_shown = Math.clamp(screen.settings_shown + opening * seconds / SETTINGS_TIME, 0, 1)
        if reset_pending and screen.settings_shown <= 0 {
            // Reset, the table closed: every count's lines forgotten, here and
            // stored (a count whose lines don't fit is laid out as
            // equal_splits starts it); each seat its starting colours, those
            // who've left the table forgotten, and the motion its default,
            // slow. Everyone starts again at 40, with no damage or pending attacks.
            // (Undo brings the lives, colours, those players and the lines
            // back; the motion's a setting, and stays.)
            reset_pending = false
            timeline.remember(game, splits)
            for n: 2 <= MAX_PLAYERS {
                splits[n] = ⟨⟩
                if Defaults.remove(`scratch "splits.«n»") is { case absent, os_error: _ }
            }
            splits[game.players] = equal_splits(game.players, size)
            layout = lay_out(size, splits[game.players])
            reset_colours := starting_colours(size, game.players)
            game = new_game(game.players, reset_colours)
            call_off_volleys(volleys, pending)
            screen.drums = ⟨⟩
            screen.history_changes = ⟨⟩
            speed = Motion.SLOW
            open_toggles(screen.toggles)
        }
        // (and into the count column's groove while a finger's on the
        // column, back as it's let go)
        screen.counts_shown = step_count_opening(screen.counts_shown, screen.counts.held, seconds)
        // Both splits share the same fade: stay hidden while closing, return after reconnection.
        table_opened := Math.max(screen.counts_shown, screen.settings_shown)
        table_held := screen.counts.held or screen.settings_open
        screen.count_ui_visible = step_count_player_ui(screen.count_ui_visible, table_opened, table_held, seconds)
        // (each player's toggles counting down to folding, and folding or opening)
        step_toggles(screen.toggles, seconds)
        step_toggles(screen.options, seconds)
        // (a player's run of colour taps ends as their toggles fold)
        // (a run of taps ends as its toggles fold: a player's colours', or
        // their options', MAX_PLAYERS on)
        if timeline.colours_of >= 0 {
            run := timeline.colours_of
            still := if run < MAX_PLAYERS then screen.toggles.open[run] else screen.options.open[run - MAX_PLAYERS]
            if !still then timeline.colours_of = -1
        }
        for k: 0 < MAX_PLAYERS { screen.history_changes[k].since += seconds }
        for drum, k: screen.drums { if drum.open then screen.history_changes[k] = ⟨⟩ }
        for *drum, k: screen.drums {
            step_drum(drum, game, seconds)
            // (a spin settled on a row: that's the life, undone as a turn is)
            if drum.settled {
                drum.settled = false
                timeline.remember(game, splits)
                game.life[k] = drum.settled_life
            }
        }
        // (the surfaces moved on by the frame's time at the chosen speed)
        surface_time += seconds * MOTION_RATES[speed]
        screen.motion = speed
        // (the brightness slider following its finger, till it's let go)
        if brightness_held {
            if held := pointer_with(pointers, brightness_pointer) is not absent {
                bright = brightness_at(layout, (held.at.x - layout.centre.x) / (CAPSULE_PITCH * cell_of(layout)))
            }
            if !screen.settings_open or let_go(pointers, brightness_pointer) then brightness_held = false
        }
        screen.brightness = bright
        if bright != stored_brightness and !brightness_held {
            if Defaults.set("brightness", bright) is os_error { }
            stored_brightness = bright
        }
        screen.foil_phase = Math.fract(screen.foil_phase + seconds * 0.65)
        screen.foil_time = Math.fract((screen.foil_time + seconds) / 600) * 600
        screen.surface_time = surface_time
        screen.orientation = orientation
        if sideways {
            draw(turned_table, layer, layout, shown, fonts, screen, volleys)
            window_size := V2⟨f32'w.size[0], f32'w.size[1]⟩
            canvas.draw_shader_canvas(V2⟨0, 0⟩, window_size, TURN.code, TURN.bindings.turn, Turn_Params⟨⟩, turned_table, TURN.bindings.drawing,
                                      TURN.bindings.filtering)
        }
        else {
            draw(canvas, layer, layout, shown, fonts, screen, volleys)
        }
        canvas.present(w.handle, vsync: true)
        worked := Time.seconds_since_start() - frame_start
        if busy_frames == 0 {
            first_shown = Time.seconds_since_start()
        }
        else {
            steady += worked
            steady_slowest = Math.max(steady_slowest, worked)
        }
        busy += worked
        slowest = Math.max(slowest, worked)
        busy_frames += 1
        scratch.reset()
        still := !dragging(screen) and screen.moving_end < 0 and !screen.counts.held and !screen.counts.settling and !screen.previewing
        // (still, it waits for input, but only for what's left of the frame
        // after its work: it's drawn at IDLE_FPS even so, as the surfaces
        // move, and anything touched is answered at once)
        if still {
            // (the frame's whole time, its windows' messages too, from the
            // last wait's end)
            left := 1.0 / IDLE_FPS - (Time.seconds_since_start() - woke)
            if left > 0.001 {
                if _ := Window.wait_for_input(milliseconds: u32'(left * 1000)) is timed_out { }
            }
        }
        woke = Time.seconds_since_start()
    }
}
