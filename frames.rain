// How the parts look: in the manner of an era of Magic's card frames, each
// colour's frame a ground colour and a surface over it (Patterns': water
// drops for blue, cracked rock for red, marble for black and gold, and so
// on), made as the screen's drawn, not copied from any card. A part of one
// colour is that colour's frame; of none, an artifact's; of several, gold,
// shaded across toward each of its colours in turn.

// Which era's frames the parts are like (a setting).
Era :: enum u8 {
    ORIGINAL       // 1993 to 2003: painterly, mottled and dark
    MODERN         // 2003 to 2014: smoother, more saturated, silver artifacts
    M15            // 2014 on: finest, lighter and quieter still, brushed metal
}

ERA_NAMES :: [Era] string⟨"Original", "Modern", "M15"⟩

// A frame's look: its ground colour, and the surface over it, its features
// scale cells across.
Look :: struct {
    ground:   Draw.RGBA
    kind:     Patterns.Kind
    scale:    f32
    strength: f32
}

// An era's looks: an artifact's, each colour's, and gold's.
Era_Looks :: struct {
    artifact: Look
    colours:  [Mana] Look
    gold:     Look
}

// Each era's looks. Each later era's features are smaller (finer) and its
// contrast lower (quieter) than the one before's.
LOOKS :: [Era] Era_Looks⟨
    // Original: a grey-brown artifact's grain, an ivory's soft clouds, water
    // drops, black marble, cracked red rock, mottled green, marbled gold.
    ⟨⟨Draw.rgb(0x9A8A76), .GRAIN, 1.0, 0.35⟩,
     ⟨⟨Draw.rgb(0xE6DFCA), .CLOUDS, 2.0, 0.22⟩, ⟨Draw.rgb(0x2A5E9A), .DROPS, 1.3, 0.45⟩, ⟨Draw.rgb(0x2A2521), .MARBLE, 1.8, 0.42⟩,
      ⟨Draw.rgb(0xB3442B), .CRACKS, 1.6, 0.42⟩, ⟨Draw.rgb(0x3A6C39), .MOTTLE, 1.3, 0.42⟩⟩,
     ⟨Draw.rgb(0xC29A3E), .MARBLE, 1.8, 0.32⟩⟩,
    // Modern: silver grain, smoother and brighter colours, three-quarters
    // the size.
    ⟨⟨Draw.rgb(0xA7AFB6), .GRAIN, 0.8, 0.2⟩,
     ⟨⟨Draw.rgb(0xF0ECDF), .CLOUDS, 1.5, 0.14⟩, ⟨Draw.rgb(0x1F6CB4), .CLOUDS, 1.2, 0.26⟩, ⟨Draw.rgb(0x24201F), .MARBLE, 1.4, 0.28⟩,
      ⟨Draw.rgb(0xC64A31), .MOTTLE, 1.0, 0.28⟩, ⟨Draw.rgb(0x2D7A47), .MOTTLE, 1.0, 0.28⟩⟩,
     ⟨Draw.rgb(0xD3AE52), .MARBLE, 1.4, 0.24⟩⟩,
    // M15: brushed silver, the finest, lightest and quietest.
    ⟨⟨Draw.rgb(0xA3ADB5), .BRUSHED, 0.8, 0.2⟩,
     ⟨⟨Draw.rgb(0xF3EFE3), .CLOUDS, 1.1, 0.1⟩, ⟨Draw.rgb(0x1B71C1), .CLOUDS, 1.0, 0.2⟩, ⟨Draw.rgb(0x272320), .MOTTLE, 0.8, 0.2⟩,
      ⟨Draw.rgb(0xCF4B35), .CRACKS, 1.0, 0.16⟩, ⟨Draw.rgb(0x2E8050), .MOTTLE, 0.8, 0.22⟩⟩,
     ⟨Draw.rgb(0xD9B65C), .CLOUDS, 1.0, 0.18⟩⟩
⟩

// Each era's feel, over all its looks: how much the slow variation larger
// than its features counts (broad: Original's painterly swings, M15's
// least), and how much fine grain is over it (Original's rough; Modern's
// smooth; M15's a fine, printed grain).
Era_Feel :: struct {
    broad: f32
    grain: f32
}

ERA_FEELS :: [Era] Era_Feel⟨⟨0.7, 0.22⟩, ⟨0.4, 0.05⟩, ⟨0.25, 0.12⟩⟩

// How fast the surfaces move (a setting): still, or slowly to quickly.
Motion :: enum u8 {
    OFF
    SLOW
    MEDIUM
    FAST
}

MOTION_NAMES :: [Motion] string⟨"Off", "Slow", "Medium", "Fast"⟩

// Each speed, in a surface's features a second.
MOTION_RATES :: [Motion] f32⟨0, 0.04, 0.12, 0.35⟩

// How big the surfaces' features are against the looks' own scales (a
// card's frame is fine-grained for its size, and a part is far bigger).
SURFACE_SCALE :: 0.32

// How far gold leans toward each of a part's colours.
GOLD_TINT :: 0.25

// An era's artifact colour (a colourless player's own colour).
artifact_of :: (era: Era -> Draw.RGBA) #pure {
    return LOOKS[era].artifact.ground
}

////////////////////////////////
// A part's surface, drawn by a shader of its own

// What the part's shader is given: its outline (each point's xy), its
// colours across it (left to right as its player sees it), its life's
// middle and the screen's centre, the way toward its player, how far it
// reaches that way from the centre and the calm area's radius, its turn and
// its left and right (in its player's frame from its middle) and how many
// points; its surface (kind, features' scale in pixels, contrast, seed;
// time, broad, grain, how many colours); and whether it's out or targeted,
// its bevel's width (pixels) and how wide its noise's octaves go.
Part_Params :: struct {
    points: [MAX_OUTLINE] V4
    stops:  [5] V4
    middle: V4
    toward: V4
    frame:  V4
    look:   V4
    more:   V4
    state:  V4
}

// The light the parts are lit by: from the screen's top left (a frame's
// bevel lit on its edges facing it), warm, and their shade cool.
PART_LIGHT :: V2⟨-0.55, -0.83⟩
PART_WARM :: V3⟨1.0, 0.92, 0.76⟩
PART_COOL :: V3⟨0.5, 0.55, 0.74⟩

// A part's colour at a pixel: its colours across it; its surface lightening
// it toward a warm light and darkening it toward a cool shade (not white
// and black: a hue-shifted light and shade, as a painted frame has), quiet
// in a calm pool of light behind its life total; darker toward its
// player's edge (a vignette, so the middle comes forward); and a bevel along
// its edges, lit where an edge faces the light and shaded where it faces
// away. Out, it's dimmed; aimed at, it lifts.
part_shade :: (from: Draw.Quad_Between, part: Shader.Uniforms(Part_Params) -> colour: V4) {
    p := from.pixel
    n := i32'(part.frame.w + 0.5)
    // (inside by the even-odd rule, and how far from its nearest edge, and
    // that edge's way inward)
    *crossings: i32 = 0
    *closest: f32 = 1000000
    *inward := V2⟨0, 0⟩
    for i: 0 < n {
        j := if i + 1 < n then i + 1 else 0
        a := part.points[i].xy
        b := part.points[j].xy
        if (a.y > p.y) != (b.y > p.y) {
            x := a.x + (p.y - a.y) / (b.y - a.y) * (b.x - a.x)
            if p.x < x then crossings += 1
        }
        ab := b - a
        t := Math.clamp(Math.dot(p - a, ab) / Math.max(Math.dot(ab, ab), 0.000001), 0, 1)
        d := Math.length(p - a - ab * t)
        if d < closest {
            closest = d
            *normal := Math.normalize(V2⟨0 - ab.y, ab.x⟩)
            if Math.dot(normal, part.middle.xy - a) < 0 then normal = normal * -1.0
            inward = normal
        }
    }
    signed := if crossings % 2 == 1 then 0 - closest else closest
    coverage := Math.clamp(0.5 - signed, 0, 1)
    if coverage <= 0 then return ⟨0, 0, 0, 0⟩
    // (its colours across it)
    angle := part.frame.x
    d := p - part.middle.xy
    local_x := d.x * Math.cos(angle) + d.y * Math.sin(angle)
    u := Math.clamp((local_x - part.frame.y) / Math.max(part.frame.z - part.frame.y, 1), 0, 1)
    stops := i32'(part.more.w + 0.5)
    *base := part.stops[0].xyz
    if stops > 1 {
        s := u * f32'(stops - 1)
        k := Math.min(i32'Math.floor(s), stops - 2)
        base = Math.mix(part.stops[k].xyz, part.stops[k + 1].xyz, s - f32'k)
    }
    light := Math.mix(base, PART_WARM, 0.55)
    shade := base * PART_COOL
    // (its surface, quiet behind its life)
    calm := 1 - Math.smoothstep(0.45, 1.0, Math.length(d) / part.toward.w)
    v := Patterns.at(Patterns.Kind'i32'(part.look.x + 0.5), p, part.look.y, part.look.w, part.more.x, angle, part.more.y, part.more.z)
    t := Math.clamp((v - 0.5) * 2, -1, 1) * part.look.z * (1 - 0.7 * calm)
    *rgb := if t > 0 then Math.mix(base, light, t) else Math.mix(base, shade, 0 - t)
    rgb = Math.mix(rgb, light, 0.1 * calm)
    // (darker toward its player's edge)
    depth := Math.clamp(Math.dot(p - part.middle.zw, part.toward.xy) / Math.max(part.toward.z, 1), 0, 1)
    rgb = Math.mix(rgb, shade * 0.8, Math.smoothstep(0.55, 1.0, depth) * 0.32)
    // (its bevel)
    bevel := part.state.z
    if closest < bevel {
        k := 1 - closest / bevel
        facing := Math.dot(inward, PART_LIGHT * -1.0)
        lit := if facing > 0 then Math.mix(rgb, V3⟨1, 0.97, 0.9⟩, 0.45) else rgb * 0.45
        rgb = Math.mix(rgb, lit, k * k * Math.abs(facing) * 0.7)
    }
    // (out, dimmed; aimed at, lifted)
    rgb = Math.mix(rgb, V3⟨0.075, 0.075, 0.094⟩, part.state.x * 0.7)
    rgb = Math.mix(rgb, V3⟨1, 1, 1⟩, part.state.y * 0.12)
    colour = V4⟨rgb.x * coverage, rgb.y * coverage, rgb.z * coverage, coverage⟩
}

Part_Surface :: shader { vertex: Draw.quad_place; fragment: part_shade }
PART_SURFACE :: Part_Surface(Draw.SHADER_TARGET)

// How wide a part's bevel is, and its calm area's radius, in cells.
BEVEL_CELLS :: 0.09
CALM_CELLS :: 2.6

// A part drawn by its shader: its colours across it and its era's surface
// (part_fill's), out or aimed at.
draw_part :: (canvas: *Draw.Canvas, layout: Layout, k: i64, colours: [] Draw.RGBA, pattern: Draw.Pattern, out: bool, targeted: bool) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    points := seat.outline[:seat.count]
    *params: Part_Params
    *low := points[0]
    *high := points[0]
    for q, i: points {
        params.points[i] = V4⟨q.x, q.y, 0, 0⟩
        low = Math.min(low, q)
        high = Math.max(high, q)
    }
    *left: f32 = 1e30
    *right: f32 = -1e30
    for q: points {
        l := local_of(seat.middle, seat.angle, q)
        left = Math.min(left, l.x)
        right = Math.max(right, l.x)
    }
    for c, i: colours[:Math.min(colours.count, 5)] { params.stops[i] = V4⟨c.r, c.g, c.b, 1⟩ }
    params.middle = V4⟨seat.middle.x, seat.middle.y, layout.centre.x, layout.centre.y⟩
    params.toward = V4⟨seat.toward.x, seat.toward.y, Math.max(seat.reach, 1), CALM_CELLS * cell⟩
    params.frame = V4⟨seat.angle, left, right, f32'seat.count⟩
    params.look = V4⟨f32'i32'pattern.kind, pattern.scale, pattern.strength, pattern.seed⟩
    params.more = V4⟨pattern.time, pattern.broad, pattern.grain, f32'Math.min(colours.count, 5)⟩
    dimmed: f32 = if out then 1 else 0
    lifted: f32 = if targeted then 1 else 0
    params.state = V4⟨dimmed, lifted, BEVEL_CELLS * cell, cell⟩
    canvas.draw_shader(low, high - low, PART_SURFACE.code, PART_SURFACE.bindings.part, params)
}

// A part's fill, for its player's colours in an era: its gradient's colours
// (into, how many) and its surface (features sized in pixels, cell's
// share, seeded by its seat so neighbours differ, moved to time, turned to
// face its player as their text is: its water falls toward them).
part_fill :: (era: Era, identity: Identity, cell: f32, seat: i64, time: f32, angle: f32, into: [] *Draw.RGBA -> count: i64, pattern: Draw.Pattern) #pure {
    looks := LOOKS[era]
    *colours: i64 = 0
    *only := Mana.WHITE
    for _, colour: looks.colours {
        if has_colour(identity, colour) {
            colours += 1
            only = colour
        }
    }
    *look := looks.artifact
    count = 0
    if colours >= 2 {
        // Gold, shaded across toward each colour (WUBRG).
        look = looks.gold
        for each, colour: looks.colours {
            if has_colour(identity, colour) {
                into[count] = Math.mix(look.ground, each.ground, GOLD_TINT)
                count += 1
            }
        }
    }
    else {
        if colours == 1 then look = looks.colours[only]
        // (one colour: its ground, lit and shaded by its surface)
        into[0] = look.ground
        count = 1
    }
    // (every part's features one size in an era, and quieter than the
    // looks' own contrast: the surface stays behind what's on it)
    pattern = ⟨kind: look.kind, scale: ERA_SCALES[era] * SURFACE_SCALE * cell, strength: look.strength * SURFACE_QUIET, seed: f32'(seat + 1), time: time,
               angle: angle, broad: ERA_FEELS[era].broad, grain: ERA_FEELS[era].grain⟩
}

// Each era's features' size (against SURFACE_SCALE), one for all its
// parts, and how much of a look's contrast a part's surface keeps.
ERA_SCALES :: [Era] f32⟨1.5, 1.15, 0.9⟩
SURFACE_QUIET :: 0.6
