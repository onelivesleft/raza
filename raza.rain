// Raza: a damage tracker for Commander, for a tablet in the middle of the
// table. Each player has a part of the screen, their life total in it
// facing them, and a damage icon toward the centre: dragged into another
// player's part, it deals that player commander damage, more the further it
// goes (up to 20, then a number to pick, 21 to start with). The parts start
// equal in area, and a line between two is moved by dragging its end along
// the edge. The capsule in the middle undoes, shows how many play (a person
// each: touched, the other counts show above and below it, to drag to for
// a new game), and will hold the settings; the corner button switches the
// text between Crimson Pro and EB Garamond. The game, the font and each
// count's lines are kept from one run to the next (Defaults', the registry's).
//
//     rain -run raza.rain

Raza :: program {
    subsystem: .WINDOWS
}

#import Draw(RENDERER: .VULKAN)
#import Window
#import Math
#import System
#import Wide
#import Arguments
#import Defaults

#include "layout.rain"
#include "game.rain"

V2 :: #alias Math.Vector2(f32)

// The fonts, carried in the program.
MANA        :: #data "fonts/mana/mana.ttf"
CRIMSON_PRO :: #data "fonts/crimson_pro/CrimsonPro[wght].ttf"
EB_GARAMOND :: #data "fonts/eb_garamond/EBGaramond[wght].ttf"

TEXT_FAMILIES :: [2] string⟨"Crimson Pro", "EB Garamond"⟩
ICON_FAMILY   :: "Mana"

// Mana's ms-power, the damage icon's glyph.
DAMAGE_GLYPH :: "\u{E921}"

BACKGROUND :: Draw.rgb(0x131318)
INK        :: Draw.rgb(0xF4EFE6)
CAPSULE    :: Draw.rgb(0x26262E)
SEAT_COLOURS :: [MAX_PLAYERS] Draw.RGBA⟨Draw.rgb(0x6A3D7A), Draw.rgb(0x2F6B57), Draw.rgb(0x8A4030), Draw.rgb(0x2F527F),
                                       Draw.rgb(0x86712C), Draw.rgb(0x55556B)⟩

// The unit the controls are measured in: a share of the screen's shorter side.
CELL_SHARE :: 0.075

cell_of :: (layout: Layout -> f32) #pure {
    return Math.min(layout.size.x, layout.size.y) * CELL_SHARE
}

// A colour toward white.
lighter :: (colour: Draw.RGBA, by: f32 -> Draw.RGBA) #pure {
    return Math.mix(colour, INK, by)
}

////////////////////////////////
// Fonts

Fonts :: struct {
    life:      Draw.Font         // the life totals
    life_size: i32               // ...its size
    small:     Draw.Font         // commander damage
    label:     Draw.Font         // the number grid's buttons
    output:    Draw.Font         // the number grid's number
    icon:      Draw.Font         // Mana's, for the damage icon
}

// How many steps of size a cell has for the life totals: the size moves in
// these as a line's end is dragged, so only a few sizes' glyphs are ever
// drawn (each size's are kept for good once drawn).
LIFE_STEPS :: 8

// The life totals' size for a layout: as big as the smallest part has room
// for (every part's the same), from 1 to 6 cells, in steps of an eighth of
// a cell.
life_size_of :: (layout: Layout -> i32) #pure {
    cell := cell_of(layout)
    *room: f32 = 1e30
    for seat: layout.seats[:layout.count] { room = Math.min(room, seat.room) }
    wanted := Math.clamp(room * 1.15, cell, 6 * cell)
    step := cell / LIFE_STEPS
    return i32'Math.round(Math.round(wanted / step) * step)
}

// The life totals' font made again, if the layout wants another size: as a
// line's end is dragged, each frame.
resize_life :: (fonts: *Fonts, family: string, layout: Layout) [os_error: Draw.Draw_Error] {
    size := life_size_of(layout)
    if size == fonts.life_size then return
    fonts.life.destroy()
    if big := Draw.load_font(family, size, 500) { fonts.life = big } else if os_error { fail: os_error }
    fonts.life_size = size
}

// The fonts for a layout, the text in a family.
load_fonts :: (family: string, layout: Layout -> fonts: Fonts) [os_error: Draw.Draw_Error] {
    fonts = ⟨⟩
    cell := cell_of(layout)
    life := life_size_of(layout)
    if big := Draw.load_font(family, life, 500) { fonts.life = big } else if os_error { fail: os_error }
    fonts.life_size = life
    if small := Draw.load_font(family, i32'(cell * 0.42), 600) { fonts.small = small } else if os_error { fail: os_error }
    if label := Draw.load_font(family, i32'(cell * 0.45), 500) { fonts.label = label } else if os_error { fail: os_error }
    if output := Draw.load_font(family, i32'(cell * 0.8), 500) { fonts.output = output } else if os_error { fail: os_error }
    if icon := Draw.load_font(ICON_FAMILY, i32'(cell * 0.6)) { fonts.icon = icon } else if os_error { fail: os_error }
}

// The fonts made again, for a new layout or family.
reload_fonts :: (fonts: *Fonts, family: string, layout: Layout) [os_error: Draw.Draw_Error] {
    fonts.life.destroy()
    fonts.small.destroy()
    fonts.label.destroy()
    fonts.output.destroy()
    fonts.icon.destroy()
    if loaded := load_fonts(family, layout) { fonts = loaded } else if os_error { fail: os_error }
}

////////////////////////////////
// Dragging, and the number grid

// A drag from a player's damage icon, while the button's down.
Drag :: struct {
    active: bool
    from:   i64
}

// Where a line from one point to another first comes into a polygon: found
// along it, then halved down to the edge.
entry_point :: (from: V2, to: V2, points: [] V2 -> V2) #pure {
    SAMPLES :: 64
    *outside: f32 = 0
    *within: f32 = 1
    for i: 0 <= SAMPLES {
        t := f32'i / SAMPLES
        if inside(from + (to - from) * t, points) {
            within = t
            break
        }
        outside = t
    }
    for _: 0 < 16 {
        t := (outside + within) / 2
        if inside(from + (to - from) * t, points) then within = t else outside = t
    }
    return from + (to - from) * within
}

// What a drag from a player's icon to a point does: the player whose part
// it's in, and how much, by how far toward that player it's come since it
// came in. Missed if it's in no other player's part, or one who's out.
aim :: (layout: Layout, game: Game, from: i64, at: V2 -> to: i64, amount: Drag_Amount) [missed] {
    to = -1
    amount = Drag_Amount.damage(1)
    if target := seat_at(layout, at) is absent then fail: missed
    if target == from or is_out(game, target) then fail: missed
    seat := layout.seats[target]
    entry := entry_point(layout.seats[from].icon, at, seat.outline[:seat.count])
    inner := Math.dot(entry - layout.centre, seat.toward)
    depth := Math.dot(at - layout.centre, seat.toward)
    share := if seat.reach - inner > 1 then (depth - inner) / (seat.reach - inner) else 1
    to = target
    amount = amount_for(share)
}

// The number grid, asked for by a drag to the far edge: tens, then units,
// then a tick or a cross. It faces the player who dragged.
Picker :: struct {
    open:  bool
    from:  i64
    to:    i64
    tens:  i32
    units: i32
}

DEFAULT_PICKED :: 21

// The parts of the number grid, in its own frame (centred on the screen,
// x along its text), in cells.
PANEL_LOW    :: V2⟨-5.4, -2.0⟩
PANEL_HIGH   :: V2⟨5.4, 2.0⟩
TENS_TOP     :: -1.8
UNITS_TOP    :: -0.75
ROW_HEIGHT   :: 0.9
BOTTOM_TOP   :: 0.4
BOTTOM_LOW   :: 1.7
OUTPUT_RIGHT :: 1.2
ACCEPT_LEFT  :: 1.4
ACCEPT_RIGHT :: 3.1
CANCEL_LEFT  :: 3.3
GRID_LEFT    :: -5.0

Picker_Part :: union {
    tens: i32
    units: i32
    accept
    cancel
    panel
    outside
}

// What of the number grid is at a point of the screen.
picker_part_at :: (layout: Layout, picker: Picker, at: V2 -> Picker_Part) #pure {
    cell := cell_of(layout)
    p := local_of(layout.centre, layout.seats[picker.from].angle, at) / cell
    if p.x < PANEL_LOW.x or p.x > PANEL_HIGH.x or p.y < PANEL_LOW.y or p.y > PANEL_HIGH.y then return Picker_Part.outside
    column := i32'Math.floor(p.x - GRID_LEFT)
    if column >= 0 and column < 10 {
        if p.y >= TENS_TOP and p.y < TENS_TOP + ROW_HEIGHT then return Picker_Part.tens(column)
        if p.y >= UNITS_TOP and p.y < UNITS_TOP + ROW_HEIGHT then return Picker_Part.units(column)
    }
    if p.y >= BOTTOM_TOP and p.y < BOTTOM_LOW {
        if p.x >= ACCEPT_LEFT and p.x < ACCEPT_RIGHT then return Picker_Part.accept
        if p.x >= CANCEL_LEFT and p.x < -GRID_LEFT then return Picker_Part.cancel
    }
    return Picker_Part.panel
}

////////////////////////////////
// The capsule in the middle, and the font button in the corner

Capsule_Part :: enum u8 {
    UNDO
    PLAYERS
    SETTINGS
}

// A person a player is shown as (in cells), and how far apart a row of
// them are.
PERSON_STEP :: 0.28

// How wide a row of people is, in cells.
people_width :: (players: i64 -> f32) #pure {
    return f32'players * PERSON_STEP
}

// How wide the players' button is, in cells: its people, with room round them.
players_width :: (players: i64 -> f32) #pure {
    return Math.max(people_width(players) + 0.4, 1)
}

// The capsule's buttons' middles, in a row at the screen's centre: undo,
// the players (as wide as its people), settings.
capsule_centre :: (layout: Layout, part: Capsule_Part, players: i64 -> V2) #pure {
    cell := cell_of(layout)
    half := players_width(players) / 2
    offset: f32 = if part is { case .UNDO: -(half + 0.6); case .PLAYERS: 0; case .SETTINGS: half + 0.6 }
    return layout.centre + V2⟨offset * cell, 0⟩
}

// The capsule's half width, in cells.
capsule_half_width :: (players: i64 -> f32) #pure {
    return players_width(players) / 2 + 1.25
}

// The capsule's button at a point, or absent.
capsule_part_at :: (layout: Layout, at: V2, players: i64 -> Capsule_Part) [absent] {
    cell := cell_of(layout)
    for part: [3] Capsule_Part⟨.UNDO, .PLAYERS, .SETTINGS⟩ {
        centre := capsule_centre(layout, part, players)
        half_width := if part == .PLAYERS then players_width(players) / 2 else 0.5
        if Math.abs(at.x - centre.x) <= half_width * cell and Math.abs(at.y - centre.y) <= 0.6 * cell then return part
    }
    fail: absent
}

// The count of players picked from: touched, the players' button shows
// each other count above or below it (fewer above), to drag to and let go
// on; let go on the button itself, it stays open for a second touch.
Count_Picker :: struct {
    open: bool
    held: bool               // the button's down since it opened
}

// Where a count's row is, beside the current count's (the button's).
count_row :: (layout: Layout, players: i64, count: i64 -> V2) #pure {
    return capsule_centre(layout, .PLAYERS, players) + V2⟨0, f32'(count - players) * 1.1 * cell_of(layout)⟩
}

// The count whose row a point is on, other than the current, or absent.
count_at :: (layout: Layout, players: i64, at: V2 -> i64) [absent] {
    cell := cell_of(layout)
    for count: 2 <= MAX_PLAYERS {
        if count == players then continue
        row := count_row(layout, players, count)
        if Math.abs(at.x - row.x) <= players_width(count) / 2 * cell and Math.abs(at.y - row.y) <= 0.55 * cell then return count
    }
    fail: absent
}

font_button :: (layout: Layout -> at: V2, size: V2) #pure {
    cell := cell_of(layout)
    size = ⟨cell, cell⟩
    at = layout.size - V2⟨1.25 * cell, 1.25 * cell⟩
}

in_font_button :: (layout: Layout, p: V2 -> bool) #pure {
    at, size := font_button(layout)
    return p.x >= at.x and p.y >= at.y and p.x < at.x + size.x and p.y < at.y + size.y
}

////////////////////////////////
// Drawing

// Text centred on a point, turned to read the right way up at angle.
draw_centred :: (canvas: *Draw.Canvas, font: Draw.Font, middle: V2, angle: f32, text: string, colour: Draw.RGBA) {
    width := f32'font.text_width(text)
    at := placed(middle, angle, ⟨-width / 2, f32'font.cap_height / 2⟩)
    canvas.draw_text(font, at, text, colour, angle)
}

// A box of a frame turned a whole number of quarters (as every player's
// is), from at to at + size in the frame, as the rounded box it is on the
// screen.
fill_turned_box :: (canvas: *Draw.Canvas, origin: V2, angle: f32, at: V2, size: V2, radius: f32, colour: Draw.RGBA) {
    a := placed(origin, angle, at)
    b := placed(origin, angle, at + size)
    low := V2⟨Math.min(a.x, b.x), Math.min(a.y, b.y)⟩
    high := V2⟨Math.max(a.x, b.x), Math.max(a.y, b.y)⟩
    canvas.fill_rounded_rect(low, high - low, radius, colour)
}

draw_seat :: (canvas: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, k: i64, targeted: bool) {
    seat := layout.seats[k]
    cell := cell_of(layout)
    out := is_out(game, k)
    base := SEAT_COLOURS[k]
    fill := if out then Math.mix(base, BACKGROUND, 0.7) else if targeted then lighter(base, 0.15) else base
    canvas.fill_polygon(seat.outline[:seat.count], fill)
    ink := if out then Math.mix(INK, fill, 0.6) else INK
    draw_centred(canvas, fonts.life, seat.middle, seat.angle, "«game.life[k]»", ink)
    // The commander damage it's taken, a chip in each commander's colour,
    // in a row below its life.
    *shown: i64 = 0
    for d: game.commander[k][:game.players] { if d > 0 then shown += 1 }
    row := f32'fonts.life.cap_height / 2 + 0.75 * cell
    *place: i64 = 0
    for d, from: game.commander[k][:game.players] {
        if d <= 0 then continue
        x := (f32'place - f32'(shown - 1) / 2) * 0.95 * cell
        middle := placed(seat.middle, seat.angle, ⟨x, row⟩)
        // (a lethal one ringed in white)
        lethal := d >= LETHAL_COMMANDER_DAMAGE
        ring := if lethal then INK else SEAT_COLOURS[from]
        chip := if lethal then SEAT_COLOURS[from] else lighter(SEAT_COLOURS[from], 0.1)
        canvas.fill_circle(middle, 0.4 * cell, ring)
        canvas.fill_circle(middle, 0.4 * cell - 3, chip)
        draw_centred(canvas, fonts.small, middle, seat.angle, "«d»", INK)
        place += 1
    }
    if !out {
        canvas.fill_circle(seat.icon, 0.45 * cell, lighter(base, 0.35))
        draw_centred(canvas, fonts.icon, seat.icon, seat.angle, DAMAGE_GLYPH, Math.mix(base, BACKGROUND, 0.5))
    }
}

draw_drag :: (canvas: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, drag: Drag, mouse: V2) {
    cell := cell_of(layout)
    seat := layout.seats[drag.from]
    colour := lighter(SEAT_COLOURS[drag.from], 0.5)
    start := seat.icon
    along := mouse - start
    if Math.length(along) < 2 then return
    d := Math.normalize(along)
    across := V2⟨-d.y, d.x⟩
    tip := mouse
    base := tip - d * 0.4 * cell
    canvas.draw_line(start, base, 0.14 * cell, colour)
    canvas.fill_polygon(⟨tip, base + across * 0.24 * cell, base - across * 0.24 * cell⟩, colour)
    // How much, by the finger, facing whoever's dragging.
    if to, amount := aim(layout, game, drag.from, mouse) is not missed {
        bubble := placed(mouse, seat.angle, ⟨0, -1.15 * cell⟩)
        canvas.fill_circle(bubble, 0.55 * cell, INK)
        text := if amount is { case damage: "«damage»"; case asked: "?" }
        draw_centred(canvas, fonts.output, bubble, seat.angle, text, SEAT_COLOURS[to])
    }
}

draw_picker :: (canvas: *Draw.Canvas, layout: Layout, fonts: Fonts, picker: Picker) {
    cell := cell_of(layout)
    origin := layout.centre
    angle := layout.seats[picker.from].angle
    accent := SEAT_COLOURS[picker.from]
    canvas.fill_rect(⟨0, 0⟩, layout.size, Draw.rgba(0x000000, 0.45))
    fill_turned_box(canvas, origin, angle, PANEL_LOW * cell, (PANEL_HIGH - PANEL_LOW) * cell, 0.3 * cell, CAPSULE)
    for column: 0 < 10 {
        left := (GRID_LEFT + f32'column + 0.05) * cell
        width := 0.9 * cell
        for row: 0 < 2 {
            row_top: f32 = if row == 0 then TENS_TOP else UNITS_TOP
            top := row_top * cell
            chosen := if row == 0 then picker.tens == i32'column else picker.units == i32'column
            key := if chosen then accent else lighter(CAPSULE, 0.08)
            fill_turned_box(canvas, origin, angle, ⟨left, top⟩, ⟨width, ROW_HEIGHT * cell - 0.1 * cell⟩, 0.15 * cell, key)
            label := if row == 0 then "«column»0" else "«column»"
            middle := placed(origin, angle, ⟨left + width / 2, top + (ROW_HEIGHT - 0.1) * cell / 2⟩)
            draw_centred(canvas, fonts.label, middle, angle, label, INK)
        }
    }
    // The number, then the tick and the cross.
    top := BOTTOM_TOP * cell
    height := (BOTTOM_LOW - BOTTOM_TOP) * cell
    fill_turned_box(canvas, origin, angle, ⟨GRID_LEFT * cell, top⟩, ⟨(OUTPUT_RIGHT - GRID_LEFT) * cell, height⟩, 0.2 * cell, BACKGROUND)
    value := picker.tens * 10 + picker.units
    draw_centred(canvas, fonts.output, placed(origin, angle, ⟨(GRID_LEFT + OUTPUT_RIGHT) / 2 * cell, top + height / 2⟩), angle,
                 "«value»", INK)
    fill_turned_box(canvas, origin, angle, ⟨ACCEPT_LEFT * cell, top⟩, ⟨(ACCEPT_RIGHT - ACCEPT_LEFT) * cell, height⟩, 0.2 * cell,
                    Draw.rgb(0x2F7A4A))
    fill_turned_box(canvas, origin, angle, ⟨CANCEL_LEFT * cell, top⟩, ⟨(-GRID_LEFT - CANCEL_LEFT) * cell, height⟩, 0.2 * cell,
                    Draw.rgb(0x8A3030))
    tick := V2⟨(ACCEPT_LEFT + ACCEPT_RIGHT) / 2 * cell, top + height / 2⟩
    s := 0.3 * cell
    stroke := 0.12 * cell
    canvas.draw_line(placed(origin, angle, tick + V2⟨-s, 0⟩), placed(origin, angle, tick + V2⟨-s / 3, s * 0.7⟩), stroke, INK)
    canvas.draw_line(placed(origin, angle, tick + V2⟨-s / 3, s * 0.7⟩), placed(origin, angle, tick + V2⟨s, -s * 0.7⟩), stroke, INK)
    cross := V2⟨(CANCEL_LEFT - GRID_LEFT) / 2 * cell, top + height / 2⟩
    canvas.draw_line(placed(origin, angle, cross + V2⟨-s, -s⟩), placed(origin, angle, cross + V2⟨s, s⟩), stroke, INK)
    canvas.draw_line(placed(origin, angle, cross + V2⟨-s, s⟩), placed(origin, angle, cross + V2⟨s, -s⟩), stroke, INK)
}

// A row of people, a count of them, centred on a point.
draw_people :: (canvas: *Draw.Canvas, centre: V2, count: i64, cell: f32, colour: Draw.RGBA) {
    left := centre.x - people_width(count) / 2 * cell
    for i: 0 < count {
        x := left + (f32'i + 0.5) * PERSON_STEP * cell
        // (a head, and shoulders: a pill wider than it's tall)
        canvas.fill_circle(V2⟨x, centre.y - 0.11 * cell⟩, 0.065 * cell, colour)
        canvas.fill_rounded_rect(V2⟨x - 0.11 * cell, centre.y - 0.01 * cell⟩, V2⟨0.22 * cell, 0.15 * cell⟩, 0.075 * cell, colour)
    }
}

draw_capsule :: (canvas: *Draw.Canvas, layout: Layout, game: Game, screen: Screen_State) {
    cell := cell_of(layout)
    c := layout.centre
    half := capsule_half_width(game.players) * cell
    canvas.fill_rounded_rect(c - V2⟨half, 0.6 * cell⟩, V2⟨2 * half, 1.2 * cell⟩, 0.6 * cell, CAPSULE)
    // The players: a person each.
    p := capsule_centre(layout, .PLAYERS, game.players)
    if screen.counts.open {
        width := players_width(game.players) * cell
        canvas.fill_rounded_rect(p - V2⟨width / 2, 0.5 * cell⟩, V2⟨width, cell⟩, 0.5 * cell, lighter(CAPSULE, 0.12))
    }
    draw_people(canvas, p, game.players, cell, INK)
    // Undo: an arrow round to the left.
    u := capsule_centre(layout, .UNDO, game.players)
    undo_ink := if screen.can_undo then INK else lighter(CAPSULE, 0.25)
    r := 0.22 * cell
    stroke := 0.09 * cell
    half_pi := f32'Math.PI / 2
    STEPS :: 12
    for i: 0 < STEPS {
        a0 := 2 * half_pi + f32'i / STEPS * 2.5 * half_pi
        a1 := 2 * half_pi + f32'(i + 1) / STEPS * 2.5 * half_pi
        canvas.draw_line(u + V2⟨Math.cos(a0), Math.sin(a0)⟩ * r, u + V2⟨Math.cos(a1), Math.sin(a1)⟩ * r, stroke, undo_ink)
    }
    head := u + V2⟨-r, 0⟩
    canvas.fill_polygon(⟨head + V2⟨-0.13 * cell, -0.02 * cell⟩, head + V2⟨0.13 * cell, -0.02 * cell⟩, head + V2⟨0, 0.15 * cell⟩⟩, undo_ink)
    // Settings (to come): a gear, faded.
    g := capsule_centre(layout, .SETTINGS, game.players)
    gear := lighter(CAPSULE, 0.3)
    for i: 0 < 8 {
        a := f32'i / 8 * 4 * half_pi
        d := V2⟨Math.cos(a), Math.sin(a)⟩
        canvas.draw_line(g + d * 0.12 * cell, g + d * 0.27 * cell, 0.1 * cell, gear)
    }
    canvas.fill_circle(g, 0.2 * cell, gear)
    canvas.fill_circle(g, 0.08 * cell, CAPSULE)
}

draw_font_button :: (canvas: *Draw.Canvas, layout: Layout, fonts: Fonts) {
    at, size := font_button(layout)
    canvas.fill_rounded_rect(at, size, 0.2 * size.x, CAPSULE)
    draw_centred(canvas, fonts.label, at + size / 2, 0, "Aa", INK)
}

// The other counts of players, a row each above or below the capsule's
// (fewer above), the one under the finger lit.
draw_counts :: (canvas: *Draw.Canvas, layout: Layout, game: Game, screen: Screen_State) {
    cell := cell_of(layout)
    *hovered: i64 = 0
    if at := count_at(layout, game.players, screen.mouse) is not absent then hovered = at
    for count: 2 <= MAX_PLAYERS {
        if count == game.players then continue
        row := count_row(layout, game.players, count)
        width := players_width(count) * cell
        fill := if count == hovered then lighter(CAPSULE, 0.3) else CAPSULE
        canvas.fill_rounded_rect(row - V2⟨width / 2, 0.5 * cell⟩, V2⟨width, cell⟩, 0.5 * cell, fill)
        draw_people(canvas, row, count, cell, INK)
    }
}

// What's happening on the screen besides the game: what's being dragged,
// and what's open.
Screen_State :: struct {
    drag:       Drag
    picker:     Picker
    counts:     Count_Picker
    moving_end: i64 = -1         // the line whose end is being dragged along the edge
    mouse:      V2
    can_undo:   bool
}

draw :: (canvas: *Draw.Canvas, layout: Layout, game: Game, fonts: Fonts, screen: Screen_State) {
    cell := cell_of(layout)
    canvas.clear(BACKGROUND)
    *targeted: i64 = -1
    if screen.drag.active {
        if to, _ := aim(layout, game, screen.drag.from, screen.mouse) is not missed then targeted = to
    }
    for k: 0 < layout.count { draw_seat(canvas, layout, game, fonts, k, k == targeted) }
    // The lines between the parts, and a handle at each's end to move it by.
    for end, k: layout.ends[:layout.count] {
        moving := k == screen.moving_end
        width: f32 = if moving then 9 else 5
        line := if moving then INK else BACKGROUND
        handle := if moving then INK else lighter(BACKGROUND, 0.12)
        canvas.draw_line(layout.centre, end, width, line)
        canvas.fill_circle(end, 0.22 * cell, handle)
    }
    draw_capsule(canvas, layout, game, screen)
    draw_font_button(canvas, layout, fonts)
    if screen.counts.open then draw_counts(canvas, layout, game, screen)
    if screen.drag.active then draw_drag(canvas, layout, game, fonts, screen.drag, screen.mouse)
    if screen.picker.open then draw_picker(canvas, layout, fonts, screen.picker)
}

////////////////////////////////
// Snapshots: what each count of players looks like, without a window

// A game of a count of players part way through: some commander damage
// (one of it lethal, with six), and the drag and the grid to show.
sample_game :: (players: i64 -> game: Game) {
    game = new_game(players)
    game.deal(1, 0, 7)
    game.deal(2, 0, 3)
    game.deal(0, 1, 12)
    if players >= 3 then game.deal(1, 2, 5)
    if players >= 6 then game.deal(3, 5, 21)
}

// Each count of players drawn as a tablet in landscape (and two in
// portrait too), a drag from the second player's icon half way into the
// first's part, into folder as raza_2.png and the like; and the number
// grid, facing the second, as raza_grid.png.
save_snapshots :: (folder: string) [failed: string] {
    sizes := [6] Wide.i32x2⟨⟨1440, 2160⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩, ⟨2160, 1440⟩⟩
    counts := [6] i64⟨2, 2, 3, 4, 5, 6⟩
    names := [6] string⟨"raza_2_portrait", "raza_2", "raza_3", "raza_4", "raza_5", "raza_6"⟩
    for size, i: sizes {
        *canvas: Draw.Canvas
        if c := Draw.create_canvas(size) { canvas = c } else if os_error { fail: failed = "no canvas: «os_error»" }
        defer canvas.destroy()
        game := sample_game(counts[i])
        screen_size := V2⟨f32'size[0], f32'size[1]⟩
        layout := lay_out(screen_size, equal_splits(game.players, screen_size))
        *fonts: Fonts
        if fonts.reload_fonts(TEXT_FAMILIES[i % 2], layout) is os_error then fail: failed = "no font: «os_error»"
        // Half way from where the line comes into the first's part to its
        // far edge.
        target := layout.seats[0]
        entry := entry_point(layout.seats[1].icon, target.middle, target.outline[:target.count])
        inner := Math.dot(entry - layout.centre, target.toward)
        finger := entry + target.toward * (target.reach - inner) * 0.5
        draw(canvas, layout, game, fonts, ⟨drag: ⟨true, 1⟩, mouse: finger, can_undo: true⟩)
        path := `scratch "«folder»/«names[i]».png"
        if canvas.save_png(path) is os_error then fail: failed = "can't write «path»: «os_error»"
        if counts[i] == 4 {
            picker := Picker⟨true, 1, 0, DEFAULT_PICKED / 10, DEFAULT_PICKED % 10⟩
            draw(canvas, layout, game, fonts, ⟨picker: picker, mouse: finger, can_undo: true⟩)
            grid_path := `scratch "«folder»/raza_grid.png"
            if canvas.save_png(grid_path) is os_error then fail: failed = "can't write «grid_path»: «os_error»"
            // The counts open, the finger on six's row.
            draw(canvas, layout, game, fonts, ⟨counts: ⟨true, true⟩, mouse: count_row(layout, 4, 6), can_undo: true⟩)
            counts_path := `scratch "«folder»/raza_counts.png"
            if canvas.save_png(counts_path) is os_error then fail: failed = "can't write «counts_path»: «os_error»"
        }
    }
}

////////////////////////////////
// The program

Options :: struct {
    snapshot: string ⟦help: "draw each count of players into PNGs in this folder (raza_2.png to raza_6.png, and raza_grid.png), and quit"⟧
}

main :: (args: [] string) [failed: string] {
    if Draw.add_font(MANA) is bad_font then fail: failed = "Mana isn't a font Draw can read"
    if Draw.add_font(CRIMSON_PRO) is bad_font then fail: failed = "Crimson Pro isn't a font Draw can read"
    if Draw.add_font(EB_GARAMOND) is bad_font then fail: failed = "EB Garamond isn't a font Draw can read"
    *options: Options
    if parsed := args.parse(Options, about: "Raza: a damage tracker for Commander, for a tablet in the middle of the table.") {
        options = parsed
    }
    else if help {
        fail: failed = help
    }
    else if bad_arguments {
        fail: failed = bad_arguments
    }
    if options.snapshot != "" {
        if save_snapshots(options.snapshot) is failed then fail: failed
        return
    }
    #with System.keep_awake()

    *w: ^Window = null
    if made := Window.create_window("", ⟨1280, 800⟩, background: 0x131318) { w = made } else if os_error {
        fail: failed = "can't open a window: «os_error»"
    }
    w.set_fullscreen(true)
    *canvas: Draw.Canvas
    if c := Draw.create_canvas(w.size, w.handle) { canvas = c } else if os_error { fail: failed = "no canvas: «os_error»" }

    // The game, the font and each count of players' lines (splits[n] for n
    // players), as they were left last time (Defaults': the registry's), or
    // a new game of four, Crimson Pro, and lines as equal_splits starts them.
    *game := Defaults.get("game", new_game(4))
    if game.players < 2 or game.players > MAX_PLAYERS then game = new_game(4)
    *history: [..] Game
    *family := Math.clamp(Defaults.get("font", i64'0), 0, 1)
    *splits: [MAX_PLAYERS + 1] Splits
    for n: 2 <= MAX_PLAYERS { splits[n] = Defaults.get(`scratch "splits.«n»", Splits⟨⟩) }
    // (what was last stored, to store again only what's changed)
    *stored_game := game
    *stored_family := family
    *layout: Layout
    *fonts: Fonts
    *fonts_for := V2⟨0, 0⟩           // the size the fonts were made for (0: none yet)
    *fonts_players: i64 = 0          // ...and the count of players
    *screen: Screen_State

    while Window.update_windows() {
        if w.close_requested then w.destroy()
        if !w.is_open then break
        size := V2⟨f32'w.size[0], f32'w.size[1]⟩
        if canvas.size != w.size {
            if canvas.resize(w.size) is os_error then fail: failed = "can't resize the canvas"
        }
        // The screen laid out each frame (its lines may be moving), and its
        // fonts made again for a new size or count, or once a line's let go.
        if !splits_fit(splits[game.players], game.players) then splits[game.players] = equal_splits(game.players, size)
        layout = lay_out(size, splits[game.players])
        if size != fonts_for or game.players != fonts_players {
            if fonts.reload_fonts(TEXT_FAMILIES[family], layout) is os_error then fail: failed = "no font: «os_error»"
            fonts_for = size
            fonts_players = game.players
        }
        mouse := V2⟨f32'w.mouse.position[0], f32'w.mouse.position[1]⟩
        screen.mouse = mouse
        cell := cell_of(layout)

        if w.keys[.F11].PRESSED then w.set_fullscreen(!w.is_fullscreen)
        if w.keys[.ESCAPE].PRESSED {
            if screen.picker.open then screen.picker.open = false
            else if screen.counts.open then screen.counts.open = false
            else if w.is_fullscreen then w.set_fullscreen(false)
        }
        if w.keys[.Z].PRESSED and w.modifiers.CONTROL and history.count > 0 then game = history.pop()

        if w.mouse.buttons[.LEFT].PRESSED {
            if screen.picker.open {
                part := picker_part_at(layout, screen.picker, mouse)
                if part is {
                case tens: screen.picker.tens = tens
                case units: screen.picker.units = units
                case accept:
                    value := screen.picker.tens * 10 + screen.picker.units
                    if value > 0 {
                        history.add(game)
                        game.deal(screen.picker.from, screen.picker.to, value)
                    }
                    screen.picker.open = false
                case cancel, outside: screen.picker.open = false
                case panel: _
                }
            }
            else if screen.counts.open {
                // (open from a touch let go on the button: a second touch picks, or closes it)
                if count := count_at(layout, game.players, mouse) is not absent {
                    history.add(game)
                    game = new_game(count)
                }
                screen.counts.open = false
            }
            else if in_font_button(layout, mouse) {
                family = 1 - family
                if fonts.reload_fonts(TEXT_FAMILIES[family], layout) is os_error then fail: failed = "no font: «os_error»"
            }
            else if part := capsule_part_at(layout, mouse, game.players) is not absent {
                if part is {
                case .UNDO:
                    if history.count > 0 then game = history.pop()
                case .PLAYERS:
                    screen.counts = ⟨open: true, held: true⟩
                case .SETTINGS: _
                }
            }
            else if end := end_at(layout, mouse, 0.6 * cell) is not absent {
                screen.moving_end = end
            }
            else {
                for k: 0 < layout.count {
                    if !is_out(game, k) and Math.length(mouse - layout.seats[k].icon) <= 0.5 * cell {
                        screen.drag = ⟨true, k⟩
                    }
                }
            }
        }
        // A line's end follows the finger along the edge, kept between its
        // neighbours.
        if screen.moving_end >= 0 {
            splits[game.players].move_split(screen.moving_end, share_at(size, mouse))
            layout = lay_out(size, splits[game.players])
            // (the life totals sized to the parts as they move)
            if fonts.resize_life(TEXT_FAMILIES[family], layout) is os_error then fail: failed = "no font: «os_error»"
        }
        if w.mouse.buttons[.LEFT].RELEASED {
            if screen.drag.active {
                if to, amount := aim(layout, game, screen.drag.from, mouse) is not missed {
                    if amount is {
                    case damage:
                        history.add(game)
                        game.deal(screen.drag.from, to, damage)
                    case asked:
                        screen.picker = ⟨true, screen.drag.from, to, DEFAULT_PICKED / 10, DEFAULT_PICKED % 10⟩
                    }
                }
                screen.drag.active = false
            }
            if screen.moving_end >= 0 {
                screen.moving_end = -1
                if Defaults.set(`scratch "splits.«game.players»", splits[game.players]) is os_error { }
            }
            if screen.counts.open and screen.counts.held {
                screen.counts.held = false
                if count := count_at(layout, game.players, mouse) is not absent {
                    history.add(game)
                    game = new_game(count)
                    screen.counts.open = false
                }
                else {
                    // (let go on the button itself: it stays open for a second touch)
                    *on_button := false
                    if over := capsule_part_at(layout, mouse, game.players) is not absent { on_button = over == .PLAYERS }
                    if !on_button then screen.counts.open = false
                }
            }
        }

        // What changed this frame, stored (a failure to store isn't the game's).
        if game != stored_game {
            if Defaults.set("game", game) is os_error { }
            stored_game = game
        }
        if family != stored_family {
            if Defaults.set("font", family) is os_error { }
            stored_family = family
        }

        screen.can_undo = history.count > 0
        draw(canvas, layout, game, fonts, screen)
        canvas.present(w.handle, vsync: true)
        scratch.reset()
        if !screen.drag.active and screen.moving_end < 0 and !screen.counts.held {
            if _ := Window.wait_for_input(milliseconds: 1000) is timed_out { }
        }
    }
}
