// Damage as motes, and the volleys that carry it: each player's motes
// (born of their elements, elements.rain's), and each volley, gathering
// at its player's spot, thrown along the stream's path to whoever it hit,
// and landing there, the life shown counting down as it lands. Each
// colour's motes are its own: white's holy light, blue's water, black's
// oily smoke, red's sparks, green's leaves on the wind, an artifact's sparks.

// A colour's motes: their colour over their life, how much light they add,
// how they flicker, their size over their life and how long they live, how
// they rise (toward the centre, from their player's side: negative falls
// toward the player) and how the wind blows them (to their player's
// right), how the flow field swirls them, how their speed dies, how fast
// they start; how they're long (streaked along their motion, or ovals
// turning); and a second colour some of them are, at a share of the size.
Mote_Style :: struct {
    colour:       Draw.RGBA
    colour_end:   Draw.RGBA
    add:          f32 = 0
    flicker:      f32 = 0
    size:         f32               // cells
    size_end:     f32
    life:         f32               // seconds
    rise:         f32 = 0           // cells a second, a second
    wind:         f32 = 0
    swirl:        f32 = 0           // cells a second
    drag:         f32 = 1
    spread:       f32 = 0.3         // cells a second
    streak:       f32 = 0           // seconds of motion
    elongation:   f32 = 1
    spin:         f32 = 0
    glint:        Draw.RGBA
    glint_chance: f32 = 0
    glint_size:   f32 = 1
    glint_add:    f32 = 1
    alive:        f32 = 60          // how many of its motes a miasma of it alone keeps alive
    shape:        Draw.Glow_Shape = .ROUND
    glint_shape:  Draw.Glow_Shape = .ROUND
    orbit:        f32 = 0
    orbit_life:   f32 = 0
    hold:         f32 = MIASMA_PULL // how hard a miasma's motes are held to its spot (a spring, a second squared)
}

// Each element's (each colour's, WUBRG, then an artifact's).
STYLES :: [Element] Mote_Style⟨
    // White: holy light, flecks slowly orbiting in its sun's corona, warm
    // gold and white-hot sparkles.
    ⟨colour: Draw.rgba(0xFFE9B0, 0.8), colour_end: Draw.rgba(0xFFD27A, 0.55), add: 1, flicker: 0.15, size: 0.035, size_end: 0.035,
     life: 1.8, rise: 0.45, swirl: 0.35, drag: 1.4, spread: 0.3, glint: Draw.rgb(0xFFFFF4), glint_chance: 0.4, glint_size: 1.5, alive: 32,
     glint_shape: .SPARK, orbit: 0.5, orbit_life: 8⟩,
    // Blue: water, drops falling, streaked as they fall, eddying, some catching
    // the light.
    ⟨colour: Draw.rgba(0xA8E0FF, 0.9), colour_end: Draw.rgba(0x3B8ED6, 0.85), add: 0.3, flicker: 0.05, size: 0.045, size_end: 0.03,
     life: 1.3, rise: -1.6, swirl: 1.4, drag: 0.9, spread: 0.7, streak: 0.03, glint: Draw.rgba(0xF2FBFF, 0.95), glint_chance: 0.3, glint_size: 0.6, glint_add: 0.8, alive: 70, shape: .DROP, glint_shape: .DROP⟩,
    // Black: oily smoke, thick and dark, curling into tendrils (each wisp
    // drawn long along its curl), a sheen of oil's colours now and then.
    ⟨colour: Draw.rgba(0x0A090C, 0.8), colour_end: Draw.rgba(0x000000, 0.55), size: 0.10, size_end: 0.26,
     life: 2.4, rise: 0.15, swirl: 2.6, drag: 0.7, spread: 0.35, streak: 0.35, glint: Draw.rgba(0x2E4A5A, 0.7), glint_chance: 0.2, glint_size: 0.7, glint_add: 0.5, alive: 30, shape: .WISP⟩,
    // Red: sparks, small and white-hot, flying up from its fire (away from
    // its player), streaking, wavering on the heat, gone quickly, barely
    // held, so they fly off.
    ⟨colour: Draw.rgb(0xFFF2C0), colour_end: Draw.rgb(0xFF6A20), add: 1, flicker: 0.4, size: 0.035, size_end: 0.015,
     life: 0.8, rise: 1.8, swirl: 0.6, drag: 0.9, spread: 0.9, streak: 0.04, glint: Draw.rgb(0xFFFFFF), glint_chance: 0.25, alive: 70,
     shape: .SPARK, glint_shape: .SPARK, hold: 0.3⟩,
    // Green: leaves blown on the wind, tumbling, now and then an autumn one.
    ⟨colour: Draw.rgba(0x8CCB5E, 0.95), colour_end: Draw.rgba(0x4E8A34, 0.9), add: 0.1, size: 0.038, size_end: 0.032,
     life: 2.2, rise: -0.2, wind: 1.4, swirl: 1.0, drag: 1.2, spread: 0.5, elongation: 2.4, spin: 4,
     glint: Draw.rgba(0xC9B44A, 0.95), glint_chance: 0.2, glint_add: 0.1, alive: 45, shape: .LEAF, glint_shape: .LEAF⟩,
    // Artifact: metal sparks, flung out and falling.
    ⟨colour: Draw.rgb(0xE8EEF2), colour_end: Draw.rgb(0x7A848C), add: 0.9, flicker: 0.3, size: 0.05, size_end: 0.02,
     life: 0.6, rise: -0.8, swirl: 0.2, drag: 2.0, spread: 1.6, streak: 0.03, glint: Draw.rgb(0xFFD99A), glint_chance: 0.2, alive: 60, shape: .SPARK, glint_shape: .SPARK⟩
⟩

// A mote's tag: what it is (a field's, the stream's, a landing's), and in
// its low 16 bits a field's seat, its element above that.
FIELD_MOTE   :: u32'1 << 16
STREAM_MOTE  :: u32'2 << 16
SPLASH_MOTE  :: u32'8 << 16

// How hard a field's motes are held to its middle, by default. (A field's
// rate of births is its style's own: alive over life.)
MIASMA_PULL :: 2.5

// The sun's flecks: born in its corona, from just past its ball to
// ORBIT_MOST of its reach out, going round at its orbit's speed
// ORBIT_RADIUS of its reach out.
ORBIT_MOST :: 0.85
ORBIT_RADIUS :: 0.68

// Every mote's size, against its style's.
MOTE_SCALE :: 1.0

// A mote of a player's, of one of their elements (chosen at random), at a
// place, moving, in their frame (up: away from them, toward the centre).
mote_of :: (random: *Random.Generator, identity: Identity, at: V2, velocity: V2, up: V2, cell: f32, tag: u32 -> Particles.Mote) {
    *list: [6] Element
    n := elements_of(identity, list)
    return mote_of_style(random, list[random.below(n)], at, velocity, up, cell, tag)
}

// A mote of an element's style, as mote_of.
mote_of_style :: (random: *Random.Generator, which: Element, at: V2, velocity: V2, up: V2, cell: f32, tag: u32 -> Particles.Mote) {
    style := STYLES[which]
    glinting := random.chance(f64'style.glint_chance)
    colour := if glinting then style.glint else style.colour
    colour_end := if glinting then style.glint else style.colour_end
    add := if glinting then style.glint_add else style.add
    size: f32 = if glinting then style.glint_size else 1
    shape := if glinting then style.glint_shape else style.shape
    // (a random direction and speed up to its spread, and a life within a
    // third either way of its own; the wind to its player's right)
    angle := f32'random.below(0.0, Math.TAU)
    speed := f32'random.below(0.0, 1.0) * style.spread * cell
    life := style.life * f32'random.below(0.7, 1.3)
    right := V2⟨0 - up.y, up.x⟩
    return ⟨at: at, velocity: velocity + V2⟨Math.cos(angle), Math.sin(angle)⟩ * speed, life: life,
            size: style.size * size * MOTE_SCALE * cell, size_end: style.size_end * size * MOTE_SCALE * cell, colour: colour, colour_end: colour_end,
            add: add, flicker: style.flicker, gravity: (up * style.rise + right * style.wind) * cell, drag: style.drag,
            swirl: style.swirl * cell, streak: style.streak, elongation: style.elongation, spin: style.spin,
            tag: tag, seed: f32'random.below(0.0, 100.0), shape: shape⟩
}

// Each player's fields' motes for a frame, for a player not out: each of
// their elements keeps its share of its own number alive (so a long-lived
// style doesn't pile up over a quick one in a mix), each born where its
// element says (field_birth), held about its field's middle by a pull. A
// field's mote is tagged with its seat, and its element above that.
feed_elements :: (motes: *Particles.System, random: *Random.Generator, layout: Layout, game: Game, elements: Elements, seconds: f32) {
    cell := cell_of(layout)
    for k: 0 < layout.count {
        if is_out(game, k) then continue
        *list: [6] Element
        n := elements_of(game.identity[k], list)
        for which, i: list[:n] {
            style := STYLES[which]
            // (its motes' life here: an orbiting one's its orbit's)
            lives := if style.orbit > 0 then style.orbit_life else style.life
            rate := style.alive * elements.stir[k] / f32'n / Math.max(lives, 0.01)
            births_now := births(random, rate, seconds)
            if births_now == 0 then continue
            f := rest_field(layout, k, i, n, elements)
            for _: 0 < births_now {
                at, outward := field_birth(random, which, f)
                *m := mote_of_style(random, which, at, outward * (0.25 * style.spread * cell), f.up, cell, FIELD_MOTE | u32'k | (u32'which << 8))
                m.home = f.start
                m.pull = style.hold
                if style.orbit > 0 {
                    // Round its field's middle, clockwise, on a spring as
                    // strong as its speed round (so a circle, a little out of
                    // round by what's left of its own start), nothing else
                    // moving it.
                    out := Math.max(Math.length(at - f.start), 0.001)
                    way := (at - f.start) / out
                    ratio := ORBIT_RADIUS * f.reach / out
                    speed := style.orbit * ratio * Math.sqrt(ratio)
                    m.velocity = V2⟨0 - way.y, way.x⟩ * speed * out + m.velocity * 0.12
                    m.pull = speed * speed
                    m.gravity = ⟨0, 0⟩
                    m.drag = 0
                    m.swirl = 0
                    m.life = style.orbit_life * f32'random.below(0.7, 1.3)
                }
                motes.add(m)
            }
        }
    }
}

// Where in a field at rest an element's mote is born, and the way out of
// the field there: the field's own procedures (elements.rain's, its
// shader's) say where it's what the mote comes from. The sun's flecks in
// its corona; fire's sparks from its flames' tips; water's drops from its
// crests; oil's and liquid metal's blobs from their edges, budding off
// (their pull draws them back); the wind's leaves anywhere in it. A few
// tries at a place that fits, then the last tried.
field_birth :: (random: *Random.Generator, which: Element, f: Field -> at: V2, outward: V2) {
    right := V2⟨0 - f.up.y, f.up.x⟩
    *q := V2⟨0, 0⟩
    for try: 0 < 12 {
        angle := f32'random.below(0.0, Math.TAU)
        way := V2⟨Math.cos(angle), Math.sin(angle)⟩
        fits := if which is {
            case .SUN:
                q = way * f32'random.below(f64'(SUN_BALL * 1.05), f64'ORBIT_MOST)
                true
            case .FIRE:
                q = V2⟨f32'random.below(-0.5, 0.5), f32'random.below(0.0, 0.95)⟩
                paint, _ := fire_at(q, q, 0, f.time, f.seed, f.stir)
                paint.w > 0.1 and paint.w < 0.55
            case .WATER:
                q = way * f32'random.below(0.5, 0.88)
                height, _ := water_waves(q, f.time, f.seed, f.stir)
                height > 0.6
            case .OIL:
                q = way * Math.sqrt(f32'random.below(0.1, 1.0))
                paint, _ := oil_at(q, q, 0, f.time, f.seed, f.stir)
                paint.w > 0.1 and paint.w < 0.7
            case .CHROME:
                q = way * Math.sqrt(f32'random.below(0.1, 1.0))
                paint, _ := chrome_at(q, q, 0, f.time, f.seed, f.stir)
                paint.w > 0.1 and paint.w < 0.7
            case .WIND:
                q = way * (Math.sqrt(f32'random.below(0.0, 1.0)) * 0.9)
                true
        }
        if fits then break
    }
    at = f.start + (right * q.x + f.up * q.y) * f.reach
    *away := right * q.x + f.up * q.y
    if Math.length(away) > 0.0001 then away = Math.normalize(away)
    outward = away
}

// How many are born in a frame at a rate a second: the whole number, and
// the rest by chance.
births :: (random: *Random.Generator, rate: f32, seconds: f32 -> i64) {
    expected := rate * seconds
    whole := i64'Math.floor(expected)
    if random.chance(f64'(expected - f32'whole)) then return whole + 1
    return whole
}

// The stream's path, as a drag's finger aims it: from the dragger's spot
// to the life total of whoever it's over (to the finger, over no one),
// bent toward the finger (a curve through start and end, pulled toward bend).
STREAM_BEND :: 0.6               // how far the bend goes toward the finger from the middle

stream_path :: (layout: Layout, game: Game, from: i64, finger: V2 -> start: V2, bend: V2, end: V2) {
    start = layout.seats[from].icon
    *ends := finger
    if to, _ := aim(layout, game, from, finger) is not missed then ends = layout.seats[to].middle
    end = ends
    middle := (start + ends) / 2
    bend = middle + (finger - middle) * STREAM_BEND
}

// The stream's motes for a frame of a drag: each of the dragger's elements
// shedding its own along its braid of the curve, thrown on along it.
STREAM_RATE :: 8
feed_stream :: (motes: *Particles.System, random: *Random.Generator, layout: Layout, game: Game, from: i64, finger: V2, seconds: f32) {
    cell := cell_of(layout)
    seat := layout.seats[from]
    if Math.length(finger - seat.icon) < 0.5 * cell then return
    start, bend, end := stream_path(layout, game, from, finger)
    *list: [6] Element
    n := elements_of(game.identity[from], list)
    for which, i: list[:n] {
        braid := braided(start, bend, end, i, n, cell)
        for _: 0 < births(random, STREAM_RATE / f32'n, seconds) {
            t := f32'random.below(0.1, 1.0)
            at := curve_at(start, braid, end, t)
            ahead := curve_at(start, braid, end, Math.min(t + 0.02, 1)) - curve_at(start, braid, end, Math.max(t - 0.02, 0))
            *way := V2⟨0, 0⟩
            if Math.length(ahead) > 0.0001 then way = Math.normalize(ahead)
            *m := mote_of_style(random, which, at, way * (1.5 * cell), seat.toward * -1, cell, STREAM_MOTE)
            m.life = m.life * 0.6
            motes.add(m)
        }
    }
}

// The point t of the way along a curve from a to c, pulled toward b.
curve_at :: (a: V2, b: V2, c: V2, t: f32 -> V2) #pure {
    return Math.mix(Math.mix(a, b, t), Math.mix(b, c, t), t)
}

// A volley: who it's from and to, the path it's thrown along (the
// stream's, as it was let go), how many points it is and how many have
// landed, whether it made its commander damage lethal, whether it's black's
// strike (its attacker's colours have black: its tendrils plunge, pulse and
// snap, and it lands all at once), and how long it's been going.
Volley :: struct {
    id:     u32
    from:   i64
    to:     i64
    start:  V2
    bend:   V2
    end:    V2
    amount: i32
    landed: i32
    lethal: bool
    black:  bool
    age:    f32
}

Volleys :: struct {
    list:    [..] Volley
    next_id: u32 = 1
}

// A volley's times (seconds): gathering at its player's spot, thrown along
// its path, landing (its points counting off the life shown over it), and
// its splash fading after.
VOLLEY_GATHER :: 0.14
VOLLEY_TRAVEL :: 0.42
VOLLEY_LAND :: 0.36
VOLLEY_LINGER :: 0.3

// Black's strike's times, after it's gathered (seconds): its tendrils
// plunging in, pulsing, then snapping toward their glob's hit, and the pool
// it leaves fading.
BLACK_REACH :: 0.32
BLACK_PULSE :: 0.3
BLACK_SNAP :: 0.26
BLACK_RESIDUE :: 0.35

// When a volley lands (its age): black's strike when its glob hits.
volley_landing :: (v: Volley -> f32) #pure {
    if v.black then return VOLLEY_GATHER + BLACK_REACH + BLACK_PULSE + BLACK_SNAP
    return VOLLEY_GATHER + VOLLEY_TRAVEL
}

// How long a volley's landing takes, its points coming off over it (black's
// all at once), and how long after landing it's gone.
volley_land :: (v: Volley -> f32) #pure {
    return if v.black then 0 else VOLLEY_LAND
}

volley_after :: (v: Volley -> f32) #pure {
    return if v.black then BLACK_RESIDUE else VOLLEY_LAND + VOLLEY_LINGER
}

// Damage dealt as a volley: the game changed at once (so undo is as
// before), the volley thrown along the stream's path from where the finger
// let go (finger), the life shown counting down as it lands (by pending,
// until it has). It's lethal when this commander damage made it so.
strike :: (game: *Game, motes: *Particles.System, volleys: *Volleys, random: *Random.Generator, layout: Layout,
           pending: *[MAX_PLAYERS] [MAX_PLAYERS] i32, from: i64, to: i64, amount: i32, finger: V2) {
    if amount <= 0 or from == to then return
    was := game.commander[to][from]
    game.deal(from, to, amount)
    lethal := was < LETHAL_COMMANDER_DAMAGE and game.commander[to][from] >= LETHAL_COMMANDER_DAMAGE
    pending[to][from] += amount
    // (the path ends at their life total whatever the finger's over now)
    start := layout.seats[from].icon
    end := layout.seats[to].middle
    middle := (start + end) / 2
    bend := middle + (finger - middle) * STREAM_BEND
    id := volleys.next_id
    volleys.next_id = if volleys.next_id >= 0xFFFF then 1 else volleys.next_id + 1
    `global volleys.list.add(⟨id: id, from: from, to: to, start: start, bend: bend, end: end, amount: amount, lethal: lethal,
                             black: has_colour(game.identity[from], .BLACK)⟩)
}

// The volleys moved on a frame: each as it lands has its points come off
// what's pending over its landing, a point at a time, its splash of motes
// thrown out as it begins (a lethal one's a burst); one whose splash has
// faded is done. How many bursts there were.
steer_volleys :: (motes: *Particles.System, volleys: *Volleys, random: *Random.Generator, layout: Layout, game: Game,
                  pending: *[MAX_PLAYERS] [MAX_PLAYERS] i32, seconds: f32 -> bursts: i64) {
    bursts = 0
    for *volley: volleys.list {
        landing := volley_landing(volley)
        before := volley.age
        volley.age += Math.max(seconds, 0)
        if before < landing and volley.age >= landing {
            splash(motes, random, layout, game.identity[volley.from], volley.to, volley.end, volley.lethal)
            if volley.lethal then bursts += 1
        }
        if volley.age >= landing {
            land := volley_land(volley)
            share := if land > 0 then Math.clamp((volley.age - landing) / land, 0, 1) else 1
            should := i32'Math.ceil(share * f32'volley.amount)
            newly := should - volley.landed
            if newly > 0 {
                pending[volley.to][volley.from] = Math.max(pending[volley.to][volley.from] - newly, 0)
                volley.landed = should
            }
        }
        if volley.age >= landing + volley_after(volley) then remove volley
    }
}

// How many motes a second each element's volley throws off as it flies
// (shared among its bolts): the storm's its debris, the deluge's its spray.
VOLLEY_MOTES :: [Element] f32⟨SUN: 45, WATER: 120, OIL: 25, FIRE: 80, WIND: 170, CHROME: 25⟩

// Each volley's motes as it flies, thrown off each of its heads ahead
// along its path: the storm's leaves (and now and then a twig), fire's
// sparks, the deluge's spray, the energy's sparkles, oil's and metal's
// drops. (Tagged as a landing's: an undo calls them off.)
feed_volleys :: (motes: *Particles.System, random: *Random.Generator, layout: Layout, game: Game, volleys: Volleys, seconds: f32) {
    cell := cell_of(layout)
    for v: volleys.list {
        if v.black or v.age < VOLLEY_GATHER or v.age >= VOLLEY_GATHER + VOLLEY_TRAVEL then continue
        *list: [6] Element
        n := elements_of(game.identity[v.from], list)
        size := volley_cells(v.amount) * cell
        across := across_path(v.start, v.end)
        speed := Math.length(v.end - v.start) * 1.15 / VOLLEY_TRAVEL
        up := layout.seats[v.from].toward * -1
        for which, i: list[:n] {
            shape := VOLLEY_SHAPES[which]
            bolts := volley_bolts(which, v.amount)
            braid := braided(v.start, v.bend, v.end, i, n, cell)
            for j: 0 < bolts {
                p := bolt_along(v.age, j, bolts)
                if p <= 0 or p >= 1 then continue
                side := (f32'j - f32'(bolts - 1) / 2) * shape.apart * cell
                bend := braid + across * (side * 2)
                head := curve_at(v.start, bend, v.end, p)
                ahead := curve_at(v.start, bend, v.end, Math.min(p + 0.02, 1)) - curve_at(v.start, bend, v.end, Math.max(p - 0.02, 0))
                *way := V2⟨0, 0⟩
                if Math.length(ahead) > 0.0001 then way = Math.normalize(ahead)
                reach := size * shape.reach
                for _: 0 < births(random, VOLLEY_MOTES[which] * 0.35 / f32'bolts, seconds) {
                    angle := f32'random.below(0.0, Math.TAU)
                    at := head + V2⟨Math.cos(angle), Math.sin(angle)⟩ * (Math.sqrt(f32'random.below(0.0, 1.0)) * reach * 0.8)
                    *m := mote_of_style(random, which, at, way * (speed * f32'random.below(0.3, 0.9)), up, cell, SPLASH_MOTE)
                    m.life = m.life * 0.6
                    if which == .WIND and random.chance(0.25) then twig(m)
                    motes.add(m)
                }
            }
        }
    }
}

// A leaf mote made a twig: brown, long and thin, tumbling.
twig :: (m: *Particles.Mote) {
    m.colour = Draw.rgba(0x6E4B2A, 0.95)
    m.colour_end = Draw.rgba(0x4A3220, 0.9)
    m.elongation = 5
    m.size = m.size * 0.75
    m.size_end = m.size
    m.add = 0
    m.shape = .LEAF
}

// A landing's splash at a place: motes of the attacker's thrown out from
// it; a lethal volley's a much bigger burst.
splash :: (motes: *Particles.System, random: *Random.Generator, layout: Layout, identity: Identity, to: i64, at: V2, lethal: bool) {
    cell := cell_of(layout)
    count := if lethal then 48 else 12
    reach: f32 = if lethal then 3 else 1.8
    for _: 0 < count {
        angle := f32'random.below(0.0, Math.TAU)
        speed := f32'random.below(0.3, 1.0) * reach * cell
        *s := mote_of(random, identity, at, V2⟨Math.cos(angle), Math.sin(angle)⟩ * speed, layout.seats[to].toward * -1, cell, SPLASH_MOTE)
        s.drag = 3
        if lethal {
            s.life = s.life * 1.2
            s.size = s.size * 1.8
            s.size_end = s.size_end * 1.5
        }
        else {
            s.life = s.life * 0.5
        }
        motes.add(s)
    }
}

// The game as it's shown while volleys are in flight: what they'll do not
// yet done.
shown_game :: (game: Game, pending: [MAX_PLAYERS] [MAX_PLAYERS] i32 -> shown: Game) #pure {
    shown = game
    for to: 0 < MAX_PLAYERS {
        for from: 0 < MAX_PLAYERS {
            shown.life[to] += pending[to][from]
            shown.commander[to][from] -= pending[to][from]
        }
    }
}

// Every volley forgotten, its splash's motes gone, and nothing pending (an
// undo, a new game).
call_off_volleys :: (motes: *Particles.System, volleys: *Volleys, pending: *[MAX_PLAYERS] [MAX_PLAYERS] i32) {
    for *m: motes.motes {
        if m.tag & SPLASH_MOTE != 0 then remove m
    }
    volleys.list.clear()
    for *row: pending { for *p: row { p = 0 } }
}

// The motes and volleys as they'd be ten seconds in (for snapshots, the
// same each time: long enough for the longest-lived miasma, white's
// orbits, to fill), with a volley of volley from from to to, let go at
// finger, the given seconds before the end (0: none).
SETTLE_FRAMES :: 600
settled_motes :: (layout: Layout, game: Game, from: i64 = -1, finger: V2 = ⟨0, 0⟩, to: i64 = 0, volley: i32 = 0, volley_age: f32 = 0.3, stirring: f32 = 0 -> motes: Particles.System, volleys: Volleys) {
    *made: Particles.System = ⟨flow_scale: MOTE_FLOW * cell_of(layout)⟩
    *thrown: Volleys
    *random := Random.generator(seed: 1)
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    *dealt := game
    thrown_at := SETTLE_FRAMES - i64'(volley_age * 60)
    // (the fields' clocks as they were, to end where settled_elements' are)
    *fields := settled_elements()
    for *s: fields.stir { s = stirring }
    for *c: fields.clock { c -= f32'SETTLE_FRAMES / 60 }
    for frame: 0 < SETTLE_FRAMES {
        seconds: f32 = 1.0 / 60
        for *c: fields.clock { c += seconds }
        feed_elements(made, random, layout, game, fields, seconds)
        if frame == thrown_at and volley > 0 then strike(dealt, made, thrown, random, layout, pending, from, to, volley, finger)
        feed_volleys(made, random, layout, game, thrown, seconds)
        made.update(seconds)
        steer_volleys(made, thrown, random, layout, game, pending, seconds)
    }
    motes = made
    volleys = thrown
}

// The flow field's eddies, in cells.
MOTE_FLOW :: 1.5
