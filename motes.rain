// Damage as motes: each player's miasma (where their damage is drawn from,
// in their colours), the stream that flows from it, as they drag, to the
// life total of whoever they're over (bent toward the finger), and the
// volley, a mote a point of damage, that flies to whoever they hit, each
// landing a splash and a point off the life shown. Each colour's motes are
// its own: white's holy light, blue's water, black's oily, tendrilled
// smoke, red's sparks, green's leaves on the wind, an artifact's sparks.

// A colour's motes: their colour over their life, how much light they add,
// how they flicker, their size over their life and how long they live, how
// they rise (toward the centre, from their player's side: negative falls
// toward the player) and how the wind blows them (to their player's
// right), how the flow field swirls them, how their speed dies, how fast
// they start; how they're long (streaked along their motion, or ovals
// turning); and a second colour some of them are, at a share of the size.
Mote_Style :: struct {
    colour:       Draw.RGBA
    colour_end:   Draw.RGBA
    add:          f32 = 0
    flicker:      f32 = 0
    size:         f32               // cells
    size_end:     f32
    life:         f32               // seconds
    rise:         f32 = 0           // cells a second, a second
    wind:         f32 = 0
    swirl:        f32 = 0           // cells a second
    drag:         f32 = 1
    spread:       f32 = 0.3         // cells a second
    streak:       f32 = 0           // seconds of motion
    elongation:   f32 = 1
    spin:         f32 = 0
    glint:        Draw.RGBA
    glint_chance: f32 = 0
    glint_size:   f32 = 1
    glint_add:    f32 = 1
    alive:        f32 = 60          // how many of its motes a miasma of it alone keeps alive
    shape:        Draw.Glow_Shape = .ROUND
    glint_shape:  Draw.Glow_Shape = .ROUND
    orbit:        f32 = 0
    orbit_life:   f32 = 0
    hold:         f32 = MIASMA_PULL // how hard a miasma's motes are held to its spot (a spring, a second squared)
}

// Each colour's (WUBRG), then an artifact's.
STYLES :: [6] Mote_Style⟨
    // White: holy light, a sun (draw_suns) with motes of light slowly
    // orbiting it, warm gold and white-hot sparkles.
    ⟨colour: Draw.rgba(0xFFE9B0, 0.8), colour_end: Draw.rgba(0xFFD27A, 0.55), add: 1, flicker: 0.15, size: 0.035, size_end: 0.035,
     life: 1.8, rise: 0.45, swirl: 0.35, drag: 1.4, spread: 0.3, glint: Draw.rgb(0xFFFFF4), glint_chance: 0.4, glint_size: 1.5, alive: 32,
     glint_shape: .SPARK, orbit: 0.5, orbit_life: 8⟩,
    // Blue: water, drops falling, streaked as they fall, eddying, some catching
    // the light.
    ⟨colour: Draw.rgba(0xA8E0FF, 0.9), colour_end: Draw.rgba(0x3B8ED6, 0.85), add: 0.3, flicker: 0.05, size: 0.065, size_end: 0.05,
     life: 1.3, rise: -1.6, swirl: 1.4, drag: 0.9, spread: 0.7, streak: 0.03, glint: Draw.rgba(0xF2FBFF, 0.95), glint_chance: 0.3, glint_size: 0.6, glint_add: 0.8, alive: 70, shape: .DROP, glint_shape: .DROP⟩,
    // Black: oily smoke, thick and dark, curling into tendrils (each wisp
    // drawn long along its curl), a sheen of oil's colours now and then.
    ⟨colour: Draw.rgba(0x0A090C, 0.8), colour_end: Draw.rgba(0x000000, 0.55), size: 0.10, size_end: 0.26,
     life: 2.4, rise: 0.15, swirl: 2.6, drag: 0.7, spread: 0.35, streak: 0.35, glint: Draw.rgba(0x2E4A5A, 0.7), glint_chance: 0.2, glint_size: 0.7, glint_add: 0.5, alive: 30, shape: .WISP⟩,
    // Red: sparks, small and white-hot, flying up from its fire (away from
    // its player), streaking, wavering on the heat, gone quickly, barely
    // held, so they fly off.
    ⟨colour: Draw.rgb(0xFFF2C0), colour_end: Draw.rgb(0xFF6A20), add: 1, flicker: 0.4, size: 0.035, size_end: 0.015,
     life: 0.8, rise: 1.8, swirl: 0.6, drag: 0.9, spread: 0.9, streak: 0.04, glint: Draw.rgb(0xFFFFFF), glint_chance: 0.25, alive: 70,
     shape: .SPARK, glint_shape: .SPARK, hold: 0.3⟩,
    // Green: leaves blown on the wind, tumbling, now and then an autumn one.
    ⟨colour: Draw.rgba(0x8CCB5E, 0.95), colour_end: Draw.rgba(0x4E8A34, 0.9), add: 0.1, size: 0.055, size_end: 0.055,
     life: 2.2, rise: -0.2, wind: 1.4, swirl: 1.0, drag: 1.2, spread: 0.5, elongation: 2.4, spin: 4,
     glint: Draw.rgba(0xC9B44A, 0.95), glint_chance: 0.2, glint_add: 0.1, alive: 45, shape: .LEAF, glint_shape: .LEAF⟩,
    // Artifact: metal sparks, flung out and falling.
    ⟨colour: Draw.rgb(0xE8EEF2), colour_end: Draw.rgb(0x7A848C), add: 0.9, flicker: 0.3, size: 0.05, size_end: 0.02,
     life: 0.6, rise: -0.8, swirl: 0.2, drag: 2.0, spread: 1.6, streak: 0.03, glint: Draw.rgb(0xFFD99A), glint_chance: 0.2, alive: 60, shape: .SPARK, glint_shape: .SPARK⟩
⟩

ARTIFACT_STYLE :: 5

// A mote's tag: what it is (a miasma's, the stream's, a volley's, a
// landing's), and in its low 16 bits a miasma's seat or a volley's id.
MIASMA_MOTE  :: u32'1 << 16
STREAM_MOTE  :: u32'2 << 16
VOLLEY_MOTE  :: u32'4 << 16
SPLASH_MOTE  :: u32'8 << 16

// How many motes a second the stream makes (more for a bigger amount); how
// far about its spot a miasma's are born (cells), and how hard they're held
// to it. (A miasma's rate is each style's own: alive over life.)
STREAM_RATE :: 45
STREAM_RATE_A_POINT :: 5
MIASMA_REACH :: 0.6
MIASMA_PULL :: 2.5

// An orbiting style's motes: born between ORBIT_LEAST and ORBIT_MOST cells
// out (about the edge of its sun's glow), going round at its orbit's speed
// ORBIT_RADIUS out.
ORBIT_LEAST :: 0.45
ORBIT_MOST :: 0.95
ORBIT_RADIUS :: 0.7

// Every mote's size, against its style's.
MOTE_SCALE :: 1.8

// The styles a player's motes are drawn from: each of their colours, or an
// artifact's with none (into; how many).
styles_of :: (identity: Identity, into: [] *i64 -> count: i64) #pure {
    count = 0
    for colour, i: [5] Mana⟨.WHITE, .BLUE, .BLACK, .RED, .GREEN⟩ {
        if has_colour(identity, colour) {
            into[count] = i
            count += 1
        }
    }
    if count == 0 {
        into[0] = ARTIFACT_STYLE
        count = 1
    }
}

// A mote of a player's, of one of their styles (chosen at random), at a
// place, moving, in their frame (up: away from them, toward the centre).
mote_of :: (random: *Random.Generator, identity: Identity, at: V2, velocity: V2, up: V2, cell: f32, tag: u32 -> Particles.Mote) {
    *styles: [6] i64
    n := styles_of(identity, styles)
    return mote_of_style(random, styles[random.below(n)], at, velocity, up, cell, tag)
}

// A mote of a style (STYLES' index), as mote_of.
mote_of_style :: (random: *Random.Generator, which: i64, at: V2, velocity: V2, up: V2, cell: f32, tag: u32 -> Particles.Mote) {
    style := STYLES[which]
    glinting := random.chance(f64'style.glint_chance)
    colour := if glinting then style.glint else style.colour
    colour_end := if glinting then style.glint else style.colour_end
    add := if glinting then style.glint_add else style.add
    size: f32 = if glinting then style.glint_size else 1
    shape := if glinting then style.glint_shape else style.shape
    // (a random direction and speed up to its spread, and a life within a
    // third either way of its own; the wind to its player's right)
    angle := f32'random.below(0.0, Math.TAU)
    speed := f32'random.below(0.0, 1.0) * style.spread * cell
    life := style.life * f32'random.below(0.7, 1.3)
    right := V2⟨0 - up.y, up.x⟩
    return ⟨at: at, velocity: velocity + V2⟨Math.cos(angle), Math.sin(angle)⟩ * speed, life: life,
            size: style.size * size * MOTE_SCALE * cell, size_end: style.size_end * size * MOTE_SCALE * cell, colour: colour, colour_end: colour_end,
            add: add, flicker: style.flicker, gravity: (up * style.rise + right * style.wind) * cell, drag: style.drag,
            swirl: style.swirl * cell, streak: style.streak, elongation: style.elongation, spin: style.spin,
            tag: tag, seed: f32'random.below(0.0, 100.0), shape: shape⟩
}

// Each miasma kept going for a frame: motes born about its player's damage
// spot (their seat's icon), held about it by a pull, for a player not out.
// Each of the player's colours keeps its share of its own number alive (so
// a long-lived style doesn't pile up over a quick one in a mix), born
// evenly over the miasma's disc (not bunched at its middle). A miasma's
// mote is tagged with its seat, and its style above that.
feed_miasmas :: (motes: *Particles.System, random: *Random.Generator, layout: Layout, game: Game, seconds: f32) {
    cell := cell_of(layout)
    for seat, k: layout.seats[:layout.count] {
        if is_out(game, k) then continue
        *styles: [6] i64
        n := styles_of(game.identity[k], styles)
        for which: styles[:n] {
            style := STYLES[which]
            // (its motes' life here: an orbiting one's its orbit's)
            lives := if style.orbit > 0 then style.orbit_life else style.life
            rate := style.alive / f32'n / Math.max(lives, 0.01)
            for _: 0 < births(random, rate, seconds) {
                angle := f32'random.below(0.0, Math.TAU)
                least: f32 = if style.orbit > 0 then ORBIT_LEAST / ORBIT_MOST else 0
                reach: f32 = if style.orbit > 0 then ORBIT_MOST else MIASMA_REACH
                out := Math.sqrt(f32'random.below(f64'(least * least), 1.0)) * reach * cell
                way := V2⟨Math.cos(angle), Math.sin(angle)⟩
                at := seat.icon + way * out
                *m := mote_of_style(random, which, at, ⟨0, 0⟩, seat.toward * -1, cell, MIASMA_MOTE | u32'k | (u32'which << 8))
                m.home = seat.icon
                m.pull = style.hold
                if style.orbit > 0 {
                    // Round its spot, clockwise, on a spring as strong as its
                    // speed round (so a circle, a little out of round by
                    // what's left of its own start), nothing else moving it.
                    ratio := ORBIT_RADIUS * cell / out
                    speed := style.orbit * ratio * Math.sqrt(ratio)
                    m.velocity = V2⟨0 - way.y, way.x⟩ * speed * out + m.velocity * 0.12
                    m.pull = speed * speed
                    m.gravity = ⟨0, 0⟩
                    m.drag = 0
                    m.swirl = 0
                    m.life = style.orbit_life * f32'random.below(0.7, 1.3)
                }
                motes.add(m)
            }
        }
    }
}

// How many are born in a frame at a rate a second: the whole number, and
// the rest by chance.
births :: (random: *Random.Generator, rate: f32, seconds: f32 -> i64) {
    expected := rate * seconds
    whole := i64'Math.floor(expected)
    if random.chance(f64'(expected - f32'whole)) then return whole + 1
    return whole
}

// The stream's path, as a drag's finger aims it: from the dragger's miasma
// to the life total of whoever it's over (to the finger, over no one),
// bent toward the finger (a curve through start and end, pulled toward bend).
STREAM_BEND :: 0.6               // how far the bend goes toward the finger from the middle
STREAM_TRAVEL :: 0.75            // seconds a mote takes along it
STREAM_SWAY :: 0.45              // how far a mote strays from it at most, cells

stream_path :: (layout: Layout, game: Game, from: i64, finger: V2 -> start: V2, bend: V2, end: V2) {
    start = layout.seats[from].icon
    *ends := finger
    if to, _ := aim(layout, game, from, finger) is not missed then ends = layout.seats[to].middle
    end = ends
    middle := (start + ends) / 2
    bend = middle + (finger - middle) * STREAM_BEND
}

// The point t of the way along a curve from a to c, pulled toward b.
curve_at :: (a: V2, b: V2, c: V2, t: f32 -> V2) #pure {
    return Math.mix(Math.mix(a, b, t), Math.mix(b, c, t), t)
}

// A mote t of the way along a path (start, bent toward bend, to end),
// swaying to one side by its own share of sway (from its seed; none at
// either end, so motes leave together and arrive together).
on_path :: (start: V2, bend: V2, end: V2, t: f32, seed: f32, age: f32, sway: f32, cell: f32 -> V2) #pure {
    on := curve_at(start, bend, end, t)
    ahead := curve_at(start, bend, end, Math.min(t + 0.01, 1)) - curve_at(start, bend, end, Math.max(t - 0.01, 0))
    *way := V2⟨1, 0⟩
    if Math.length(ahead) > 0.0001 then way = Math.normalize(ahead)
    across := V2⟨0 - way.y, way.x⟩
    share := Math.fract(seed * 0.618) * 2 - 1
    off := Math.sin(t * 3.14159) * (share * sway + 0.08 * Math.sin(age * 7 + seed)) * cell
    return on + across * off
}

// How long a path mote's life is against the time it takes along its path:
// longer, so it's still bright when it gets there (taken out then).
PATH_LIFE :: 1.6

// The stream for a frame of a drag: motes from the dragger's miasma, more
// for a bigger amount, set off along its path (steer_stream moves them).
feed_stream :: (motes: *Particles.System, random: *Random.Generator, layout: Layout, game: Game, from: i64, finger: V2, amount: i32, seconds: f32) {
    cell := cell_of(layout)
    seat := layout.seats[from]
    rate := f32'STREAM_RATE + f32'STREAM_RATE_A_POINT * f32'amount
    if Math.length(finger - seat.icon) < 1 then return
    for _: 0 < births(random, rate, seconds) {
        *m := mote_of(random, game.identity[from], seat.icon, ⟨0, 0⟩, seat.toward * -1, cell, STREAM_MOTE)
        // (its time along the path, in home.x: its life is longer)
        travel := STREAM_TRAVEL * f32'random.below(0.85, 1.15)
        m.home = ⟨travel, 0⟩
        m.life = travel * PATH_LIFE
        m.gravity = ⟨0, 0⟩
        m.swirl = 0
        m.drag = 0
        motes.add(m)
    }
}

// The stream's motes moved along its path for a frame, each t of the way
// (its age over its time along it), its velocity what it moved (for its
// streak); one that's come to the end is taken out there, still bright.
steer_stream :: (motes: *Particles.System, layout: Layout, game: Game, from: i64, finger: V2, seconds: f32) {
    if seconds <= 0 then return
    cell := cell_of(layout)
    start, bend, end := stream_path(layout, game, from, finger)
    for *m: motes.motes {
        if m.tag & STREAM_MOTE == 0 then continue
        t := m.age / Math.max(m.home.x, 0.0001)
        if t >= 1 {
            remove m
            continue
        }
        next := on_path(start, bend, end, t, m.seed, m.age, STREAM_SWAY, cell)
        m.velocity = (next - m.at) / seconds
        m.at = next
    }
}

// A volley in flight: who it's from and to, the path its motes take (the
// stream's, as it was let go), how many points it is and how many have
// landed, and whether it made its commander damage lethal.
Volley :: struct {
    id:     u32
    from:   i64
    to:     i64
    start:  V2
    bend:   V2
    end:    V2
    amount: i32
    landed: i32
    lethal: bool
}

Volleys :: struct {
    list:    [..] Volley
    next_id: u32 = 1
}

// How long a volley's mote takes along its path, and how far it strays.
VOLLEY_TRAVEL :: 0.5
VOLLEY_SWAY :: 0.3

// A volley fired: a mote a point of damage along its path, each a little
// after the last (quicker for more), bigger and brighter than the
// miasma's so each can be followed. Its motes are tagged with its id.
fire_volley :: (motes: *Particles.System, volleys: *Volleys, random: *Random.Generator, layout: Layout, identity: Identity, from: i64, to: i64,
                amount: i32, lethal: bool, start: V2, bend: V2, end: V2) {
    if amount <= 0 then return
    cell := cell_of(layout)
    id := volleys.next_id
    volleys.next_id = if volleys.next_id >= 0xFFFF then 1 else volleys.next_id + 1
    `global volleys.list.add(⟨id: id, from: from, to: to, start: start, bend: bend, end: end, amount: amount, lethal: lethal⟩)
    interval := Math.min(1.2 / f32'Math.max(amount, 1), 0.07)
    for i: 0 < i64'amount {
        *m := mote_of(random, identity, start, ⟨0, 0⟩, layout.seats[from].toward * -1, cell, VOLLEY_MOTE | id)
        m.delay = f32'i * interval
        m.life = VOLLEY_TRAVEL * PATH_LIFE
        // (bigger than the miasma's, its own material kept, and a halo of its
        // colour lightened behind it, so each can be followed: black's stays
        // dark smoke against a pale glow)
        m.size = m.size * 1.5 + 0.08 * cell
        m.size_end = m.size
        pale := lighter(m.colour, 0.6)
        m.halo = ⟨pale.r, pale.g, pale.b, 0.3⟩
        m.flicker = 0
        m.gravity = ⟨0, 0⟩
        m.swirl = 0
        m.drag = 0
        motes.add(m)
    }
}

// Damage dealt as a volley: the game changed at once (so undo is as
// before), its motes flying along the stream's path from where the finger
// let go (finger), the life shown counting down as they land (by pending,
// until they have). It's lethal when this commander damage made it so.
strike :: (game: *Game, motes: *Particles.System, volleys: *Volleys, random: *Random.Generator, layout: Layout,
           pending: *[MAX_PLAYERS] [MAX_PLAYERS] i32, from: i64, to: i64, amount: i32, finger: V2) {
    if amount <= 0 or from == to then return
    was := game.commander[to][from]
    game.deal(from, to, amount)
    lethal := was < LETHAL_COMMANDER_DAMAGE and game.commander[to][from] >= LETHAL_COMMANDER_DAMAGE
    pending[to][from] += amount
    // (the path ends at their life total whatever the finger's over now)
    start := layout.seats[from].icon
    end := layout.seats[to].middle
    middle := (start + end) / 2
    bend := middle + (finger - middle) * STREAM_BEND
    fire_volley(motes, volleys, random, layout, game.identity[from], from, to, amount, lethal, start, bend, end)
}

// The volleys moved on a frame: each mote along its volley's path, landing
// when it comes to the end (a point off the life shown, and a splash); a
// volley with no motes left is settled (any points not landed come off
// what's pending too: a mote that went before it landed counts) and, if
// lethal, ends in a burst. How many bursts there were.
steer_volleys :: (motes: *Particles.System, volleys: *Volleys, random: *Random.Generator, layout: Layout, game: Game,
                  pending: *[MAX_PLAYERS] [MAX_PLAYERS] i32, seconds: f32 -> bursts: i64) {
    bursts = 0
    cell := cell_of(layout)
    #with scratch.rewind()
    // (splashes made after the loop over the motes: none added while in it)
    *splashes: [..] V2 in scratch
    *splash_volleys: [..] i64 in scratch
    for *m: motes.motes {
        if m.tag & VOLLEY_MOTE == 0 or m.delay > 0 then continue
        id := m.tag & 0xFFFF
        *v: i64 = -1
        for volley, k: volleys.list { if volley.id == id then v = k }
        if v < 0 {
            remove m
            continue
        }
        volley := volleys.list[v]
        t := m.age / VOLLEY_TRAVEL
        if t >= 1 {
            if pending[volley.to][volley.from] > 0 then pending[volley.to][volley.from] -= 1
            volleys.list[v].landed += 1
            `scratch splashes.add(volley.end)
            `scratch splash_volleys.add(v)
            remove m
            continue
        }
        next := on_path(volley.start, volley.bend, volley.end, t, m.seed, m.age, VOLLEY_SWAY, cell)
        if seconds > 0 then m.velocity = (next - m.at) / seconds
        m.at = next
    }
    for at, i: splashes {
        volley := volleys.list[splash_volleys[i]]
        splash(motes, random, layout, game.identity[volley.from], volley.to, at, false)
    }
    // Settled: those with no motes left.
    for *volley: volleys.list {
        *left := 0
        for m: motes.motes { if m.tag & VOLLEY_MOTE != 0 and m.tag & 0xFFFF == volley.id then left += 1 }
        if left > 0 then continue
        unlanded := volley.amount - volley.landed
        if unlanded > 0 then pending[volley.to][volley.from] = Math.max(pending[volley.to][volley.from] - unlanded, 0)
        if volley.lethal {
            splash(motes, random, layout, game.identity[volley.from], volley.to, volley.end, true)
            bursts += 1
        }
        remove volley
    }
}

// A landing's splash at a place: motes of the attacker's thrown out from
// it; a lethal volley's end a much bigger burst.
splash :: (motes: *Particles.System, random: *Random.Generator, layout: Layout, identity: Identity, to: i64, at: V2, lethal: bool) {
    cell := cell_of(layout)
    count := if lethal then 90 else 14
    reach: f32 = if lethal then 5 else 2.8
    for _: 0 < count {
        angle := f32'random.below(0.0, Math.TAU)
        speed := f32'random.below(0.3, 1.0) * reach * cell
        *s := mote_of(random, identity, at, V2⟨Math.cos(angle), Math.sin(angle)⟩ * speed, layout.seats[to].toward * -1, cell, SPLASH_MOTE)
        s.drag = 3
        if lethal {
            s.life = s.life * 1.2
            s.size = s.size * 1.8
            s.size_end = s.size_end * 1.5
        }
        else {
            s.life = s.life * 0.5
        }
        motes.add(s)
    }
}

// The game as it's shown while volleys are in flight: what they'll do not
// yet done.
shown_game :: (game: Game, pending: [MAX_PLAYERS] [MAX_PLAYERS] i32 -> shown: Game) #pure {
    shown = game
    for to: 0 < MAX_PLAYERS {
        for from: 0 < MAX_PLAYERS {
            shown.life[to] += pending[to][from]
            shown.commander[to][from] -= pending[to][from]
        }
    }
}

// Every volley's motes gone, every volley forgotten, and nothing pending
// (an undo, a new game).
call_off_volleys :: (motes: *Particles.System, volleys: *Volleys, pending: *[MAX_PLAYERS] [MAX_PLAYERS] i32) {
    for *m: motes.motes {
        if m.tag & VOLLEY_MOTE != 0 then remove m
    }
    volleys.list.clear()
    for *row: pending { for *p: row { p = 0 } }
}

// The motes as they'd be ten seconds in (for snapshots, the same each time:
// long enough for the longest-lived miasma, white's orbits, to fill): the
// miasmas, a drag's stream from from to finger over the last two seconds
// (from -1: none), and a volley of volley from from to to, let go there, a
// third of a second before the end (0: none).
SETTLE_FRAMES :: 600
settled_motes :: (layout: Layout, game: Game, from: i64 = -1, finger: V2 = ⟨0, 0⟩, amount: i32 = 0, to: i64 = 0, volley: i32 = 0 -> motes: Particles.System) {
    *made: Particles.System = ⟨flow_scale: MOTE_FLOW * cell_of(layout)⟩
    *volleys: Volleys
    *random := Random.generator(seed: 1)
    *pending: [MAX_PLAYERS] [MAX_PLAYERS] i32
    for frame: 0 < SETTLE_FRAMES {
        seconds: f32 = 1.0 / 60
        streaming := from >= 0 and volley == 0 and frame >= SETTLE_FRAMES - 120
        feed_miasmas(made, random, layout, game, seconds)
        if streaming then feed_stream(made, random, layout, game, from, finger, amount, seconds)
        if frame == SETTLE_FRAMES - 20 and volley > 0 {
            start, bend, end := stream_path(layout, game, from, finger)
            fire_volley(made, volleys, random, layout, game.identity[from], from, to, volley, false, start, bend, end)
        }
        made.update(seconds)
        if streaming then steer_stream(made, layout, game, from, finger, seconds)
        steer_volleys(made, volleys, random, layout, game, pending, seconds)
    }
    motes = made
}

// The flow field's eddies, in cells.
MOTE_FLOW :: 1.5

// How many points a heart's outline has (a GPU's shader takes 64 at most:
// a soft, wavering edge needs no more), and how big one alone is, in cells.
HEART_POINTS :: 36
HEART_CELLS :: 1.6

// What's at the heart of a colour's miasma.
Heart :: enum u8 {
    SUN       // white's
    WATER     // blue's
    OIL       // black's
    FIRE      // red's
    METAL     // an artifact's (no colours)
}

// The heart each of a player's colours has at their miasma, under its motes:
// white's sun (its motes orbiting it), blue's water (its drops falling from
// it), black's slick of oil (its smoke curling over it), red's fire (its
// sparks flying up from it), an artifact's liquid metal (its sparks flung
// from it); green has none. One alone is at the player's damage spot,
// HEART_CELLS across; several are smaller, round it, slowly turning. Each
// faces its player (up, away from them), and moves with time always, as
// the miasmas do.
draw_hearts :: (canvas: *Draw.Canvas, layout: Layout, game: Game, time: f32) {
    cell := cell_of(layout)
    for seat, k: layout.seats[:layout.count] {
        if is_out(game, k) then continue
        *hearts: [4] Heart
        *n: i64 = 0
        for colour, i: [4] Mana⟨.WHITE, .BLUE, .BLACK, .RED⟩ {
            if has_colour(game.identity[k], colour) {
                hearts[n] = Heart'u8'i
                n += 1
            }
        }
        if game.identity[k] == 0 {
            hearts[0] = .METAL
            n = 1
        }
        for heart, i: hearts[:n] {
            *at := seat.icon
            *size := HEART_CELLS * cell
            if n > 1 {
                turn := f32'i / f32'n * f32'Math.TAU + time * 0.05
                at = seat.icon + V2⟨Math.cos(turn), Math.sin(turn)⟩ * (0.5 * cell)
                size = 0.62 * HEART_CELLS * cell
            }
            seed := f32'(k * 3 + i)
            draw_heart(canvas, heart, at, size, seat.angle, time, seed)
        }
    }
}

// One heart, size across at a point, facing a way (its player's text's turn).
draw_heart :: (canvas: *Draw.Canvas, heart: Heart, at: V2, size: f32, angle: f32, time: f32, seed: f32) {
    if heart is {
    case .SUN: draw_sun(canvas, at, size, angle, time, seed)
    case .WATER: draw_water(canvas, at, size, angle, time, seed)
    case .OIL: draw_oil(canvas, at, size, angle, time, seed)
    case .FIRE: draw_fire(canvas, at, size, angle, time, seed)
    case .METAL: draw_metal(canvas, at, size, angle, time, seed)
    }
}

// A circle's outline about a point.
ring_about :: (at: V2, radius: f32 -> [HEART_POINTS] V2) #pure {
    *ring: [HEART_POINTS] V2
    for i: 0 < HEART_POINTS {
        a := f32'i / f32'HEART_POINTS * f32'Math.TAU
        ring[i] = at + V2⟨Math.cos(a), Math.sin(a)⟩ * radius
    }
    return ring
}

// White's sun: a disc white-hot in its middle, gold, then amber fading to
// nothing at its edge, its light a starfield's depths (Patterns' stars:
// clusters and clouds drifting through it), breathing slowly, a bloom of
// its light about it and a hot point at its heart.
draw_sun :: (canvas: *Draw.Canvas, at: V2, size: f32, angle: f32, time: f32, seed: f32) {
    r := 0.6 * size * (1 + 0.04 * Math.sin(time * 0.8 + seed))
    ring := ring_about(at, r)
    canvas.fill_light(at, 0.1 * size, 1.1 * size, Draw.rgba(0xFFB860, 0.3), 1)
    // (the starfield's stars a pixel or two, its clouds about the disc's
    // size; its dark fading the light, as space between)
    canvas.fill_polygon(ring[:], Draw.Gradient⟨from: at, to: at + V2⟨r, 0⟩, radial: true,
        colours: ⟨Draw.rgba(0xFFF4D8, 1), Draw.rgba(0xFFD890, 0.95), Draw.rgba(0xF4A850, 0.8), Draw.rgba(0xD87830, 0.45), Draw.rgba(0xB05020, 0)⟩,
        pattern: ⟨kind: .STARS, scale: 0.006 * size, strength: 0.9, seed: seed, time: time * 1.5, angle: angle, fades: true⟩⟩)
    canvas.fill_glow(at, 0.16 * size, Draw.rgba(0xFFFFF6, 0.8), 1)
}

// Red's fire: three flames one inside another (red, orange, white-yellow at
// its heart), each a teardrop rising up its player's frame (toward the
// screen's centre), its tip swaying, its light tongues of fire climbing
// (Patterns' flames), and a glow of its light about it.
draw_fire :: (canvas: *Draw.Canvas, at: V2, size: f32, angle: f32, time: f32, seed: f32) {
    canvas.fill_light(at, 0.12 * size, 1.0 * size, Draw.rgba(0xFF7A30, 0.28), 1)
    sway := 0.1 * Math.sin(time * 3.1 + seed) + 0.04 * Math.sin(time * 7.3 + seed * 2.3)
    // (its dark fades it to clear, so its tongues break its edges, not black:
    // the outer flame broken most, the heart nearly whole)
    *pattern := Draw.Pattern⟨kind: .FLAMES, scale: 0.13 * size, seed: seed, time: time * 2.6, angle: angle, fades: true⟩
    strengths := [3] f32⟨0.95, 0.55, 0.25⟩
    layers := [3] f32⟨1, 0.66, 0.36⟩
    colours := [3] [3] Draw.RGBA⟨
        ⟨Draw.rgba(0xFF6A1C, 0.85), Draw.rgba(0xE0381A, 0.6), Draw.rgba(0x901010, 0)⟩,
        ⟨Draw.rgba(0xFFB838, 0.9), Draw.rgba(0xFF7A22, 0.7), Draw.rgba(0xE04010, 0)⟩,
        ⟨Draw.rgba(0xFFF6D0, 0.9), Draw.rgba(0xFFD860, 0.75), Draw.rgba(0xFFA030, 0)⟩
    ⟩
    for layer, l: layers {
        // (tall and narrow; each inner one lower, so the heat's at the root)
        h := 0.62 * size * layer
        w := 0.34 * size * (0.5 + 0.5 * layer)
        // (its bulb toward its player, so it rises from the spot)
        base := V2⟨0, 0.2 * size + 0.62 * size * (1 - layer) * 0.6⟩
        *outline: [HEART_POINTS] V2
        for i: 0 < HEART_POINTS {
            t := f32'i / f32'HEART_POINTS * f32'Math.TAU
            y := 0 - h * Math.cos(t)
            up := (h - y) / (2 * h)
            // (its edge wavering with noise that climbs, more toward its tip)
            side: f32 = if t < f32'Math.PI then 1 else -1
            waver := Patterns.layered(V2⟨side * 2.3 + seed, y / size * 4 + time * 2.4⟩, 2) - 0.5
            x := w * Math.sin(t) * Math.sin(t / 2) * (1 + waver * (0.3 + 0.9 * up)) + sway * size * up * up
            outline[i] = placed(at, angle, base + V2⟨x, y⟩)
        }
        heart := placed(at, angle, base + V2⟨0, 0.45 * h⟩)
        pattern.strength = strengths[l]
        canvas.fill_polygon(outline[:], Draw.Gradient⟨from: heart, to: heart + V2⟨1.45 * h, 0⟩, radial: true, colours: colours[l][:], pattern: pattern⟩)
    }
}

// A blob's outline about a point, half size across, its edge wandering (as
// quickly as speed) in and out by up to wobble of its radius.
blob_outline :: (at: V2, size: f32, time: f32, seed: f32, speed: f32, wobble: f32 -> [HEART_POINTS] V2) #pure {
    *outline: [HEART_POINTS] V2
    for i: 0 < HEART_POINTS {
        a := f32'i / f32'HEART_POINTS * f32'Math.TAU
        way := V2⟨Math.cos(a), Math.sin(a)⟩
        wander := Patterns.layered(way * 1.3 + V2⟨time * speed + seed * 3.1, seed * 1.7⟩, 2)
        outline[i] = at + way * (0.5 * size * (1 + 2 * wobble * (wander - 0.5)))
    }
    return outline
}

// Blue's water: a body of it, clear cyan at its heart to deep blue, a pale
// rim where it meets the air, its edge rippling, its surface streaming
// toward its player (Patterns' water: ripples sliding over themselves,
// caustics, foam on the crests), a soft blue light about it.
draw_water :: (canvas: *Draw.Canvas, at: V2, size: f32, angle: f32, time: f32, seed: f32) {
    canvas.fill_glow(at, 0.75 * size, Draw.rgba(0x3AA6E0, 0.22), 1)
    outline := blob_outline(at, size, time, seed, 0.25, 0.2)
    canvas.fill_polygon(outline[:], Draw.Gradient⟨from: at, to: at + V2⟨0.56 * size, 0⟩, radial: true,
        colours: ⟨Draw.rgba(0x9FE6FF, 0.78), Draw.rgba(0x3AA6E0, 0.85), Draw.rgba(0x1A6CB8, 0.9), Draw.rgba(0xBFF0FF, 0.95)⟩,
        pattern: ⟨kind: .WATER, scale: 0.22 * size, strength: 0.6, seed: seed, time: time * 1.2, angle: angle⟩⟩)
}

// An artifact's liquid metal: a blob of silver, its edge slow and heavy,
// its surface swirling (Patterns' chrome: a sky's reflection and its
// horizon in each swell, a faint bismuth tint).
draw_metal :: (canvas: *Draw.Canvas, at: V2, size: f32, angle: f32, time: f32, seed: f32) {
    outline := blob_outline(at, size, time, seed, 0.06, 0.15)
    canvas.fill_polygon(outline[:], Draw.Gradient⟨from: at, to: at + V2⟨0.55 * size, 0⟩, radial: true,
        colours: ⟨Draw.rgba(0xE8ECF0, 0.98), Draw.rgba(0xB8C0C8, 0.98), Draw.rgba(0x8A929A, 0.98)⟩,
        pattern: ⟨kind: .CHROME, scale: 0.3 * size, strength: 0.9, seed: seed, time: time * 0.5, angle: angle⟩⟩)
}

// Black's slick of oil: a blob of near-black, its edge slowly wandering,
// its surface flowing (Patterns' oil: lit slopes, sharp highlights, a
// rainbow sheen where it runs thin).
draw_oil :: (canvas: *Draw.Canvas, at: V2, size: f32, angle: f32, time: f32, seed: f32) {
    outline := blob_outline(at, size, time, seed, 0.08, 0.3)
    canvas.fill_polygon(outline[:], Draw.Gradient⟨from: at, to: at + V2⟨0.6 * size, 0⟩, radial: true,
        colours: ⟨Draw.rgba(0x0C0B11, 0.97), Draw.rgba(0x09080D, 0.94), Draw.rgba(0x060509, 0.88)⟩,
        pattern: ⟨kind: .OIL, scale: 0.3 * size, strength: 0.85, seed: seed, time: time * 0.35, angle: angle⟩⟩)
}

// A soft pool of shadow under each miasma, so its light shows on a light part.
// (A black player's is a pale haze instead, so their oily smoke shows on it.)
draw_miasma_pools :: (canvas: *Draw.Canvas, layout: Layout, game: Game) {
    cell := cell_of(layout)
    black_only := Identity'(u8'1 << u8'Mana.BLACK)
    for seat, k: layout.seats[:layout.count] {
        if is_out(game, k) then continue
        pool := if game.identity[k] == black_only then Draw.rgba(0xA89CB0, 0.35) else Draw.rgba(0x000000, 0.4)
        canvas.fill_glow(seat.icon, 1.2 * cell, pool)
    }
}
