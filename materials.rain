// Original material atlas: seven surfaces and one neutral turbulence tile.
MATERIAL_BYTES :: #data "textures/materials-v1.png"
material_image: Draw.Image

// Inset samples keep bilinear filtering inside one atlas cell.
material_sample :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, tile: i32, uv: V2 -> V3) {
    inset := V2⟨0.006, 0.006⟩ + uv * 0.988
    mapped := (inset + V2⟨f32'(tile % 4), f32'(tile / 4)⟩) / V2⟨4, 2⟩
    return Shader.sample_level(atlas, filtering, mapped, 0).xyz
}

// Four overlapping windows fade to zero at their own wrap. This makes a
// continuous repeat without reflecting recognisable leaves into a kaleidoscope.
material_at :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, tile: i32, uv: V2 -> V3) {
    a := Math.fract(uv)
    b := Math.fract(uv + V2⟨0.5, 0.5⟩)
    wave := Math.sin(a * f32'Math.PI)
    weight := wave * wave
    p00 := material_sample(atlas, filtering, tile, a)
    p10 := material_sample(atlas, filtering, tile, V2⟨b.x, a.y⟩)
    p01 := material_sample(atlas, filtering, tile, V2⟨a.x, b.y⟩)
    p11 := material_sample(atlas, filtering, tile, b)
    return Math.mix(Math.mix(p11, p01, weight.x), Math.mix(p10, p00, weight.x), weight.y)
}


// Two scales moving against each other keep the detail from looking like a
// scrolling photograph. This is density detail, never a replacement silhouette.
material_flow :: (atlas: Shader.Texture_2D, filtering: Shader.Sampler, q: V2, time: f32, seed: f32 -> f32) {
    drift := V2⟨time * 0.035, 0 - time * 0.09⟩
    a := material_at(atlas, filtering, 7, q * 0.45 + drift + V2⟨seed, 0⟩).x
    b := material_at(atlas, filtering, 7, V2⟨q.y, 0 - q.x⟩ * 0.73 - drift * 0.6).x
    return Math.clamp(a * 0.65 + b * 0.35, 0, 1)
}

// The atlas follows WUBRG, then colourless and gold; never infer an identity
// from its current RGB palette, which may change.
material_tile :: (identity: Identity -> i32) #pure {
    *count: i32 = 0
    *tile: i32 = 5
    for colour: [5] Mana⟨.WHITE, .BLUE, .BLACK, .RED, .GREEN⟩ {
        if has_colour(identity, colour) { count += 1; tile = i32'u8'colour }
    }
    return if count > 1 then 6 else tile
}

material_tiles_follow_identity :: () #test {
    assert(material_tile(0) == 5)
    for i: 0 < 5 { assert(material_tile(u8'1 << u8'i) == i32'i) }
    for i: 0 < 5 {
        for j: i + 1 < 5 { assert(material_tile((u8'1 << u8'i) | (u8'1 << u8'j)) == 6) }
    }
}

// Card-back material, shared by the central controls and count selector.
CONTROL_BYTES :: #data "textures/card-back-v1.png"
control_image: Draw.Image

control_material :: (texture: Shader.Texture_2D, filtering: Shader.Sampler, uv: V2 -> V3) {
    a := Math.fract(uv)
    b := Math.fract(uv + V2⟨0.5, 0.5⟩)
    wave := Math.sin(a * f32'Math.PI)
    weight := wave * wave
    p00 := Shader.sample_level(texture, filtering, a, 0).xyz
    p10 := Shader.sample_level(texture, filtering, V2⟨b.x, a.y⟩, 0).xyz
    p01 := Shader.sample_level(texture, filtering, V2⟨a.x, b.y⟩, 0).xyz
    p11 := Shader.sample_level(texture, filtering, b, 0).xyz
    return Math.mix(Math.mix(p11, p01, weight.x), Math.mix(p10, p00, weight.x), weight.y)
}

Control_Panel_Params :: struct {
    box: V4     // centre, half size
    style: V4   // corner radius, texture scale, reserved
}

control_panel_shade :: (from: Draw.Quad_Between, panel: Shader.Uniforms(Control_Panel_Params), texture: Shader.Texture_2D, filtering: Shader.Sampler -> colour: V4) {
    p := from.pixel - panel.box.xy
    distance := round_box_distance(p, panel.box.zw, panel.style.x)
    if distance > 1 then return V4⟨0, 0, 0, 0⟩
    coverage := Math.clamp(0.5 - distance, 0, 1)
    rgb := control_material(texture, filtering, from.pixel / panel.style.y) * (0.78 + 0.22 * Math.smoothstep(0, 5, 0 - distance))
    return V4⟨rgb.x, rgb.y, rgb.z, 1⟩ * coverage
}

Control_Panel :: shader { vertex: Draw.quad_place; fragment: control_panel_shade }
CONTROL_PANEL :: Control_Panel(Draw.SHADER_TARGET)

draw_control_panel :: (canvas: *Draw.Canvas, at: V2, size: V2, radius: f32, cell: f32) {
    centre := at + size / 2
    params := Control_Panel_Params⟨V4⟨centre.x, centre.y, size.x / 2, size.y / 2⟩, V4⟨radius, cell * 6, 0, 0⟩⟩
    canvas.draw_shader_image(at - V2⟨1, 1⟩, size + V2⟨2, 2⟩, CONTROL_PANEL.code, CONTROL_PANEL.bindings.panel, params, control_image, CONTROL_PANEL.bindings.texture, CONTROL_PANEL.bindings.filtering)
}
