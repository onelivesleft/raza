// The game: each player's life, and the damage each commander has done to
// each player.

STARTING_LIFE :: 40
LETHAL_COMMANDER_DAMAGE :: 21

// Magic's five colours, in their order (WUBRG).
Mana :: enum u8 {
    WHITE
    BLUE
    BLACK
    RED
    GREEN
}

// A commander's colour identity: a bit for each colour, by Mana's value.
Identity :: #alias u8

has_colour :: (identity: Identity, colour: Mana -> bool) #pure {
    return identity & (u8'1 << u8'colour) != 0
}

// The identity of one colour alone.
mono :: (colour: Mana -> Identity) #pure {
    return u8'1 << u8'colour
}

// The way a seat's player faces, as an angle from the centre (y down).
facing_of :: (seat: Seat -> f32) #pure {
    return Math.atan2(seat.toward.y, seat.toward.x)
}

// The colours the settings' Reset gives, seat by seat, for a count of
// players on a screen of a size (its lines where they start). Six are, from
// the top seat round clockwise, white, blue, green, black, red and an
// artifact deck (no colours). Fewer are six's with players taken away, the
// rest staying where they were: five without the artifact deck, four
// without white too, three without black, two without green. Each time one
// goes, the others go round to the next count's seats as little as they can
// (of two ways as little, clockwise). Six's top seat is the one facing
// nearest straight up (of two as near, the one right of the top).
starting_colours :: (size: V2, players: i64 -> identity: [MAX_PLAYERS] Identity) #pure {
    // (within a step and a half of facing, or of a step for each player's
    // going round, counts as as near: facings are rounded to steps, so two
    // places mirrored about the top may differ by one)
    *layout := lay_out(size, equal_splits(MAX_PLAYERS, size))
    up := -f32'Math.PI / 2
    *top: i64 = 0
    *least: f32 = 1e30
    for seat, k: layout.seats[:MAX_PLAYERS] {
        turn := turn_between(up, facing_of(seat))
        off := Math.abs(turn)
        if off < least - 1.5 * FACING_STEP or (off < least + 1.5 * FACING_STEP and turn > 0) {
            least = off
            top = k
        }
    }
    from_top := [MAX_PLAYERS] Identity⟨mono(.WHITE), mono(.BLUE), mono(.GREEN), mono(.BLACK), mono(.RED), 0⟩
    identity = ⟨⟩
    for colours, i: from_top { identity[(top + i) % MAX_PLAYERS] = colours }
    // Who goes as the count comes down from six: the n-th, going to n - 1.
    going := [MAX_PLAYERS + 1] Identity⟨0, 0, 0, mono(.GREEN), mono(.BLACK), mono(.WHITE), 0⟩
    *n: i64 = MAX_PLAYERS
    while n > Math.clamp(players, 2, MAX_PLAYERS) {
        // Those staying, in order round, and where each faces.
        *staying: [MAX_PLAYERS] Identity
        *was: [MAX_PLAYERS] f32
        *m: i64 = 0
        *gone := false
        for k: 0 < n {
            if !gone and identity[k] == going[n] {
                gone = true
            } else {
                staying[m] = identity[k]
                was[m] = facing_of(layout.seats[k])
                m += 1
            }
        }
        next := lay_out(size, equal_splits(n - 1, size))
        // The turn round the next count's seats that moves them least.
        *best_turn: i64 = 0
        *best_cost: f32 = 1e30
        *best_way: f32 = 0
        for turn: 0 < m {
            *cost: f32 = 0
            *way: f32 = 0
            for i: 0 < m {
                moved := turn_between(was[i], facing_of(next.seats[(i + turn) % m]))
                cost += Math.abs(moved)
                way += moved
            }
            tie := 1.5 * FACING_STEP * f32'm
            if cost < best_cost - tie or (cost < best_cost + tie and way > best_way) {
                best_turn = turn
                best_cost = cost
                best_way = way
            }
        }
        identity = ⟨⟩
        for colours, i: staying[:m] { identity[(i + best_turn) % m] = colours }
        layout = next
        n -= 1
    }
}

// The colours a game of to players takes from one of from players (on a
// screen of a size). Each seat is a slot, named by its starting colours
// (Reset's, which tell a count's slots apart; a slot's own colours are
// whatever its player has set). A count's change keeps each slot both
// counts have, its colours as they are, at its place in the new count; takes
// away the slots the smaller lacks (from six down: the artifact deck's,
// then white's, black's, green's); and gives a slot added its starting
// colours.
colours_for :: (identity: [MAX_PLAYERS] Identity, from: i64, to: i64, size: V2 -> colours: [MAX_PLAYERS] Identity) #pure {
    a := Math.clamp(from, 2, MAX_PLAYERS)
    b := Math.clamp(to, 2, MAX_PLAYERS)
    was := starting_colours(size, a)
    colours = starting_colours(size, b)
    for j: 0 < b {
        for k: 0 < a {
            if was[k] == colours[j] {
                colours[j] = identity[k]
                break
            }
        }
    }
}

Game :: struct {
    players:   i64 = 4
    life:      [MAX_PLAYERS] i32
    // commander[to][from]: what from's commander has done to to.
    commander: [MAX_PLAYERS] [MAX_PLAYERS] i32
    // Each player's commander's colours, as they've set them.
    identity:  [MAX_PLAYERS] Identity
}

// A game begun: everyone at the starting life, no damage done, each seat's
// colours those it had before (the same decks, mostly, sit in the same
// seats).
new_game :: (players: i64, identity: [MAX_PLAYERS] Identity = ⟨⟩ -> game: Game) #pure {
    game = ⟨players: Math.clamp(players, 2, MAX_PLAYERS), identity: identity⟩
    for *l: game.life { l = STARTING_LIFE }
}

// Whether a player has lost: no life left, or a commander's lethal damage.
is_out :: (game: Game, player: i64 -> bool) #pure {
    if game.life[player] <= 0 then return true
    for d: game.commander[player][:game.players] {
        if d >= LETHAL_COMMANDER_DAMAGE then return true
    }
    return false
}

// Commander damage from one player's commander to another: it's life lost
// too.
deal :: (game: *Game, from: i64, to: i64, amount: i32) {
    if amount <= 0 or from == to then return
    game.commander[to][from] += amount
    game.life[to] -= amount
}

// What a drag that's reached a share of the way across a player's part
// does: 1 just inside, up to 20 near its far edge, and in the last strip a
// number to pick (asked).
QUESTION_FROM :: 0.88
MOST_BY_DRAG :: 20

Drag_Amount :: union {
    damage: i32
    asked
}

amount_for :: (share: f32 -> Drag_Amount) #pure {
    if share >= QUESTION_FROM then return Drag_Amount.asked
    steps := i32'Math.floor(Math.max(share, 0) / QUESTION_FROM * f32'MOST_BY_DRAG)
    return Drag_Amount.damage(Math.clamp(steps + 1, 1, MOST_BY_DRAG))
}
