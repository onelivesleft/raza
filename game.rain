// The game: each player's life, and the damage each commander has done to
// each player.

STARTING_LIFE :: 40
LETHAL_COMMANDER_DAMAGE :: 21

// Magic's five colours, in their order (WUBRG).
Mana :: enum u8 {
    WHITE
    BLUE
    BLACK
    RED
    GREEN
}

// A commander's colour identity: a bit for each colour, by Mana's value.
Identity :: #alias u8

has_colour :: (identity: Identity, colour: Mana -> bool) #pure {
    return identity & (u8'1 << u8'colour) != 0
}

// The identity of one colour alone.
mono :: (colour: Mana -> Identity) #pure {
    return u8'1 << u8'colour
}

// The colours the settings' Reset gives, from the top seat round clockwise: white, blue,
// green, black, red and an artifact deck (no colours) for six; five drop the
// artifact, four white, three black, and two green. The top seat is the one
// facing nearest straight up (of two as near, the one right of the top).
starting_colours :: (layout: Layout -> identity: [MAX_PLAYERS] Identity) #pure {
    n := layout.count
    w := mono(.WHITE)
    u := mono(.BLUE)
    g := mono(.GREEN)
    b := mono(.BLACK)
    r := mono(.RED)
    order: [MAX_PLAYERS] Identity = if n is {
        case 6: ⟨w, u, g, b, r, 0⟩
        case 5: ⟨w, u, g, b, r, 0⟩
        case 4: ⟨u, g, b, r, 0, 0⟩
        case 3: ⟨u, g, r, 0, 0, 0⟩
        case: ⟨u, r, 0, 0, 0, 0⟩
    }
    up := -f32'Math.PI / 2
    *top: i64 = 0
    *least: f32 = 1e30
    for seat, k: layout.seats[:n] {
        turn := turn_between(up, Math.atan2(seat.toward.y, seat.toward.x))
        off := Math.abs(turn)
        // (within a step and a half of facing counts as as near: facings are
        // rounded to steps, so two parts mirrored about the top may differ by one)
        if off < least - 1.5 * FACING_STEP or (off < least + 1.5 * FACING_STEP and turn > 0) {
            least = off
            top = k
        }
    }
    identity = ⟨⟩
    for colours, i: order[:n] { identity[(top + i) % n] = colours }
}

Game :: struct {
    players:   i64 = 4
    life:      [MAX_PLAYERS] i32
    // commander[to][from]: what from's commander has done to to.
    commander: [MAX_PLAYERS] [MAX_PLAYERS] i32
    // Each player's commander's colours, as they've set them.
    identity:  [MAX_PLAYERS] Identity
}

// A game begun: everyone at the starting life, no damage done, each seat's
// colours those it had before (the same decks, mostly, sit in the same
// seats).
new_game :: (players: i64, identity: [MAX_PLAYERS] Identity = ⟨⟩ -> game: Game) #pure {
    game = ⟨players: Math.clamp(players, 2, MAX_PLAYERS), identity: identity⟩
    for *l: game.life { l = STARTING_LIFE }
}

// Whether a player has lost: no life left, or a commander's lethal damage.
is_out :: (game: Game, player: i64 -> bool) #pure {
    if game.life[player] <= 0 then return true
    for d: game.commander[player][:game.players] {
        if d >= LETHAL_COMMANDER_DAMAGE then return true
    }
    return false
}

// Commander damage from one player's commander to another: it's life lost
// too.
deal :: (game: *Game, from: i64, to: i64, amount: i32) {
    if amount <= 0 or from == to then return
    game.commander[to][from] += amount
    game.life[to] -= amount
}

// What a drag that's reached a share of the way across a player's part
// does: 1 just inside, up to 20 near its far edge, and in the last strip a
// number to pick (asked).
QUESTION_FROM :: 0.88
MOST_BY_DRAG :: 20

Drag_Amount :: union {
    damage: i32
    asked
}

amount_for :: (share: f32 -> Drag_Amount) #pure {
    if share >= QUESTION_FROM then return Drag_Amount.asked
    steps := i32'Math.floor(Math.max(share, 0) / QUESTION_FROM * f32'MOST_BY_DRAG)
    return Drag_Amount.damage(Math.clamp(steps + 1, 1, MOST_BY_DRAG))
}
