// The game: each player's life, and the damage each commander has done to
// each player.

STARTING_LIFE :: 40
LETHAL_COMMANDER_DAMAGE :: 21

// Magic's five colours, in their order (WUBRG).
Mana :: enum u8 {
    WHITE
    BLUE
    BLACK
    RED
    GREEN
}

// A commander's colour identity: a bit for each colour, by Mana's value.
Identity :: #alias u8

has_colour :: (identity: Identity, colour: Mana -> bool) #pure {
    return identity & (u8'1 << u8'colour) != 0
}

// The identity of one colour alone.
mono :: (colour: Mana -> Identity) #pure {
    return u8'1 << u8'colour
}

// The way a seat's player faces, as an angle from the centre (y down).
facing_of :: (seat: Seat -> f32) #pure {
    return Math.atan2(seat.toward.y, seat.toward.x)
}

// The slots: each seat of a count is a slot, named by its starting colours
// (Reset's, which tell a count's slots apart; a slot's own colours are
// whatever its player has set). As the count comes down from six, a slot
// goes each time: GOING[n] names the one that goes from n to n - 1 (the
// artifact deck's, then white's, black's, green's); as it goes up, that slot
// comes back.
GOING :: [MAX_PLAYERS + 1] Identity⟨0, 0, 0, mono(.GREEN), mono(.BLACK), mono(.WHITE), 0⟩

// Which of a count's seats holds a slot's name (or colours), or -1.
seat_of :: (identity: [MAX_PLAYERS] Identity, count: i64, name: Identity -> i64) #pure {
    for c, k: identity[:count] { if c == name then return k }
    return -1
}

// Each seat's colours carried from a count's lines (more) to one fewer's
// (fewer), as the lines' morph takes the seats: the seat going (its index
// among more's) is the one whose two lines meet in one, and each other's
// colours go to the seat it becomes.
carried_down :: (identity: [MAX_PLAYERS] Identity, fewer: Splits, more: Splits, going: i64 -> carried: [MAX_PLAYERS] Identity) #pure {
    doubled, turn := morph_choice(fewer, more, going)
    m := more.count
    carried = ⟨⟩
    for i: 0 < m {
        if i != doubled then carried[source_of(i, doubled)] = identity[(i + turn) % m]
    }
}

// ...and from a count's lines (fewer) up to one more's (more): the seat
// that's new (coming, its index among more's) given added, each other's
// colours going to the seat it becomes.
carried_up :: (identity: [MAX_PLAYERS] Identity, fewer: Splits, more: Splits, coming: i64, added: Identity -> carried: [MAX_PLAYERS] Identity) #pure {
    doubled, turn := morph_choice(fewer, more, coming)
    m := more.count
    carried = ⟨⟩
    for i: 0 < m {
        if i != doubled then carried[(i + turn) % m] = identity[source_of(i, doubled)]
    }
    carried[coming] = added
}

// The colours the settings' Reset gives, seat by seat, for a count of
// players on a screen of a size (its lines where they start): each seat its
// slot's name. Six are, from the top seat round clockwise, white, blue,
// green, black, red and an artifact deck (no colours); six's top seat the
// one facing nearest straight up (of two as near, the one right of the top).
// Fewer are six's with slots taken away as GOING says, the rest carried as
// the lines' morph takes them (so the seat that goes is the one that's seen
// to go).
starting_colours :: (size: V2, players: i64 -> identity: [MAX_PLAYERS] Identity) #pure {
    // (within a step and a half of facing counts as as near: facings are
    // rounded to steps, so two places mirrored about the top may differ by one)
    six := lay_out(size, equal_splits(MAX_PLAYERS, size))
    up := -f32'Math.PI / 2
    *top: i64 = 0
    *least: f32 = 1e30
    for seat, k: six.seats[:MAX_PLAYERS] {
        turn := turn_between(up, facing_of(seat))
        off := Math.abs(turn)
        if off < least - 1.5 * FACING_STEP or (off < least + 1.5 * FACING_STEP and turn > 0) {
            least = off
            top = k
        }
    }
    from_top := [MAX_PLAYERS] Identity⟨mono(.WHITE), mono(.BLUE), mono(.GREEN), mono(.BLACK), mono(.RED), 0⟩
    identity = ⟨⟩
    for colours, i: from_top { identity[(top + i) % MAX_PLAYERS] = colours }
    *n: i64 = MAX_PLAYERS
    while n > Math.clamp(players, 2, MAX_PLAYERS) {
        identity = carried_down(identity, equal_splits(n - 1, size), equal_splits(n, size), seat_of(identity, n, GOING[n]))
        n -= 1
    }
}

Game :: struct {
    players:   i64 = 4
    life:      [MAX_PLAYERS] i32
    // commander[to][from]: what from's commander has done to to.
    commander: [MAX_PLAYERS] [MAX_PLAYERS] i32
    // Each player's commander's colours, as they've set them.
    identity:  [MAX_PLAYERS] Identity
}

// A game begun: everyone at the starting life, no damage done, each seat's
// colours those it had before (the same decks, mostly, sit in the same
// seats).
new_game :: (players: i64, identity: [MAX_PLAYERS] Identity = ⟨⟩ -> game: Game) #pure {
    game = ⟨players: Math.clamp(players, 2, MAX_PLAYERS), identity: identity⟩
    for *l: game.life { l = STARTING_LIFE }
}

// Whether a player has lost: no life left, or a commander's lethal damage.
is_out :: (game: Game, player: i64 -> bool) #pure {
    if game.life[player] <= 0 then return true
    for d: game.commander[player][:game.players] {
        if d >= LETHAL_COMMANDER_DAMAGE then return true
    }
    return false
}

// Commander damage from one player's commander to another: it's life lost
// too.
deal :: (game: *Game, from: i64, to: i64, amount: i32) {
    if amount <= 0 or from == to then return
    game.commander[to][from] += amount
    game.life[to] -= amount
}

// Progress from the region entry to the life total along the source-to-life
// line: nine equal bands, then a number to pick (asked).
QUESTION_FROM :: 1.0
MOST_BY_DRAG :: 9

Drag_Amount :: union {
    damage: i32
    asked
}

amount_for :: (share: f32 -> Drag_Amount) #pure {
    if share > QUESTION_FROM then return Drag_Amount.asked
    steps := i32'Math.floor(Math.max(share, 0) / QUESTION_FROM * f32'MOST_BY_DRAG)
    return Drag_Amount.damage(Math.clamp(steps + 1, 1, MOST_BY_DRAG))
}
